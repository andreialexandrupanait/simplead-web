# Copiază acest fișier în `.env` și completează valorile reale.
# Toate sunt OPȚIONALE în dev — dacă lipsesc, funcțiile aferente se dezactivează elegant.

# URL-ul canonic al site-ului (folosit pentru sitemap, OG, JSON-LD).
SITE_URL=https://simplead.ro

# --- Runtime server (setate în producție / Docker) ---
# Adresa și portul pe care ascultă adaptorul @astrojs/node standalone.
HOST=0.0.0.0
PORT=4321
# Director persistent pentru imaginile încărcate din /admin (volum în producție).
UPLOADS_DIR=/app/uploads

# Analytics & tracking — lăsate goale = scripturile NU se injectează.
GA4_ID=
GTM_ID=
CLARITY_ID=
# ID-uri pixel/tracking suplimentare (goale = dezactivate).
META_PIXEL_ID=
TIKTOK_ID=
REDDIT_ID=

# --- Google API server-side (GTM/GA4 provisioning & reports, opțional) ---
# Cheie Service Account JSON (inline) pentru API-urile GTM/GA4.
GOOGLE_SA_KEY=
GTM_SA_KEY=
# Alternativ: cale către fișierul de credențiale SA (folosit de scripturi).
GOOGLE_APPLICATION_CREDENTIALS=
GA4_PROPERTY_ID=
GTM_ACCOUNT_ID=
GTM_CONTAINER_ID=
# Meta Conversions API (server-side) — token, gol = dezactivat.
META_CAPI_TOKEN=

# Adresa care primește mesajele din formular.
CONTACT_TO_EMAIL=contact@simplead.ro
# Adresa „from" verificată în providerul de email.
CONTACT_FROM_EMAIL=site@simplead.ro

# Link public Cal.com pentru programări (ex. https://cal.com/andrei-panait/30min).
CALCOM_LINK=

# --- Bază de date (Postgres) ---
# Gol = site-ul rulează fără DB (pachete fallback, lead-urile nu se salvează).
# În Docker dev: postgres://simplead:simplead@db:5432/simplead
DATABASE_URL=
# Parola Postgres pentru docker-compose.prod.yml (schimb-o în producție!).
POSTGRES_PASSWORD=
# Domeniul pentru profilul caddy din producție (Hetzner).
DOMAIN=simplead.ro

# --- Admin (/admin) ---
# Generează cheile cu: pnpm gen:key --password "parola-ta"
# Fără acestea, /admin/login afișează „admin neconfigurat".
SESSION_SECRET=
ADMIN_EMAIL=
# Nume afișat pentru contul de admin bootstrap-at (opțional).
ADMIN_NAME=
# Recomandat: hash scrypt (din gen:key). ADMIN_PASSWORD plaintext doar în dev.
ADMIN_PASSWORD_HASH=
ADMIN_PASSWORD=

# Cheia master pentru criptarea secretelor salvate din /admin/integrari (64 hex).
APP_ENCRYPTION_KEY=

# --- Better Auth (useri & sesiuni) ---
# Secret de semnare (fallback pe SESSION_SECRET dacă lipsește) — generează 32+ bytes.
BETTER_AUTH_SECRET=
# URL de bază (fallback pe SITE_URL). În dev: http://localhost:4321
BETTER_AUTH_URL=
# Parolă pentru bootstrap-ul primului admin via POST /api/auth/setup (altfel se generează una).
ADMIN_SETUP_PASSWORD=
# Înregistrare publică (default OFF). 'true' = oricine se poate înregistra (rol implicit: client).
PUBLIC_SIGNUP=
# Flag-uri rezervate pentru extensii viitoare (vezi docs/roadmap-auth.md) — momentan inactive.
ENABLE_2FA=
ENABLE_ORGANIZATIONS=

# --- Login cu Google (opțional) ---
# Creează un OAuth Client (Web) în Google Cloud Console și adaugă redirect URI:
#   ${SITE_URL}/api/auth/callback/google
# Fără aceste valori, butonul „Continuă cu Google" e ascuns pe pagina de login.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Doar conturile din acest domeniu Workspace au voie să intre (default: simplead.ro).
GOOGLE_ALLOWED_DOMAIN=simplead.ro

# --- Integrări (fallback) ---
# Valorile principale se introduc din /admin/integrari (criptate în DB).
# Env-ul de mai jos e folosit doar dacă nu există valoare în DB.
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SMARTBILL_EMAIL=
SMARTBILL_TOKEN=
SMARTBILL_SERIES=
SMARTBILL_CIF=
SMARTBILL_TAX_NAME=
SMARTBILL_TAX_PERCENT=
SLACK_WEBHOOK_URL=

# MailerLite (newsletter) — fallback env; principalele valori vin din /admin.
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=

# ERP extern (opțional) — fallback env.
ERP_BASE_URL=
ERP_API_TOKEN=
