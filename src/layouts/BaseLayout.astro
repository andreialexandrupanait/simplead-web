---
import '../styles/global.css';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import Analytics from '@components/Analytics.astro';
import CookieBanner from '@components/CookieBanner.astro';
import ScrollTop from '@components/ui/ScrollTop.astro';
import ContactDrawer from '@components/react/ContactDrawer';
import { site } from '@data/site';
import { localeFromPath, localizePath, EN_LIVE } from '@i18n/index';
import { getPublicSettings, whatsappHref } from '@lib/server/public-settings';

interface Props {
  title?: string;
  description?: string;
  /** Imagine OG relativă la /public sau absolută. */
  ogImage?: string;
  /** Navbar transparent peste hero. */
  transparentNav?: boolean;
  /** Hero-ul de sub navbar e dark (text/logo alb peste el). */
  navOverDark?: boolean;
  /** Marchează pagina activă în meniu. */
  activePath?: string;
  /** Dezactivează indexarea. */
  noindex?: boolean;
  /** Tipul OpenGraph (website implicit; „article" pentru blog/portofoliu). */
  ogType?: 'website' | 'article';
  /** JSON-LD specific paginii (Service, BlogPosting…), adăugat în @graph. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  ogImage = '/og-default.png',
  transparentNav = false,
  navOverDark = false,
  activePath = Astro.url.pathname,
  noindex = false,
  ogType = 'website',
  schema,
} = Astro.props;

const locale = localeFromPath(Astro.url.pathname);
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · Grafică & marketing digital`;
const origin = (Astro.site ?? new URL(Astro.url.origin)).toString().replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const ogImageUrl = new URL(ogImage, Astro.site ?? Astro.url.origin).href;

// Alternate-uri de limbă (emise doar când versiunea EN e live, ca să nu trimitem
// crawlerele spre pagini inexistente).
const altBase = Astro.site ?? Astro.url.origin;
const roAlt = new URL(localizePath(Astro.url.pathname, 'ro'), altBase).href;
const enAlt = new URL(localizePath(Astro.url.pathname, 'en'), altBase).href;
const ogLocale = locale === 'en' ? 'en_US' : 'ro_RO';
const ogLocaleAlt = locale === 'en' ? 'ro_RO' : 'en_US';

// Setări publice: telefonul apare doar dacă e activat din /admin/setari.
const pub = await getPublicSettings();
const waHref = whatsappHref(pub.whatsappNumber);

// JSON-LD: Organization + LocalBusiness + WebSite (+ schema specific paginii).
// `telephone` intră în datele structurate doar când telefonul e public.
const telephone = site.contact.phoneHref.replace('tel:', '');
const phoneLd = pub.showPhone ? { telephone } : {};
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${origin}#organization`,
      name: site.name,
      url: origin,
      logo: new URL('/favicon.svg', origin).href,
      description: site.description,
      founder: { '@id': `${origin}#founder` },
      address: {
        '@type': 'PostalAddress',
        addressLocality: site.contact.city,
        addressCountry: 'RO',
      },
      ...phoneLd,
      email: site.contact.email,
    },
    {
      '@type': 'LocalBusiness',
      '@id': `${origin}#localbusiness`,
      name: site.name,
      url: origin,
      image: ogImageUrl,
      description: site.description,
      ...phoneLd,
      email: site.contact.email,
      priceRange: '$$',
      address: {
        '@type': 'PostalAddress',
        addressLocality: site.contact.city,
        addressCountry: 'RO',
      },
      areaServed: { '@type': 'Country', name: 'România' },
      // Program: Luni–Vineri, 09:00–18:00 (din site.contact.schedule)
      openingHoursSpecification: {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
        opens: '09:00',
        closes: '18:00',
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${origin}#website`,
      url: origin,
      name: site.name,
      inLanguage: 'ro-RO',
      publisher: { '@id': `${origin}#organization` },
    },
    // E-E-A-T: fondatorul ca Person cu credențiale academice verificabile.
    {
      '@type': 'Person',
      '@id': `${origin}#founder`,
      name: site.founder,
      jobTitle: site.founderTitle,
      url: site.founderSite,
      sameAs: [site.founderSite, site.founderOrcid],
      hasCredential: {
        '@type': 'EducationalOccupationalCredential',
        credentialCategory: 'degree',
        name: site.founderCredential,
      },
      worksFor: { '@id': `${origin}#organization` },
    },
    ...(schema ? (Array.isArray(schema) ? schema : [schema]) : []),
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    {
      EN_LIVE && (
        <>
          <link rel="alternate" hreflang="ro" href={roAlt} />
          <link rel="alternate" hreflang="en" href={enAlt} />
          <link rel="alternate" hreflang="x-default" href={roAlt} />
        </>
      )
    }
    <link rel="alternate" type="application/rss+xml" title="Simplead · Blog" href="/rss.xml" />

    <!-- Fonturi default site (Google Fonts) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Hanken+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content={ogLocale} />
    {EN_LIVE && <meta property="og:locale:alternate" content={ogLocaleAlt} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="theme-color" content="#ffffff" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    <Analytics />
  </head>
  <body>
    {
      /* GTM noscript scos intenționat: ar fi rulat fără consimțământ (GDPR).
        Trackerele pornesc doar după acceptul din CookieBanner. */
    }
    <a href="#main" class="skip-link">Sari la conținut</a>
    <Navbar transparent={transparentNav} overDark={navOverDark} activePath={activePath} />
    <main id="main">
      {
        Astro.locals.isAdmin && Astro.locals.siteMaintenance && (
          <div
            style="position:sticky;top:0;z-index:201;background:var(--ink);color:#fff;text-align:center;padding:9px 16px;font-size:0.85rem;font-weight:600;font-family:var(--font-body)"
          >
            Site-ul e în mentenanță. Îl vezi doar tu (admin); vizitatorii văd ecranul de mentenanță.
            Schimbi din{' '}
            <a href="/admin/setari" style="color:var(--signal);text-decoration:underline">
              Setări
            </a>
            .
          </div>
        )
      }
      {
        Astro.locals.pageUnderConstruction && Astro.locals.isAdmin && (
          <div
            style="position:sticky;top:0;z-index:200;background:var(--signal);color:var(--ink);text-align:center;padding:9px 16px;font-size:0.85rem;font-weight:600;font-family:var(--font-body)"
          >
            Pagina e marcată „în construcție". O vezi doar tu (admin); vizitatorii văd ecranul de
            construcție. Schimbi din{' '}
            <a href="/admin/setari" style="color:var(--ink);text-decoration:underline">
              Setări
            </a>
            .
          </div>
        )
      }
      <slot />
    </main>
    <Footer />
    <CookieBanner />
    <ScrollTop />

    <ContactDrawer
      client:idle
      phone={pub.showPhone ? site.contact.phone : ''}
      phoneHref={pub.showPhone ? site.contact.phoneHref : ''}
      email={site.contact.email}
      showPhone={pub.showPhone}
      whatsappHref={waHref}
    />

    {
      /* Linkurile către /contact deschid drawer-ul; fără JS / înainte de hidratare,
        navighează normal (degradare elegantă). */
    }
    <script>
      document.addEventListener('click', (e) => {
        const target = e.target as Element | null;
        const a = target?.closest?.('a[href*="/contact"]') as HTMLAnchorElement | null;
        if (!a) return;
        if (
          e.defaultPrevented ||
          (e as MouseEvent).button !== 0 ||
          (e as MouseEvent).metaKey ||
          (e as MouseEvent).ctrlKey ||
          (e as MouseEvent).shiftKey ||
          (e as MouseEvent).altKey
        )
          return;
        if (a.hasAttribute('data-no-drawer') || a.getAttribute('target') === '_blank') return;
        let url: URL;
        try {
          url = new URL(a.href, location.origin);
        } catch {
          return;
        }
        if (url.pathname !== '/contact') return;
        // Drawer nehidratat încă → lăsăm linkul să navigheze normal.
        if (typeof window.openContactDrawer !== 'function') return;
        e.preventDefault();
        window.openContactDrawer(url.searchParams.get('service') || '');
      });
    </script>

    <script>
      // Scroll reveal: subtil, accesibil ([data-reveal] / [data-reveal-stagger]).
      const els = Array.from(
        document.querySelectorAll<HTMLElement>('[data-reveal],[data-reveal-stagger]'),
      );
      if (els.length) {
        if (!('IntersectionObserver' in window)) {
          els.forEach((e) => e.classList.add('is-in'));
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((en) => {
                if (en.isIntersecting) {
                  en.target.classList.add('is-in');
                  io.unobserve(en.target);
                }
              });
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
          );
          els.forEach((e) => io.observe(e));
          // siguranță: dezvăluie orice rămâne ascuns după 1.2s
          setTimeout(() => {
            els.forEach((e) => {
              if (!e.classList.contains('is-in')) e.classList.add('is-in');
            });
          }, 1200);
        }
      }
    </script>
  </body>
</html>

<style>
  /* Skip-link: ascuns vizual, apare la focus de tastatură (accesibilitate). */
  .skip-link {
    position: fixed;
    top: 8px;
    left: 8px;
    z-index: 1000;
    padding: 10px 16px;
    border-radius: var(--r-sm);
    background: var(--ink);
    color: #fff;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
    transform: translateY(-150%);
    transition: transform 0.18s var(--ease-snap, ease);
  }
  .skip-link:focus-visible {
    transform: translateY(0);
    outline: 2px solid var(--electric);
    outline-offset: 2px;
  }
  @media (prefers-reduced-motion: reduce) {
    .skip-link {
      transition: none;
    }
  }
</style>
