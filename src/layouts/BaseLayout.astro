---
import '../styles/global.css';
import Navbar from '@components/Navbar.astro';
import Footer from '@components/Footer.astro';
import Analytics from '@components/Analytics.astro';
import CookieBanner from '@components/CookieBanner.astro';
import { site } from '@data/site';
import { resolveLocale } from '@i18n/index';

interface Props {
  title?: string;
  description?: string;
  /** Imagine OG relativă la /public sau absolută. */
  ogImage?: string;
  /** Navbar transparent peste hero. */
  transparentNav?: boolean;
  /** Hero-ul de sub navbar e dark (text/logo alb peste el). */
  navOverDark?: boolean;
  /** Marchează pagina activă în meniu. */
  activePath?: string;
  /** Dezactivează indexarea. */
  noindex?: boolean;
  /** JSON-LD specific paginii (Service, BlogPosting…), adăugat în @graph. */
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = site.description,
  ogImage = '/og-default.png',
  transparentNav = false,
  navOverDark = false,
  activePath = Astro.url.pathname,
  noindex = false,
  schema,
} = Astro.props;

const locale = resolveLocale(Astro.currentLocale);
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} · Grafică & marketing digital`;
const origin = (Astro.site ?? new URL(Astro.url.origin)).toString().replace(/\/$/, '');
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).href;
const ogImageUrl = new URL(ogImage, Astro.site ?? Astro.url.origin).href;

// JSON-LD: Organization + LocalBusiness + WebSite (+ schema specific paginii)
const telephone = site.contact.phoneHref.replace('tel:', '');
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${origin}#organization`,
      name: site.name,
      url: origin,
      logo: new URL('/favicon.svg', origin).href,
      description: site.description,
      founder: { '@type': 'Person', name: site.founder, jobTitle: site.founderTitle },
      address: {
        '@type': 'PostalAddress',
        addressLocality: site.contact.city,
        addressCountry: 'RO',
      },
      telephone,
      email: site.contact.email,
    },
    {
      '@type': 'LocalBusiness',
      '@id': `${origin}#localbusiness`,
      name: site.name,
      url: origin,
      image: ogImageUrl,
      description: site.description,
      telephone,
      email: site.contact.email,
      priceRange: '$$',
      address: {
        '@type': 'PostalAddress',
        addressLocality: site.contact.city,
        addressCountry: 'RO',
      },
      areaServed: { '@type': 'Country', name: 'România' },
      // Program: Luni–Vineri, 09:00–18:00 (din site.contact.schedule)
      openingHoursSpecification: {
        '@type': 'OpeningHoursSpecification',
        dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
        opens: '09:00',
        closes: '18:00',
      },
    },
    {
      '@type': 'WebSite',
      '@id': `${origin}#website`,
      url: origin,
      name: site.name,
      inLanguage: 'ro-RO',
      publisher: { '@id': `${origin}#organization` },
    },
    ...(schema ? (Array.isArray(schema) ? schema : [schema]) : []),
  ],
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />

    <!-- Fonturi default site (Google Fonts) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Hanken+Grotesk:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:locale" content="ro_RO" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <meta name="theme-color" content="#ffffff" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    <Analytics />
  </head>
  <body>
    {
      /* GTM noscript scos intenționat: ar fi rulat fără consimțământ (GDPR).
        Trackerele pornesc doar după acceptul din CookieBanner. */
    }
    <Navbar transparent={transparentNav} overDark={navOverDark} activePath={activePath} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <CookieBanner />

    <script>
      // Scroll reveal: subtil, accesibil ([data-reveal] / [data-reveal-stagger]).
      const els = Array.from(
        document.querySelectorAll<HTMLElement>('[data-reveal],[data-reveal-stagger]'),
      );
      if (els.length) {
        if (!('IntersectionObserver' in window)) {
          els.forEach((e) => e.classList.add('is-in'));
        } else {
          const io = new IntersectionObserver(
            (entries) => {
              entries.forEach((en) => {
                if (en.isIntersecting) {
                  en.target.classList.add('is-in');
                  io.unobserve(en.target);
                }
              });
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
          );
          els.forEach((e) => io.observe(e));
          // siguranță: dezvăluie orice rămâne ascuns după 1.2s
          setTimeout(() => {
            els.forEach((e) => {
              if (!e.classList.contains('is-in')) e.classList.add('is-in');
            });
          }, 1200);
        }
      }
    </script>
  </body>
</html>
