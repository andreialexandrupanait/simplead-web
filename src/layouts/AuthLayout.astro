---
/**
 * Layout pentru paginile de autentificare (login, recuperare, reset).
 * Split-screen, fără shell-ul admin (nu încarcă admin.css). Stiluri în auth.css,
 * pe tokenii din global.css. noindex.
 */
import '../styles/global.css';
import '../styles/auth.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Admin Simplead</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="auth-body">
    <slot />
  </body>
</html>
