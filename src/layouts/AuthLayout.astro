---
/**
 * Layout pentru paginile de autentificare (login, recuperare, reset).
 * Split-screen, fără shell-ul admin (nu încarcă admin.css). Stiluri în auth.css,
 * pe tokenii din global.css. noindex.
 */
import '../styles/global.css';
import '../styles/fonts.css';
import '../styles/auth.css';

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Admin Simplead</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/space-grotesk-600-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/hanken-grotesk-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body class="auth-body">
    <slot />
  </body>
</html>
