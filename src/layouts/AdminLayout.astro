---
/**
 * Layout pentru zona /admin: sidebar pe grupuri + topbar + toast-uri.
 * Fără Navbar/Footer/Analytics publice, noindex. Stiluri în styles/admin.css,
 * pe tokenii design system-ului (global.css).
 */
import '../styles/global.css';
import '../styles/fonts.css';
import '../styles/admin-theme.css';
import '../styles/admin.css';
import Logo from '../components/ui/Logo.astro';
import { takeFlash } from '../lib/server/flash';
import { readTheme } from '../lib/server/theme';

interface Props {
  title: string;
  /** Ascunde meniul (pagina de login). */
  bare?: boolean;
  /** Container mai lat (dashboard + liste dense). */
  wide?: boolean;
}
const { title, bare = false, wide = false } = Astro.props;

const flash = takeFlash(Astro.cookies);
// Paginile bare (login/recuperare) rămân light; restul citesc preferința din
// cookie și o ștanțează pe <body> încă din primul byte (zero flash).
const theme = bare ? 'light' : readTheme(Astro.cookies);

// Iconuri inline (stroke 2, 24x24) — fără dependențe.
const icons: Record<string, string> = {
  panou:
    '<rect x="3" y="3" width="7" height="9" rx="1.5"/><rect x="14" y="3" width="7" height="5" rx="1.5"/><rect x="14" y="12" width="7" height="9" rx="1.5"/><rect x="3" y="16" width="7" height="5" rx="1.5"/>',
  articole: '<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/>',
  portofoliu:
    '<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/>',
  media:
    '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.5-3.5L6 23"/>',
  comenzi:
    '<circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/>',
  pachete: '<path d="M21 8 12 3 3 8v8l9 5 9-5Z"/><path d="m3 8 9 5 9-5"/><path d="M12 13v8"/>',
  leads:
    '<path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.9"/><path d="M16 3.1a4 4 0 0 1 0 7.8"/>',
  abonati:
    '<path d="M4 4h16a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Z"/><path d="m22 6-10 7L2 6"/>',
  integrari:
    '<circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.9l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.9-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1-1.6 1.7 1.7 0 0 0-1.9.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.9 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.6-1 1.7 1.7 0 0 0-.3-1.9l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.9.3h.1a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.9-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.9v.1a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1Z"/>',
  site: '<circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10Z"/>',
  logout:
    '<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="m16 17 5-5-5-5"/><path d="M21 12H9"/>',
  tichete: '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z"/>',
  utilizatori:
    '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
  cont: '<circle cx="12" cy="8" r="4"/><path d="M4 21v-1a6 6 0 0 1 6-6h4a6 6 0 0 1 6 6v1"/>',
  evenimente: '<path d="M22 12h-4l-3 9L9 3l-3 9H2"/>',
  content:
    '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><path d="M9 13h6M9 17h6"/>',
  chevron: '<path d="m9 18 6-6-6-6"/>',
};

// Navigație în stil WordPress: intrări de nivel 1 (cu icon) care se expandează
// în submeniuri. Secțiunea care conține pagina curentă e deschisă automat.
type NavItem = { label: string; href: string };
type NavNode =
  | { type: 'single'; label: string; href: string; icon: string }
  | { type: 'group'; label: string; icon: string; items: NavItem[] };

const nav: NavNode[] = [
  { type: 'single', label: 'Panou', href: '/admin', icon: 'panou' },
  {
    type: 'group',
    label: 'Conținut',
    icon: 'content',
    items: [
      { label: 'Articole', href: '/admin/articole' },
      { label: 'Portofoliu', href: '/admin/portofoliu' },
      { label: 'Media', href: '/admin/media' },
      { label: 'Previzualizări clienți', href: '/admin/clienti' },
    ],
  },
  {
    type: 'group',
    label: 'Vânzări',
    icon: 'comenzi',
    items: [
      { label: 'Comenzi', href: '/admin/comenzi' },
      { label: 'Pachete', href: '/admin/pachete' },
    ],
  },
  {
    type: 'group',
    label: 'Audiență',
    icon: 'leads',
    items: [
      { label: 'Lead-uri', href: '/admin/leads' },
      { label: 'Tichete', href: '/admin/tichete' },
      { label: 'Abonați', href: '/admin/abonati' },
    ],
  },
  {
    type: 'group',
    label: 'Setări',
    icon: 'integrari',
    items: [
      { label: 'Utilizatori', href: '/admin/utilizatori' },
      { label: 'Site', href: '/admin/setari' },
      { label: 'Integrări', href: '/admin/integrari' },
      { label: 'Tracking & Analytics', href: '/admin/tracking' },
      { label: 'Experiment A/B', href: '/admin/experiment' },
    ],
  },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) =>
  currentPath === href || (href !== '/admin' && currentPath.startsWith(href));
const sectionActive = (items: NavItem[]) => items.some((i) => isActive(i.href));
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Admin Simplead</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="preload"
      href="/fonts/space-grotesk-600-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/hanken-grotesk-400-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body class="admin-body" data-theme={theme}>
    {
      bare ? (
        <main class="admin-main">
          <slot />
        </main>
      ) : (
        <div class="admin-shell" id="adminShell">
          <button class="admin-scrim" id="adminScrim" aria-label="Închide meniul" />
          <aside class="admin-sidebar">
            <a href="/admin" class="admin-sidebar__logo" aria-label="Admin Simplead">
              <Logo height={26} color="#ffffff" />
              <span class="admin-logo-badge">Admin</span>
            </a>
            <nav class="admin-nav" aria-label="Navigație admin">
              {nav.map((node) =>
                node.type === 'single' ? (
                  <a
                    href={node.href}
                    class:list={[
                      'admin-nav__link',
                      'admin-nav__link--top',
                      isActive(node.href) && 'is-active',
                    ]}
                    aria-current={isActive(node.href) ? 'page' : undefined}
                  >
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      set:html={icons[node.icon]}
                    />
                    <span class="admin-nav__text">{node.label}</span>
                  </a>
                ) : (
                  <div class="admin-nav__group">
                    <a
                      href={node.items[0].href}
                      class:list={[
                        'admin-nav__link',
                        'admin-nav__link--top',
                        'admin-nav__parent',
                        sectionActive(node.items) && 'is-section',
                      ]}
                      aria-current={sectionActive(node.items) ? 'true' : undefined}
                    >
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        set:html={icons[node.icon]}
                      />
                      <span class="admin-nav__text">{node.label}</span>
                      <svg
                        class="admin-nav__caret"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        set:html={icons.chevron}
                      />
                    </a>
                    <div class="admin-nav__flyout" role="menu" aria-label={node.label}>
                      <div class="admin-nav__flyout-label">{node.label}</div>
                      {node.items.map((item) => (
                        <a
                          href={item.href}
                          class:list={['admin-nav__sublink', isActive(item.href) && 'is-active']}
                          aria-current={isActive(item.href) ? 'page' : undefined}
                        >
                          {item.label}
                        </a>
                      ))}
                    </div>
                  </div>
                ),
              )}
            </nav>
            <div class="admin-sidebar__foot">
              <a href="/admin/cont">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={icons.cont}
                />
                Contul meu
              </a>
              <a href="/" target="_blank" rel="noopener">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={icons.site}
                />
                Vezi site-ul
              </a>
              <form method="post" action="/api/admin/logout">
                <button type="submit">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    set:html={icons.logout}
                  />
                  Ieși din cont
                </button>
              </form>
            </div>
          </aside>
          <div class="admin-content">
            <header class="admin-topbar">
              <button class="admin-burger" id="adminBurger" aria-label="Deschide meniul">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                >
                  <path d="M3 6h18M3 12h18M3 18h18" />
                </svg>
              </button>
              <div class="admin-topbar__title">{title}</div>
              <div class="admin-topbar__actions">
                <form method="post" action="/api/admin/theme" id="adminThemeForm">
                  <button
                    type="submit"
                    class="admin-theme-toggle"
                    id="adminThemeToggle"
                    aria-label="Comută tema"
                    aria-pressed={theme === 'dark' ? 'true' : 'false'}
                    title="Comută light / dark"
                  >
                    <svg
                      class="icon-sun"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <circle cx="12" cy="12" r="4" />
                      <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
                    </svg>
                    <svg
                      class="icon-moon"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z" />
                    </svg>
                  </button>
                </form>
                <a
                  class="admin-btn admin-btn--ghost admin-btn--sm"
                  href="/"
                  target="_blank"
                  rel="noopener"
                >
                  Vezi site-ul ↗
                </a>
              </div>
            </header>
            <main class:list={['admin-main', wide && 'admin-main--wide']}>
              <slot />
            </main>
          </div>
        </div>
      )
    }

    <div class="admin-toasts" id="adminToasts" aria-live="polite"></div>
    {flash && <script type="application/json" id="adminFlash" set:html={JSON.stringify(flash)} />}

    <script>
      // Toast-uri: window.adminToast(msg, kind) pentru acțiunile pe fetch +
      // redarea mesajului flash setat de POST-urile server-side.
      const toasts = document.getElementById('adminToasts')!;
      function adminToast(msg: string, kind: 'ok' | 'error' = 'ok') {
        const el = document.createElement('div');
        el.className = `admin-toast${kind === 'error' ? ' admin-toast--error' : ''}`;
        el.textContent = msg;
        toasts.appendChild(el);
        setTimeout(() => {
          el.classList.add('is-leaving');
          setTimeout(() => el.remove(), 300);
        }, 4200);
      }
      (window as unknown as { adminToast: typeof adminToast }).adminToast = adminToast;

      const flashEl = document.getElementById('adminFlash');
      if (flashEl?.textContent) {
        try {
          const f = JSON.parse(flashEl.textContent) as { kind: 'ok' | 'error'; msg: string };
          adminToast(f.msg, f.kind);
        } catch {
          /* flash corupt: îl ignorăm */
        }
      }

      // Sidebar pe mobil.
      const shell = document.getElementById('adminShell');
      document.getElementById('adminBurger')?.addEventListener('click', () => {
        shell?.classList.toggle('nav-open');
      });
      document.getElementById('adminScrim')?.addEventListener('click', () => {
        shell?.classList.remove('nav-open');
      });

      // Comutator temă: cu JS flip instant (cookie + atribut), fără reload.
      // Fără JS, form-ul face POST la /api/admin/theme și redirect. Baseline OK.
      document.getElementById('adminThemeForm')?.addEventListener('submit', (e) => {
        e.preventDefault();
        const body = document.body;
        const next = body.dataset.theme === 'dark' ? 'light' : 'dark';
        body.dataset.theme = next;
        document.cookie = `sa_theme=${next}; path=/admin; max-age=31536000; samesite=lax`;
        const btn = document.getElementById('adminThemeToggle');
        btn?.setAttribute('aria-pressed', next === 'dark' ? 'true' : 'false');
      });
    </script>
  </body>
</html>
