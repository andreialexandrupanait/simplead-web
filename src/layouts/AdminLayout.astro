---
/**
 * Layout pentru zona /admin: fără Navbar/Footer/Analytics publice, noindex.
 * Refolosește tokenii design system-ului (global.css), pe fundal deschis.
 */
import '../styles/global.css';
import Logo from '../components/ui/Logo.astro';

interface Props {
  title: string;
  /** Ascunde meniul (pagina de login). */
  bare?: boolean;
}
const { title, bare = false } = Astro.props;

const navItems = [
  { label: 'Panou', href: '/admin' },
  { label: 'Comenzi', href: '/admin/comenzi' },
  { label: 'Pachete', href: '/admin/pachete' },
  { label: 'Lead-uri', href: '/admin/leads' },
  { label: 'Integrări', href: '/admin/integrari' },
];
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Admin Simplead</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Hanken+Grotesk:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="admin-body">
    <header class="admin-topbar">
      <a href="/admin" class="admin-topbar__logo" aria-label="Admin Simplead">
        <Logo />
      </a>
      {
        !bare && (
          <>
            <nav class="admin-topbar__nav" aria-label="Navigație admin">
              {navItems.map((item) => (
                <a
                  href={item.href}
                  class:list={[
                    'admin-topbar__link',
                    (currentPath === item.href ||
                      (item.href !== '/admin' && currentPath.startsWith(item.href))) &&
                      'is-active',
                  ]}
                >
                  {item.label}
                </a>
              ))}
            </nav>
            <form method="post" action="/api/admin/logout" class="admin-topbar__logout">
              <button type="submit" class="admin-btn admin-btn--ghost">
                Ieși
              </button>
            </form>
          </>
        )
      }
    </header>
    <main class="admin-main">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  .admin-body {
    background: var(--canvas-soft);
    color: var(--ink);
    font-family: var(--font-body);
    min-height: 100vh;
  }
  .admin-topbar {
    display: flex;
    align-items: center;
    gap: 28px;
    padding: 14px 28px;
    background: var(--canvas);
    border-bottom: 1px solid var(--line);
  }
  .admin-topbar__logo {
    display: inline-flex;
    align-items: center;
  }
  .admin-topbar__nav {
    display: flex;
    gap: 4px;
    flex: 1;
    flex-wrap: wrap;
  }
  .admin-topbar__link {
    padding: 8px 14px;
    border-radius: var(--r-xs);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--muted);
  }
  .admin-topbar__link:hover {
    color: var(--electric);
    background: var(--canvas-soft);
  }
  .admin-topbar__link.is-active {
    color: var(--electric);
    background: color-mix(in srgb, var(--electric) 8%, transparent);
  }
  .admin-main {
    max-width: 1080px;
    margin: 0 auto;
    padding: 36px 28px 80px;
  }
  .admin-main h1 {
    font-size: 1.65rem;
    margin-bottom: 6px;
  }
  .admin-main .admin-sub {
    color: var(--muted);
    margin-bottom: 28px;
  }

  /* Carduri pe fundal deschis (echivalentul admin al surface-card). */
  .admin-card {
    background: var(--canvas);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: 24px;
    box-shadow: var(--sh-sm);
  }
  .admin-card + .admin-card {
    margin-top: 20px;
  }
  .admin-card h2 {
    font-size: 1.15rem;
    margin-bottom: 4px;
  }
  .admin-card .admin-hint {
    color: var(--muted);
    font-size: 0.9rem;
    margin-bottom: 16px;
  }

  /* Bannere de stare (avertizări configurare, succes, eroare). */
  .admin-banner {
    border-radius: var(--r-sm);
    padding: 12px 16px;
    font-size: 0.95rem;
    margin-bottom: 20px;
    border: 1px solid var(--line);
  }
  .admin-banner--warn {
    background: color-mix(in srgb, var(--signal) 14%, var(--canvas));
    border-color: color-mix(in srgb, var(--signal) 50%, var(--line));
  }
  .admin-banner--error {
    background: #fdf0f0;
    border-color: #efc7c7;
    color: #8a2424;
  }
  .admin-banner--ok {
    background: color-mix(in srgb, var(--cyan) 10%, var(--canvas));
    border-color: color-mix(in srgb, var(--cyan) 40%, var(--line));
  }

  /* Formulare. */
  .admin-field {
    display: block;
    margin-bottom: 16px;
  }
  .admin-field > span {
    display: block;
    font-weight: 600;
    font-size: 0.9rem;
    margin-bottom: 6px;
  }
  .admin-field small {
    display: block;
    color: var(--muted);
    font-size: 0.82rem;
    margin-top: 4px;
  }
  .admin-input,
  .admin-select,
  .admin-textarea {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--line);
    border-radius: var(--r-xs);
    background: var(--canvas);
    color: var(--ink);
    font: inherit;
    font-size: 0.95rem;
  }
  .admin-input:focus,
  .admin-select:focus,
  .admin-textarea:focus {
    outline: 2px solid color-mix(in srgb, var(--electric) 45%, transparent);
    border-color: var(--electric);
  }
  .admin-textarea {
    min-height: 110px;
    resize: vertical;
  }
  .admin-check {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
    color: var(--muted);
  }

  /* Butoane native (echivalentul Button.astro pentru <button type=submit>). */
  .admin-btn {
    display: inline-block;
    padding: 10px 20px;
    border-radius: var(--r-xs);
    border: 1px solid transparent;
    background: var(--electric);
    color: #fff;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.86rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition:
      transform 0.18s var(--ease-snap),
      background-color 0.18s var(--ease-snap),
      color 0.18s var(--ease-snap),
      border-color 0.18s var(--ease-snap);
  }
  .admin-btn:hover {
    transform: translateY(-1px);
  }
  .admin-btn--outline {
    background: transparent;
    color: var(--ink);
    border-color: var(--ink);
  }
  .admin-btn--outline:hover {
    border-color: var(--electric);
    color: var(--electric);
  }
  .admin-btn--ghost {
    background: transparent;
    color: var(--muted);
    border-color: var(--line);
    padding: 8px 14px;
  }
  .admin-btn--ghost:hover {
    color: var(--electric);
    border-color: var(--electric);
  }
  .admin-btn--sm {
    padding: 6px 12px;
    font-size: 0.78rem;
  }

  /* Tabele. */
  .admin-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.92rem;
  }
  .admin-table th {
    text-align: left;
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--muted);
    padding: 10px 12px;
    border-bottom: 1px solid var(--line);
  }
  .admin-table td {
    padding: 12px;
    border-bottom: 1px solid var(--line);
    vertical-align: top;
  }
  .admin-table tr:last-child td {
    border-bottom: none;
  }

  /* Etichete mici de stare. */
  .admin-tag {
    display: inline-block;
    padding: 2px 10px;
    border-radius: var(--r-pill);
    font-size: 0.78rem;
    font-weight: 600;
    background: var(--canvas-soft);
    color: var(--muted);
    border: 1px solid var(--line);
  }
  .admin-tag--on {
    background: color-mix(in srgb, var(--cyan) 12%, var(--canvas));
    color: #0b6e63;
    border-color: color-mix(in srgb, var(--cyan) 40%, var(--line));
  }

  .admin-grid {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }
  .admin-actions {
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
    margin-top: 8px;
  }
</style>
