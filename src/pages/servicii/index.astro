---
import BaseLayout from '@layouts/BaseLayout.astro';
import ServiceHubHero from '@components/sections/ServiceHubHero.astro';
import ServiceHubCards from '@components/sections/ServiceHubCards.astro';
import FaqSection from '@components/sections/FaqSection.astro';
import CtaSection from '@components/sections/CtaSection.astro';
import { servicesFaqs } from '@data/content';
import { services, serviceHref } from '@data/services';
import { breadcrumbLd, faqLd, itemListLd } from '@/lib/seo-schema';

export const prerender = false;

const origin = (Astro.site ?? new URL(Astro.url.origin)).toString().replace(/\/$/, '');
const pageSchema = [
  breadcrumbLd(origin, [{ label: 'Acasă', href: '/' }, { label: 'Servicii' }]),
  itemListLd(
    origin,
    services.map((s) => ({ name: s.title, url: serviceHref(s.slug) })),
  ),
  faqLd(servicesFaqs),
];
---

<BaseLayout
  title="Servicii"
  description="Marketing, grafică, web și mentenanță, la un singur partener. Lucrăm pe obiective clare și pornim de la date și de la cum decid oamenii (neuromarketing)."
  ogImage="/api/og/servicii.png"
  transparentNav={true}
  navOverDark={true}
  schema={pageSchema}
>
  <ServiceHubHero
    eyebrow="Servicii"
    title="Grafică, web și marketing, "
    titleAccent="la un singur partener"
    sub="Marketing, grafică, web și mentenanță, la un singur partener. Doi oameni și colaboratori aleși pe proiect: destui cât să acoperim tot, destul de puțini cât să luăm fiecare proiect în serios."
  />
  <ServiceHubCards />

  {/* Card simplu către pagina de suport tehnic (înlocuiește catalogul tehnic). */}
  <section class="section section--tint">
    <div class="container">
      <div class="svc-support" data-reveal>
        <div class="svc-support__text">
          <h3 class="svc-support__title">Ai o problemă tehnică punctuală?</h3>
          <p class="svc-support__desc">
            WordPress căzut, SSL expirat, DNS greșit, email în spam sau vrei să muți site-ul fără
            downtime. Le rezolvăm fără să deschizi un proiect întreg.
          </p>
        </div>
        <a class="svc-support__cta" href="/suport">
          Vezi ce acoperim
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <FaqSection
    items={servicesFaqs}
    eyebrow="Întrebări frecvente"
    title="Ce vor să știe "
    titleAccent="clienții noștri"
  />
  <CtaSection href="/contact" />
</BaseLayout>

<style>
  .svc-support {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 32px;
    flex-wrap: wrap;
    padding: clamp(28px, 4vw, 44px);
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: var(--sh-sm);
  }
  .svc-support__text {
    flex: 1 1 420px;
    min-width: 0;
  }
  .svc-support__title {
    margin-top: 10px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.4rem, 2.4vw, 1.85rem);
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .svc-support__desc {
    margin-top: 12px;
    max-width: 60ch;
    font-size: 1.02rem;
    line-height: 1.55;
    color: var(--muted);
  }
  .svc-support__cta {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 14px 26px;
    border-radius: var(--r-sm);
    background: var(--electric);
    color: #fff;
    font-weight: 700;
    box-shadow: var(--glow-electric);
    transition: filter 0.18s var(--ease-snap);
  }
  .svc-support__cta:hover {
    filter: brightness(1.06);
  }
  .svc-support__cta svg {
    width: 18px;
    height: 18px;
    transition: transform 0.2s var(--ease-snap);
  }
  .svc-support__cta:hover svg {
    transform: translateX(3px);
  }
</style>
