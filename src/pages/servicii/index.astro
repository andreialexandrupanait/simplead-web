---
import BaseLayout from '@layouts/BaseLayout.astro';
import ServiceHubHero from '@components/sections/ServiceHubHero.astro';
import ServiceHubCards from '@components/sections/ServiceHubCards.astro';
import Differentiator from '@components/home/Differentiator.astro';
import ProcessTimeline from '@components/home/ProcessTimeline.astro';
import ToolsSection from '@components/home/ToolsSection.astro';
import Testimonials from '@components/home/Testimonials.astro';
import FaqSection from '@components/sections/FaqSection.astro';
import CtaSection from '@components/sections/CtaSection.astro';
import { servicesFaqs } from '@data/content';
---

<BaseLayout
  title="Servicii"
  description="Marketing, grafică, web și mentenanță, de la aceeași echipă: pornim de la cum decid oamenii și lucrăm pe obiective clare."
  transparentNav={true}
  navOverDark={true}
>
  <ServiceHubHero
    eyebrow="Servicii"
    title="Serviciile cu care afacerea ta "
    titleAccent="se vede și vinde"
    sub="Marketing, grafică, web și mentenanță, de la aceeași echipă. Pornim de la cum decid oamenii și lucrăm pe obiective clare. Tu te ocupi de afacere, noi de imaginea și promovarea ei."
  />
  <ServiceHubCards />
  <Differentiator />
  <ProcessTimeline />
  <ToolsSection />
  <Testimonials />
  <FaqSection
    items={servicesFaqs}
    eyebrow="Întrebări frecvente"
    title="Ce vor să știe "
    titleAccent="clienții noștri"
  />
  <CtaSection href="/contact" />
</BaseLayout>
