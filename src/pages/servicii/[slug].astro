---
import BaseLayout from '@layouts/BaseLayout.astro';
import ServiceHero from '@components/sections/ServiceHero.astro';
import ForWhom from '@components/sections/ForWhom.astro';
import CapabilitiesGrid from '@components/sections/CapabilitiesGrid.astro';
import AppShowcase from '@components/sections/AppShowcase.astro';
import ServiceProcess from '@components/sections/ServiceProcess.astro';
import ProjectsGrid from '@components/sections/ProjectsGrid.astro';
import WhySimplead from '@components/sections/WhySimplead.astro';
import FaqSection from '@components/sections/FaqSection.astro';
import CtaNotch from '@components/sections/CtaNotch.astro';
import SupportServiceDetail from '@components/sections/SupportServiceDetail.astro';
import { getService, type ServiceProcessStep } from '@data/services';
import { supportServices } from '@data/support-services';
import { processSteps } from '@data/content';
import { clientsForService } from '@data/clients';

// On-demand: ca tot site-ul să treacă prin middleware (mentenanță/construcție).
// Datele sunt statice (@data/services + @data/support-services), deci doar căutăm
// după slug. „mentenanta-website" e tratat prin redirect în astro.config.mjs.
export const prerender = false;

const slug = Astro.params.slug!;
const service = getService(slug);
// Serviciu de suport (catalog) — același URL /servicii/{slug}, alt template.
const support = service ? undefined : supportServices.find((s) => s.slug === slug);
if (!service && !support) {
  return Astro.rewrite('/404');
}

// Pilon: proces specific sau procesul generic (content.ts).
const proc: ServiceProcessStep[] = service
  ? (service.process ??
    processSteps.map((p) => ({ n: String(p.n).padStart(2, '0'), title: p.title, body: p.text })))
  : [];

const pageTitle = `${service ? service.title : support!.title} · Servicii`;
const pageDesc = service ? service.summary : support!.cardSummary;

// Ritm vizual: ProjectsGrid (light) se randează doar dacă serviciul are proiecte
// live. Când lipsește, mutăm fundalurile WhySimplead/FAQ ca să păstrăm alternanța
// tint/light fără două secțiuni identice la rând.
// Paginile bogate (cu `topics` — ex. consultanță) inserează AppShowcase (care
// alternează intern), deci au propria schemă de fundaluri: ServiceProcess (tint)
// e urmat de WhySimplead light, ca să nu rămână două secțiuni tint lipite.
const hasTopics = !!service?.topics;
const hasProjects = service ? clientsForService(service.key).length > 0 : false;
const whyVariant = hasTopics ? 'light' : hasProjects ? 'tint' : 'light';
const faqVariant = hasTopics ? 'tint' : hasProjects ? 'light' : 'tint';

const origin = (Astro.site ?? new URL(Astro.url.origin)).toString().replace(/\/$/, '');
const serviceSchema = {
  '@type': 'Service',
  name: service ? service.title : support!.title,
  description: pageDesc,
  serviceType: service ? service.title : support!.title,
  url: `${origin}/servicii/${service ? service.slug : support!.slug}`,
  provider: { '@id': `${origin}#organization` },
  areaServed: { '@type': 'Country', name: 'România' },
};
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  transparentNav={true}
  navOverDark={true}
  schema={serviceSchema}
>
  {
    service ? (
      <>
        <ServiceHero
          title={service.heroTitle}
          titleAccent={service.heroTitleAccent}
          sub={service.heroSub}
          image={service.image}
          imageAlt={service.title}
          current={service.title}
          primaryCtaHref={`/contact?service=${encodeURIComponent(service.title)}`}
        />

        {service.forWhom && <ForWhom items={service.forWhom} />}

        <CapabilitiesGrid
          items={service.capabilities}
          eyebrow={service.capHead.eyebrow}
          title={service.capHead.title}
          titleAccent={service.capHead.titleAccent}
          sub={service.capHead.sub}
          cardVariant="refined"
          variant="light"
        />

        {service.topics && <AppShowcase topics={service.topics} variant="tint" />}

        <ServiceProcess steps={proc} />

        {service.engagement && (
          <CapabilitiesGrid
            items={service.engagement}
            eyebrow="Cum lucrăm împreună"
            title="Modele de "
            titleAccent="colaborare"
            sub="Alegi cum lucrăm: un proiect punctual sau un parteneriat lunar. Detalii și pachete pe pagina Pachete."
            cardVariant="refined"
            variant="light"
          />
        )}

        <ProjectsGrid service={service.key} variant="light" />

        <WhySimplead variant={whyVariant} />

        <FaqSection
          items={service.faqs}
          variant={faqVariant}
          eyebrow="FAQ"
          title="Ce vor să știe "
          titleAccent="clienții noștri"
        />

        <CtaNotch title={service.claim} subtitle={service.claimSub} />
      </>
    ) : (
      <SupportServiceDetail support={support!} />
    )
  }
</BaseLayout>
