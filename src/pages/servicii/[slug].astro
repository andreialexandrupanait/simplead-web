---
import BaseLayout from '@layouts/BaseLayout.astro';
import ServiceHero from '@components/sections/ServiceHero.astro';
import CapabilitiesGrid from '@components/sections/CapabilitiesGrid.astro';
import ServiceProcess from '@components/sections/ServiceProcess.astro';
import ClientCase from '@components/sections/ClientCase.astro';
import FaqSection from '@components/sections/FaqSection.astro';
import CtaNotch from '@components/sections/CtaNotch.astro';
import SupportServiceDetail from '@components/sections/SupportServiceDetail.astro';
import { services, type ServiceProcessStep } from '@data/services';
import { supportServices } from '@data/support-services';
import { processSteps } from '@data/content';

export function getStaticPaths() {
  // Piloni: „mentenanta-website" are pagină dedicată la /mentenanta (vezi redirect-ul
  // din astro.config.mjs), deci aici nu o generăm.
  const pillars = services
    .filter((s) => s.slug !== 'mentenanta-website')
    .map((s) => ({ params: { slug: s.slug }, props: { service: s } }));
  // Servicii de suport (catalog) — același URL /servicii/{slug}, alt template.
  const support = supportServices.map((s) => ({ params: { slug: s.slug }, props: { support: s } }));
  return [...pillars, ...support];
}

const { service, support } = Astro.props;

// Pilon: proces specific sau procesul generic (content.ts).
const proc: ServiceProcessStep[] = service
  ? (service.process ??
    processSteps.map((p) => ({ n: String(p.n).padStart(2, '0'), title: p.title, body: p.text })))
  : [];

const pageTitle = `${service ? service.title : support.title} · Servicii`;
const pageDesc = service ? service.summary : support.cardSummary;

const origin = (Astro.site ?? new URL(Astro.url.origin)).toString().replace(/\/$/, '');
const serviceSchema = {
  '@type': 'Service',
  name: service ? service.title : support.title,
  description: pageDesc,
  serviceType: service ? service.title : support.title,
  url: `${origin}/servicii/${service ? service.slug : support.slug}`,
  provider: { '@id': `${origin}#organization` },
  areaServed: { '@type': 'Country', name: 'România' },
};
---

<BaseLayout
  title={pageTitle}
  description={pageDesc}
  transparentNav={true}
  navOverDark={true}
  schema={serviceSchema}
>
  {
    service ? (
      <>
        <ServiceHero
          title={service.heroTitle}
          titleAccent={service.heroTitleAccent}
          sub={service.heroSub}
          image={service.image}
          imageAlt={service.title}
          current={service.title}
        />

        <CapabilitiesGrid
          items={service.capabilities}
          eyebrow={service.capHead.eyebrow}
          title={service.capHead.title}
          titleAccent={service.capHead.titleAccent}
          sub={service.capHead.sub}
        />

        <ServiceProcess steps={proc} />

        {service.caseStudy && <ClientCase caseStudy={service.caseStudy} />}

        <FaqSection
          items={service.faqs}
          variant="tint"
          eyebrow="FAQ"
          title="Ce vor să știe "
          titleAccent="clienții noștri"
        />

        <CtaNotch title={service.claim} />
      </>
    ) : (
      <SupportServiceDetail support={support} />
    )
  }
</BaseLayout>
