---
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/sections/PageHeader.astro';
import CtaSection from '@components/sections/CtaSection.astro';
import { site } from '@data/site';

export async function getStaticPaths() {
  const entries = await getCollection('blog', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const { title, description, pubDate, updatedDate, author, tags, cover } = entry.data;
const dateStr = pubDate.toLocaleDateString('ro-RO', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

// Timp de citire: ~200 cuvinte/min, minim 1 min.
const wordCount = (entry.body ?? '').split(/\s+/).filter(Boolean).length;
const readingMinutes = Math.max(1, Math.round(wordCount / 200));

// Cuprins: doar h2/h3, afișat de la 3 titluri în sus.
const tocItems = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showToc = tocItems.length >= 3;

// Articole similare: întâi cele cu tag comun, apoi cele mai recente.
const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).filter(
  (p) => p.id !== entry.id,
);
const related = [
  ...allPosts.filter((p) => p.data.tags.some((t) => tags.includes(t))),
  ...allPosts.filter((p) => !p.data.tags.some((t) => tags.includes(t))),
].slice(0, 3);

const origin = (Astro.site ?? new URL(Astro.url.origin)).toString().replace(/\/$/, '');
const blogSchema = {
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: author,
    jobTitle: site.founderTitle,
    url: site.founderSite,
  },
  publisher: { '@id': `${origin}#organization` },
  mainEntityOfPage: `${origin}/blog/${entry.id}`,
  wordCount,
  inLanguage: 'ro-RO',
  ...(cover ? { image: new URL(cover, origin).href } : {}),
};

const fmtShort = (d: Date) =>
  d.toLocaleDateString('ro-RO', { year: 'numeric', month: 'short', day: 'numeric' });
---

<BaseLayout
  title={title}
  description={description}
  transparentNav={true}
  navOverDark={true}
  schema={blogSchema}
>
  <PageHeader
    crumb={[{ label: 'Acasă', href: '/' }, { label: 'Blog', href: '/blog' }, { label: title }]}
    eyebrow="Blog"
    title={title}
  />

  <section class="section section--light">
    <div class:list={['container', 'post-layout', !showToc && 'post-layout--single']}>
      {
        showToc && (
          <aside class="post-toc" aria-label="Cuprins">
            <details class="post-toc__box" open>
              <summary>Cuprins</summary>
              <nav>
                <ol>
                  {tocItems.map((h) => (
                    <li class:list={[h.depth === 3 && 'is-sub']}>
                      <a href={`#${h.slug}`}>{h.text}</a>
                    </li>
                  ))}
                </ol>
              </nav>
            </details>
          </aside>
        )
      }

      <div class="post-main">
        <div class="post-meta">
          <time datetime={pubDate.toISOString()}>{dateStr}</time>
          <span aria-hidden="true">·</span>
          <span>{readingMinutes} min de citit</span>
          {
            tags.length > 0 && (
              <>
                <span aria-hidden="true">·</span>
                <span class="post-meta__tag">#{tags[0]}</span>
              </>
            )
          }
        </div>

        <article class="prose-simplead post-content"><Content /></article>

        <div class="post-author">
          <div class="post-author__avatar" aria-hidden="true">
            {author.charAt(0)}
          </div>
          <div>
            <p class="post-author__name">{author}</p>
            <p class="post-author__bio">
              Doctor în marketing, cu cercetare în neuromarketing. Înainte să scrie sau să
              construiască ceva, se uită la cum decid oamenii.
              <a href={site.founderSite} rel="noopener" target="_blank"> Mai mult despre Andrei</a>.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  {
    related.length > 0 && (
      <section class="section section--light post-related-wrap">
        <div class="container">
          <h2 class="post-related-title">Citește în continuare</h2>
          <div class="post-related" data-reveal-stagger>
            {related.map((p) => (
              <a class="post-related__card" href={`/blog/${p.id}`}>
                <span class="post-related__meta">
                  {p.data.tags[0] ?? 'Blog'} · {fmtShort(p.data.pubDate)}
                </span>
                <h3>{p.data.title}</h3>
                <p>{p.data.description}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CtaSection
    title="Vrei rezultate ca acestea pentru afacerea ta?"
    subtitle={`Scrie-ne sau sună la ${site.contact.phone}. Prima discuție e fără obligații.`}
    href="/contact"
  />
</BaseLayout>

<style>
  .post-layout {
    display: grid;
    grid-template-columns: 240px minmax(0, 720px);
    gap: 48px;
    justify-content: center;
  }
  .post-layout--single {
    grid-template-columns: minmax(0, 760px);
  }

  /* Cuprins: sticky pe desktop, pliabil pe mobil. */
  .post-toc__box {
    position: sticky;
    top: 96px;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: 16px 18px;
    background: var(--canvas);
  }
  .post-toc__box summary {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    cursor: pointer;
    list-style: none;
  }
  .post-toc__box summary::-webkit-details-marker {
    display: none;
  }
  .post-toc ol {
    margin: 12px 0 0;
    padding: 0;
    list-style: none;
  }
  .post-toc li {
    margin-bottom: 8px;
    font-size: 0.88rem;
    line-height: 1.4;
  }
  .post-toc li.is-sub {
    padding-left: 14px;
  }
  .post-toc a {
    color: var(--muted);
  }
  .post-toc a:hover {
    color: var(--electric);
  }

  .post-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    font-size: 0.88rem;
    color: var(--muted);
    margin-bottom: 26px;
  }
  .post-meta__tag {
    color: var(--electric);
    font-weight: 600;
  }

  /* Caseta de autor (E-E-A-T). */
  .post-author {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    margin-top: 44px;
    padding: 20px 22px;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--canvas-soft);
  }
  .post-author__avatar {
    flex: 0 0 48px;
    height: 48px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--cyan);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.2rem;
    display: grid;
    place-items: center;
  }
  .post-author__name {
    font-weight: 700;
    margin-bottom: 4px;
  }
  .post-author__bio {
    font-size: 0.92rem;
    color: var(--muted);
    line-height: 1.55;
    margin: 0;
  }
  .post-author__bio a {
    color: var(--electric);
    font-weight: 600;
  }

  /* Articole similare. */
  .post-related-wrap {
    padding-top: 0;
  }
  .post-related-title {
    font-size: 1.4rem;
    margin-bottom: 22px;
  }
  .post-related {
    display: grid;
    gap: 20px;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }
  .post-related__card {
    display: block;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: 20px 22px;
    background: var(--canvas);
    transition:
      transform 0.2s var(--ease-snap),
      border-color 0.2s var(--ease-snap);
  }
  .post-related__card:hover {
    transform: translateY(-3px);
    border-color: var(--electric);
  }
  .post-related__meta {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .post-related__card h3 {
    font-size: 1.05rem;
    margin: 8px 0;
    line-height: 1.35;
  }
  .post-related__card p {
    font-size: 0.9rem;
    color: var(--muted);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (max-width: 900px) {
    .post-layout {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
    .post-toc__box {
      position: static;
    }
  }
</style>
