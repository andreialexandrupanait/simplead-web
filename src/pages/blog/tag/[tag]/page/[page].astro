---
import BaseLayout from '@layouts/BaseLayout.astro';
import BlogListing from '@components/sections/BlogListing.astro';
import CtaSection from '@components/sections/CtaSection.astro';
import { getPublishedPosts, getAllTags } from '@lib/server/content';
import { paginatePosts, blogPageHref, blogListSchema, BLOG_PAGE_SIZE } from '@lib/blog-page';
import { slugify } from '@lib/slug';

export const prerender = false;

const tagSlug = Astro.params.tag!;
const base = `/blog/tag/${tagSlug}`;
const page = parseInt(Astro.params.page ?? '', 10);
if (!Number.isInteger(page) || page < 2) {
  return Astro.redirect(base, 301);
}

const allPosts = await getPublishedPosts();
const allTags = (await getAllTags()).map((t) => t.tag);
const match = allTags.find((t) => slugify(t) === tagSlug);
const items = allPosts.filter((p) => (p.tags ?? []).some((t) => slugify(t) === tagSlug));
if (!match || items.length === 0) {
  return Astro.rewrite('/404');
}

const { totalPages, safePage, pageItems } = paginatePosts(items, page, false);
if (page > totalPages) {
  return Astro.redirect(totalPages >= 2 ? `${base}/page/${totalPages}` : base, 301);
}

const subtitle = `Tot ce am scris despre ${match.toLowerCase()}.`;
const origin = (Astro.site ?? new URL(Astro.url.origin)).toString().replace(/\/$/, '');
const prevUrl = blogPageHref(base, safePage - 1);
const nextUrl = safePage < totalPages ? blogPageHref(base, safePage + 1) : undefined;
const schema = blogListSchema({
  name: `${match} · Blog Simplead · pagina ${safePage}`,
  description: subtitle,
  url: `${origin}${base}/page/${safePage}`,
  origin,
  posts: pageItems,
  startPosition: (safePage - 1) * BLOG_PAGE_SIZE + 1,
  crumbs: [
    { label: 'Acasă', href: '/' },
    { label: 'Blog', href: '/blog' },
    { label: match, href: base },
    { label: `Pagina ${safePage}` },
  ],
});
---

<BaseLayout
  title={`${match} · Blog · pagina ${safePage}`}
  description={subtitle}
  transparentNav={true}
  navOverDark={true}
  prevUrl={prevUrl}
  nextUrl={nextUrl}
  schema={schema}
>
  <BlogListing title={match} subtitle={subtitle} items={items} page={safePage} basePath={base} />

  <CtaSection />
</BaseLayout>
