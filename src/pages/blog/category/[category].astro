---
import BaseLayout from '@layouts/BaseLayout.astro';
import BlogListing from '@components/sections/BlogListing.astro';
import CtaSection from '@components/sections/CtaSection.astro';
import { getPublishedPosts, getActiveCategories } from '@lib/server/content';
import { paginatePosts, blogListSchema } from '@lib/blog-page';
import { slugify } from '@lib/slug';

export const prerender = false;

const catSlug = Astro.params.category!;
const allPosts = await getPublishedPosts();
const categories = await getActiveCategories();

const match = categories.find((c) => slugify(c) === catSlug);
const items = allPosts.filter((p) => p.category && slugify(p.category) === catSlug);
if (!match || items.length === 0) {
  return Astro.rewrite('/404');
}

const base = `/blog/category/${catSlug}`;
const page = Math.max(1, parseInt(Astro.url.searchParams.get('page') ?? '1', 10) || 1);
// Paginile 2+ trăiesc la /blog/category/SLUG/page/N (stil WordPress).
if (page >= 2) {
  return Astro.redirect(`${base}/page/${page}`, 301);
}

const subtitle = `Articole din categoria ${match.toLowerCase()}.`;

const origin = (Astro.site ?? new URL(Astro.url.origin)).toString().replace(/\/$/, '');
const { totalPages, pageItems } = paginatePosts(items, 1, false);
const nextUrl = totalPages > 1 ? `${base}/page/2` : undefined;
const schema = blogListSchema({
  name: `${match} · Blog Simplead`,
  description: subtitle,
  url: `${origin}${base}`,
  origin,
  posts: pageItems,
  crumbs: [{ label: 'Acasă', href: '/' }, { label: 'Blog', href: '/blog' }, { label: match }],
});
---

<BaseLayout
  title={`${match} · Blog`}
  description={subtitle}
  transparentNav={true}
  navOverDark={true}
  nextUrl={nextUrl}
  schema={schema}
>
  <BlogListing
    title={match}
    subtitle={subtitle}
    items={items}
    categories={categories}
    activeCategory={catSlug}
    page={1}
    basePath={base}
  />

  <CtaSection />
</BaseLayout>
