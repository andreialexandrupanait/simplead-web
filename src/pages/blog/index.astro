---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/sections/PageHeader.astro';
import BlogFeature from '@components/sections/BlogFeature.astro';
import CtaSection from '@components/sections/CtaSection.astro';
import { getPublishedPosts } from '@lib/server/content';

// Articolele vin din DB (editate în /admin) — pagina e on-demand ca publicarea
// să fie instant, fără rebuild.
export const prerender = false;

const posts = await getPublishedPosts();
const [featured, ...rest] = posts;
const fmt = (d: Date | null) =>
  (d ?? new Date()).toLocaleDateString('ro-RO', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout
  title="Blog"
  description="Idei și ghiduri din lumea marketingului: branding, neuromarketing și web design, pe înțelesul tău."
  transparentNav={true}
  navOverDark={true}
>
  <PageHeader
    crumb={[{ label: 'Acasă', href: '/' }, { label: 'Blog' }]}
    eyebrow="De pe blog"
    title="Idei și ghiduri din lumea marketingului"
    accent="marketingului"
    subtitle="Despre branding, marketing digital și design, pe înțelesul tău."
  />

  <section class="section section--light">
    <div class="container">
      {featured && <BlogFeature post={featured} />}

      {
        posts.length === 0 && (
          <p style="text-align:center;color:var(--ink-soft);padding:48px 0">
            Lucrăm la primele articole — revino curând.
          </p>
        )
      }

      <div class="blog-page-grid" data-reveal-stagger>
        {
          rest.map((post) => (
            <a class="blog-card" href={`/blog/${post.slug}`}>
              <div class="ph blog-thumb">
                {post.cover ? <img src={post.cover} alt={post.title} loading="lazy" /> : post.title}
              </div>
              <div class="blog-meta">
                <span class="cat">{post.tags[0] ?? 'Blog'}</span>
                <span>{fmt(post.publishedAt)}</span>
              </div>
              <h3>{post.title}</h3>
              <p>{post.description}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <CtaSection href="/contact" />
</BaseLayout>
