---
import BaseLayout from '@layouts/BaseLayout.astro';
import BlogListing from '@components/sections/BlogListing.astro';
import CtaSection from '@components/sections/CtaSection.astro';
import { getPublishedPosts, getActiveCategories } from '@lib/server/content';

// Articolele vin din DB (editate în /admin) — pagina e on-demand ca publicarea
// să fie instantă, plus citim ?q= și ?page= la request time.
export const prerender = false;

const q = (Astro.url.searchParams.get('q') ?? '').trim();
const page = Math.max(1, parseInt(Astro.url.searchParams.get('page') ?? '1', 10) || 1);

const allPosts = await getPublishedPosts();
const categories = await getActiveCategories();

const ql = q.toLowerCase();
const items = q
  ? allPosts.filter((p) =>
      [p.title, p.description, ...(p.tags ?? [])].join(' ').toLowerCase().includes(ql),
    )
  : allPosts;

const subtitle =
  'Idei și ghiduri din lumea marketingului: branding, neuromarketing și web design, pe înțelesul tău.';
---

<BaseLayout title="Blog" description={subtitle} transparentNav={true} navOverDark={true}>
  <BlogListing
    title="Blog"
    subtitle={subtitle}
    items={items}
    categories={categories}
    query={q}
    page={page}
    showFeatured={!q}
    basePath="/blog"
  />

  <CtaSection />
</BaseLayout>
