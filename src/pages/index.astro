---
import BaseLayout from '@layouts/BaseLayout.astro';
import HomeHero from '@components/home/HomeHero.astro';
import ServicesSection from '@components/sections/ServicesSection.astro';
import Differentiator from '@components/home/Differentiator.astro';
import ProcessTimeline from '@components/home/ProcessTimeline.astro';
import CaseStudiesTabbed from '@components/home/CaseStudiesTabbed.astro';
import MaintenanceTeaser from '@components/home/MaintenanceTeaser.astro';
import AiSection from '@components/home/AiSection.astro';
import Testimonials from '@components/home/Testimonials.astro';
import CtaFinal from '@components/home/CtaFinal.astro';
import { getPublicSettings } from '@lib/server/public-settings';

// On-demand: ProofSection arată proiectele live din DB (editate în /admin).
// Build-ul nu are acces la DB; cache-ul de 60s din content.ts ține costul mic.
export const prerender = false;

// Vizibilitatea secțiunilor e controlată din /admin/setari (cheile din @data/sections).
const { hiddenHomeSections } = await getPublicSettings();
const show = (key: string) => !hiddenHomeSections.includes(key);
---

<BaseLayout transparentNav={true}>
  {
    /* 1 Hero → 2 Servicii → 3 Diferențiator → 4 Proces → 5 Studii de caz →
      6 Mentenanță → 7 AI → 8 Testimoniale → 9 CTA final.
      Fiecare secțiune se poate ascunde din /admin/setari. */
  }
  {show('hero') && <HomeHero />}
  {show('services') && <ServicesSection />}
  {show('differentiator') && <Differentiator />}
  {show('process') && <ProcessTimeline />}
  {show('case-studies') && <CaseStudiesTabbed />}
  {show('maintenance') && <MaintenanceTeaser />}
  {show('ai') && <AiSection />}
  {show('testimonials') && <Testimonials />}
  {show('cta') && <CtaFinal />}
</BaseLayout>
