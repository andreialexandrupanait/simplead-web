---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/sections/PageHeader.astro';
import CtaSection from '@components/sections/CtaSection.astro';
import FaqSection from '@components/sections/FaqSection.astro';
import PackageFeatures from '@components/sections/PackageFeatures.astro';
import ServiceIcon from '@components/ui/ServiceIcon.astro';
import type { ServiceIcon as ServiceIconName } from '@data/services';
import { getPublicPackages, formatPrice, canBuy } from '@/lib/server/packages';
import { getIntegration } from '@/lib/server/settings';
import { hourlyRates, hourlyRatesIntro } from '@/data/pricing';
import { packagesFaqs } from '@data/content';

// On-demand: pachetele vin din DB (editabile din admin, fără rebuild).
export const prerender = false;

const { items, fromDb } = await getPublicPackages();
if (!fromDb) {
  Astro.response.headers.set('Cache-Control', 'no-store');
}

// Cumpărarea directă apare doar cu Stripe configurat (din /admin/integrari) și
// doar pe pachetele cu preț fix; vezi canBuy() din lib/server/packages.
const stripeReady = fromDb && Boolean((await getIntegration('stripe')).secretKey.value);
const canceled = Astro.url.searchParams.get('canceled') === '1';

const bySort = (a: { sort: number }, b: { sort: number }) => a.sort - b.sort;
const services = items.filter((p) => p.kind === 'service');
// Ordinea cerută explicit, independent de `sort` din DB: Redesign, Prezentare, Magazin.
const WEB_ORDER = ['ux-ui-redesign', 'site-prezentare', 'magazin-online'];
const webRank = (p: { slug: string; sort: number }) => {
  const i = WEB_ORDER.indexOf(p.slug);
  return i === -1 ? 100 + p.sort : i;
};
const web = services.filter((p) => p.category === 'web').sort((a, b) => webRank(a) - webRank(b));
const graphics = services.filter((p) => p.category === 'grafica-marketing');
// Servicii fără grupare: le arătăm tot în secțiunea grafică & marketing.
const graphicsRest = services.filter(
  (p) => p.category !== 'web' && p.category !== 'grafica-marketing',
);
const graphicsAll = [...graphics, ...graphicsRest].sort(bySort);
// Cardul „dominant": cel din mijloc când sunt exact 3 (Prezentare).
const featuredWebIdx = web.length === 3 ? 1 : -1;
const maintenance = items.filter((p) => p.kind === 'maintenance');
const addons = items.filter((p) => p.kind === 'addon');

const contactHref = (name: string) => `/contact?service=${encodeURIComponent(name)}`;

// Icon pe cardurile grafică (map pe slug; fallback `grafica` pt. pachete noi din admin).
const graphicsIcon = (slug: string): ServiceIconName =>
  slug === 'strategie-marketing' ? 'marketing' : 'grafica';

const metaDescription =
  'Pachete clare pentru site-uri, identitate vizuală și grafică, plus abonamente lunare de mentenanță. Știi de la început ce primești și de unde pornește prețul.';
---

<BaseLayout
  title="Pachete și prețuri"
  description={metaDescription}
  transparentNav={true}
  navOverDark={true}
>
  <PageHeader
    crumb={[{ label: 'Acasă', href: '/' }, { label: 'Pachete' }]}
    eyebrow="Pachete și prețuri"
    title="Pachete clare, fără surprize"
    accent="fără surprize"
    subtitle="Prețuri clare și abonamente lunare. Știi de la început ce primești și cât plătești."
  />

  {
    canceled && (
      <section class="pk-sec" style="padding-bottom:0">
        <div class="pk-wrap">
          <p class="pk-canceled">
            Plata a fost anulată. Nicio problemă: pachetele te așteaptă mai jos, iar dacă ai
            întrebări <a href="/contact">scrie-ne</a>.
          </p>
        </div>
      </section>
    )
  }

  {/* 1. Pachete web (showpiece) */}
  {
    web.length > 0 && (
      <section class="pk-sec pk-web" id="web">
        <div class="pk-wrap">
          <header class="pk-head pk-head--center" data-reveal>
            <span class="pk-eyebrow">Pachete web</span>
            <h2 class="pk-h2">
              Site-uri și <em>magazine online</em>
            </h2>
            <p class="pk-lead">
              Site de prezentare, magazin online sau redesign, construite în WordPress — rapide,
              sigure și ușor de administrat de tine.
            </p>
          </header>
          <div class="pk-web-grid">
            {web.map((pkg, i) => (
              <article class:list={['pk-w', i === featuredWebIdx && 'pk-w--feat']}>
                {i === featuredWebIdx && (
                  <span class="pk-w-badge">
                    <span>Cel mai cerut</span>
                  </span>
                )}
                <span class="pk-w-idx">{String(i + 1).padStart(2, '0')}</span>
                <h3 class="pk-w-name">{pkg.name}</h3>
                <p class="pk-w-desc">{pkg.description}</p>
                <p class="pk-w-price">{formatPrice(pkg)}</p>
                <PackageFeatures
                  features={pkg.features}
                  featureGroups={pkg.featureGroups}
                  variant="lg"
                />
                {pkg.note && <p class="pk-w-note">{pkg.note}</p>}
                <div class="pk-cta">
                  {canBuy(pkg, stripeReady) && (
                    <form method="post" action="/api/checkout">
                      <input type="hidden" name="slug" value={pkg.slug} />
                      <button type="submit" class="pk-btn pk-btn--fill">
                        <span>Cumpără</span>
                      </button>
                    </form>
                  )}
                  <a
                    class:list={['pk-btn', i === featuredWebIdx && 'pk-btn--fill']}
                    href={contactHref(pkg.name)}
                  >
                    <span>Cere ofertă →</span>
                  </a>
                </div>
              </article>
            ))}
          </div>
          <aside class="pk-ai-note">
            <span class="pk-ai-note__icon">
              <ServiceIcon icon="ai" />
            </span>
            <p>
              <strong>Ai nevoie de ceva simplu?</strong> Uneori cea mai bună variantă e un site
              static, construit rapid cu ajutorul AI — fără să plătești pentru complexitate de care
              nu ai nevoie. Folosim AI acolo unde chiar ajută și recomandăm mereu soluția potrivită,
              nu cea mai scumpă.
            </p>
          </aside>
        </div>
      </section>
    )
  }

  {/* 2. Abonamente de mentenanță */}
  {
    maintenance.length > 0 && (
      <section class="pk-sec pk-sec--soft" id="mentenanta">
        <div class="pk-wrap">
          <header class="pk-head pk-head--center" data-reveal>
            <span class="pk-eyebrow">Mentenanță</span>
            <h2 class="pk-h2">
              Întreținem site-ul, <em>lună de lună</em>
            </h2>
            <p class="pk-lead">
              Ținem site-ul actualizat, salvat și supravegheat, ca să meargă bine fără să-ți faci
              griji. <a href="/mentenanta">Calculează-ți abonamentul →</a>
            </p>
          </header>
          <div class="pk-mnt">
            <div class="pk-mnt-cards">
              {maintenance.map((pkg) => (
                <article class="pk-card pk-card--mnt">
                  <span class="pk-card-icon">
                    <ServiceIcon icon="mentenanta" />
                  </span>
                  <h3>{pkg.name}</h3>
                  <p class="pk-mnt-price">{formatPrice(pkg)}</p>
                  <p class="pk-card-desc">{pkg.description}</p>
                  <PackageFeatures
                    features={pkg.features}
                    featureGroups={pkg.featureGroups}
                    variant="sm"
                  />
                  <div class="pk-cta">
                    {canBuy(pkg, stripeReady) && (
                      <form method="post" action="/api/checkout">
                        <input type="hidden" name="slug" value={pkg.slug} />
                        <button type="submit" class="pk-btn pk-btn--fill">
                          <span>Abonează-te</span>
                        </button>
                      </form>
                    )}
                    <a class="pk-btn" href="/mentenanta">
                      <span>Vezi detalii →</span>
                    </a>
                  </div>
                </article>
              ))}
            </div>
            {addons.length > 0 && (
              <aside class="pk-addons">
                <h3>Adaugi oricând</h3>
                <ul>
                  {addons.map((pkg) => (
                    <li>
                      <span>{pkg.name}</span>
                      <span class="pk-addon-price">+{formatPrice(pkg)}</span>
                    </li>
                  ))}
                </ul>
              </aside>
            )}
          </div>
        </div>
      </section>
    )
  }

  {/* 3. Grafică & marketing */}
  {
    graphicsAll.length > 0 && (
      <section class="pk-sec" id="grafica">
        <div class="pk-wrap">
          <header class="pk-head pk-head--center" data-reveal>
            <span class="pk-eyebrow">Grafică & marketing</span>
            <h2 class="pk-h2">
              Identitate, vizualuri și <em>strategie</em>
            </h2>
            <p class="pk-lead">
              De la identitatea vizuală și materialele grafice până la strategia de marketing — tot
              ce ține de imaginea brandului tău, cu preț fix.
            </p>
          </header>
          <div class="pk-grid3">
            {graphicsAll.map((pkg) => (
              <article class="pk-card pk-card--gfx">
                <span class="pk-card-icon">
                  <ServiceIcon icon={graphicsIcon(pkg.slug)} />
                </span>
                <div class="pk-card-head">
                  <h3>{pkg.name}</h3>
                  <span class="pk-card-price">{formatPrice(pkg)}</span>
                </div>
                <p class="pk-card-desc">{pkg.description}</p>
                <PackageFeatures
                  features={pkg.features}
                  featureGroups={pkg.featureGroups}
                  variant="sm"
                />
                {pkg.note && <p class="pk-note">{pkg.note}</p>}
                <a class="pk-link" href={contactHref(pkg.name)}>
                  Cere ofertă →
                </a>
              </article>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {/* 4. Tarife orare */}
  <section class="pk-sec pk-sec--dark" id="tarife">
    <div class="pk-wrap">
      <header class="pk-head pk-head--center" data-reveal>
        <span class="pk-eyebrow">Tarife orare</span>
        <h2 class="pk-h2">
          Și pentru lucrări <em>punctuale</em>
        </h2>
        <p class="pk-lead">{hourlyRatesIntro}</p>
      </header>
      <ul class="pk-rates">
        {
          hourlyRates.map((r) => (
            <li>
              <span class="pk-rate-label">{r.label}</span>
              <span class="pk-rate-val">
                {r.amount}
                <span class="pk-rate-period">{r.period}</span>
              </span>
            </li>
          ))
        }
      </ul>
      <div class="pk-rates-cta">
        <a class="pk-btn pk-btn--fill" href="/contact?service=Lucrare%20la%20or%C4%83">
          <span>Cere o estimare →</span>
        </a>
      </div>
    </div>
  </section>

  <FaqSection items={packagesFaqs} variant="tint" />

  <CtaSection
    title="Nu știi ce pachet ți se potrivește?"
    subtitle="Scrie-ne: îți răspundem cu o recomandare concretă, nu cu un call de vânzări."
    href="/contact"
    cta="Scrie-ne"
  />
</BaseLayout>

<style>
  /* ============ Etichetă de secțiune (kicker, ca pe restul site-ului) ============ */
  .pk-eyebrow {
    display: inline-block;
    margin-bottom: 16px;
    font-family: var(--font-display);
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--electric);
  }

  /* ============ Sistem de secțiuni ============ */
  .pk-sec {
    position: relative;
    padding-block: clamp(34px, 4.5vw, 58px);
    scroll-margin-top: 84px;
  }
  .pk-sec--soft {
    background: var(--canvas-soft);
  }
  /* Secțiune dark (tarife orare) — contrast pe finalul paginii. */
  .pk-sec--dark {
    background: var(--ink);
  }
  .pk-sec--dark .pk-eyebrow {
    color: var(--cyan);
  }
  .pk-sec--dark .pk-h2 {
    color: #fff;
  }
  .pk-sec--dark .pk-lead {
    color: var(--muted-dark);
  }
  /* wrapper propriu: doar lățime + padding orizontal (fără cei 110px verticali
     ai .container global, care dublau spațierea). */
  .pk-wrap {
    width: 100%;
    max-width: var(--maxw);
    margin-inline: auto;
    padding-inline: clamp(20px, 5vw, 40px);
  }
  .pk-head {
    margin-bottom: clamp(26px, 3vw, 40px);
  }
  .pk-head--center {
    margin-inline: auto;
    text-align: center;
  }
  /* etichetă oblică = aceeași semnătură ca butoanele brandului */
  .pk-tag {
    display: inline-block;
    transform: skew(-10deg);
    background: var(--ink);
    padding: 6px 14px;
    border-radius: var(--r-xs);
    margin-bottom: 16px;
  }
  .pk-tag span {
    display: inline-block;
    transform: skew(10deg);
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #fff;
  }
  .pk-h2 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2rem, 3.8vw, 2.95rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--ink);
    /* titlul pe un singur rând; pe ecrane mici revine la wrap (vezi media query) */
    white-space: nowrap;
  }
  @media (max-width: 720px) {
    .pk-h2 {
      white-space: normal;
      text-wrap: balance;
    }
  }
  .pk-h2 em {
    font-style: normal;
    color: var(--electric);
  }
  .pk-lead {
    margin-top: 12px;
    color: var(--muted);
    font-size: 1.02rem;
    line-height: 1.55;
    text-wrap: pretty;
  }
  .pk-head--center .pk-lead {
    margin-inline: auto;
  }
  .pk-lead a {
    color: var(--electric);
    font-weight: 600;
  }

  /* ============ Butoane oblice + CTA în coloană ============ */
  .pk-cta {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: auto;
  }
  .pk-cta form {
    display: contents;
  }
  .pk-btn {
    display: inline-flex;
    justify-content: center;
    align-items: center;
    width: 100%;
    transform: skew(-10deg);
    border: 1px solid var(--line);
    border-radius: var(--r-xs);
    background: var(--canvas);
    color: var(--ink);
    padding: 12px 20px;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    cursor: pointer;
    transition:
      transform 0.18s var(--ease-snap),
      border-color 0.2s,
      background 0.2s,
      color 0.2s;
  }
  .pk-btn span {
    display: inline-block;
    transform: skew(10deg);
  }
  .pk-btn:hover {
    transform: skew(-10deg) translateY(-2px);
    border-color: var(--electric);
    color: var(--electric);
  }
  .pk-btn--fill {
    background: var(--electric);
    border-color: var(--electric);
    color: #fff;
    box-shadow: var(--glow-electric);
  }
  .pk-btn--fill:hover {
    background: #1184ff;
    border-color: #1184ff;
    color: #fff;
  }

  /* ============ Web: showpiece ============ */
  /* fără overflow:hidden — altfel tooltip-urile (.pf-tip) ar fi tăiate; gradientul
     din ::after e oricum delimitat de inset:0. */
  .pk-web::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(38% 48% at 50% -6%, rgba(0, 119, 252, 0.1) 0%, transparent 62%),
      radial-gradient(32% 42% at 94% 96%, rgba(0, 224, 198, 0.08) 0%, transparent 60%);
  }
  .pk-web > .pk-wrap {
    position: relative;
    z-index: 1;
  }
  .pk-web-grid {
    display: grid;
    gap: 22px;
    grid-template-columns: repeat(3, 1fr);
    align-items: stretch;
  }
  @media (max-width: 900px) {
    .pk-web-grid {
      grid-template-columns: 1fr;
      max-width: 420px;
      gap: 16px;
    }
  }
  .pk-w {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--canvas);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: 24px 22px;
    box-shadow: var(--sh-sm);
    transition:
      transform 0.28s var(--ease-snap),
      border-color 0.28s var(--ease-snap),
      box-shadow 0.28s var(--ease-snap);
  }
  .pk-w:hover {
    transform: translateY(-5px);
    box-shadow: var(--sh-lg);
  }
  /* Cardul „dominant": fără border colorat — îl scoatem în evidență printr-un
     fundal ușor tentat și o elevație mai mare. */
  .pk-w--feat {
    background: linear-gradient(
      180deg,
      color-mix(in srgb, var(--electric) 7%, var(--canvas)),
      var(--canvas) 62%
    );
    box-shadow: var(--sh-lg);
  }
  /* Etichetă „cel mai cerut": tag galben oblic, sus-dreapta — iese în evidență. */
  .pk-w-badge {
    position: absolute;
    top: 14px;
    right: -7px;
    transform: skew(-10deg);
    background: var(--signal);
    padding: 6px 13px;
    box-shadow: 0 8px 18px -8px rgba(245, 217, 63, 0.7);
  }
  .pk-w-badge span {
    display: inline-block;
    transform: skew(10deg);
    font-family: var(--font-display);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #1a1205;
  }
  .pk-w-idx {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    color: var(--electric);
  }
  .pk-w-name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.42rem;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 6px 0;
  }
  .pk-w-desc {
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.45;
    margin-bottom: 14px;
    /* Rezervă 2 rânduri, ca lista să înceapă la același nivel pe toate cardurile. */
    min-height: 2.7rem;
  }
  @media (max-width: 900px) {
    .pk-w-desc {
      min-height: 0;
    }
  }
  .pk-w-price {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 2.15rem;
    line-height: 1;
    color: var(--ink);
    margin-bottom: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--line);
  }
  .pk-w--feat .pk-w-price {
    color: var(--electric);
  }
  .pk-w-note {
    margin: 0 0 16px;
    padding: 11px 13px;
    font-size: 0.84rem;
    line-height: 1.45;
    color: var(--muted);
    background: var(--canvas-soft);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
  }
  .pk-ai-note {
    display: flex;
    align-items: center;
    gap: 16px;
    max-width: 720px;
    margin: clamp(34px, 4vw, 52px) auto 0;
    padding: 20px 24px;
    background: var(--canvas-soft);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    box-shadow: var(--sh-sm);
  }
  .pk-ai-note p {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--muted);
  }
  .pk-ai-note strong {
    color: var(--ink);
  }
  .pk-ai-note__icon {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 999px;
    color: var(--electric);
    background: color-mix(in srgb, var(--electric) 12%, var(--canvas));
  }

  /* ============ Grafică & marketing: 3-up compact ============ */
  .pk-grid3 {
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    align-items: start;
  }
  .pk-card {
    display: flex;
    flex-direction: column;
    background: var(--canvas);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    padding: 22px;
    transition:
      transform 0.25s var(--ease-snap),
      border-color 0.25s var(--ease-snap),
      box-shadow 0.25s var(--ease-snap);
  }
  .pk-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--sh-md);
  }
  .pk-card-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    margin-bottom: 14px;
    border-radius: var(--r-sm);
    color: var(--electric);
    background: color-mix(in srgb, var(--electric) 10%, var(--canvas));
  }
  .pk-card-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 8px;
  }
  .pk-card-head h3 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.18rem;
    color: var(--ink);
  }
  .pk-card-price {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.4rem;
    color: var(--electric);
    white-space: nowrap;
  }
  .pk-card-desc {
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.45;
    margin-bottom: 14px;
  }
  .pk-note {
    margin: 0 0 16px;
    padding: 11px 13px;
    font-size: 0.82rem;
    line-height: 1.45;
    color: var(--muted);
    background: var(--canvas-soft);
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
  }
  .pk-link {
    align-self: flex-start;
    margin-top: auto;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--electric);
    transition: color 0.2s;
  }
  .pk-link:hover {
    color: #1184ff;
  }

  /* ============ Mentenanță ============ */
  .pk-mnt {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 18px;
    align-items: start;
  }
  @media (max-width: 860px) {
    .pk-mnt {
      grid-template-columns: 1fr;
    }
  }
