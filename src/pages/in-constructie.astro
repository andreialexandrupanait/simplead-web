---
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/ui/Button.astro';

export const prerender = false;

// Pagina e servită prin rewrite din middleware pe rutele marcate „în construcție".
// 503 = „temporar indisponibil", corect pentru motoare de căutare.
Astro.response.status = 503;
---

<BaseLayout title="În construcție" noindex>
  <section class="uc">
    <div class="site-container uc__inner">
      <span class="uc__ic" aria-hidden="true">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M14.7 6.3a4 4 0 0 0-5.4 5.4l-6 6a1.4 1.4 0 0 0 2 2l6-6a4 4 0 0 0 5.4-5.4l-2.6 2.6-2-2 2.6-2.6Z"
          ></path>
          <path d="m14 14 4.5 4.5a1.4 1.4 0 0 0 2-2L16 12"></path>
        </svg>
      </span>
      <h1 class="uc__title">Lucrăm la pagina asta.</h1>
      <p class="uc__sub">
        O pregătim cu grijă și revine în curând. Până atunci, hai să vorbim direct sau aruncă un ochi
        pe ce avem deja.
      </p>
      <div class="uc__cta">
        <Button href="/" size="lg" withArrow>Înapoi pe prima pagină</Button>
        <Button href="/contact" size="lg" variant="outline">Scrie-ne</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .uc {
    position: relative;
    background: var(--canvas);
    padding-block: clamp(80px, 14vw, 180px);
    overflow: hidden;
  }
  .uc::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(0, 119, 252, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 119, 252, 0.06) 1px, transparent 1px);
    background-size: 54px 54px;
    -webkit-mask-image: radial-gradient(70% 70% at 50% 30%, #000, transparent 75%);
    mask-image: radial-gradient(70% 70% at 50% 30%, #000, transparent 75%);
    pointer-events: none;
  }
  .uc__inner {
    position: relative;
    max-width: 620px;
    margin-inline: auto;
    text-align: center;
  }
  .uc__ic {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: var(--r-md);
    background: var(--signal);
    color: var(--ink);
    box-shadow: var(--sh-md);
  }
  .uc__ic svg {
    width: 32px;
    height: 32px;
  }
  .uc__title {
    margin-top: 12px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 4.6vw, 3.2rem);
    line-height: 1.07;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .uc__sub {
    margin: 18px auto 0;
    max-width: 46ch;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--muted);
  }
  .uc__cta {
    margin-top: 32px;
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
