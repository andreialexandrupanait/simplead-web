---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/sections/PageHeader.astro';
import CtaSection from '@components/sections/CtaSection.astro';
import { resources } from '@data/resources';

export const prerender = false;

const origin = 'https://simplead.ro';
const schema = {
  '@type': 'ItemList',
  name: 'Resurse Simplead',
  itemListElement: resources.map((r, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: r.title,
    url: `${origin}/resurse#${r.slug}`,
  })),
};

const KIND_LABEL: Record<string, string> = {
  ghid: 'Ghid gratuit',
  checklist: 'Checklist gratuit',
  audit: 'Produs digital',
};
---

<BaseLayout
  title="Resurse"
  description="Ghiduri, checklist-uri și audituri de marketing: resurse practice de la Simplead, bazate pe cercetare în neuromarketing."
  transparentNav={true}
  navOverDark={true}
  schema={schema}
>
  <PageHeader
    crumb={[{ label: 'Acasă', href: '/' }, { label: 'Resurse' }]}
    eyebrow="Resurse"
    title="Unelte practice pentru afacerea ta"
    accent="practice"
    subtitle="Ghiduri și instrumente pe care le folosim în proiectele reale, pe înțelesul tău, fără jargon."
  />

  <section class="section section--light">
    <div class="container">
      <div class="res-grid" data-reveal-stagger>
        {
          resources.map((r) => (
            <article class="res-card" id={r.slug}>
              <div class="res-card__head">
                <span class="res-kind">{KIND_LABEL[r.kind]}</span>
                {r.status === 'coming-soon' && <span class="res-soon">În curând</span>}
              </div>
              <h3>{r.title}</h3>
              <p>{r.description.replace(/\s*\[confirmă:[^\]]*\]/g, '')}</p>

              {r.access === 'gated' ? (
                <form class="res-gate" data-resource={r.slug}>
                  <input
                    type="email"
                    name="email"
                    required
                    placeholder="Emailul tău"
                    aria-label="Emailul tău"
                  />
                  <input
                    type="text"
                    name="company"
                    tabindex="-1"
                    autocomplete="off"
                    aria-hidden="true"
                    style="position:absolute;left:-9999px"
                  />
                  <button type="submit" class="pill pill--grad">
                    {r.status === 'coming-soon' ? 'Anunță-mă când apare' : 'Primește pe email'}
                  </button>
                  <p class="res-gate__msg" aria-live="polite" />
                </form>
              ) : (
                <div class="res-paid">
                  <span class="res-price">
                    {r.priceLabel?.includes('[confirmă') ? 'Preț în curând' : r.priceLabel}
                  </span>
                  <a class="pill pill--grad" href={`/contact?service=${r.slug}`}>
                    Vreau să aflu primul
                  </a>
                </div>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <CtaSection
    title="Vrei ajutor aplicat, nu doar teorie?"
    subtitle="Hai să vorbim despre proiectul tău. Prima discuție e fără obligații."
    href="/contact"
  />
</BaseLayout>

<style>
  .res-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(290px, 1fr));
    gap: 22px;
  }
  .res-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--canvas);
    padding: 26px;
    transition:
      transform 0.2s var(--ease-snap),
      border-color 0.2s var(--ease-snap),
      box-shadow 0.25s var(--ease-snap);
  }
  .res-card:hover {
    transform: translateY(-4px);
    border-color: var(--cyan);
    box-shadow: var(--sh-md);
  }
  .res-card__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
  }
  .res-kind {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--electric);
  }
  .res-soon {
    font-size: 0.72rem;
    font-weight: 600;
    padding: 3px 10px;
    border-radius: var(--r-pill);
    background: color-mix(in srgb, var(--signal) 20%, var(--canvas));
    color: #7a6505;
  }
  .res-card h3 {
    font-size: 1.18rem;
    color: var(--ink);
  }
  .res-card p {
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--muted);
    flex: 1;
  }
  .res-gate {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    position: relative;
  }
  .res-gate input[type='email'] {
    flex: 1;
    min-width: 170px;
    padding: 11px 14px;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    font: inherit;
    font-size: 16px;
  }
  .res-gate input[type='email']:focus {
    outline: 2px solid color-mix(in srgb, var(--electric) 45%, transparent);
    border-color: var(--electric);
  }
  .res-gate__msg {
    width: 100%;
    font-size: 0.85rem;
    margin: 0;
    min-height: 1.2em;
  }
  .res-gate__msg.is-ok {
    color: #0b6e63;
  }
  .res-gate__msg.is-error {
    color: #8a2424;
  }
  .res-paid {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex-wrap: wrap;
  }
  .res-price {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--ink);
  }
</style>

<script>
  // Email-gate: salvează abonatul cu sursa resursei; conținutul se trimite
  // (sau se anunță) pe email.
  document.querySelectorAll<HTMLFormElement>('[data-resource]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const msg = form.querySelector<HTMLElement>('.res-gate__msg')!;
      const email = (form.querySelector('input[name="email"]') as HTMLInputElement).value;
      const company = (form.querySelector('input[name="company"]') as HTMLInputElement).value;
      msg.className = 'res-gate__msg';
      msg.textContent = 'Se trimite…';
      try {
        const res = await fetch('/api/newsletter', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, company, source: `resurse:${form.dataset.resource}` }),
        });
        const body = (await res.json()) as { ok: boolean; error?: string };
        if (body.ok) {
          msg.classList.add('is-ok');
          msg.textContent = 'Gata! Te anunțăm pe email imediat ce resursa e disponibilă.';
          form.reset();
          (
            window as unknown as { saTrack?: (e: string, p?: Record<string, unknown>) => void }
          ).saTrack?.('sign_up', { method: `resurse:${form.dataset.resource}` });
        } else {
          msg.classList.add('is-error');
          msg.textContent = body.error ?? 'Ceva n-a mers. Încearcă din nou.';
        }
      } catch {
        msg.classList.add('is-error');
        msg.textContent = 'Eroare de rețea. Încearcă din nou.';
      }
    });
  });
</script>
