---
import BaseLayout from '@layouts/BaseLayout.astro';

// On-demand: rutele din DB (blog/portofoliu) fac `Astro.rewrite('/404')` la
// slug-uri inexistente, iar rewrite-ul are nevoie de pagina 404 ca modul SSR.
export const prerender = false;
---

<BaseLayout title="Pagina nu a fost găsită" noindex={true}>
  <section class="section section--light" style="min-height:70vh;display:flex;align-items:center">
    <div class="container" style="text-align:center">
      <p class="sec-title" style="font-size:clamp(80px,14vw,160px);line-height:1"><span class="g">404</span></p>
      <h1 style="margin-top:12px;font-family:var(--font-display);font-size:clamp(24px,3vw,32px);font-weight:700;color:var(--ink)">
        Pagina nu a fost găsită
      </h1>
      <p style="margin-top:16px;font-size:16px;color:var(--ink-soft)">
        Se pare că pagina căutată nu există sau a fost mutată. Hai înapoi la lucruri simple.
      </p>
      <div style="margin-top:32px;display:flex;justify-content:center">
        <a class="pill pill--grad" href="/">Înapoi acasă <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>
      </div>
      <div class="nf-links">
        <a href="/servicii">Servicii</a>
        <a href="/pachete">Pachete & prețuri</a>
        <a href="/portofoliu">Portofoliu</a>
        <a href="/blog">Blog</a>
        <a href="/intrebari-frecvente">Întrebări frecvente</a>
        <a href="/contact">Contact</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf-links {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }
  .nf-links a {
    padding: 8px 16px;
    border: 1px solid var(--line);
    border-radius: var(--r-pill);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--ink-soft);
    transition:
      border-color 0.15s ease,
      color 0.15s ease;
  }
  .nf-links a:hover {
    border-color: var(--electric);
    color: var(--electric);
  }
</style>
