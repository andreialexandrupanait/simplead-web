---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/sections/PageHeader.astro';
---

<BaseLayout title="Politica de confidențialitate" noindex={true} transparentNav={true} navOverDark={true}>
  <PageHeader title="Politica de confidențialitate" />
  <section class="section section--light">
    <div class="container" style="max-width:820px">
      <div class="prose-simplead">
        <!-- TODO: înlocuiește cu politica GDPR reală (date colectate, cookies, drepturi). -->
        <p>
          Aceasta este o pagină provizorie. Politica de confidențialitate completă (prelucrarea
          datelor cu caracter personal conform GDPR, cookies, drepturile utilizatorilor) urmează a
          fi completată.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
