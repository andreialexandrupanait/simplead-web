---
import BaseLayout from '@layouts/BaseLayout.astro';
import FaqHero from '@components/sections/FaqHero.astro';
import FaqSection from '@components/sections/FaqSection.astro';
import CtaSection from '@components/sections/CtaSection.astro';
import { faqs, generalFaqs, servicesFaqs, type Faq } from '@data/content';
import { SUPPORT_ICON, type SupportIconKey } from '@data/support-services';

// Hub-ul FAQ: general + colaborare/mentenanță + servicii, o singură schemă FAQPage.
const groups: { id: string; title: string; icon: SupportIconKey; items: Faq[] }[] = [
  { id: 'generale', title: 'Despre Simplead', icon: 'support', items: faqs },
  { id: 'colaborare', title: 'Colaborare & mentenanță', icon: 'refresh', items: generalFaqs },
  { id: 'servicii', title: 'Despre servicii', icon: 'spark', items: servicesFaqs },
];

const categories = groups.map((g) => ({
  id: g.id,
  title: g.title,
  count: g.items.length,
  iconSvg: SUPPORT_ICON[g.icon],
}));

// Text curat pentru schema FAQPage (fără HTML din răspunsuri).
const toAnswer = (f: Faq) => [...f.body, ...(f.list ?? [])].join(' ').replace(/<[^>]+>/g, '');
const origin = 'https://simplead.ro';
const schema = {
  '@type': 'FAQPage',
  mainEntity: groups.flatMap((g) =>
    g.items.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: toAnswer(f) },
    })),
  ),
  url: `${origin}/intrebari-frecvente`,
};
---

<BaseLayout
  title="Întrebări frecvente"
  description="Răspunsuri directe la întrebările despre serviciile Simplead: colaborare, prețuri, mentenanță, termene și procesul de lucru."
  transparentNav={true}
  navOverDark={true}
  schema={schema}
>
  <FaqHero
    title="Întrebări frecvente"
    intro="Tot ce te întrebi despre cum lucrăm, ce livrăm, cât costă și ce se întâmplă după ce începem — la un loc, fără jargon. Nu găsești răspunsul? Scrie-ne, revenim în 24 de ore lucrătoare."
    categories={categories}
  />

  {
    groups.map((g, i) => (
      <div id={g.id} data-faq-group>
        <FaqSection
          title={g.title}
          titleAccent=""
          iconSvg={SUPPORT_ICON[g.icon]}
          items={g.items}
          variant={i % 2 === 0 ? 'light' : 'tint'}
        />
      </div>
    ))
  }

  <p class="faq-noresults section section--light" data-faq-noresults hidden>
    <span class="container">
      Nicio întrebare nu se potrivește căutării tale. Încearcă alt cuvânt sau{' '}
      <a href="/contact">scrie-ne direct</a>.
    </span>
  </p>

  <CtaSection
    title="N-ai găsit răspunsul?"
    subtitle="Scrie-ne întrebarea ta. Prima discuție e fără obligații."
    href="/contact"
  />
</BaseLayout>

<style>
  /* Ascundere robustă la filtrare (bate orice display din .section/.faq-item). */
  .faq-item[hidden],
  [data-faq-group][hidden] {
    display: none !important;
  }
  .faq-noresults {
    text-align: center;
    color: var(--muted);
    font-size: 1.02rem;
  }
  .faq-noresults .container {
    display: block;
  }
  .faq-noresults a {
    color: var(--electric);
    font-weight: 600;
  }
</style>

<script>
  // Căutare live: filtrează toate întrebările peste grupuri, ascunde grupurile
  // goale și afișează mesajul „niciun rezultat". Fără diacritice, ca să prindă
  // și „pret" pentru „preț".
  const input = document.querySelector<HTMLInputElement>('[data-faq-search]');
  const countEl = document.querySelector<HTMLElement>('[data-faq-count]');
  const noRes = document.querySelector<HTMLElement>('[data-faq-noresults]');
  const groupEls = Array.from(document.querySelectorAll<HTMLElement>('[data-faq-group]'));
  const itemEls = Array.from(document.querySelectorAll<HTMLElement>('.faq-item'));

  const norm = (s: string) =>
    s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
  itemEls.forEach((it) => (it.dataset.text = norm(it.textContent || '')));

  if (input) {
    input.addEventListener('input', () => {
      const q = norm(input.value.trim());
      if (!q) {
        itemEls.forEach((it) => (it.hidden = false));
        groupEls.forEach((g) => (g.hidden = false));
        if (noRes) noRes.hidden = true;
        if (countEl) countEl.textContent = '';
        return;
      }
      let total = 0;
      itemEls.forEach((it) => {
        const match = (it.dataset.text || '').includes(q);
        it.hidden = !match;
        if (match) total++;
      });
      groupEls.forEach((g) => {
        g.hidden = !g.querySelector('.faq-item:not([hidden])');
      });
      if (noRes) noRes.hidden = total > 0;
      if (countEl)
        countEl.textContent = total
          ? `${total} ${total === 1 ? 'rezultat' : 'rezultate'}`
          : '';
    });
  }
</script>
