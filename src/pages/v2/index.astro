<script>
  // ── Servicii: săgeți prev/next + stare disabled ──
  {
    const track = document.querySelector<HTMLElement>('.hp-svc__track');
    const prev = document.querySelector<HTMLButtonElement>('.hp-svc__btn[data-dir="prev"]');
    const next = document.querySelector<HTMLButtonElement>('.hp-svc__btn[data-dir="next"]');
    if (track) {
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const behavior: ScrollBehavior = reduce ? 'auto' : 'smooth';
      const stepBy = () => {
        const item = track.querySelector<HTMLElement>('.hp-svc__item');
        const w = item ? item.getBoundingClientRect().width : 300;
        return (w + 22) * 1.5;
      };
      const sync = () => {
        const max = track.scrollWidth - track.clientWidth - 2;
        if (prev) prev.disabled = track.scrollLeft <= 2;
        if (next) next.disabled = track.scrollLeft >= max;
      };
      prev?.addEventListener('click', () => track.scrollBy({ left: -stepBy(), behavior }));
      next?.addEventListener('click', () => track.scrollBy({ left: stepBy(), behavior }));
      track.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', sync);
      sync();
    }
  }

  // ── Proces: pași clicabili → panou activ ──
  {
    const root = document.querySelector<HTMLElement>('[data-proc]');
    if (root) {
      const steps = Array.from(root.querySelectorAll<HTMLButtonElement>('.hp-proc__step'));
      const panels = Array.from(root.querySelectorAll<HTMLElement>('.hp-proc__panel'));
      const show = (i: number) => {
        steps.forEach((s, k) => s.setAttribute('aria-selected', k === i ? 'true' : 'false'));
        panels.forEach((p, k) => {
          p.classList.toggle('on', k === i);
          p.setAttribute('aria-hidden', k === i ? 'false' : 'true');
        });
      };
      steps.forEach((s, i) => {
        s.addEventListener('click', () => show(i));
        s.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
            e.preventDefault();
            const dir = e.key === 'ArrowRight' ? 1 : -1;
            const n = (i + dir + steps.length) % steps.length;
            show(n);
            steps[n]?.focus();
          }
        });
      });
    }
  }

  // ── Studii de caz: taburi ──
  {
    const root = document.getElementById('hp-cs');
    if (root) {
      const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('.hp-cs__tab'));
      const cards = Array.from(root.querySelectorAll<HTMLElement>('.hp-cs__card'));
      const select = (i: number) => {
        tabs.forEach((t, k) => t.setAttribute('aria-selected', k === i ? 'true' : 'false'));
        cards.forEach((c, k) => {
          c.classList.toggle('on', k === i);
          c.setAttribute('aria-hidden', k === i ? 'false' : 'true');
        });
      };
      tabs.forEach((t, i) => {
        t.addEventListener('click', () => select(i));
        t.addEventListener('keydown', (e) => {
          if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
            e.preventDefault();
            const dir = e.key === 'ArrowRight' ? 1 : -1;
            const n = (i + dir + tabs.length) % tabs.length;
            select(n);
            tabs[n]?.focus();
          }
        });
      });
    }
  }
</script>
