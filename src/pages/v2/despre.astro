---
import BaseLayoutV2 from '@layouts/BaseLayoutV2.astro';

export const prerender = false;

// Conținut IDENTIC cu varianta A (src/pages/despre.astro). Doar prezentarea diferă.
const metaDescription =
  'Simplead e un studio mic de grafică și marketing digital. Suntem doi, Andrei (doctor în marketing) și Gabriel, plus colaboratori la nevoie. Pornim de la cum decid oamenii, nu de la presupuneri.';

// Logo-uri reale de clienți/parteneri (identice cu varianta A).
const clients = [
  { src: '/parteneri/feaa-galati.png', name: 'FEAA Galați', w: 1057, h: 216 },
  { src: '/parteneri/m1-med-beauty.png', name: 'M1 Med Beauty', w: 278, h: 63 },
  { src: '/parteneri/matematica-interactiva.png', name: 'Matematica Interactivă', w: 2084, h: 687 },
  { src: '/parteneri/priority-clinic.png', name: 'Priority Clinic', w: 1402, h: 183 },
  { src: '/parteneri/simona-halep.png', name: 'Hotel Simona Halep', w: 852, h: 275 },
  { src: '/parteneri/fastrackids.webp', name: 'FasTrackKids', w: 1558, h: 382 },
  { src: '/parteneri/roll-shape.png', name: 'Roll Shape', w: 1485, h: 797 },
  { src: '/parteneri/premium-stone.png', name: 'Premium Stone', w: 785, h: 116 },
  { src: '/parteneri/georgiana-ungureanu.png', name: 'Georgiana Ungureanu', w: 878, h: 85 },
  { src: '/parteneri/ichb.png', name: 'ICHB', w: 781, h: 218 },
  { src: '/parteneri/isor.png', name: 'ISOR', w: 268, h: 86 },
  { src: '/parteneri/florin-pasat.png', name: 'Florin Pasat', w: 300, h: 101 },
];
---

<BaseLayoutV2 title="Despre" description={metaDescription}>
  {/* ===== HERO ===== */}
  <section class="dv-hero">
    <div class="v2-container dv-hero__inner">
      <div class="dv-crumb">
        <a href="/">Acasă</a> <span>/</span> <span class="accent">Despre noi</span>
      </div>
      <h1 class="dv-hero__title">
        Doi oameni care îți tratează proiectul <span class="accent">ca pe-al lor.</span>
      </h1>
      <p class="dv-hero__sub">
        Studio mic de grafică și marketing digital, nu o agenție cu zeci de oameni. Lucrezi direct
        cu noi, de la prima discuție până la final.
      </p>
      <div class="dv-duo">
        <div class="dv-duo__card">
          <b>Andrei Panait</b><span>Strategie, web &amp; cercetare</span>
        </div>
        <span class="dv-duo__slash" aria-hidden="true">/</span>
        <div class="dv-duo__card">
          <b>Gabriel Tulearca</b><span>Grafică, marketing &amp; social</span>
        </div>
      </div>
      <div class="dv-hero__cta">
        <a class="v2-btn" href="/contact">Hai să discutăm</a>
        <a class="v2-btn v2-btn--ghost" href="/portofoliu">Vezi portofoliu</a>
      </div>
    </div>
  </section>

  {/* ===== POVESTEA ===== */}
  <section class="dv-story">
    <div class="v2-container dv-story__grid">
      <div data-reveal>
        <div class="v2-eyebrow">Povestea</div>
        <h2 class="v2-h2 dv-story__title">De ce există <span class="accent">Simplead</span></h2>
        <p class="dv-p">
          Am început să fac grafică încă din liceu. Colegii și primii mei colaboratori veneau mereu
          cu cereri: un afiș, un logo, un material pentru promovare. Și de fiecare dată procesul era
          mult mai complicat decât trebuia, pentru un rezultat care putea fi simplu și folositor.
        </p>
        <p class="dv-p">
          De-acolo a pornit Simplead: din dorința de a face lucrurile mai simple și mai utile. Am
          deschis firma cu ajutorul unei finanțări europene și de-atunci am mers mai departe,
          proiect cu proiect.
        </p>
      </div>
      <div data-reveal>
        <div class="dv-stat-grid">
          <div class="dv-stat"><b>[confirmă]</b><span>ani de lucru</span></div>
          <div class="dv-stat"><b>[confirmă]</b><span>proiecte</span></div>
        </div>
        <div class="dv-badge">
          <span class="dv-badge__ic" aria-hidden="true">★</span>
          <span>Pornit cu o finanțare europeană</span>
        </div>
      </div>
    </div>
  </section>

  {/* ===== METODA (dark) ===== */}
  <section class="dv-method">
    <div class="v2-container dv-method__inner">
      <h2 class="dv-method__title">
        Mai puțin noroc, <span class="dv-blue">mai multă metodă</span>.
      </h2>
      <p class="dv-method__p">
        Cele mai multe mesaje de marketing nu dau greș din cauza bugetului mic. Dau greș fiindcă
        deciziile se iau pe „mie îmi place" sau pe ce zic oamenii într-un chestionar. Și oamenii nu
        prea cumpără cum spun: cele mai multe decizii se iau repede și emoțional, înainte ca rațiunea
        să intre în joc.
      </p>
      <p class="dv-method__p">
        De-aia pornim de la cum decid oamenii cu adevărat, nu de la presupuneri. Asta intră în
        alegeri concrete de pe proiectul tău: ce vede omul întâi, cum simte pagina în primele
        secunde, ce îl face să aibă încredere și să acționeze.
      </p>
      <blockquote class="dv-method__quote">
        „Nu avem un buton magic și nici nu promitem ceva ce nu putem livra. Ne bazăm pe date,
        procesăm informațiile și îmbunătățim acolo unde este nevoie să intervenim."
      </blockquote>
    </div>
  </section>

  {/* ===== ECHIPA ===== */}
  <section class="dv-team">
    <div class="v2-container dv-team__grid">
      <div data-reveal>
        <h2 class="v2-h2">
          Suficient de mici cât să ne pese.
          <span class="accent">Suficient de buni cât să ducem treaba la capăt.</span>
        </h2>
        <p class="dv-p">
          Lucrăm direct pe proiectele clienților, fără să pasăm la juniori și fără să dispărem după
          ce semnăm. Eu mă ocup de strategie, web și partea de cercetare. Gabriel a preluat grafica
          de la mine și ține design-ul, strategiile de marketing și social media. Când e nevoie de
          foto, video sau dezvoltare specializată, chemăm colaboratori cu care lucrăm de ani de zile
          și în care avem încredere.
        </p>
        <p class="dv-p">
          Așa, ai mereu cu cine vorbi direct, nu se pierde informație între departamente și tot ce
          livrăm a trecut prin aceleași mâini, de la brief până la final.
        </p>
        <p class="dv-p">
          Lucrăm cu afaceri mici și medii din România, dar și cu clienți din afara țării care vor un
          partener serios.
        </p>
      </div>
      <div class="dv-people" data-reveal>
        <article class="dv-person">
          <img src="/andrei.webp" alt="Andrei Alexandru Panait" width="84" height="84" loading="lazy" />
          <div>
            <div class="dv-person__name">Andrei Alexandru Panait</div>
            <div class="dv-person__role">Fondator</div>
            <p class="dv-person__bio">
              Strategie, web și cercetare. Doctor în marketing, cu cercetare în neuromarketing.
            </p>
          </div>
        </article>
        <article class="dv-person">
          <span class="dv-person__mono" aria-hidden="true">GT</span>
          <div>
            <div class="dv-person__name">Gabriel Tulearca</div>
            <div class="dv-person__role">Grafică, marketing &amp; social media</div>
            <p class="dv-person__bio">Doctorand în marketing.</p>
          </div>
        </article>
      </div>
    </div>
  </section>

  {/* ===== DOVADA: lead + testimonial + logo-uri ===== */}
  <section class="dv-proof">
    <div class="v2-container">
      <div class="dv-proof__head" data-reveal>
        <h2 class="v2-h2 center">
          Afaceri mici, instituții, <span class="accent">proiecte din mai multe domenii.</span>
        </h2>
        <p class="dv-proof__lead">
          Am lucrat cu afaceri la început de drum și cu instituții mari: FEAA Galați, Universitatea
          „Dunărea de Jos", plus clienți din sănătate și beauty, educație, brand personal și
          business. Peste 20 de site-uri construite de noi sunt și azi online, în patru domenii
          diferite. Fiecare a primit aceeași atenție, indiferent de buget.
        </p>
      </div>
      <figure class="dv-quote" data-reveal>
        <blockquote>„Simply professional. Trustworthy, honest and creative.”</blockquote>
        <figcaption><b>Bogdan Drăgan</b><span>FEAA Galați</span></figcaption>
      </figure>
      <div class="dv-logos" data-reveal>
        {
          clients.map((c) => (
            <span class="dv-logo">
              <img src={c.src} alt={c.name} width={c.w} height={c.h} loading="lazy" />
            </span>
          ))
        }
      </div>
    </div>
  </section>

  {/* ===== COLABORĂRI LUNGI (dark) ===== */}
  <section class="dv-trust">
    <div class="v2-container dv-trust__grid">
      <div data-reveal>
        <h2 class="dv-trust__title">
          Relații care țin de ani, <span class="dv-blue">nu de luni</span>
        </h2>
        <p class="dv-trust__sub">
          Unii clienți sunt cu noi de <b>[confirmă: ani]</b>. Doi parteneri principali,
          <b>Marketing Deck</b> și <b>M1 Med Beauty</b>, ne trimit constant proiecte noi, fiindcă
          rezultatele se văd în timp.
        </p>
        <div class="dv-trust__stats">
          <div><b>[confirmă]</b><span>ani, cea mai lungă colaborare</span></div>
          <div><b>2</b><span>parteneri principali</span></div>
        </div>
      </div>
      <div class="dv-partners" data-reveal>
        <span class="dv-partners__label">Parteneri principali</span>
        <a
          class="dv-partner"
          href="https://marketingdeck.com/?utm_source=simplead.ro&utm_medium=referral&utm_campaign=parteneri-simplead"
          target="_blank"
          rel="noopener"
        >
          <b>Marketing Deck</b>
          <span>Vezi site-ul <span aria-hidden="true">↗</span></span>
        </a>
        <a
          class="dv-partner"
          href="https://m1-beauty.com/?utm_source=simplead.ro&utm_medium=referral&utm_campaign=parteneri-simplead"
          target="_blank"
          rel="noopener"
        >
          <b>M1 Med Beauty</b>
          <span>Vezi site-ul <span aria-hidden="true">↗</span></span>
        </a>
      </div>
    </div>
  </section>

  {/* ===== VALORI ===== */}
  <section class="dv-values">
    <div class="v2-container">
      <h2 class="v2-h2 center dv-values__title" data-reveal>
        Câteva lucruri <span class="accent">în care credem</span>.
      </h2>
      <div class="dv-values__grid" data-reveal>
        <div class="dv-value">
          <span class="dv-value__num">01</span>
          <h3>Un client informat e un client mai bun</h3>
          <p>Îți explicăm ce primești și de ce, fără jargon. Deciziile bune se iau cu lucrurile pe masă.</p>
        </div>
        <div class="dv-value">
          <span class="dv-value__num">02</span>
          <h3>Onestitatea de la început costă mai puțin</h3>
          <p>Inclusiv un „asta nu e specialitatea noastră" spus din start, în loc de o dezamăgire la final.</p>
        </div>
        <div class="dv-value">
          <span class="dv-value__num">03</span>
          <h3>Un proiect mic, tratat serios</h3>
          <p>Face mai mult decât un proiect mare tratat ca un simplu număr de factură.</p>
        </div>
      </div>
    </div>
  </section>

  {/* ===== CTA ===== */}
  <section class="dv-cta">
    <div class="v2-container">
      <div class="dv-cta__box">
        <div class="v2-eyebrow dv-cta__kicker">Hai să începem</div>
        <h2 class="dv-cta__title">Vrei să lucrăm <span class="dv-blue">împreună</span>?</h2>
        <p class="dv-cta__sub">
          Spune-ne în câteva cuvinte cu ce te putem ajuta. Îți răspundem noi, oameni, la fiecare
          mesaj.
        </p>
        <div class="dv-cta__actions">
          <a class="v2-btn v2-btn--light" href="/contact">Hai să discutăm</a>
          <a class="v2-btn v2-btn--ghost dv-cta__ghost" href="/portofoliu">Vezi portofoliu</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayoutV2>

<style>
  .dv-p {
    font-size: 15.5px;
    line-height: 1.75;
    color: var(--v2-muted);
    margin: 16px 0 0;
  }
  .center {
    text-align: center;
  }
  .dv-blue {
    color: var(--v2-blue-soft);
  }

  /* ===== HERO ===== */
  .dv-hero {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0) 35%, #ffffff 88%),
      linear-gradient(#e9eef7 1px, transparent 1px),
      linear-gradient(90deg, #e9eef7 1px, transparent 1px);
    background-size:
      auto,
      88px 88px,
      88px 88px;
  }
  .dv-hero__inner {
    padding: 56px 36px 80px;
    text-align: center;
  }
  .dv-crumb {
    font-size: 13px;
    font-weight: 600;
    color: var(--v2-faint);
    text-align: left;
  }
  .dv-crumb a {
    color: var(--v2-faint);
  }
  .dv-crumb span {
    margin: 0 6px;
  }
  .dv-crumb .accent {
    font-weight: 700;
    margin: 0;
  }
  .dv-hero__title {
    font-size: clamp(34px, 5.4vw, 54px);
    line-height: 1.12;
    letter-spacing: -0.025em;
    font-weight: 800;
    margin: 36px auto 0;
    max-width: 880px;
    text-wrap: balance;
  }
  .dv-hero__sub {
    font-size: 17px;
    line-height: 1.7;
    color: var(--v2-muted);
    max-width: 640px;
    margin: 22px auto 0;
  }
  .dv-duo {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    margin-top: 32px;
    flex-wrap: wrap;
  }
  .dv-duo__card {
    background: #fff;
    border: 1px solid var(--v2-line-soft);
    border-radius: 10px;
    padding: 14px 22px;
    text-align: left;
  }
  .dv-duo__card b {
    display: block;
    font-size: 14.5px;
    font-weight: 800;
  }
  .dv-duo__card span {
    display: block;
    font-size: 12.5px;
    color: var(--v2-faint);
    font-weight: 600;
    margin-top: 2px;
  }
  .dv-duo__slash {
    font-size: 20px;
    font-weight: 800;
    color: var(--v2-blue);
  }
  .dv-hero__cta {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-top: 36px;
    flex-wrap: wrap;
  }

  /* ===== POVESTEA ===== */
  .dv-story {
    border-top: 1px solid var(--v2-line);
  }
  .dv-story__grid {
    padding: 88px 36px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }
  .dv-story__title {
    margin-top: 14px;
  }
  .dv-stat-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 18px;
  }
  .dv-stat {
    background: #fff;
    border: 1px solid var(--v2-line-soft);
    border-radius: var(--v2-r-card);
    padding: 26px 28px;
  }
  .dv-stat b {
    display: block;
    font-size: 32px;
    font-weight: 800;
    color: var(--v2-blue);
  }
  .dv-stat span {
    display: block;
    font-size: 13px;
    font-weight: 600;
    color: var(--v2-faint);
    margin-top: 4px;
  }
  .dv-badge {
    margin-top: 18px;
    background: var(--v2-tint);
    border: 1px solid var(--v2-tint-line);
    border-radius: var(--v2-r-card);
    padding: 20px 24px;
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .dv-badge__ic {
    flex: none;
    width: 40px;
    height: 40px;
    background: var(--v2-blue);
    border-radius: 9px;
    color: #fff;
    font-size: 17px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .dv-badge span:last-child {
    font-size: 14.5px;
    font-weight: 700;
    color: var(--v2-navy);
  }

  /* ===== METODA (dark) ===== */
  .dv-method {
    color: #fff;
    background-color: var(--v2-navy-deep);
    background-image:
      radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px),
      radial-gradient(ellipse 60% 55% at 12% 100%, rgba(32, 101, 236, 0.28), transparent 70%),
      linear-gradient(135deg, #0c1633 0%, #102a63 55%, #0e2152 100%);
    background-size:
      24px 24px,
      auto,
      auto;
  }
  .dv-method__inner {
    max-width: 980px;
    padding: 96px 36px;
    text-align: center;
    margin: 0 auto;
  }
  .dv-method__title {
    font-size: clamp(30px, 4.4vw, 40px);
    letter-spacing: -0.02em;
    font-weight: 800;
    margin: 0;
  }
  .dv-method__p {
    font-size: 16px;
    line-height: 1.75;
    color: #a9b4cc;
    margin: 20px auto 0;
    max-width: 800px;
  }
  .dv-method__quote {
    margin: 40px auto 0;
    max-width: 720px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--v2-r-card);
    padding: 28px 34px;
    font-size: 16.5px;
    line-height: 1.7;
    font-weight: 600;
    font-style: italic;
  }

  /* ===== ECHIPA ===== */
  .dv-team__grid {
    padding: 96px 36px 88px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
  }
  .dv-people {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .dv-person {
    background: #fff;
    border: 1px solid var(--v2-line-soft);
    border-radius: 14px;
    padding: 26px 28px;
    display: flex;
    gap: 20px;
    align-items: center;
  }
  .dv-person img,
  .dv-person__mono {
    width: 84px;
    height: 84px;
    border-radius: 12px;
    flex: none;
    object-fit: cover;
  }
  .dv-person__mono {
    background: var(--v2-navy);
    color: #fff;
    font-size: 26px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .dv-person__name {
    font-size: 17px;
    font-weight: 800;
  }
  .dv-person__role {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--v2-blue);
    margin-top: 3px;
  }
  .dv-person__bio {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--v2-muted);
    margin: 8px 0 0;
  }

  /* ===== DOVADA ===== */
  .dv-proof {
    background-color: var(--v2-surface-soft);
    background-image: radial-gradient(#e4eaf5 1.1px, transparent 1.1px);
    background-size: 26px 26px;
    border-top: 1px solid var(--v2-line);
    padding: 88px 0;
  }
  .dv-proof__head {
    max-width: 820px;
    margin: 0 auto;
  }
  .dv-proof__lead {
    font-size: 16px;
    line-height: 1.75;
    color: var(--v2-muted);
    text-align: center;
    margin: 22px auto 0;
  }
  .dv-quote {
    max-width: 640px;
    margin: 40px auto 0;
    text-align: center;
  }
  .dv-quote blockquote {
    margin: 0;
    font-size: 22px;
    line-height: 1.5;
    font-weight: 700;
    font-style: italic;
    color: var(--v2-navy);
  }
  .dv-quote figcaption {
    margin-top: 14px;
    font-size: 13.5px;
    color: var(--v2-faint);
  }
  .dv-quote figcaption b {
    color: var(--v2-navy);
  }
  .dv-quote figcaption span::before {
    content: ' · ';
  }
  .dv-logos {
    margin: 48px auto 0;
    max-width: 1000px;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 28px 32px;
    align-items: center;
  }
  .dv-logo {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .dv-logo img {
    max-width: 100%;
    max-height: 42px;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.62;
    transition:
      filter 0.2s ease,
      opacity 0.2s ease;
  }
  .dv-logo img:hover {
    filter: grayscale(0);
    opacity: 1;
  }

  /* ===== COLABORĂRI (dark) ===== */
  .dv-trust {
    color: #fff;
    background: linear-gradient(135deg, #0c1633 0%, #102a63 100%);
  }
  .dv-trust__grid {
    padding: 88px 36px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 72px;
    align-items: center;
  }
  .dv-trust__title {
    font-size: clamp(28px, 4vw, 36px);
    font-weight: 800;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .dv-trust__sub {
    font-size: 15.5px;
    line-height: 1.75;
    color: #a9b4cc;
    margin: 20px 0 0;
  }
  .dv-trust__sub b {
    color: #fff;
    font-weight: 700;
  }
  .dv-trust__stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
    margin-top: 28px;
  }
  .dv-trust__stats b {
    display: block;
    font-size: 30px;
    font-weight: 800;
