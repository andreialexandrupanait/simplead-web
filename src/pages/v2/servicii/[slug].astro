<script>
  // Acordeoane single-open per listă (FAQ paginii + FAQ pe teme). Independente,
  // ca să meargă și când sunt mai multe pe pagină.
  document.querySelectorAll<HTMLElement>('.sv-faq').forEach((list) => {
    const items = Array.from(list.querySelectorAll<HTMLElement>('.sv-faq-item'));
    items.forEach((item) => {
      const q = item.querySelector<HTMLButtonElement>('.sv-faq-q');
      q?.addEventListener('click', () => {
        const open = item.classList.contains('is-open');
        items.forEach((other) => {
          other.classList.remove('is-open');
          other.querySelector('.sv-faq-q')?.setAttribute('aria-expanded', 'false');
        });
        if (!open) {
          item.classList.add('is-open');
          q.setAttribute('aria-expanded', 'true');
        }
      });
    });
  });
</script>
