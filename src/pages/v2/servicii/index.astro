---
import BaseLayoutV2 from '@layouts/BaseLayoutV2.astro';
import { services, serviceHref } from '@data/services';
import { whyPanel, svcHubStats, servicesFaqs } from '@data/content';

export const prerender = false;

// Conținut IDENTIC cu varianta A (src/pages/servicii/index.astro). Doar prezentarea diferă.
// Aceleași surse de date: @data/services (cele 6 servicii) și @data/content
// (whyPanel, svcHubStats, servicesFaqs).
const metaDescription =
  'Marketing, grafică, web și mentenanță, la un singur partener. Lucrăm pe obiective clare și pornim de la date și de la cum decid oamenii (neuromarketing).';

const heroSub =
  'Marketing, grafică, web și mentenanță, la un singur partener. Doi oameni și colaboratori aleși pe proiect: destui cât să acoperim tot, destul de puțini cât să luăm fiecare proiect în serios.';
---

<BaseLayoutV2 title="Servicii" description={metaDescription}>
  {/* ===== HERO ===== */}
  <section class="sv-hero">
    <div class="v2-container sv-hero__inner">
      <div class="sv-crumb">
        <a href="/">Acasă</a> <span>/</span> <span class="accent">Servicii</span>
      </div>
      <div class="sv-hero__grid">
        <div data-reveal>
          <h1 class="sv-hero__title">
            Grafică, web și marketing, <span class="accent">la un singur partener</span>
          </h1>
          <p class="sv-hero__sub">{heroSub}</p>
          <div class="sv-hero__cta">
            <a class="v2-btn" href="/contact">Cere o ofertă</a>
            <a class="sv-link" href="#servicii">
              Vezi serviciile <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
        <aside class="sv-panel" data-reveal>
          <div class="sv-panel__head"><span class="sv-panel__dot" aria-hidden="true"></span>De ce Simplead?</div>
          <ul class="sv-panel__list">
            {
              whyPanel.map((item) => (
                <li>
                  <span class="sv-panel__check" aria-hidden="true">✓</span>
                  {item}
                </li>
              ))
            }
          </ul>
          <div class="sv-panel__stats">
            {
              svcHubStats.map((s) => (
                <div class="sv-stat">
                  <b>
                    {s.value}
                    {s.em && <em>{s.em}</em>}
                  </b>
                  <span>{s.label}</span>
                </div>
              ))
            }
          </div>
        </aside>
      </div>
    </div>
  </section>

  {/* ===== ȘASE DIRECȚII ===== */}
  <section class="sv-services" id="servicii">
    <div class="v2-container">
      <div class="sv-services__head" data-reveal>
        <h2 class="v2-h2">Șase direcții, <span class="accent">un singur partener</span></h2>
        <p class="sv-services__sub">
          Simplu de gestionat, ușor de scalat. Le poți lua separat sau ca pachet complet. Le
          coordonăm noi.
        </p>
      </div>
      <div class="sv-grid" data-reveal>
        {
          services.map((s, i) => (
            <a class="sv-card" href={serviceHref(s.slug)}>
              <div class="sv-card__media">
                <img src={s.image} alt={s.title} loading="lazy" />
                <span class="sv-card__num">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <div class="sv-card__body">
                <h3 class="sv-card__title">{s.title}</h3>
                <p class="sv-card__desc">{s.summary}</p>
                <div class="sv-card__tags">
                  {s.tags.map((t) => (
                    <span>{t}</span>
                  ))}
                </div>
                <span class="sv-card__more">Vezi detalii <span aria-hidden="true">→</span></span>
              </div>
            </a>
          ))
        }
      </div>

      {/* Suport tehnic punctual (înlocuiește catalogul tehnic). */}
      <div class="sv-support" data-reveal>
        <div>
          <h3 class="sv-support__title">Ai o problemă tehnică punctuală?</h3>
          <p class="sv-support__desc">
            WordPress căzut, SSL expirat, DNS greșit, email în spam sau vrei să muți site-ul fără
            downtime. Le rezolvăm fără să deschizi un proiect întreg.
          </p>
        </div>
        <a class="sv-support__cta" href="/suport">Vezi ce acoperim</a>
      </div>
    </div>
  </section>

  {/* ===== FAQ ===== */}
  <section class="sv-faq">
    <div class="v2-container sv-faq__inner">
      <h2 class="v2-h2 sv-faq__title">Ce vor să știe <span class="accent">clienții noștri</span></h2>
      <div class="sv-faq__list">
        {
          servicesFaqs.map((f, i) => (
            <div class:list={['sv-faq-item', i === 0 && 'is-open']}>
              <button class="sv-faq-q" type="button" aria-expanded={i === 0 ? 'true' : 'false'}>
                <span>{f.q}</span>
                <span class="sv-faq-ic" aria-hidden="true">▾</span>
              </button>
              <div class="sv-faq-a">
                <div class="sv-faq-a__inner">
                  {f.body.map((p) => (
                    <p set:html={p} />
                  ))}
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {/* ===== CTA ===== */}
  <section class="sv-cta">
    <div class="v2-container">
      <div class="sv-cta__box" data-reveal>
        <h2 class="sv-cta__title">Gata să-ți pui <span class="dv-blue">afacerea pe roți</span>?</h2>
        <p class="sv-cta__sub">
          Hai să discutăm despre proiectul tău. Prima întâlnire e fără obligații.
        </p>
        <div class="sv-cta__actions">
          <a class="v2-btn v2-btn--light" href="/contact">Cere o ofertă</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayoutV2>

<style>
  .dv-blue {
    color: var(--v2-blue-soft);
  }

  /* ===== HERO ===== */
  .sv-hero {
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0) 35%, #ffffff 88%),
      linear-gradient(#e9eef7 1px, transparent 1px),
      linear-gradient(90deg, #e9eef7 1px, transparent 1px);
    background-size:
      auto,
      88px 88px,
      88px 88px;
  }
  .sv-hero__inner {
    padding: 56px 36px 80px;
  }
  .sv-crumb {
    font-size: 13px;
    font-weight: 600;
    color: var(--v2-faint);
  }
  .sv-crumb a {
    color: var(--v2-faint);
  }
  .sv-crumb span {
    margin: 0 6px;
  }
  .sv-crumb .accent {
    font-weight: 700;
    margin: 0;
  }
  .sv-hero__grid {
    margin-top: 36px;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 80px;
    align-items: center;
  }
  .sv-hero__title {
    font-size: clamp(32px, 5vw, 52px);
    line-height: 1.12;
    letter-spacing: -0.025em;
    font-weight: 800;
    margin: 0;
    text-wrap: balance;
  }
  .sv-hero__sub {
    font-size: 17px;
    line-height: 1.7;
    color: var(--v2-muted);
    max-width: 560px;
    margin: 24px 0 0;
  }
  .sv-hero__cta {
    display: flex;
    gap: 24px;
    margin-top: 36px;
    align-items: center;
    flex-wrap: wrap;
  }
  .sv-link {
    color: var(--v2-navy);
    font-size: 15.5px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .sv-link:hover {
    color: var(--v2-blue);
  }

  .sv-panel {
    background: #fff;
    border: 1px solid var(--v2-line-soft);
    border-radius: var(--v2-r-card);
    box-shadow: 0 20px 48px rgba(13, 27, 62, 0.12);
    overflow: hidden;
  }
  .sv-panel__head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 22px 28px;
    border-bottom: 1px solid #eef1f6;
    font-size: 16px;
    font-weight: 800;
  }
  .sv-panel__dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--v2-blue);
    box-shadow: 0 0 0 4px rgba(32, 101, 236, 0.16);
  }
  .sv-panel__list {
    list-style: none;
    margin: 0;
    padding: 20px 28px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .sv-panel__list li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 14.5px;
    line-height: 1.45;
    font-weight: 600;
    color: #33415e;
  }
  .sv-panel__check {
    flex: none;
    width: 22px;
    height: 22px;
    background: var(--v2-tint);
    color: var(--v2-blue);
    border-radius: 50%;
    font-size: 12px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 1px;
  }
  .sv-panel__stats {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid #eef1f6;
  }
  .sv-stat {
    padding: 18px 20px;
    border-right: 1px solid #eef1f6;
  }
  .sv-stat:last-child {
    border-right: none;
  }
  .sv-stat b {
    display: block;
    font-size: 22px;
    font-weight: 800;
  }
  .sv-stat em {
    font-style: normal;
    color: var(--v2-blue);
  }
  .sv-stat span {
    display: block;
    font-size: 12px;
    font-weight: 600;
    color: var(--v2-faint);
    margin-top: 2px;
  }

  /* ===== ȘASE DIRECȚII ===== */
  .sv-services {
    border-top: 1px solid var(--v2-line);
    padding: 96px 0;
  }
  .sv-services__head {
    max-width: 720px;
    margin-bottom: 52px;
  }
  .sv-services__sub {
    font-size: 16.5px;
    line-height: 1.65;
    color: var(--v2-muted);
    margin: 18px 0 0;
  }
  .sv-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .sv-card {
    background: #fff;
    border: 1px solid var(--v2-line-soft);
    border-radius: var(--v2-r-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    color: var(--v2-navy);
    transition:
      border-color 0.2s ease,
      box-shadow 0.2s ease,
      transform 0.2s ease;
  }
  .sv-card:hover {
    border-color: var(--v2-blue);
    box-shadow: 0 14px 32px rgba(13, 27, 62, 0.12);
    transform: translateY(-3px);
  }
  .sv-card__media {
    position: relative;
    height: 150px;
  }
  .sv-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .sv-card__num {
    position: absolute;
    left: 16px;
    top: 14px;
    background: rgba(255, 255, 255, 0.94);
    color: var(--v2-navy);
    font-size: 11px;
    font-weight: 800;
    padding: 4px 9px;
    border-radius: 5px;
  }
  .sv-card__body {
    padding: 22px 24px 26px;
    display: flex;
    flex-direction: column;
    flex: 1;
  }
  .sv-card__title {
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.01em;
    margin: 0;
  }
  .sv-card__desc {
    font-size: 13.5px;
    line-height: 1.6;
    color: var(--v2-muted);
    margin: 8px 0 0;
  }
  .sv-card__tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: 14px;
  }
  .sv-card__tags span {
    background: #eef2f8;
    color: #33415e;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 9px;
    border-radius: 4px;
  }
  .sv-card__more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    padding-top: 16px;
    font-size: 13.5px;
    font-weight: 700;
    color: var(--v2-blue);
  }

  .sv-support {
    margin-top: 28px;
    background: var(--v2-navy-deep);
    background-image: radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 24px 24px;
    border-radius: var(--v2-r-card);
    padding: 32px 36px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 48px;
    color: #fff;
    flex-wrap: wrap;
  }
  .sv-support__title {
    font-size: 20px;
    font-weight: 800;
    margin: 0;
  }
  .sv-support__desc {
    font-size: 14.5px;
    line-height: 1.65;
    color: #a9b4cc;
    margin: 8px 0 0;
    max-width: 640px;
  }
  .sv-support__cta {
    flex: none;
    background: var(--v2-blue);
    color: #fff;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    padding: 15px 28px;
    border-radius: var(--v2-r);
    white-space: nowrap;
    transition:
      background-color 0.18s ease,
      color 0.18s ease;
  }
  .sv-support__cta:hover {
    background: #fff;
    color: var(--v2-navy-deep);
  }

  /* ===== FAQ ===== */
  .sv-faq {
    background: var(--v2-surface-soft);
    border-top: 1px solid var(--v2-line);
  }
  .sv-faq__inner {
    max-width: 880px;
    padding: 96px 36px;
  }
  .sv-faq__title {
    text-align: center;
    margin: 0 0 40px;
  }
  .sv-faq__list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .sv-faq-item {
    background: #fff;
    border: 1px solid var(--v2-line-soft);
    border-radius: 10px;
    overflow: hidden;
  }
  .sv-faq-q {
    width: 100%;
    border: none;
    background: none;
    cursor: pointer;
    font-family: var(--v2-font);
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
    padding: 20px 26px;
    text-align: left;
    color: var(--v2-navy);
  }
  .sv-faq-q > span:first-child {
    font-size: 16.5px;
    font-weight: 700;
  }
  .sv-faq-ic {
    font-size: 14px;
    font-weight: 800;
    color: var(--v2-blue);
    transform: rotate(0deg);
    transition: transform 0.2s ease;
    flex: none;
  }
  .sv-faq-item.is-open .sv-faq-ic {
    transform: rotate(180deg);
  }
  .sv-faq-a {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.24s ease;
  }
  .sv-faq-item.is-open .sv-faq-a {
    grid-template-rows: 1fr;
  }
  .sv-faq-a__inner {
    overflow: hidden;
  }
  .sv-faq-a__inner p {
    margin: 0;
    padding: 0 26px 22px;
    font-size: 14.5px;
    line-height: 1.7;
    color: var(--v2-muted);
  }
  .sv-faq-a__inner :global(a) {
    color: var(--v2-blue);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ===== CTA ===== */
  .sv-cta {
    padding: 80px 0 96px;
  }
  .sv-cta__box {
    background: linear-gradient(135deg, #0c1633 0%, #102a63 100%);
    color: #fff;
    border-radius: var(--v2-r-lg);
    padding: 64px 48px;
    text-align: center;
  }
  .sv-cta__title {
    font-size: clamp(28px, 4vw, 38px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    font-weight: 800;
    margin: 0;
    text-wrap: balance;
  }
  .sv-cta__sub {
    font-size: 16px;
    line-height: 1.65;
    color: #a9b4cc;
    max-width: 520px;
    margin: 18px auto 0;
  }
  .sv-cta__actions {
    display: flex;
    justify-content: center;
    margin-top: 30px;
  }

  /* ===== Responsive ===== */
  @media (max-width: 900px) {
    .sv-hero__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .sv-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 640px) {
    .sv-services {
      padding: 64px 0;
    }
    .sv-grid {
      grid-template-columns: 1fr;
    }
    .sv-support {
      padding: 28px 24px;
    }
    .sv-faq__inner {
      padding: 64px 20px;
    }
    .sv-cta__box {
      padding: 48px 24px;
    }
  }
</style>

<script>
  // Acordeon single-open pentru FAQ-ul paginii /servicii (varianta B).
  document.querySelectorAll<HTMLElement>('.sv-faq__list').forEach((list) => {
    const items = Array.from(list.querySelectorAll<HTMLElement>('.sv-faq-item'));
    items.forEach((item) => {
      const btn = item.querySelector<HTMLButtonElement>('.sv-faq-q');
      btn?.addEventListener('click', () => {
        const isOpen = item.classList.contains('is-open');
        items.forEach((other) => {
          other.classList.remove('is-open');
          other.querySelector('.sv-faq-q')?.setAttribute('aria-expanded', 'false');
        });
        if (!isOpen) {
          item.classList.add('is-open');
          btn.setAttribute('aria-expanded', 'true');
        }
      });
    });
  });
</script>
