---
import BaseLayout from '@layouts/BaseLayout.astro';
import CtaSection from '@components/sections/CtaSection.astro';
import Button from '@components/ui/Button.astro';
import Logo from '@components/ui/Logo.astro';

export const prerender = false;

const metaDescription =
  'Simplead e un studio mic de grafică și marketing digital. Suntem doi, Andrei (doctor în marketing) și Gabriel, plus colaboratori la nevoie. Pornim de la cum decid oamenii, nu de la presupuneri.';

// Iconițe (inner SVG, stroke).
const ICON = {
  eye: '<path d="M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>',
  shield:
    '<path d="M12 3l8 3v6c0 4.5-3.2 7.8-8 9-4.8-1.2-8-4.5-8-9V6l8-3z"/><path d="M9 12l2 2 4-4"/>',
  star: '<path d="M12 3l2.7 5.5 6 .9-4.3 4.2 1 6-5.4-2.8L6.6 19.6l1-6L3.3 9.4l6-.9z"/>',
};

// Logo-uri reale de clienți/parteneri (descărcate local în public/parteneri).
const clients = [
  { src: '/parteneri/feaa-galati.png', name: 'FEAA Galați', w: 1057, h: 216 },
  { src: '/parteneri/m1-med-beauty.png', name: 'M1 Med Beauty', w: 278, h: 63 },
  { src: '/parteneri/matematica-interactiva.png', name: 'Matematica Interactivă', w: 2084, h: 687 },
  { src: '/parteneri/priority-clinic.png', name: 'Priority Clinic', w: 1402, h: 183 },
  { src: '/parteneri/simona-halep.png', name: 'Hotel Simona Halep', w: 852, h: 275 },
  { src: '/parteneri/fastrackids.webp', name: 'FasTrackKids', w: 1558, h: 382 },
  { src: '/parteneri/roll-shape.png', name: 'Roll Shape', w: 1485, h: 797 },
  { src: '/parteneri/premium-stone.png', name: 'Premium Stone', w: 785, h: 116 },
  { src: '/parteneri/georgiana-ungureanu.png', name: 'Georgiana Ungureanu', w: 878, h: 85 },
  { src: '/parteneri/ichb.png', name: 'ICHB', w: 781, h: 218 },
  { src: '/parteneri/isor.png', name: 'ISOR', w: 268, h: 86 },
  { src: '/parteneri/florin-pasat.png', name: 'Florin Pasat', w: 300, h: 101 },
];
---

<BaseLayout title="Despre" description={metaDescription} transparentNav={true}>
  {/* ===== HERO editorial: cei doi oameni ===== */}
  <section class="dh-hero">
    <div class="dh-hero__bg" aria-hidden="true"></div>
    <div class="dh-hero__wash" aria-hidden="true"></div>

    <div class="site-container dh-hero__inner">
      <p class="dh-hero__eyebrow">Despre noi</p>
      <h1 class="dh-hero__title">
        Doi oameni care îți tratează proiectul <span class="g">ca pe-al lor.</span>
      </h1>
      <p class="dh-hero__sub">
        Studio mic de grafică și marketing digital, nu o agenție cu zeci de oameni. Lucrezi direct
        cu noi, de la prima discuție până la final.
      </p>

      <div class="dh-duo" data-reveal>
        <div class="dh-duo__person">
          <b>Andrei Panait</b>
          <span>Strategie, web & cercetare</span>
        </div>
        <span class="dh-duo__plus" aria-hidden="true">/</span>
        <div class="dh-duo__person">
          <b>Gabriel Tulearca</b>
          <span>Grafică, marketing & social</span>
        </div>
      </div>

      <div class="dh-hero__cta">
        <Button href="/contact" variant="primary" size="lg">Hai să discutăm</Button>
        <a class="dh-hero__link" href="/portofoliu">Vezi portofoliu</a>
      </div>
    </div>
  </section>

  {/* ===== Povestea: 2 coloane (text | panou logo) ===== */}
  <section class="section section--tint dh-story-sec">
    <div class="container">
      <div class="dh-story-grid">
        <div class="dh-story-copy" data-reveal>
          <p class="dh-story-eyebrow">Povestea</p>
          <h2 class="sec-title">De ce există <span class="g">Simplead</span></h2>
          <p>
            Am început să fac grafică încă din liceu. Colegii și primii mei colaboratori veneau mereu
            cu cereri: un afiș, un logo, un material pentru promovare. Și de fiecare dată procesul era
            mult mai complicat decât trebuia, pentru un rezultat care putea fi simplu și folositor.
          </p>
          <p>
            De-acolo a pornit Simplead: din dorința de a face lucrurile mai simple și mai utile. Am
            deschis firma cu ajutorul unei finanțări europene și de-atunci am mers mai departe,
            proiect cu proiect.
          </p>
          <div class="dh-story-stats">
            <div><b>[confirmă]</b><span>ani de lucru</span></div>
            <div><b>[confirmă]</b><span>proiecte</span></div>
          </div>
        </div>

        <aside class="dh-logo-panel" data-reveal>
          <Logo height={60} color="#fff" />
          <span class="dh-logo-panel__cap">Pornit cu o finanțare europeană</span>
        </aside>
      </div>
    </div>
  </section>

  {/* ===== Metoda: manifesto + citat mare ===== */}
  <section class="section section--light ab-pattern dh-method-sec">
    <div class="container">
      <div class="dh-manifesto" data-reveal>
        <h2 class="sec-title center">Mai puțin noroc, <span class="g">mai multă metodă.</span></h2>
        <div class="dh-manifesto__lead">
          <p>
            Cele mai multe mesaje de marketing nu dau greș din cauza bugetului mic. Dau greș fiindcă
            deciziile se iau pe „mie îmi place" sau pe ce zic oamenii într-un chestionar. Și oamenii
            nu prea cumpără cum spun: cele mai multe decizii se iau repede și emoțional, înainte ca
            rațiunea să intre în joc.
          </p>
          <p>
            De-aia pornim de la cum decid oamenii cu adevărat, nu de la presupuneri. Asta intră în
            alegeri concrete de pe proiectul tău: ce vede omul întâi, cum simte pagina în primele
            secunde, ce îl face să aibă încredere și să acționeze.
          </p>
        </div>

        <figure class="dh-quote-card">
          <blockquote>
            Nu avem un buton magic și nici nu promitem ceva ce nu putem livra. Ne bazăm pe date,
            procesăm informațiile și îmbunătățim acolo unde este nevoie să intervenim.
          </blockquote>
        </figure>
      </div>
    </div>
  </section>

  {/* ===== Cei doi: 2 coloane (text | carduri) ===== */}
  {
    /* TODO: înlocuiește monogramul lui Gabriel cu fotografia reală când e disponibilă. */
  }
  <section class="section section--tint team-section">
    <div class="container">
      <div class="about2">
        <div class="about2__story" data-reveal>
          <h2 class="sec-title">
            Suficient de mici cât să ne pese.
            <span class="g">Suficient de buni cât să ducem treaba la capăt.</span>
          </h2>
          <p>
            Lucrăm direct pe proiectele clienților, fără să pasăm la juniori și fără să dispărem după
            ce semnăm. Eu mă ocup de strategie, web și partea de cercetare. Gabriel a preluat grafica
            de la mine și ține design-ul, strategiile de marketing și social media. Când e nevoie de
            foto, video sau dezvoltare specializată, chemăm colaboratori cu care lucrăm de ani de
            zile și în care avem încredere.
          </p>
          <p>
            Așa, ai mereu cu cine vorbi direct, nu se pierde informație între departamente și tot ce
            livrăm a trecut prin aceleași mâini, de la brief până la final.
          </p>
          <p>
            Lucrăm cu afaceri mici și medii din România, dar și cu clienți din afara țării care vor
            un partener serios.
          </p>
        </div>

        <div class="about2__team" data-reveal>
          <div class="team">
            <article class="team-card">
              <div class="team-photo" style="background:#eef1f8;">
                <img
                  src="/andrei.webp"
                  alt="Andrei Alexandru Panait"
                  width="640"
                  height="640"
                  loading="lazy"
                />
              </div>
              <b>Andrei Alexandru Panait</b>
              <span class="team-role">Fondator</span>
              <p class="team-bio">
                Strategie, web și cercetare. Doctor în marketing, cu cercetare în neuromarketing.
              </p>
            </article>
            <article class="team-card">
              <div class="team-photo team-photo--mono" style="background:#ece7f6;">
                <span>GT</span>
              </div>
              <b>Gabriel Tulearca</b>
              <span class="team-role">Grafică, marketing &amp; social media</span>
              <p class="team-bio">Doctorand în marketing.</p>
            </article>
          </div>
        </div>
      </div>
    </div>
  </section>

  {/* ===== Dovada: lead + citat mare + bandă de logo-uri ===== */}
  <section class="section section--light dh-proof-sec">
    <div class="container">
      <div class="dh-proof__head" data-reveal>
        <h2 class="sec-title center">
          Afaceri mici, instituții, <span class="g">proiecte din mai multe domenii.</span>
        </h2>
        <p class="dh-proof__lead">
          Am lucrat cu afaceri la început de drum și cu instituții mari: FEAA Galați, Universitatea
          „Dunărea de Jos", plus clienți din sănătate și beauty, educație, brand personal și
          business. Peste 20 de site-uri construite de noi sunt și azi online, în patru domenii
          diferite. Fiecare a primit aceeași atenție, indiferent de buget.
        </p>
      </div>

      <figure class="dh-quote" data-reveal>
        <blockquote>„Simply professional. Trustworthy, honest and creative.”</blockquote>
        <figcaption><b>Bogdan Drăgan</b><span>FEAA Galați</span></figcaption>
      </figure>

      <div class="dh-logos" data-reveal>
        {
          clients.map((c) => (
            <span class="ab-logo">
              <img src={c.src} alt={c.name} width={c.w} height={c.h} loading="lazy" />
            </span>
          ))
        }
      </div>
    </div>
  </section>

  {/* ===== Colaborări lungi: 2 coloane (text+cifre | parteneri), dark ===== */}
  <section class="section trust">
    <span class="trust__glow" aria-hidden="true"></span>
    <div class="container">
      <div class="trust__grid">
        <div class="trust__copy" data-reveal>
          <h2 class="trust__title">
            Relații care țin de ani, <span class="g">nu de luni</span>
          </h2>
          <p class="trust__sub">
            Unii clienți sunt cu noi de <b>[confirmă: ani]</b>. Doi parteneri principali,
            <b>Marketing Deck</b> și <b>M1 Med Beauty</b>, ne trimit constant proiecte noi, fiindcă
            rezultatele se văd în timp.
          </p>
          <div class="trust__stats">
            <div><b>[confirmă]</b><span>ani, cea mai lungă colaborare</span></div>
            <div><b>2</b><span>parteneri principali</span></div>
          </div>
        </div>

        <div class="trust__partners" data-reveal>
          <span class="trust__label">Parteneri principali</span>
          <a
            class="trust__card"
            href="https://marketingdeck.com/?utm_source=simplead.ro&utm_medium=referral&utm_campaign=parteneri-simplead"
            target="_blank"
            rel="noopener"
          >
            <b>Marketing Deck</b>
            <span>
              Vezi site-ul
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"><path d="M7 17L17 7M9 7h8v8"></path></svg
              >
            </span>
          </a>
          <a
            class="trust__card"
            href="https://m1-beauty.com/?utm_source=simplead.ro&utm_medium=referral&utm_campaign=parteneri-simplead"
            target="_blank"
            rel="noopener"
          >
            <b>M1 Med Beauty</b>
            <span>
              Vezi site-ul
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"><path d="M7 17L17 7M9 7h8v8"></path></svg
              >
            </span>
          </a>
        </div>
      </div>
    </div>
  </section>

  {/* ===== Valori: 3-up ===== */}
  <section class="section section--light ab-pattern ab-beliefs">
    <div class="container">
      <h2 class="sec-title center" data-reveal>
        Câteva lucruri în care <span class="g">credem.</span>
      </h2>
      <div class="beliefs" data-reveal-stagger>
        <article class="belief">
          <span class="belief__ic" set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">${ICON.eye}</svg>`} />
          <h3>Un client informat e un client mai bun</h3>
          <p>Îți explicăm ce primești și de ce, fără jargon. Deciziile bune se iau cu lucrurile pe masă.</p>
        </article>
        <article class="belief">
          <span class="belief__ic" set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">${ICON.shield}</svg>`} />
          <h3>Onestitatea de la început costă mai puțin</h3>
          <p>Inclusiv un „asta nu e specialitatea noastră" spus din start, în loc de o dezamăgire la final.</p>
        </article>
        <article class="belief">
          <span class="belief__ic" set:html={`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">${ICON.star}</svg>`} />
          <h3>Un proiect mic, tratat serios</h3>
          <p>Face mai mult decât un proiect mare tratat ca un simplu număr de factură.</p>
        </article>
      </div>
    </div>
  </section>

  <CtaSection
    kicker="Hai să începem"
    title="Vrei să lucrăm împreună?"
    subtitle="Spune-ne în câteva cuvinte cu ce te putem ajuta. Îți răspundem noi, oameni, la fiecare mesaj."
    href="/contact"
    cta="Hai să discutăm"
    secondaryHref="/portofoliu"
    secondaryLabel="Vezi portofoliu"
  />
</BaseLayout>

<style>
  /* ===================== HERO editorial ===================== */
  .dh-hero {
    position: relative;
    overflow: hidden;
    background: var(--canvas);
    padding-top: calc(var(--nav-h) + clamp(40px, 7vw, 96px));
    padding-bottom: clamp(48px, 7vw, 92px);
  }
  .dh-hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image:
      linear-gradient(to right, rgba(3, 13, 74, 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(3, 13, 74, 0.035) 1px, transparent 1px);
    background-size: 40px 40px;
    -webkit-mask-image: linear-gradient(180deg, #000 0%, rgba(0, 0, 0, 0.3) 42%, transparent 72%);
    mask-image: linear-gradient(180deg, #000 0%, rgba(0, 0, 0, 0.3) 42%, transparent 72%);
    pointer-events: none;
  }
  .dh-hero__wash {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: radial-gradient(52% 40% at 50% -8%, rgba(0, 119, 252, 0.08), transparent 70%);
    pointer-events: none;
  }
  .dh-hero__inner {
    position: relative;
    z-index: 1;
    max-width: 1080px;
    margin-inline: auto;
    text-align: center;
  }
  .dh-hero__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--electric);
  }
  .dh-hero__title {
    margin: 18px auto 0;
    max-width: 26ch;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.4rem, 5.2vw, 4.2rem);
    line-height: 1.04;
    letter-spacing: -0.025em;
    color: var(--ink);
    text-wrap: balance;
  }
  .dh-hero__title .g {
    color: var(--electric);
  }
  .dh-hero__sub {
    margin: 22px auto 0;
    max-width: 70ch;
    font-size: clamp(1.0625rem, 1.4vw, 1.18rem);
    line-height: 1.6;
    color: var(--muted);
  }

  /* semnătura „doi oameni" */
  .dh-duo {
    margin-top: 36px;
    display: inline-flex;
    align-items: center;
    gap: clamp(20px, 4vw, 44px);
    padding: 18px clamp(22px, 4vw, 36px);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: #fff;
    box-shadow: var(--sh-sm);
  }
  .dh-duo__person b {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.05rem, 1.8vw, 1.3rem);
    color: var(--ink);
  }
  .dh-duo__person span {
    display: block;
    margin-top: 3px;
    font-size: 0.84rem;
    color: var(--muted);
  }
  .dh-duo__plus {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    line-height: 1;
    color: var(--cyan);
  }

  .dh-hero__cta {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 22px;
  }
  .dh-hero__link {
    font-weight: 700;
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: var(--line);
    transition: text-decoration-color 0.2s var(--ease-snap);
  }
  .dh-hero__link:hover {
    text-decoration-color: var(--electric);
  }

  /* ===================== Pattern comun + utilitare ===================== */
  .ab-pattern {
    position: relative;
    overflow: hidden;
  }
  .ab-pattern::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image:
      linear-gradient(rgba(3, 13, 74, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(3, 13, 74, 0.045) 1px, transparent 1px);
    background-size: 54px 54px;
    -webkit-mask-image: radial-gradient(72% 72% at 82% 8%, #000 0%, transparent 68%);
    mask-image: radial-gradient(72% 72% at 82% 8%, #000 0%, transparent 68%);
    pointer-events: none;
  }
  .ab-pattern > .container {
    position: relative;
    z-index: 1;
  }
  .sec-title.center {
    text-align: center;
  }

  /* ===================== Povestea (2 coloane text | logo) ===================== */
  .dh-story-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(36px, 5vw, 72px);
    align-items: center;
  }
  .dh-story-copy {
    min-width: 0;
  }
  .dh-story-eyebrow {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--electric);
    margin-bottom: 12px;
  }
  .dh-story-copy p {
    margin-top: 16px;
    font-size: 1.06rem;
    line-height: 1.7;
    color: var(--muted);
  }
  .dh-story-stats {
    margin-top: 28px;
    display: flex;
    gap: 16px;
  }
  .dh-story-stats div {
    padding: 14px 24px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    box-shadow: var(--sh-sm);
  }
  .dh-story-stats b {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.8rem;
    line-height: 1;
    color: var(--electric);
  }
  .dh-story-stats span {
    display: block;
    margin-top: 6px;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .dh-logo-panel {
    position: relative;
    overflow: hidden;
    display: grid;
    place-items: center;
    gap: 22px;
    min-height: 300px;
    padding: clamp(36px, 5vw, 56px);
    border-radius: var(--r-xl);
    background: linear-gradient(135deg, var(--navy), var(--ink));
    box-shadow: var(--sh-lg);
    text-align: center;
  }
  .dh-logo-panel::after {
    content: '';
    position: absolute;
    right: -60px;
    bottom: -60px;
    width: 220px;
    height: 220px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(110, 91, 224, 0.4), transparent 70%);
    pointer-events: none;
  }
  .dh-logo-panel > * {
    position: relative;
    z-index: 1;
  }
  .dh-logo-panel__cap {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.62);
  }

  /* ===================== Metoda (manifesto + citat mare) ===================== */
  .dh-manifesto {
    max-width: 820px;
    margin-inline: auto;
    text-align: center;
  }
  .dh-manifesto__lead {
    margin-top: 22px;
    text-align: left;
  }
  .dh-manifesto__lead p {
    margin-top: 14px;
    font-size: 1.06rem;
    line-height: 1.68;
    color: var(--muted);
  }
  .dh-quote-card {
    position: relative;
    overflow: hidden;
    margin: clamp(30px, 4vw, 46px) auto 0;
    max-width: 720px;
    padding: clamp(24px, 3vw, 38px) clamp(28px, 4vw, 48px);
    border-radius: var(--r-xl);
    background: linear-gradient(135deg, var(--navy), var(--ink));
    box-shadow: var(--sh-lg);
    text-align: center;
  }
  .dh-quote-card::after {
    content: '';
    position: absolute;
    left: -70px;
    bottom: -70px;
    width: 240px;
    height: 240px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(110, 91, 224, 0.4), transparent 70%);
    pointer-events: none;
  }
  .dh-quote-card blockquote {
    position: relative;
    z-index: 1;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.1rem, 1.9vw, 1.4rem);
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: #fff;
    text-wrap: balance;
  }

  /* ===================== Cei doi (2 coloane: text | carduri) ===================== */
  .team-section {
    position: relative;
    overflow: hidden;
  }
  .team-section::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image:
