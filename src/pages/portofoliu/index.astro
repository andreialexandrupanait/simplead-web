---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/sections/PageHeader.astro';
import PortfolioPageGrid from '@components/sections/PortfolioPageGrid.astro';
import CtaSection from '@components/sections/CtaSection.astro';

const projects = (await getCollection('portfolio', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<BaseLayout
  title="Portofoliu"
  description="Proiecte de care suntem mândri: branding, magazine online și campanii de marketing din Galați și nu numai."
  transparentNav={true}
  navOverDark={true}
>
  <PageHeader
    crumb={[{ label: 'Acasă', href: '/' }, { label: 'Portofoliu' }]}
    eyebrow="Portofoliu"
    title="Proiecte de care suntem mândri"
    accent="mândri"
    subtitle="De la branding și magazine online, până la campanii de admitere universitară. Iată o parte din ce am construit."
  />

  <PortfolioPageGrid projects={projects} />

  <CtaSection href="/contact" />
</BaseLayout>
