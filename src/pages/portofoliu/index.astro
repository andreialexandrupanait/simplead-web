---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/sections/PageHeader.astro';
import PortfolioPageGrid from '@components/sections/PortfolioPageGrid.astro';
import CtaSection from '@components/sections/CtaSection.astro';
import { getPublishedProjects } from '@lib/server/content';
import { breadcrumbLd, itemListLd } from '@/lib/seo-schema';

// Proiectele vin din DB (editate în /admin) — on-demand, publicare instant.
export const prerender = false;

const projects = await getPublishedProjects();

const origin = (Astro.site ?? new URL(Astro.url.origin)).toString().replace(/\/$/, '');
const pageSchema = [
  breadcrumbLd(origin, [{ label: 'Acasă', href: '/' }, { label: 'Portofoliu' }]),
  itemListLd(
    origin,
    projects.map((p) => ({ name: p.title, url: `/portofoliu/${p.slug}` })),
  ),
];
---

<BaseLayout
  title="Portofoliu"
  description="Proiecte de care suntem mândri: branding, magazine online și grafică publicitară din Galați și nu numai."
  ogImage="/api/og/portofoliu.png"
  transparentNav={true}
  navOverDark={true}
  schema={pageSchema}
>
  <PageHeader
    crumb={[{ label: 'Acasă', href: '/' }, { label: 'Portofoliu' }]}
    eyebrow="Portofoliu"
    title="Proiecte de care suntem mândri"
    accent="mândri"
    subtitle="De la branding și magazine online, până la grafică publicitară și identitate de brand. Iată o parte din ce am construit."
  />

  <PortfolioPageGrid projects={projects} />

  <CtaSection href="/contact" />
</BaseLayout>
