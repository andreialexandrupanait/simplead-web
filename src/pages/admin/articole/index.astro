---
import { and, count, desc, eq, ilike, or, type SQL } from 'drizzle-orm';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHeader from '../../../components/admin/PageHeader.astro';
import StatusBadge from '../../../components/admin/StatusBadge.astro';
import EmptyState from '../../../components/admin/EmptyState.astro';
import Pagination from '../../../components/admin/Pagination.astro';
import { getDb } from '../../../lib/server/db';
import { posts } from '../../../lib/server/schema';
import { readingMinutes } from '../../../lib/server/markdown';

export const prerender = false;

const db = getDb();
const PER_PAGE = 20;

const q = Astro.url.searchParams.get('q')?.trim() ?? '';
const filter = Astro.url.searchParams.get('status') ?? '';
const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);

const conditions: SQL[] = [];
if (filter === 'draft' || filter === 'published') conditions.push(eq(posts.status, filter));
if (q) {
  const like = `%${q}%`;
  conditions.push(or(ilike(posts.title, like), ilike(posts.body, like))!);
}
const where = conditions.length ? and(...conditions) : undefined;

let rows: (typeof posts.$inferSelect)[] = [];
let total = 0;
let publishedCount = 0;
let draftCount = 0;
let dbError = false;

if (db) {
  try {
    const [data, [{ n }], [pub], [dra]] = await Promise.all([
      db
        .select()
        .from(posts)
        .where(where)
        .orderBy(desc(posts.updatedAt))
        .limit(PER_PAGE)
        .offset((page - 1) * PER_PAGE),
      db.select({ n: count() }).from(posts).where(where),
      db.select({ n: count() }).from(posts).where(eq(posts.status, 'published')),
      db.select({ n: count() }).from(posts).where(eq(posts.status, 'draft')),
    ]);
    rows = data;
    total = n;
    publishedCount = pub.n;
    draftCount = dra.n;
  } catch (err) {
    console.warn('[admin] Listarea articolelor a eșuat:', err);
    dbError = true;
  }
}

const totalPages = Math.max(1, Math.ceil(total / PER_PAGE));
const dateFmt = new Intl.DateTimeFormat('ro-RO', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});
const chipUrl = (status: string) => {
  const u = new URL(Astro.url);
  u.searchParams.delete('page');
  if (status) u.searchParams.set('status', status);
  else u.searchParams.delete('status');
  return u.pathname + u.search;
};
---

<AdminLayout title="Articole">
  <PageHeader title="Articole" sub="Blogul site-ului: publicarea e instant, fără rebuild.">
    <a href="/blog" target="_blank" class="admin-btn admin-btn--ghost">Vezi blogul ↗</a>
    <a href="/admin/articole/nou" class="admin-btn">+ Articol nou</a>
  </PageHeader>

  {
    !db && (
      <div class="admin-banner admin-banner--warn">
        <strong>Fără bază de date.</strong> Articolele nu pot fi editate.
      </div>
    )
  }
  {
    dbError && (
      <div class="admin-banner admin-banner--error">Conexiunea la baza de date a eșuat.</div>
    )
  }

  {
    db && !dbError && (
      <>
        <div class="admin-toolbar">
          <div class="admin-count-chips">
            <a href={chipUrl('')} class:list={[!filter && 'is-active']}>
              Toate ({publishedCount + draftCount})
            </a>
            <a href={chipUrl('published')} class:list={[filter === 'published' && 'is-active']}>
              Publicate ({publishedCount})
            </a>
            <a href={chipUrl('draft')} class:list={[filter === 'draft' && 'is-active']}>
              Drafturi ({draftCount})
            </a>
          </div>
          <span class="admin-toolbar__spacer" />
          <form method="get" class="admin-toolbar__search" style="max-width:320px">
            {filter && <input type="hidden" name="status" value={filter} />}
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
            >
              <circle cx="11" cy="11" r="8" />
              <path d="m21 21-4.3-4.3" />
            </svg>
            <input
              class="admin-input"
              type="search"
              name="q"
              value={q}
              placeholder="Caută în titluri și conținut…"
              autocomplete="off"
            />
          </form>
        </div>

        <div class="admin-card admin-card--flush">
          {rows.length === 0 ? (
            <EmptyState
              title="Niciun articol găsit"
              hint={
                q || filter
                  ? 'Încearcă altă căutare sau alt filtru.'
                  : 'Scrie primul articol: blogul e principalul canal de SEO.'
              }
              actionLabel={q || filter ? undefined : 'Articol nou'}
              actionHref={q || filter ? undefined : '/admin/articole/nou'}
            />
          ) : (
            <div class="post-list">
              {rows.map((post) => (
                <div class="post-row">
                  <a
                    class="post-row__thumb"
                    href={`/admin/articole/${post.id}`}
                    aria-hidden="true"
                    tabindex="-1"
                  >
                    {post.cover ? (
                      <img src={post.cover} alt="" loading="lazy" />
                    ) : (
                      <span>fără copertă</span>
                    )}
                  </a>
                  <div class="post-row__main">
                    <div class="post-row__title">
                      <a href={`/admin/articole/${post.id}`}>{post.title}</a>
                      <StatusBadge status={post.status} />
                    </div>
                    {post.description && <p class="post-row__desc">{post.description}</p>}
                    <div class="post-row__meta">
                      <span>
                        {post.status === 'published' && post.publishedAt
                          ? `Publicat ${dateFmt.format(post.publishedAt)}`
                          : `Modificat ${dateFmt.format(post.updatedAt)}`}
                      </span>
                      <span>·</span>
                      <span>~{readingMinutes(post.body)} min de citit</span>
                      {post.tags.slice(0, 3).map((t) => (
                        <span class="chip">{t}</span>
                      ))}
                    </div>
                  </div>
                  <div class="post-row__actions">
                    <a
                      class="admin-btn admin-btn--ghost admin-btn--sm"
                      href={`/admin/articole/${post.id}`}
                    >
                      Editează
                    </a>
                    <a
                      class="admin-btn admin-btn--ghost admin-btn--sm"
                      href={
                        post.status === 'published'
                          ? `/blog/${post.slug}`
                          : `/blog/${post.slug}?preview=1`
                      }
                      target="_blank"
                      rel="noopener"
                    >
                      Vezi ↗
                    </a>
                  </div>
                </div>
              ))}
            </div>
          )}
        </div>
        <Pagination page={page} totalPages={totalPages} totalItems={total} url={Astro.url} />
      </>
    )
  }
</AdminLayout>
