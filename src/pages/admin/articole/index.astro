---
import { and, count, desc, eq, ilike, or, type SQL } from 'drizzle-orm';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Toolbar from '../../../components/admin/Toolbar.astro';
import StatusBadge from '../../../components/admin/StatusBadge.astro';
import EmptyState from '../../../components/admin/EmptyState.astro';
import Pagination from '../../../components/admin/Pagination.astro';
import { getDb } from '../../../lib/server/db';
import { posts } from '../../../lib/server/schema';

export const prerender = false;

const db = getDb();
const PER_PAGE = 20;

const q = Astro.url.searchParams.get('q')?.trim() ?? '';
const filter = Astro.url.searchParams.get('status') ?? '';
const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);

const conditions: SQL[] = [];
if (filter === 'draft' || filter === 'published') conditions.push(eq(posts.status, filter));
if (q) {
  const like = `%${q}%`;
  conditions.push(or(ilike(posts.title, like), ilike(posts.body, like))!);
}
const where = conditions.length ? and(...conditions) : undefined;

let rows: (typeof posts.$inferSelect)[] = [];
let total = 0;
let dbError = false;

if (db) {
  try {
    const [data, [{ n }]] = await Promise.all([
      db
        .select()
        .from(posts)
        .where(where)
        .orderBy(desc(posts.updatedAt))
        .limit(PER_PAGE)
        .offset((page - 1) * PER_PAGE),
      db.select({ n: count() }).from(posts).where(where),
    ]);
    rows = data;
    total = n;
  } catch (err) {
    console.warn('[admin] Listarea articolelor a eșuat:', err);
    dbError = true;
  }
}

const totalPages = Math.max(1, Math.ceil(total / PER_PAGE));
const dateFmt = new Intl.DateTimeFormat('ro-RO', { dateStyle: 'medium' });
---

<AdminLayout title="Articole">
  <div class="admin-page-head">
    <div>
      <h1>Articole</h1>
      <p class="admin-sub">
        Blogul site-ului — publicarea e instant, fără rebuild.
        <a href="/blog" target="_blank" style="color:var(--electric)">Vezi blogul ↗</a>
      </p>
    </div>
    <a href="/admin/articole/nou" class="admin-btn">+ Articol nou</a>
  </div>

  {
    !db && (
      <div class="admin-banner admin-banner--warn">
        <strong>Fără bază de date.</strong> Articolele nu pot fi editate.
      </div>
    )
  }
  {dbError && <div class="admin-banner admin-banner--error">Conexiunea la baza de date a eșuat.</div>}

  {
    db && !dbError && (
      <>
        <Toolbar searchPlaceholder="Caută în titluri și conținut…" q={q}>
          <select class="admin-select" name="status" data-autosubmit>
            <option value="">Toate</option>
            <option value="published" selected={filter === 'published'}>Publicate</option>
            <option value="draft" selected={filter === 'draft'}>Drafturi</option>
          </select>
        </Toolbar>

        <div class="admin-card admin-card--flush">
          {rows.length === 0 ? (
            <EmptyState
              title="Niciun articol găsit"
              hint={
                q || filter
                  ? 'Încearcă altă căutare sau alt filtru.'
                  : 'Scrie primul articol — blogul e principalul canal de SEO.'
              }
              actionLabel={q || filter ? undefined : 'Articol nou'}
              actionHref={q || filter ? undefined : '/admin/articole/nou'}
            />
          ) : (
            <div class="admin-table-wrap">
              <table class="admin-table">
                <thead>
                  <tr>
                    <th>Titlu</th>
                    <th>Taguri</th>
                    <th>Status</th>
                    <th>Publicat</th>
                    <th>Actualizat</th>
                  </tr>
                </thead>
                <tbody>
                  {rows.map((post) => (
                    <tr>
                      <td>
                        <a class="admin-row-link" href={`/admin/articole/${post.id}`}>
                          {post.title}
                        </a>
                        <br />
                        <small style="color:var(--muted)">/blog/{post.slug}</small>
                      </td>
                      <td style="color:var(--muted)">{post.tags.join(', ') || '–'}</td>
                      <td>
                        <StatusBadge status={post.status} />
                      </td>
                      <td style="white-space:nowrap">
                        {post.publishedAt ? dateFmt.format(post.publishedAt) : '–'}
                      </td>
                      <td style="white-space:nowrap">{dateFmt.format(post.updatedAt)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>
        <Pagination page={page} totalPages={totalPages} totalItems={total} url={Astro.url} />
      </>
    )
  }
</AdminLayout>
