---
import AuthLayout from '../../layouts/AuthLayout.astro';
import AuthAside from '../../components/ui/AuthAside.astro';
import Logo from '../../components/ui/Logo.astro';
import ForgotPasswordForm from '../../components/react/ForgotPasswordForm.tsx';

export const prerender = false;
---

<AuthLayout title="Recuperare parolă">
  <div class="auth-shell">
    <AuthAside
      title="Ai uitat parola?"
      text="Îți trimitem un link de resetare pe email. În câteva minute ești din nou în cont."
    />
    <main class="auth-main">
      <div class="auth-form-wrap">
        <div class="auth-brand">
          <Logo height={30} />
        </div>
        <ForgotPasswordForm client:load />
      </div>
    </main>
  </div>
</AuthLayout>
