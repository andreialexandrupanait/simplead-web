---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { setFlash } from '../../lib/server/flash';
import {
  getPublicSettings,
  saveTrackingSettings,
  type TrackingSettings,
} from '../../lib/server/public-settings';

export const prerender = false;

let saveError: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const data: TrackingSettings = {
    gtmId: String(form.get('gtmId') ?? ''),
    ga4Id: String(form.get('ga4Id') ?? ''),
    clarityId: String(form.get('clarityId') ?? ''),
    metaPixelId: String(form.get('metaPixelId') ?? ''),
    tiktokPixelId: String(form.get('tiktokPixelId') ?? ''),
    gscVerification: String(form.get('gscVerification') ?? ''),
  };
  const result = await saveTrackingSettings(data);
  if (result.ok) {
    setFlash(Astro.cookies, { kind: 'ok', msg: 'ID-urile de tracking au fost salvate.' });
    return Astro.redirect('/admin/tracking', 303);
  }
  saveError = result.error;
}

const t = (await getPublicSettings()).tracking;

const FIELDS: {
  name: keyof TrackingSettings;
  label: string;
  placeholder: string;
  hint: string;
}[] = [
  {
    name: 'gtmId',
    label: 'Google Tag Manager (container)',
    placeholder: 'GTM-XXXXXXX',
    hint: 'MOTORUL UNIC. Singurul care se încarcă direct în pagină. Toate tag-urile (GA4/Meta/TikTok/Clarity) rulează prin el, cu consimțământ la nivel de tag. Site-ul îi trimite evenimente în dataLayer.',
  },
  {
    name: 'ga4Id',
    label: 'Google Analytics 4',
    placeholder: 'G-XXXXXXXXXX',
    hint: 'Measurement ID. NU se mai încarcă direct — se folosește pentru a provisiona tag-ul GA4 în GTM (scripts/gtm-provision.mjs) și pentru tracking server-side.',
  },
  {
    name: 'metaPixelId',
    label: 'Meta (Facebook) Pixel',
    placeholder: '123456789012345',
    hint: 'Pixel ID din Meta Events Manager. Folosit pentru tag-ul Meta din GTM și pentru Conversions API (server-side). Nu se mai încarcă nativ.',
  },
  {
    name: 'tiktokPixelId',
    label: 'TikTok Pixel',
    placeholder: 'CXXXXXXXXXXXXXXXXX',
    hint: 'Pixel ID din TikTok Events Manager. Folosit pentru tag-ul TikTok din GTM. Nu se mai încarcă nativ.',
  },
  {
    name: 'clarityId',
    label: 'Microsoft Clarity',
    placeholder: 'xxxxxxxxxx',
    hint: 'Project ID pentru heatmaps + session recordings. Se adaugă ca tag în GTM (nu se mai încarcă nativ).',
  },
  {
    name: 'gscVerification',
    label: 'Google Search Console — verificare',
    placeholder: 'conținutul meta-tagului (fără <meta ...>)',
    hint: 'Din GSC → metoda „HTML tag": copiază DOAR valoarea content="..." (adăugăm noi meta-tagul în <head>).',
  },
];
---

<AdminLayout title="Tracking & analytics">
  <div class="admin-page-head">
    <div>
      <h1>Tracking & analytics</h1>
      <p class="admin-hint">
        ID-uri publice. Toate trackerele pornesc <strong
          >doar după acceptul din bannerul de cookies</strong
        > (GDPR). Lasă gol ce nu folosești.
      </p>
    </div>
  </div>

  {saveError && <div class="admin-banner admin-banner--error">{saveError}</div>}

  <div class="admin-banner">
    <strong>GTM e motorul unic.</strong> Doar containerul GTM se încarcă în pagină; GA4, Meta, TikTok
    și Clarity rulează ca tag-uri <em>în interiorul</em> GTM (cu consimțământ pe fiecare tag). Site-ul
    trimite evenimente în <code>dataLayer</code>: la conversii —
    <code>generate_lead</code> (contact/ofertă/tichet, pe /multumesc), <code>sign_up</code>
    (newsletter), <code>purchase</code> (după plata Stripe, pe /multumim) — plus evenimentele pe care
    le definești în <a href="/admin/evenimente">Evenimente</a>. ID-urile de mai jos hrănesc
    provizionarea GTM (<code>scripts/gtm-provision.mjs</code>) și tracking-ul server-side
    (Conversions API), nu se mai încarcă nativ.
  </div>

  <form method="post" style="max-width:640px">
    {
      FIELDS.map((f) => (
        <div class="admin-card" style="margin-top:16px">
          <label class="admin-field" style="margin-bottom:0">
            <span>{f.label}</span>
            <input
              class="admin-input"
              type="text"
              name={f.name}
              value={t[f.name]}
              placeholder={f.placeholder}
              autocomplete="off"
              spellcheck="false"
            />
            <small>{f.hint}</small>
          </label>
        </div>
      ))
    }
    <div class="admin-savebar">
      <button type="submit" class="admin-btn">Salvează</button>
    </div>
  </form>
</AdminLayout>
