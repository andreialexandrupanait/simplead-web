---
import { and, count, desc, eq, ilike, or, type SQL } from 'drizzle-orm';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Toolbar from '../../../components/admin/Toolbar.astro';
import StatusBadge from '../../../components/admin/StatusBadge.astro';
import EmptyState from '../../../components/admin/EmptyState.astro';
import Pagination from '../../../components/admin/Pagination.astro';
import PageHeader from '../../../components/admin/PageHeader.astro';
import { getDb } from '../../../lib/server/db';
import { leads, leadStatus } from '../../../lib/server/schema';

export const prerender = false;

const db = getDb();
const STATUSES = leadStatus.enumValues;
const PER_PAGE = 25;

const q = Astro.url.searchParams.get('q')?.trim() ?? '';
const filter = Astro.url.searchParams.get('status') ?? '';
const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);

const conditions: SQL[] = [];
if (filter && STATUSES.includes(filter as (typeof STATUSES)[number])) {
  conditions.push(eq(leads.status, filter as (typeof STATUSES)[number]));
}
if (q) {
  const like = `%${q}%`;
  conditions.push(
    or(ilike(leads.name, like), ilike(leads.email, like), ilike(leads.message, like))!,
  );
}
const where = conditions.length ? and(...conditions) : undefined;

let rows: (typeof leads.$inferSelect)[] = [];
let total = 0;
let dbError = false;

if (db) {
  try {
    const [data, [{ n }]] = await Promise.all([
      db
        .select()
        .from(leads)
        .where(where)
        .orderBy(desc(leads.createdAt))
        .limit(PER_PAGE)
        .offset((page - 1) * PER_PAGE),
      db.select({ n: count() }).from(leads).where(where),
    ]);
    rows = data;
    total = n;
  } catch (err) {
    console.warn('[admin] Listarea lead-urilor a eșuat:', err);
    dbError = true;
  }
}

const totalPages = Math.max(1, Math.ceil(total / PER_PAGE));
const dateFmt = new Intl.DateTimeFormat('ro-RO', { dateStyle: 'medium', timeStyle: 'short' });
const exportUrl = `/api/admin/export/leads.csv${Astro.url.search}`;
const STATUS_LABEL: Record<string, string> = {
  nou: 'Nou',
  contactat: 'Contactat',
  calificat: 'Calificat',
  castigat: 'Câștigat',
  pierdut: 'Pierdut',
};
---

<AdminLayout title="Lead-uri" wide>
  <PageHeader title="Lead-uri" sub="Mesajele primite prin formularul de contact." />

  {
    !db && (
      <div class="admin-banner admin-banner--warn">
        <strong>Fără bază de date.</strong> Lead-urile noi nu se salvează (rămân doar pe email).
      </div>
    )
  }
  {
    dbError && (
      <div class="admin-banner admin-banner--error">Conexiunea la baza de date a eșuat.</div>
    )
  }

  {
    db && !dbError && (
      <>
        <Toolbar searchPlaceholder="Caută după nume, email sau mesaj…" q={q}>
          <select class="admin-select" name="status" data-autosubmit>
            <option value="">Toate statusurile</option>
            {STATUSES.map((s) => (
              <option value={s} selected={filter === s}>
                {STATUS_LABEL[s]}
              </option>
            ))}
          </select>
          <a slot="actions" class="admin-btn admin-btn--ghost admin-btn--sm" href={exportUrl}>
            Export CSV
          </a>
        </Toolbar>

        <div class="admin-card admin-card--flush">
          {rows.length === 0 ? (
            <EmptyState
              title="Niciun lead găsit"
              hint={
                q || filter
                  ? 'Încearcă altă căutare sau alt filtru.'
                  : 'Lead-urile apar aici când cineva trimite formularul de contact.'
              }
            />
          ) : (
            <div class="admin-table-wrap">
              <table class="admin-table">
                <thead>
                  <tr>
                    <th>Contact</th>
                    <th>Serviciu</th>
                    <th>Mesaj</th>
                    <th>Primit</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  {rows.map((lead) => (
                    <tr>
                      <td>
                        <a class="admin-row-link" href={`/admin/leads/${lead.id}`}>
                          {lead.name}
                        </a>
                        <br />
                        <span class="u-sub">{lead.email}</span>
                      </td>
                      <td>{lead.service || '–'}</td>
                      <td class="u-muted" style="max-width:320px">
                        {lead.message.length > 90 ? `${lead.message.slice(0, 90)}…` : lead.message}
                      </td>
                      <td class="u-nowrap">{dateFmt.format(lead.createdAt)}</td>
                      <td>
                        <StatusBadge status={lead.status} />
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>
        <Pagination page={page} totalPages={totalPages} totalItems={total} url={Astro.url} />
      </>
    )
  }
</AdminLayout>
