---
import { and, asc, eq, ne } from 'drizzle-orm';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PackageForm from '../../../components/admin/PackageForm.astro';
import { getDb } from '../../../lib/server/db';
import { orders, packages } from '../../../lib/server/schema';
import {
  centsToPrice,
  featuresToInput,
  parseFeaturesInput,
  parsePackageForm,
  priceToCents,
} from '../../../lib/server/admin-schemas';

export const prerender = false;

const db = getDb();
const { id } = Astro.params;
if (!db || !id) return Astro.redirect('/admin/pachete', 302);

const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
if (!UUID_RE.test(id)) return Astro.redirect('/admin/pachete', 302);

type FormValues = {
  name: string;
  slug: string;
  kind: string;
  description: string;
  price: string;
  currency: string;
  interval: string;
  pricing: string;
  features: string;
  category: string;
  note: string;
  sort: number | string;
  active: boolean;
  otoPackageId: string;
  otoDiscountPercent: number | string;
};

let errors: Record<string, string[]> = {};
let saveError: string | null = null;
let formOverride: FormValues | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();

  if (form.get('action') === 'delete') {
    try {
      // Ștergere doar dacă nu există comenzi legate; altfel dezactivăm.
      const linked = await db.select().from(orders).where(eq(orders.packageId, id)).limit(1);
      if (linked.length === 0) {
        await db.delete(packages).where(eq(packages.id, id));
      } else {
        await db
          .update(packages)
          .set({ active: false, updatedAt: new Date() })
          .where(eq(packages.id, id));
      }
      return Astro.redirect('/admin/pachete', 303);
    } catch (err) {
      console.warn('[admin] Ștergerea pachetului a eșuat:', err);
      saveError = 'Ștergerea a eșuat. Încearcă din nou.';
    }
  } else {
    const parsed = parsePackageForm(form);
    if (!parsed.ok) {
      errors = parsed.errors;
      formOverride = {
        ...parsed.raw,
        sort: parsed.raw.sort,
        active: parsed.raw.active === 'true',
      };
    } else {
      try {
        const parsedFeatures = parseFeaturesInput(parsed.data.features);
        await db
          .update(packages)
          .set({
            name: parsed.data.name,
            slug: parsed.data.slug,
            kind: parsed.data.kind,
            description: parsed.data.description,
            priceCents: priceToCents(parsed.data.price),
            currency: parsed.data.currency,
            interval: parsed.data.interval,
            pricing: parsed.data.pricing,
            features: parsedFeatures.features,
            featureGroups: parsedFeatures.featureGroups,
            category: parsed.data.category,
            note: parsed.data.note,
            sort: parsed.data.sort,
            active: parsed.data.active,
            // Un pachet nu poate fi propriul OTO.
            otoPackageId:
              parsed.data.otoPackageId && parsed.data.otoPackageId !== id
                ? parsed.data.otoPackageId
                : null,
            otoDiscountPercent: parsed.data.otoDiscountPercent,
            updatedAt: new Date(),
          })
          .where(eq(packages.id, id));
        return Astro.redirect('/admin/pachete', 303);
      } catch (err) {
        console.warn('[admin] Actualizarea pachetului a eșuat:', err);
        saveError = 'Salvarea a eșuat (slug duplicat sau eroare de DB).';
        formOverride = {
          ...parsed.data,
          sort: parsed.data.sort,
          active: parsed.data.active,
        };
      }
    }
  }
}

let row: typeof packages.$inferSelect | undefined;
try {
  [row] = await db.select().from(packages).where(eq(packages.id, id)).limit(1);
} catch (err) {
  console.warn('[admin] Citirea pachetului a eșuat:', err);
}
if (!row) return Astro.redirect('/admin/pachete', 302);

const values: FormValues = formOverride ?? {
  name: row.name,
  slug: row.slug,
  kind: row.kind,
  description: row.description,
  price: row.priceCents === 0 ? '' : centsToPrice(row.priceCents),
  currency: row.currency.trim(),
  interval: row.interval,
  pricing: row.pricing,
  features: featuresToInput(row.features, row.featureGroups),
  category: row.category,
  note: row.note,
  sort: row.sort,
  active: row.active,
  otoPackageId: row.otoPackageId ?? '',
  otoDiscountPercent: row.otoDiscountPercent,
};

// Candidați OTO: pachete one-time, fără pachetul curent.
let otoCandidates: { id: string; name: string }[] = [];
try {
  otoCandidates = await db
    .select({ id: packages.id, name: packages.name })
    .from(packages)
    .where(and(eq(packages.interval, 'one_time'), ne(packages.id, id)))
    .orderBy(asc(packages.name));
} catch {
  /* fără candidați */
}
---

<AdminLayout title={`Editare: ${row.name}`}>
  <h1>Editare pachet</h1>
  <p class="admin-sub">{row.name} · <code>{row.slug}</code></p>

  <div class="admin-card">
    {saveError && <div class="admin-banner admin-banner--error">{saveError}</div>}
    <PackageForm
      values={values}
      errors={errors}
      submitLabel="Salvează modificările"
      otoCandidates={otoCandidates}
    />
  </div>

  <div class="admin-card">
    <h2>Ștergere</h2>
    <p class="admin-hint">
      Dacă pachetul are comenzi, va fi doar dezactivat (istoricul rămâne intact).
    </p>
    <form method="post" onsubmit="return confirm('Sigur vrei să ștergi acest pachet?')">
      <input type="hidden" name="action" value="delete" />
      <button type="submit" class="admin-btn admin-btn--outline">Șterge pachetul</button>
    </form>
  </div>
</AdminLayout>
