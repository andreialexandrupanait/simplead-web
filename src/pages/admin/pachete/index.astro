---
import { asc, eq } from 'drizzle-orm';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import { getDb } from '../../../lib/server/db';
import { packages } from '../../../lib/server/schema';
import { centsToPrice } from '../../../lib/server/admin-schemas';

export const prerender = false;

const db = getDb();

// Acțiune rapidă: activează/dezactivează un pachet din listă.
if (Astro.request.method === 'POST' && db) {
  const form = await Astro.request.formData();
  const id = String(form.get('id') ?? '');
  const action = String(form.get('action') ?? '');
  if (id && (action === 'activate' || action === 'deactivate')) {
    try {
      await db
        .update(packages)
        .set({ active: action === 'activate', updatedAt: new Date() })
        .where(eq(packages.id, id));
    } catch (err) {
      console.warn('[admin] Schimbarea stării pachetului a eșuat:', err);
    }
  }
  return Astro.redirect('/admin/pachete', 303);
}

let rows: (typeof packages.$inferSelect)[] = [];
let dbError = false;
if (db) {
  try {
    rows = await db.select().from(packages).orderBy(asc(packages.kind), asc(packages.sort));
  } catch (err) {
    console.warn('[admin] Listarea pachetelor a eșuat:', err);
    dbError = true;
  }
}

const KIND_LABEL: Record<string, string> = {
  service: 'Serviciu',
  maintenance: 'Mentenanță',
  addon: 'Add-on',
};
const INTERVAL_LABEL: Record<string, string> = {
  one_time: 'o singură dată',
  monthly: '/lună',
  yearly: '/an',
};
---

<AdminLayout title="Pachete">
  <h1>Pachete</h1>
  <p class="admin-sub">
    Pachetele afișate pe pagina publică <a href="/pachete" target="_blank">/pachete</a>. Prețurile
    marcate cu <code>[confirmă]</code> sunt drafturi de completat.
  </p>

  {
    !db && (
      <div class="admin-banner admin-banner--warn">
        <strong>Fără bază de date.</strong> Pachetele nu pot fi editate; site-ul folosește
        fallback-ul din cod.
      </div>
    )
  }
  {
    dbError && (
      <div class="admin-banner admin-banner--error">Conexiunea la baza de date a eșuat.</div>
    )
  }

  {
    db && !dbError && (
      <div class="admin-card">
        <div class="admin-actions" style="margin-bottom:16px">
          <a href="/admin/pachete/nou" class="admin-btn">
            Pachet nou
          </a>
          {rows.length === 0 && (
            <span class="admin-hint" style="margin:0">
              Niciun pachet încă. Rulează <code>pnpm db:seed</code> pentru drafturile inițiale.
            </span>
          )}
        </div>
        {rows.length > 0 && (
          <table class="admin-table">
            <thead>
              <tr>
                <th>Nume</th>
                <th>Tip</th>
                <th>Preț</th>
                <th>Stare</th>
                <th>Acțiuni</th>
              </tr>
            </thead>
            <tbody>
              {rows.map((p) => (
                <tr>
                  <td>
                    <a href={`/admin/pachete/${p.id}`} style="font-weight:600">
                      {p.name}
                    </a>
                    <br />
                    <small style="color:var(--muted)">{p.slug}</small>
                  </td>
                  <td>{KIND_LABEL[p.kind]}</td>
                  <td>
                    {p.priceCents === 0
                      ? '[confirmă]'
                      : `${centsToPrice(p.priceCents)} ${p.currency.trim()}`}
                    <small style="color:var(--muted)"> {INTERVAL_LABEL[p.interval]}</small>
                  </td>
                  <td>
                    <span class:list={['admin-tag', p.active && 'admin-tag--on']}>
                      {p.active ? 'activ' : 'inactiv'}
                    </span>
                  </td>
                  <td>
                    <form method="post" style="display:inline">
                      <input type="hidden" name="id" value={p.id} />
                      <input
                        type="hidden"
                        name="action"
                        value={p.active ? 'deactivate' : 'activate'}
                      />
                      <button type="submit" class="admin-btn admin-btn--ghost admin-btn--sm">
                        {p.active ? 'Dezactivează' : 'Activează'}
                      </button>
                    </form>
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </div>
    )
  }
</AdminLayout>
