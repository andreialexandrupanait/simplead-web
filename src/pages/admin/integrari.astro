---
import AdminLayout from '../../layouts/AdminLayout.astro';
import IntegrationLogo from '../../components/admin/IntegrationLogo.astro';
import { slugify } from '../../lib/slug';
import { getDb } from '../../lib/server/db';
import { getEncryptionKey } from '../../lib/server/crypto';
import { setFlash } from '../../lib/server/flash';
import {
  INTEGRATIONS,
  getMaskedIntegration,
  saveIntegration,
  type IntegrationName,
  type MaskedField,
} from '../../lib/server/settings';

export const prerender = false;

const db = getDb();
const hasEncryptionKey = getEncryptionKey() !== null;

let saveError: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const integration = String(form.get('integration') ?? '') as IntegrationName;

  if (integration in INTEGRATIONS) {
    const fields = Object.keys(INTEGRATIONS[integration].fields);
    const values: Record<string, string> = {};
    const clear: string[] = [];
    for (const field of fields) {
      values[field] = String(form.get(field) ?? '');
      if (form.get(`clear_${field}`)) clear.push(field);
    }
    const result = await saveIntegration(integration, values as never, clear as never[]);
    if (result.ok) {
      setFlash(Astro.cookies, {
        kind: 'ok',
        msg: `Setările ${INTEGRATIONS[integration].label} au fost salvate.`,
      });
      const savedGroup = (INTEGRATIONS[integration] as { group: string }).group;
      return Astro.redirect(`/admin/integrari?tab=${slugify(savedGroup)}`, 303);
    }
    saveError = result.error;
  }
}

// Etichete + hint-uri per câmp (textul de sub input).
const FIELD_META: Record<string, Record<string, { label: string; hint?: string }>> = {
  stripe: {
    secretKey: {
      label: 'Secret key',
      hint: 'Cheia secretă din Stripe Dashboard (sk_live_... sau sk_test_...).',
    },
    webhookSecret: {
      label: 'Webhook secret',
      hint: 'Din Stripe → Developers → Webhooks (whsec_...). Endpoint: https://simplead.ro/api/stripe/webhook, eveniment checkout.session.completed.',
    },
  },
  smartbill: {
    email: { label: 'Email cont', hint: 'Emailul contului SmartBill.' },
    token: { label: 'Token API', hint: 'Din SmartBill Cloud: Contul meu → Integrări → API.' },
    series: { label: 'Serie facturi', hint: 'Seria folosită pentru facturile emise automat.' },
    cif: { label: 'CIF firmă', hint: 'CIF-ul firmei din SmartBill (ex. 41501661).' },
    taxName: {
      label: 'Denumire cotă TVA',
      hint: 'Cum apare în SmartBill (implicit „Normala"). Pentru neplătitor de TVA, denumirea cotei de 0%.',
    },
    taxPercent: {
      label: 'Procent TVA',
      hint: 'Implicit 21. Pune 0 dacă firma nu e plătitoare de TVA.',
    },
  },
  postmark: {
    serverToken: { label: 'Server token', hint: 'Din Postmark: Servers → API Tokens.' },
    fromEmail: {
      label: 'Adresă expeditor',
      hint: 'Adresă verificată în Postmark (ex. site@simplead.ro).',
    },
  },
  email: {
    toEmail: {
      label: 'Adresă destinatar',
      hint: 'Unde ajung mesajele din formulare (ex. contact@simplead.ro).',
    },
  },
  slack: {
    webhookUrl: { label: 'Webhook URL', hint: 'Incoming webhook pentru canalul de notificări.' },
  },
  mailerlite: {
    apiKey: {
      label: 'API key',
      hint: 'Din MailerLite: Integrations → API → Generate new token.',
    },
    groupId: {
      label: 'Group ID (opțional)',
      hint: 'ID-ul grupului/audienței unde intră abonații. Din MailerLite: Subscribers → Groups → (grup) → din URL. Gol = fără grup.',
    },
  },
  google: {
    clientId: {
      label: 'Client ID',
      hint: 'Din Google Cloud Console → Credentials → OAuth client (tip Web).',
    },
    clientSecret: {
      label: 'Client secret',
      hint: 'Secretul OAuth. Redirect URI autorizat: https://simplead.ro/api/auth/callback/google',
    },
    allowedDomain: {
      label: 'Domeniu permis',
      hint: 'Doar conturile Workspace din acest domeniu pot intra (ex. simplead.ro).',
    },
  },
};

type IntMeta = {
  label: string;
  group: string;
  desc: string;
  docs?: string;
  testable?: boolean;
  fields: Record<string, { key: string; env: string; secret: boolean }>;
};

const integrationNames = Object.keys(INTEGRATIONS) as IntegrationName[];
const masked = Object.fromEntries(
  await Promise.all(integrationNames.map(async (name) => [name, await getMaskedIntegration(name)])),
) as Record<IntegrationName, Record<string, MaskedField>>;

// „Tracking" (Conversii/CAPI) e gestionat acum în hub-ul /admin/tracking → tab Conversii.
const GROUP_ORDER = ['Plăți & facturare', 'Email', 'Notificări', 'Newsletter', 'Autentificare'];
const grouped = GROUP_ORDER.map((group) => ({
  group,
  slug: slugify(group),
  names: integrationNames.filter((n) => (INTEGRATIONS[n] as IntMeta).group === group),
  configured: integrationNames.filter(
    (n) => (INTEGRATIONS[n] as IntMeta).group === group && Object.values(masked[n]).some((f) => f.source),
  ).length,
})).filter((g) => g.names.length > 0);

const totalConfigured = integrationNames.filter((n) =>
  Object.values(masked[n]).some((f) => f.source),
).length;

const tabParam = Astro.url.searchParams.get('tab');
const activeTab = grouped.find((g) => g.slug === tabParam) ?? grouped[0];
---

<AdminLayout title="Integrări">
  <div class="admin-page-head">
    <div>
      <h1>Integrări</h1>
      <p class="admin-sub">
        Conectează serviciile externe. Cheile se salvează criptat în baza de date și nu se afișează
        niciodată întregi. Câmp gol = valoarea existentă rămâne neschimbată.
      </p>
    </div>
    <span class="admin-tag admin-tag--plain int-count">
      {totalConfigured}/{integrationNames.length} configurate
    </span>
  </div>

  {
    !db && (
      <div class="admin-banner admin-banner--warn">
        <strong>Fără bază de date.</strong> Salvarea cheilor necesită <code>DATABASE_URL</code>.
        Până atunci, integrările pot funcționa doar din variabile de mediu.
      </div>
    )
  }
  {
    !hasEncryptionKey && (
      <div class="admin-banner admin-banner--warn">
        <strong>Cheie de criptare lipsă.</strong> Setează <code>APP_ENCRYPTION_KEY</code> (vezi
        <code>pnpm gen:key</code>) ca să poți salva chei secrete.
      </div>
    )
  }
  {saveError && <div class="admin-banner admin-banner--error">{saveError}</div>}

  <div class="admin-count-chips int-tabs">
    {grouped.map((g) => (
      <a href={`?tab=${g.slug}`} class:list={[g.slug === activeTab.slug && 'is-active']}>
        {g.group}
        <span class="int-tab-count">{g.configured}/{g.names.length}</span>
      </a>
    ))}
  </div>

  <div class="int-grid">
    {
      activeTab.names.map((name) => {
        const meta = INTEGRATIONS[name] as IntMeta;
        const fields = Object.entries(meta.fields);
        const configured = Object.values(masked[name]).some((f) => f.source);
        return (
              <div class="admin-card int-card" id={name}>
                <div class="int-card__head">
                  <IntegrationLogo name={name} />
                  <div class="int-card__titles">
                    <h3>{meta.label}</h3>
                    <span
                      class:list={['admin-tag', configured ? 'admin-tag--ok' : 'admin-tag--warn']}
                    >
                      {configured ? 'Configurată' : 'Neconfigurată'}
                    </span>
                  </div>
                  {meta.docs && (
                    <a class="int-card__docs" href={meta.docs} target="_blank" rel="noopener">
                      Ghid ↗
                    </a>
                  )}
                </div>
                <p class="int-card__desc">{meta.desc}</p>
                <form method="post">
                  <input type="hidden" name="integration" value={name} />
                  {fields.map(([fieldName, field]) => {
                    const m = masked[name][fieldName]!;
                    const fmeta = FIELD_META[name]?.[fieldName];
                    return (
                      <label class="admin-field">
                        <span>
                          {fmeta?.label ?? fieldName}
                          {m.source && (
                            <span class="admin-tag admin-tag--on" style="margin-left:8px">
                              {m.source === 'db' ? 'salvat în DB' : 'din .env'}
                            </span>
                          )}
                        </span>
                        <input
                          class="admin-input"
                          type={field.secret ? 'password' : 'text'}
                          name={fieldName}
                          placeholder={m.masked ?? 'nesetat'}
                          autocomplete="off"
                        />
                        {fmeta?.hint && <small>{fmeta.hint}</small>}
                        {m.source === 'db' && (
                          <small>
                            <label class="admin-check">
                              <input type="checkbox" name={`clear_${fieldName}`} value="1" />
                              șterge valoarea salvată
                            </label>
                          </small>
                        )}
                      </label>
                    );
                  })}
                  <div class="admin-actions">
                    <button type="submit" class="admin-btn">
                      Salvează
                    </button>
                    {meta.testable && (
                      <button
                        type="button"
                        class="admin-btn admin-btn--outline"
                        data-test-integration={name}
                      >
                        Testează
                      </button>
                    )}
                    <span class="test-result" data-test-result={name} aria-live="polite" />
                  </div>
                </form>
              </div>
        );
      })
    }
  </div>
</AdminLayout>

<style>
  .int-count {
    align-self: center;
    white-space: nowrap;
  }
  .int-group {
    margin-top: 28px;
  }
  .int-group:first-of-type {
    margin-top: 8px;
  }
  .int-group__title {
    font-size: 0.82rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--admin-text-soft);
    margin: 0 0 14px;
  }
  .int-tabs {
    margin: 6px 0 22px;
  }
  .int-tab-count {
    margin-left: 8px;
    font-size: 0.76rem;
    opacity: 0.7;
    font-variant-numeric: tabular-nums;
  }
  .int-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(440px, 1fr));
    gap: 18px;
    align-items: stretch;
  }
  .int-card {
    margin: 0;
    display: flex;
    flex-direction: column;
  }
  .int-card__head {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .int-card__titles {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  .int-card__titles h3 {
    margin: 0;
    font-size: 1.1rem;
  }
  .int-card__docs {
    font-size: 0.85rem;
    color: var(--electric);
    text-decoration: none;
    font-weight: 500;
    white-space: nowrap;
  }
  .int-card__docs:hover {
    text-decoration: underline;
  }
  .int-card__desc {
    margin: 12px 0 16px;
    color: var(--admin-text-soft);
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .test-result {
    font-size: 0.9rem;
    color: var(--admin-text-soft);
  }
  .test-result.is-ok {
    color: var(--admin-ok-fg);
    font-weight: 600;
  }
  .test-result.is-error {
    color: var(--admin-danger-fg);
    font-weight: 600;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-test-integration]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const name = btn.dataset.testIntegration!;
      const result = document.querySelector<HTMLElement>(`[data-test-result="${name}"]`)!;
      result.className = 'test-result';
      result.textContent = 'Se testează...';
      btn.disabled = true;
      try {
        const res = await fetch('/api/admin/integrations/test', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ integration: name }),
        });
        const body = (await res.json()) as { ok: boolean; detail?: string };
        result.textContent = body.detail ?? (body.ok ? 'Funcționează.' : 'A eșuat.');
        result.classList.add(body.ok ? 'is-ok' : 'is-error');
        const toast = (window as unknown as { adminToast?: (m: string, k?: string) => void })
          .adminToast;
        toast?.(
          body.ok ? `Testul ${name} a reușit.` : `Testul ${name} a eșuat.`,
          body.ok ? 'ok' : 'error',
        );
      } catch {
        result.textContent = 'Testul a eșuat (eroare de rețea).';
        result.classList.add('is-error');
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>
