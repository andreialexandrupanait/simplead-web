---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import UsersAdmin from '../../../components/react/UsersAdmin.tsx';
import { can } from '../../../lib/server/authz';

export const prerender = false;

// Doar cine are user:list (adminul) vede ecranul. Middleware-ul a verificat deja
// că e staff autentificat; aici filtrăm fin pe capability.
const allowed = await can(Astro.request.headers, { user: ['list'] });
if (!allowed) return Astro.redirect('/admin');

const me = Astro.locals.user;
---

<AdminLayout title="Utilizatori">
  <div class="admin-page-head">
    <div>
      <h1>Utilizatori</h1>
      <p class="admin-sub">Conturile cu acces în platformă: roluri, suspendare, impersonare.</p>
    </div>
  </div>

  <UsersAdmin client:load currentUserId={me?.id ?? ''} />
</AdminLayout>
