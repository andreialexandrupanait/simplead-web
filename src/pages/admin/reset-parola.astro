---
import AuthLayout from '../../layouts/AuthLayout.astro';
import AuthAside from '../../components/ui/AuthAside.astro';
import Logo from '../../components/ui/Logo.astro';
import ResetPasswordForm from '../../components/react/ResetPasswordForm.tsx';

export const prerender = false;
---

<AuthLayout title="Setează o parolă nouă">
  <div class="auth-shell">
    <AuthAside
      title="Setează o parolă nouă"
      text="Alege o parolă puternică, de cel puțin 10 caractere. Apoi te poți autentifica imediat."
    />
    <main class="auth-main">
      <div class="auth-form-wrap">
        <div class="auth-brand">
          <Logo height={30} />
        </div>
        <ResetPasswordForm client:load />
      </div>
    </main>
  </div>
</AuthLayout>
