---
import { and, count, desc, eq, gte, ilike, lte, or, type SQL } from 'drizzle-orm';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Toolbar from '../../../components/admin/Toolbar.astro';
import StatusBadge from '../../../components/admin/StatusBadge.astro';
import EmptyState from '../../../components/admin/EmptyState.astro';
import Pagination from '../../../components/admin/Pagination.astro';
import { getDb } from '../../../lib/server/db';
import { orders, orderStatus, packages } from '../../../lib/server/schema';
import { formatAmount } from '../../../lib/server/packages';

export const prerender = false;

const db = getDb();
const STATUSES = orderStatus.enumValues;
const PER_PAGE = 25;

const q = Astro.url.searchParams.get('q')?.trim() ?? '';
const filter = Astro.url.searchParams.get('status') ?? '';
const from = Astro.url.searchParams.get('from') ?? '';
const to = Astro.url.searchParams.get('to') ?? '';
const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);

const conditions: SQL[] = [];
if (filter && STATUSES.includes(filter as (typeof STATUSES)[number])) {
  conditions.push(eq(orders.status, filter as (typeof STATUSES)[number]));
}
if (q) {
  const like = `%${q}%`;
  conditions.push(
    or(ilike(orders.customerEmail, like), ilike(orders.stripeCheckoutSessionId, like))!,
  );
}
if (from && !Number.isNaN(Date.parse(from))) conditions.push(gte(orders.createdAt, new Date(from)));
if (to && !Number.isNaN(Date.parse(to)))
  conditions.push(lte(orders.createdAt, new Date(`${to}T23:59:59`)));
const where = conditions.length ? and(...conditions) : undefined;

type Row = { order: typeof orders.$inferSelect; packageName: string | null };
let rows: Row[] = [];
let total = 0;
let dbError = false;

if (db) {
  try {
    const [data, [{ n }]] = await Promise.all([
      db
        .select({ order: orders, packageName: packages.name })
        .from(orders)
        .leftJoin(packages, eq(orders.packageId, packages.id))
        .where(where)
        .orderBy(desc(orders.createdAt))
        .limit(PER_PAGE)
        .offset((page - 1) * PER_PAGE),
      db.select({ n: count() }).from(orders).where(where),
    ]);
    rows = data;
    total = n;
  } catch (err) {
    console.warn('[admin] Listarea comenzilor a eșuat:', err);
    dbError = true;
  }
}

const totalPages = Math.max(1, Math.ceil(total / PER_PAGE));
const dateFmt = new Intl.DateTimeFormat('ro-RO', { dateStyle: 'medium', timeStyle: 'short' });
const exportUrl = `/api/admin/export/orders.csv${Astro.url.search}`;
const STATUS_LABEL: Record<string, string> = {
  pending: 'În așteptare',
  paid: 'Plătită',
  failed: 'Eșuată',
  refunded: 'Rambursată',
  canceled: 'Anulată',
};
---

<AdminLayout title="Comenzi">
  <div class="admin-page-head">
    <div>
      <h1>Comenzi</h1>
      <p class="admin-sub">
        Comenzile din Stripe Checkout. Pentru rambursări și detalii fine de plată, deschide comanda
        și sari în Stripe Dashboard.
      </p>
    </div>
  </div>

  {
    !db && (
      <div class="admin-banner admin-banner--warn">
        <strong>Fără bază de date.</strong> Comenzile nu pot fi afișate.
      </div>
    )
  }
  {dbError && <div class="admin-banner admin-banner--error">Conexiunea la baza de date a eșuat.</div>}

  {
    db && !dbError && (
      <>
        <Toolbar searchPlaceholder="Caută după email sau ID sesiune…" q={q}>
          <select class="admin-select" name="status" data-autosubmit>
            <option value="">Toate statusurile</option>
            {STATUSES.map((s) => (
              <option value={s} selected={filter === s}>
                {STATUS_LABEL[s]}
              </option>
            ))}
          </select>
          <input class="admin-input" type="date" name="from" value={from} title="De la data" />
          <input class="admin-input" type="date" name="to" value={to} title="Până la data" />
          <a slot="actions" class="admin-btn admin-btn--ghost admin-btn--sm" href={exportUrl}>
            Export CSV
          </a>
        </Toolbar>

        <div class="admin-card admin-card--flush">
          {rows.length === 0 ? (
            <EmptyState
              title="Nicio comandă găsită"
              hint={
                q || filter || from || to
                  ? 'Încearcă altă căutare sau alte filtre.'
                  : 'Comenzile apar după ce configurezi cheile Stripe din Integrări și cineva cumpără un pachet.'
              }
              actionLabel={q || filter ? undefined : 'Configurează Stripe'}
              actionHref={q || filter ? undefined : '/admin/integrari'}
            />
          ) : (
            <div class="admin-table-wrap">
              <table class="admin-table">
                <thead>
                  <tr>
                    <th>Data</th>
                    <th>Client</th>
                    <th>Pachet</th>
                    <th class="num">Sumă</th>
                    <th>Status</th>
                    <th>Factură</th>
                  </tr>
                </thead>
                <tbody>
                  {rows.map(({ order, packageName }) => (
                    <tr>
                      <td style="white-space:nowrap">
                        <a class="admin-row-link" href={`/admin/comenzi/${order.id}`}>
                          {dateFmt.format(order.createdAt)}
                        </a>
                      </td>
                      <td>{order.customerEmail ?? '–'}</td>
                      <td>
                        {packageName ?? '–'}
                        {order.otoForOrderId && <span class="admin-tag admin-tag--plain"> OTO</span>}
                      </td>
                      <td class="num">{formatAmount(order.amountCents, order.currency)}</td>
                      <td>
                        <StatusBadge status={order.status} />
                      </td>
                      <td>
                        {order.invoiceNumber
                          ? `${order.invoiceSeries ?? ''} ${order.invoiceNumber}`
                          : '–'}
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>
        <Pagination page={page} totalPages={totalPages} totalItems={total} url={Astro.url} />
      </>
    )
  }
</AdminLayout>
