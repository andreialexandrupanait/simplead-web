---
import { eq } from 'drizzle-orm';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import StatusBadge from '../../../components/admin/StatusBadge.astro';
import { getDb } from '../../../lib/server/db';
import { tickets, ticketStatus } from '../../../lib/server/schema';
import { ticketCategoryLabel } from '../../../lib/ticket-schema';
import { setFlash } from '../../../lib/server/flash';

export const prerender = false;

const db = getDb();
const STATUSES = ticketStatus.enumValues;
const id = Astro.params.id!;

if (!db) {
  return Astro.redirect('/admin/tichete', 302);
}

// Salvare status + notițe (`updatedAt` reflectă ultima atingere).
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const status = String(form.get('status') ?? '') as (typeof STATUSES)[number];
  const notes = String(form.get('notes') ?? '').slice(0, 5000);
  if (STATUSES.includes(status)) {
    try {
      await db
        .update(tickets)
        .set({ status, notes, updatedAt: new Date() })
        .where(eq(tickets.id, id));
      setFlash(Astro.cookies, { kind: 'ok', msg: 'Tichet actualizat.' });
    } catch (err) {
      console.warn('[admin] Actualizarea tichetului a eșuat:', err);
      setFlash(Astro.cookies, { kind: 'error', msg: 'Salvarea a eșuat. Încearcă din nou.' });
    }
  }
  return Astro.redirect(`/admin/tichete/${id}`, 303);
}

let ticket: typeof tickets.$inferSelect | null = null;
try {
  const rows = await db.select().from(tickets).where(eq(tickets.id, id)).limit(1);
  ticket = rows[0] ?? null;
} catch (err) {
  console.warn('[admin] Citirea tichetului a eșuat:', err);
}
if (!ticket) {
  return Astro.redirect('/admin/tichete', 302);
}

const dateFmt = new Intl.DateTimeFormat('ro-RO', { dateStyle: 'long', timeStyle: 'short' });
const STATUS_LABEL: Record<string, string> = {
  deschis: 'Deschis',
  in_lucru: 'În lucru',
  oferta_trimisa: 'Ofertă trimisă',
  rezolvat: 'Rezolvat',
  inchis: 'Închis',
};
const PRIORITY_LABEL: Record<string, string> = {
  scazuta: 'Scăzută',
  normala: 'Normală',
  ridicata: 'Ridicată',
  urgenta: 'Urgentă',
};
---

<AdminLayout title={`Tichet: ${ticket.name}`}>
  <div class="admin-page-head">
    <div>
      <a href="/admin/tichete" style="font-size:0.88rem;color:var(--admin-text-soft)">← Înapoi la tichete</a>
      <h1 style="margin-top:6px">{ticket.name}</h1>
      <p class="admin-sub">
        Primit pe {dateFmt.format(ticket.createdAt)} · {ticketCategoryLabel(ticket.category)} · prioritate
        {PRIORITY_LABEL[ticket.priority]}
      </p>
    </div>
    <StatusBadge status={ticket.status} />
  </div>

  <div class="admin-cols">
    <div class="admin-card">
      <h2>Descriere</h2>
      <p class="admin-hint">
        {ticket.siteUrl ? `Site: ${ticket.siteUrl}` : 'Fără site indicat.'}
        {ticket.packageSlug ? ` · Lucrare vizată: ${ticket.packageSlug}` : ''}
      </p>
      <p style="white-space:pre-wrap;line-height:1.65;margin:0">{ticket.message}</p>
    </div>

    <div>
      <div class="admin-card">
        <h2>Contact</h2>
        <dl class="admin-kv" style="margin-top:12px">
          <dt>Email</dt>
          <dd>
            <a href={`mailto:${ticket.email}`} style="color:var(--electric)">{ticket.email}</a>
          </dd>
          {
            ticket.phone && (
              <>
                <dt>Telefon</dt>
                <dd>
                  <a href={`tel:${ticket.phone}`} style="color:var(--electric)">
                    {ticket.phone}
                  </a>
                </dd>
              </>
            )
          }
          {
            ticket.company && (
              <>
                <dt>Firmă</dt>
                <dd>{ticket.company}</dd>
              </>
            )
          }
          {
            ticket.siteUrl && (
              <>
                <dt>Site</dt>
                <dd>{ticket.siteUrl}</dd>
              </>
            )
          }
        </dl>
        <div class="admin-actions" style="margin-top:16px">
          <a class="admin-btn admin-btn--sm" href={`mailto:${ticket.email}`}>Răspunde pe email</a>
          {
            ticket.phone && (
              <a class="admin-btn admin-btn--ghost admin-btn--sm" href={`tel:${ticket.phone}`}>
                Sună
              </a>
            )
          }
        </div>
      </div>

      <form method="post" class="admin-card" style="margin-top:20px">
        <h2>Status & notițe</h2>
        <p class="admin-hint">Notițele sunt interne, doar tu le vezi.</p>
        <label class="admin-field">
          <span>Status</span>
          <select class="admin-select" name="status">
            {
              STATUSES.map((s) => (
                <option value={s} selected={ticket.status === s}>
                  {STATUS_LABEL[s]}
                </option>
              ))
            }
          </select>
        </label>
        <label class="admin-field">
          <span>Notițe</span>
          <textarea
            class="admin-textarea"
            name="notes"
            placeholder="Ex: am cerut acces, am trimis ofertă…">{ticket.notes}</textarea
          >
        </label>
        <button type="submit" class="admin-btn">Salvează</button>
      </form>
    </div>
  </div>
</AdminLayout>

