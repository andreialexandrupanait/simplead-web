---
import { and, count, desc, eq, ilike, or, type SQL } from 'drizzle-orm';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Toolbar from '../../../components/admin/Toolbar.astro';
import StatusBadge from '../../../components/admin/StatusBadge.astro';
import EmptyState from '../../../components/admin/EmptyState.astro';
import Pagination from '../../../components/admin/Pagination.astro';
import { getDb } from '../../../lib/server/db';
import { tickets, ticketStatus } from '../../../lib/server/schema';
import { ticketCategories, ticketCategoryLabel } from '../../../lib/ticket-schema';

export const prerender = false;

const db = getDb();
const STATUSES = ticketStatus.enumValues;
const PER_PAGE = 25;

const q = Astro.url.searchParams.get('q')?.trim() ?? '';
const filter = Astro.url.searchParams.get('status') ?? '';
const catFilter = Astro.url.searchParams.get('category') ?? '';
const page = Math.max(1, Number(Astro.url.searchParams.get('page')) || 1);

const conditions: SQL[] = [];
if (filter && STATUSES.includes(filter as (typeof STATUSES)[number])) {
  conditions.push(eq(tickets.status, filter as (typeof STATUSES)[number]));
}
if (catFilter && ticketCategories.some((c) => c.value === catFilter)) {
  conditions.push(eq(tickets.category, catFilter));
}
if (q) {
  const like = `%${q}%`;
  conditions.push(
    or(
      ilike(tickets.name, like),
      ilike(tickets.email, like),
      ilike(tickets.message, like),
      ilike(tickets.siteUrl, like),
    )!,
  );
}
const where = conditions.length ? and(...conditions) : undefined;

let rows: (typeof tickets.$inferSelect)[] = [];
let total = 0;
let dbError = false;

if (db) {
  try {
    const [data, [{ n }]] = await Promise.all([
      db
        .select()
        .from(tickets)
        .where(where)
        .orderBy(desc(tickets.createdAt))
        .limit(PER_PAGE)
        .offset((page - 1) * PER_PAGE),
      db.select({ n: count() }).from(tickets).where(where),
    ]);
    rows = data;
    total = n;
  } catch (err) {
    console.warn('[admin] Listarea tichetelor a eșuat:', err);
    dbError = true;
  }
}

const totalPages = Math.max(1, Math.ceil(total / PER_PAGE));
const dateFmt = new Intl.DateTimeFormat('ro-RO', { dateStyle: 'medium', timeStyle: 'short' });
const exportUrl = `/api/admin/export/tickets.csv${Astro.url.search}`;
const STATUS_LABEL: Record<string, string> = {
  deschis: 'Deschis',
  in_lucru: 'În lucru',
  oferta_trimisa: 'Ofertă trimisă',
  rezolvat: 'Rezolvat',
  inchis: 'Închis',
};
---

<AdminLayout title="Tichete">
  <div class="admin-page-head">
    <div>
      <h1>Tichete</h1>
      <p class="admin-sub">Cererile de suport trimise prin pagina /suport.</p>
    </div>
  </div>

  {
    !db && (
      <div class="admin-banner admin-banner--warn">
        <strong>Fără bază de date.</strong> Tichetele noi nu se salvează (rămân doar pe email).
      </div>
    )
  }
  {
    dbError && (
      <div class="admin-banner admin-banner--error">Conexiunea la baza de date a eșuat.</div>
    )
  }

  {
    db && !dbError && (
      <>
        <Toolbar searchPlaceholder="Caută după nume, email, mesaj sau site…" q={q}>
          <select class="admin-select" name="status" data-autosubmit>
            <option value="">Toate statusurile</option>
            {STATUSES.map((s) => (
              <option value={s} selected={filter === s}>
                {STATUS_LABEL[s]}
              </option>
            ))}
          </select>
          <select class="admin-select" name="category" data-autosubmit>
            <option value="">Toate categoriile</option>
            {ticketCategories.map((c) => (
              <option value={c.value} selected={catFilter === c.value}>
                {c.label}
              </option>
            ))}
          </select>
          <a slot="actions" class="admin-btn admin-btn--ghost admin-btn--sm" href={exportUrl}>
            Export CSV
          </a>
        </Toolbar>

        <div class="admin-card admin-card--flush">
          {rows.length === 0 ? (
            <EmptyState
              title="Niciun tichet găsit"
              hint={
                q || filter || catFilter
                  ? 'Încearcă altă căutare sau alt filtru.'
                  : 'Tichetele apar aici când cineva trimite o cerere de suport.'
              }
            />
          ) : (
            <div class="admin-table-wrap">
              <table class="admin-table">
                <thead>
                  <tr>
                    <th>Contact</th>
                    <th>Categorie</th>
                    <th>Site</th>
                    <th>Primit</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody>
                  {rows.map((ticket) => (
                    <tr>
                      <td>
                        <a class="admin-row-link" href={`/admin/tichete/${ticket.id}`}>
                          {ticket.name}
                        </a>
                        <br />
                        <span style="color:var(--muted);font-size:0.85rem">{ticket.email}</span>
                      </td>
                      <td>{ticketCategoryLabel(ticket.category)}</td>
                      <td style="color:var(--muted)">{ticket.siteUrl || '–'}</td>
                      <td style="white-space:nowrap">{dateFmt.format(ticket.createdAt)}</td>
                      <td>
                        <StatusBadge status={ticket.status} />
                      </td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}
        </div>
        <Pagination page={page} totalPages={totalPages} totalItems={total} url={Astro.url} />
      </>
    )
  }
</AdminLayout>
