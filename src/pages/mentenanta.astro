---
import BaseLayout from '@layouts/BaseLayout.astro';
import ServiceHero from '@components/sections/ServiceHero.astro';
import CapabilitiesGrid from '@components/sections/CapabilitiesGrid.astro';
import ClientCase from '@components/sections/ClientCase.astro';
import CtaNotch from '@components/sections/CtaNotch.astro';
import FaqSection from '@components/sections/FaqSection.astro';
import { generalFaqs } from '@data/content';
import { getService } from '@data/services';

// Conținutul serviciului „Mentenanță website" trăiește acum pe această pagină unică.
const mnt = getService('mentenanta-website');

const metaDescription =
  'Calculator mentenanță web Simplead. Pachete de la 50€/lună, cu monitorizare continuă a site-ului, backup, securitate și suport. Prețul se calculează automat.';

/** Pachetele de bază (alegi unul). Prețuri în EUR/lună. */
const basePackages = [
  {
    id: 'standard',
    name: 'Standard',
    price: 50,
    tag: 'siguranță esențială',
    items: ['Backup săptămânal', 'Actualizări CMS', '1h modificări incluse'],
  },
  {
    id: 'premium',
    name: 'Premium',
    price: 90,
    tag: 'performanță maximă',
    items: ['Backup zilnic', 'Securitate avansată', '3h modificări incluse'],
  },
];

/** Opțiuni suplimentare (bifezi câte vrei). Prețuri în EUR/lună. */
const addOns = [
  { id: 'suport', name: '+2 ore suport tehnic', price: 40, desc: '' },
  {
    id: 'seo',
    name: 'Optimizare SEO continuă',
    price: 100,
    desc: 'Monitorizare poziții Google, optimizare cuvinte cheie, ajustări on-page lunare.',
  },
  {
    id: 'hosting',
    name: 'Găzduire premium dedicată',
    price: 30,
    desc: 'Server NVMe rapid, securitate extra.',
  },
  {
    id: 'analytics',
    name: 'Raportare avansată Analytics',
    price: 25,
    desc: 'Rapoarte trafic & conversii + sugestii.',
  },
];

// Schema FAQPage (GEO): din FAQ-ul aprobat.
const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: generalFaqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.body.join(' ') },
  })),
};
---

<BaseLayout
  title="Calculator Mentenanță Web"
  description={metaDescription}
  transparentNav={true}
  navOverDark={true}
  schema={faqSchema}
>
  <ServiceHero
    title="Tu te ocupi de afacere, "
    titleAccent="eu de partea tehnică"
    sub="Îți monitorizez site-ul continuu cu aplicația mea internă, care urmărește [confirmă: lista de parametri]. Așa prind problemele înainte să le simți tu. Alege-ți pachetul mai jos; prețul se actualizează automat."
    image={mnt?.image ?? ''}
    imageAlt="Mentenanță website Simplead"
    current="Mentenanță"
  />

  {
    mnt && (
      <CapabilitiesGrid
        items={mnt.capabilities}
        eyebrow={mnt.capHead.eyebrow}
        title={mnt.capHead.title}
        titleAccent={mnt.capHead.titleAccent}
        sub={mnt.capHead.sub}
        variant="light"
      />
    )
  }

  <section class="section section--tint">
    <div class="container">
      <form class="calc" id="calc">
        <div class="calc__main">
          <!-- 1. Pachet de bază -->
          <fieldset class="calc__block">
            <legend class="calc__step"><span>1</span> Pachet de bază</legend>
            <div class="calc__pkgs">
              {
                basePackages.map((p, i) => (
                  <label class="pkg">
                    <input
                      type="radio"
                      name="pkg"
                      value={p.id}
                      data-price={p.price}
                      data-label={p.name}
                      checked={i === 0}
                    />
                    <span class="pkg__card">
                      <span class="pkg__top">
                        <span class="pkg__name">{p.name}</span>
                        <span class="pkg__price">{p.price}€<small>/lună</small></span>
                      </span>
                      <span class="pkg__tag">{p.tag}</span>
                      <ul class="pkg__list">
                        {p.items.map((it) => (
                          <li>{it}</li>
                        ))}
                      </ul>
                    </span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <!-- 2. Opțiuni suplimentare -->
          <fieldset class="calc__block">
            <legend class="calc__step"><span>2</span> Opțiuni suplimentare</legend>
            <div class="calc__addons">
              {
                addOns.map((a) => (
                  <label class="addon">
                    <input type="checkbox" name="addon" value={a.id} data-price={a.price} data-label={a.name} />
                    <span class="addon__box" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12l5 5L20 7" /></svg>
                    </span>
                    <span class="addon__body">
                      <span class="addon__row">
                        <span class="addon__name">{a.name}</span>
                        <span class="addon__price">+{a.price}€/lună</span>
                      </span>
                      {a.desc && <span class="addon__desc">{a.desc}</span>}
                    </span>
                  </label>
                ))
              }
            </div>
          </fieldset>
        </div>

        <!-- Sumar pachet (sidebar) -->
        <aside class="calc__side">
          <div class="summary">
            <h2 class="summary__title">Pachetul tău</h2>
            <ul class="summary__list" id="summaryList"></ul>
            <div class="summary__total">
              <span>Total estimat</span>
              <strong id="summaryTotal">50 €/lună</strong>
            </div>
            <a class="summary__cta" href="/contact">Solicită Pachetul</a>
            <p class="summary__note">Prețurile sunt estimative. Nu se adaugă TVA.</p>
          </div>
        </aside>
      </form>
    </div>
  </section>

  <!-- Proces de plată -->
  <section class="section section--light">
    <div class="container">
      <div class="sec-head">
        <span class="sec-eyebrow">Proces de plată</span>
        <h2 class="sec-title">Transparent, fără surprize</h2>
      </div>
      <div class="pay">
        <div class="pay__card">
          <h3>Dezvoltare web &amp; branding</h3>
          <p>Avans 40–50% la semnarea contractului, restul la predare.</p>
        </div>
        <div class="pay__card">
          <h3>Mentenanță</h3>
          <p>Lunar, pe pachetul ales mai sus.</p>
        </div>
      </div>
    </div>
  </section>

  {mnt?.caseStudy && <ClientCase caseStudy={mnt.caseStudy} variant="tint" />}

  <FaqSection
    items={generalFaqs}
    variant="light"
    eyebrow="Întrebări frecvente"
    title="Ai "
    titleAccent="întrebări?"
  />

  {mnt && <CtaNotch title={mnt.claim} />}
</BaseLayout>

<style>
  .calc {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 40px;
    align-items: start;
  }
  .calc__block {
    border: 0;
    padding: 0;
    margin: 0 0 40px;
  }
  .calc__block:last-child {
    margin-bottom: 0;
  }
  .calc__step {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.3rem;
    color: var(--ink);
    margin-bottom: 22px;
    padding: 0;
  }
  .calc__step span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--electric);
    color: #fff;
    font-size: 0.92rem;
  }

  /* Pachete de bază */
  .calc__pkgs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .pkg input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .pkg__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 22px;
    border: 1.5px solid var(--line);
    border-radius: var(--r-md);
    background: var(--canvas);
    cursor: pointer;
    transition:
      border-color 0.18s var(--ease-snap),
      box-shadow 0.18s var(--ease-snap);
  }
  .pkg__card:hover {
    border-color: var(--cyan);
  }
  .pkg input:checked + .pkg__card {
    border-color: var(--electric);
    box-shadow: var(--glow-electric);
  }
  .pkg input:focus-visible + .pkg__card {
    outline: 2px solid var(--electric);
    outline-offset: 2px;
  }
  .pkg__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
  }
  .pkg__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--ink);
  }
  .pkg__price {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    color: var(--electric);
  }
  .pkg__price small {
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--muted);
  }
  .pkg__tag {
    margin-top: 4px;
    font-size: 0.86rem;
    color: var(--muted);
  }
  .pkg__list {
    list-style: none;
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .pkg__list li {
    position: relative;
    padding-left: 22px;
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--ink);
  }
  .pkg__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 7px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--cyan);
  }

  /* Opțiuni suplimentare */
  .calc__addons {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .addon {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 18px 20px;
    border: 1.5px solid var(--line);
    border-radius: var(--r-md);
    background: var(--canvas);
    cursor: pointer;
    transition: border-color 0.18s var(--ease-snap);
  }
  .addon:hover {
    border-color: var(--cyan);
  }
  .addon input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .addon__box {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    margin-top: 1px;
    border: 1.5px solid var(--line);
    border-radius: var(--r-xs);
    color: #fff;
    background: transparent;
    transition:
      background 0.15s var(--ease-snap),
      border-color 0.15s var(--ease-snap);
  }
  .addon__box svg {
    width: 16px;
    height: 16px;
    opacity: 0;
    transition: opacity 0.15s var(--ease-snap);
  }
  .addon input:checked + .addon__box {
    background: var(--electric);
    border-color: var(--electric);
  }
  .addon input:checked + .addon__box svg {
    opacity: 1;
  }
  .addon input:checked ~ .addon__body .addon__name {
    color: var(--electric);
  }
  .addon input:focus-visible + .addon__box {
    outline: 2px solid var(--electric);
    outline-offset: 2px;
  }
  .addon__body {
    flex: 1;
  }
  .addon__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .addon__name {
    font-weight: 700;
    font-size: 1rem;
    color: var(--ink);
  }
  .addon__price {
    flex-shrink: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.96rem;
    color: var(--ink);
  }
  .addon__desc {
    display: block;
    margin-top: 4px;
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--muted);
  }

  /* Sumar (sidebar) */
  .calc__side {
    position: sticky;
    top: calc(var(--nav-h) + 20px);
  }
  .summary {
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--canvas-soft);
    padding: 26px;
    box-shadow: var(--sh-sm);
  }
  .summary__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--ink);
    margin-bottom: 18px;
  }
  .summary__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-bottom: 18px;
    border-bottom: 1px solid var(--line);
  }
  .summary__list li {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 0.92rem;
    color: var(--ink);
  }
  .summary__list li span:last-child {
    flex-shrink: 0;
    font-weight: 700;
  }
  .summary__list li.is-muted {
    color: var(--muted);
  }
  .summary__total {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-top: 18px;
  }
  .summary__total span {
    font-size: 0.96rem;
    color: var(--muted);
  }
  .summary__total strong {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.6rem;
    color: var(--electric);
  }
  .summary__cta {
    display: block;
    margin-top: 20px;
    padding: 15px 24px;
    text-align: center;
    background: var(--electric);
    color: #fff;
    border-radius: var(--r-sm);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.92rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    box-shadow: var(--glow-electric);
    transition: transform 0.18s var(--ease-snap);
  }
  .summary__cta:hover {
    transform: translateY(-2px);
  }
  .summary__note {
    margin-top: 14px;
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--muted);
    text-align: center;
  }

  /* Proces de plată */
  .pay {
    margin-top: 40px;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .pay__card {
    padding: 28px;
    background: var(--canvas);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
  }
  .pay__card h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--ink);
  }
  .pay__card p {
    margin-top: 10px;
    font-size: 0.98rem;
    line-height: 1.55;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .calc {
      grid-template-columns: 1fr;
    }
    .calc__side {
      position: static;
    }
  }
  @media (max-width: 560px) {
    .calc__pkgs {
      grid-template-columns: 1fr;
    }
    .pay {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const form = document.getElementById('calc') as HTMLFormElement | null;
  const summaryList = document.getElementById('summaryList');
  const summaryTotal = document.getElementById('summaryTotal');

  if (form && summaryList && summaryTotal) {
    const fmt = (n: number) => `${n} €/lună`;

    const render = () => {
      const rows: { label: string; price: number }[] = [];

      const pkg = form.querySelector<HTMLInputElement>('input[name="pkg"]:checked');
      if (pkg) {
        rows.push({
          label: `Pachet ${pkg.dataset.label}`,
          price: Number(pkg.dataset.price) || 0,
        });
      }

      form
        .querySelectorAll<HTMLInputElement>('input[name="addon"]:checked')
        .forEach((el) => {
          rows.push({ label: el.dataset.label || '', price: Number(el.dataset.price) || 0 });
        });

      const total = rows.reduce((sum, r) => sum + r.price, 0);

      summaryList.innerHTML = rows
        .map(
          (r) =>
            `<li><span>${r.label}</span><span>${r.price}€</span></li>`,
        )
        .join('');
      summaryTotal.textContent = fmt(total);
    };

    form.addEventListener('change', render);
    render();
  }
</script>
