---
import BaseLayout from '@layouts/BaseLayout.astro';
import ServiceHero from '@components/sections/ServiceHero.astro';
import AppShowcase from '@components/sections/AppShowcase.astro';
import ProjectsGrid from '@components/sections/ProjectsGrid.astro';
import CtaNotch from '@components/sections/CtaNotch.astro';
import FaqSection from '@components/sections/FaqSection.astro';
import { mentenantaFaqs, appTopics } from '@data/content';
import { getService } from '@data/services';
import {
  maintenanceBase as basePackages,
  maintenanceAddons as addOns,
} from '@lib/maintenance-plans';

export const prerender = false;

// Conținutul serviciului „Mentenanță website" trăiește acum pe această pagină unică.
const mnt = getService('mentenanta-website');

const metaDescription =
  'Calculator mentenanță web Simplead. Pachete de la 50€/lună, cu monitorizare continuă a site-ului, backup, securitate și suport. Prețul se calculează automat.';

// Schema FAQPage (GEO): din FAQ-ul aprobat + întrebările despre aplicație.
const appFaqs = appTopics.flatMap((t) => t.faqs);
const faqSchema = {
  '@type': 'FAQPage',
  mainEntity: [...appFaqs, ...mentenantaFaqs].map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.body.join(' ') },
  })),
};
---

<BaseLayout
  title="Calculator Mentenanță Web"
  description={metaDescription}
  transparentNav={true}
  navOverDark={true}
  schema={faqSchema}
>
  <ServiceHero
    title="Tu te ocupi de afacere, "
    titleAccent="noi de partea tehnică"
    sub="Îți monitorizăm site-ul continuu cu aplicația noastră internă, SimpleAd Manager, care urmărește uptime, securitate, performanță și backup. Așa prindem problemele înainte să le simți tu. Alege-ți pachetul mai jos; prețul se actualizează automat."
    image={mnt?.image ?? ''}
    imageAlt="Mentenanță website Simplead"
    current="Mentenanță"
  />

  <AppShowcase topics={appTopics} variant="light" />

  <section class="section section--tint">
    <div class="container">
      <form class="calc" id="calc" method="post" action="/api/mentenanta-checkout">
        <div class="calc__main">
          <!-- 1. Pachet de bază -->
          <fieldset class="calc__block">
            <legend class="calc__step"><span>1</span> Pachet de bază</legend>
            <div class="calc__pkgs">
              {
                basePackages.map((p, i) => (
                  <label class="pkg">
                    <input
                      type="radio"
                      name="base"
                      value={p.slug}
                      data-price={p.price}
                      data-label={p.name}
                      checked={i === 0}
                    />
                    <span class="pkg__card">
                      <span class="pkg__top">
                        <span class="pkg__name">{p.name}</span>
                        <span class="pkg__price">
                          {p.price}€<small>/lună</small>
                        </span>
                      </span>
                      <span class="pkg__tag">{p.tag}</span>
                      <ul class="pkg__list">
                        {p.items.map((it) => (
                          <li>{it}</li>
                        ))}
                      </ul>
                    </span>
                  </label>
                ))
              }
            </div>
          </fieldset>

          <!-- 2. Opțiuni suplimentare -->
          <fieldset class="calc__block">
            <legend class="calc__step"><span>2</span> Opțiuni suplimentare</legend>
            <div class="calc__addons">
              {
                addOns.map((a) => (
                  <label class="addon">
                    <input
                      type="checkbox"
                      name="addons"
                      value={a.slug}
                      data-price={a.price}
                      data-label={a.name}
                    />
                    <span class="addon__box" aria-hidden="true">
                      <svg
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="3"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      >
                        <path d="M5 12l5 5L20 7" />
                      </svg>
                    </span>
                    <span class="addon__body">
                      <span class="addon__row">
                        <span class="addon__name">{a.name}</span>
                        <span class="addon__price">+{a.price}€/lună</span>
                      </span>
                      {a.desc && <span class="addon__desc">{a.desc}</span>}
                    </span>
                  </label>
                ))
              }
            </div>
          </fieldset>
        </div>

        <!-- Sumar pachet (sidebar) -->
        <aside class="calc__side">
          <div class="summary">
            <h2 class="summary__title">Pachetul tău</h2>
            <ul class="summary__list" id="summaryList"></ul>
            <div class="summary__total">
              <span>Total estimat</span>
              <strong id="summaryTotal">50 €/lună</strong>
            </div>
            <button type="submit" class="summary__cta">Mergi la plată</button>
            <p class="summary__note">
              Plată securizată prin Stripe, abonament lunar. Nu se adaugă TVA. Poți anula oricând.
            </p>
          </div>
        </aside>
      </form>
    </div>
  </section>

  <ProjectsGrid
    service="mentenanta"
    title="Site-uri pe care le ținem live chiar acum"
    showLive
    variant="light"
  />

  <FaqSection
    items={mentenantaFaqs}
    variant="tint"
    eyebrow="Întrebări frecvente"
    title="Ai "
    titleAccent="întrebări?"
  />

  {mnt && <CtaNotch title="Tu te ocupi de afacere." subtitle="Noi ne ocupăm de site." />}
</BaseLayout>

<style>
  .calc {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 40px;
    align-items: start;
    /* ancora #calc nu intră sub navbar-ul fix */
    scroll-margin-top: calc(var(--nav-h) + 24px);
  }
  .calc__block {
    border: 0;
    padding: 0;
    margin: 0 0 40px;
  }
  .calc__block:last-child {
    margin-bottom: 0;
  }
  .calc__step {
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.3rem;
    color: var(--ink);
    margin-bottom: 22px;
    padding: 0;
  }
  .calc__step span {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--electric);
    color: #fff;
    font-size: 0.92rem;
  }

  /* Pachete de bază */
  .calc__pkgs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }
  .pkg input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .pkg__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 22px;
    border: 1.5px solid var(--line);
    border-radius: var(--r-md);
    background: var(--canvas);
    cursor: pointer;
    transition:
      border-color 0.18s var(--ease-snap),
      box-shadow 0.18s var(--ease-snap);
  }
  .pkg__card:hover {
    border-color: var(--cyan);
  }
  .pkg input:checked + .pkg__card {
    border-color: var(--electric);
    box-shadow: var(--glow-electric);
  }
  .pkg input:focus-visible + .pkg__card {
    outline: 2px solid var(--electric);
    outline-offset: 2px;
  }
  .pkg__top {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 10px;
  }
  .pkg__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--ink);
  }
  .pkg__price {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    color: var(--electric);
  }
  .pkg__price small {
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--muted);
  }
  .pkg__tag {
    margin-top: 4px;
    font-size: 0.86rem;
    color: var(--muted);
  }
  .pkg__list {
    list-style: none;
    margin-top: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .pkg__list li {
    position: relative;
    padding-left: 22px;
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--ink);
  }
  .pkg__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 7px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--cyan);
  }

  /* Opțiuni suplimentare */
  .calc__addons {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .addon {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding: 18px 20px;
    border: 1.5px solid var(--line);
    border-radius: var(--r-md);
    background: var(--canvas);
    cursor: pointer;
    transition: border-color 0.18s var(--ease-snap);
  }
  .addon:hover {
    border-color: var(--cyan);
  }
  .addon input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .addon__box {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    margin-top: 1px;
    border: 1.5px solid var(--line);
    border-radius: var(--r-xs);
    color: #fff;
    background: transparent;
    transition:
      background 0.15s var(--ease-snap),
      border-color 0.15s var(--ease-snap);
  }
  .addon__box svg {
    width: 16px;
    height: 16px;
    opacity: 0;
    transition: opacity 0.15s var(--ease-snap);
  }
  .addon input:checked + .addon__box {
    background: var(--electric);
    border-color: var(--electric);
  }
  .addon input:checked + .addon__box svg {
    opacity: 1;
  }
  .addon input:checked ~ .addon__body .addon__name {
    color: var(--electric);
  }
  .addon input:focus-visible + .addon__box {
    outline: 2px solid var(--electric);
    outline-offset: 2px;
  }
  .addon__body {
    flex: 1;
  }
  .addon__row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
  }
  .addon__name {
    font-weight: 700;
    font-size: 1rem;
    color: var(--ink);
  }
  .addon__price {
    flex-shrink: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.96rem;
    color: var(--ink);
  }
  .addon__desc {
    display: block;
    margin-top: 4px;
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--muted);
  }

  /* Sumar (sidebar) */
  .calc__side {
    position: sticky;
    top: calc(var(--nav-h) + 20px);
  }
  /* Sumar - versiune dark, identică cu cardul „Simply professional" (.cs-stat) */
  .summary {
    position: relative;
    overflow: hidden;
    border-radius: 24px;
    background: var(--navy);
    color: #fff;
    padding: 32px;
    box-shadow: var(--sh-lg);
  }
  .summary::after {
    content: '';
    position: absolute;
    right: -50px;
    bottom: -50px;
    width: 180px;
    height: 180px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(110, 91, 224, 0.4), transparent 70%);
  }
  .summary > * {
    position: relative;
    z-index: 1;
  }
  .summary__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    color: #fff;
    margin-bottom: 18px;
  }
  .summary__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-bottom: 18px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }
  /* Rândurile sunt injectate din JS (innerHTML), deci nu primesc scope-ul Astro:
     stilăm descendenții cu :global ca să se aplice și bullet-ul, și culorile. */
  .summary__list :global(li) {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 0.92rem;
    color: rgba(225, 230, 245, 0.9);
  }
  .summary__list :global(li span:first-child) {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
  }
  /* Bullet pentru fiecare serviciu din listă (bază + opțiuni suplimentare). */
  .summary__list :global(li span:first-child::before) {
    content: '';
    flex-shrink: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--cyan);
    transform: translateY(-2px);
  }
  .summary__list :global(li span:last-child) {
    flex-shrink: 0;
    font-weight: 700;
    color: var(--cyan);
  }
  .summary__list :global(li.is-muted) {
    color: rgba(225, 230, 245, 0.6);
  }
  .summary__total {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin-top: 18px;
  }
  .summary__total span {
    font-size: 0.96rem;
    color: rgba(225, 230, 245, 0.7);
  }
  .summary__total strong {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.6rem;
    color: var(--cyan);
  }
  .summary__cta {
    display: block;
    width: 100%;
    margin-top: 22px;
    padding: 15px 24px;
    text-align: center;
    background: var(--grad);
    color: #fff;
    border: none;
    border-radius: var(--r-sm);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.92rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    cursor: pointer;
    box-shadow: var(--glow-electric);
    transition:
      transform 0.18s var(--ease-snap),
      box-shadow 0.18s var(--ease-snap);
  }
  .summary__cta:hover {
    transform: translateY(-2px);
    box-shadow: var(--glow-cyan);
  }
  .summary__note {
    margin-top: 14px;
    font-size: 0.82rem;
    line-height: 1.5;
    color: rgba(225, 230, 245, 0.6);
    text-align: center;
  }

  @media (max-width: 900px) {
    .calc {
      grid-template-columns: 1fr;
    }
    .calc__side {
      position: static;
    }
  }
  @media (max-width: 560px) {
    .calc__pkgs {
      grid-template-columns: 1fr;
    }
  }

  /* Testimonial (ClientCase) - doar pe această pagină: împiedicăm tăierea
     titlului mare din cardul dark și lăsăm coloana să se strângă. */
  .mnt-case :global(.cs-stat),
  .mnt-case :global(.cs-case) {
    min-width: 0;
  }
  .mnt-case :global(.cs-stat .big) {
    font-size: clamp(30px, 3vw, 42px);
    overflow-wrap: break-word;
    word-break: break-word;
  }
</style>

<script>
  const form = document.getElementById('calc') as HTMLFormElement | null;
  const summaryList = document.getElementById('summaryList');
  const summaryTotal = document.getElementById('summaryTotal');

  if (form && summaryList && summaryTotal) {
    const fmt = (n: number) => `${n} €/lună`;

    const render = () => {
      const rows: { label: string; price: number; addon: boolean }[] = [];

      const pkg = form.querySelector<HTMLInputElement>('input[name="base"]:checked');
      if (pkg) {
        rows.push({
          label: `Pachet ${pkg.dataset.label}`,
          price: Number(pkg.dataset.price) || 0,
          addon: false,
        });
      }

      form.querySelectorAll<HTMLInputElement>('input[name="addons"]:checked').forEach((el) => {
        rows.push({
          label: el.dataset.label || '',
          price: Number(el.dataset.price) || 0,
          addon: true,
        });
      });

      const total = rows.reduce((sum, r) => sum + r.price, 0);

      summaryList.innerHTML = rows
        .map(
          (r) =>
            `<li class="${r.addon ? 'is-addon' : 'is-base'}"><span>${r.label}</span><span>${r.price}€</span></li>`,
        )
        .join('');
      summaryTotal.textContent = fmt(total);
    };

    form.addEventListener('change', render);
    render();
  }
</script>
