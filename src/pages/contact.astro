---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/sections/PageHeader.astro';
import ContactSection from '@components/sections/ContactSection.astro';

const calLink = import.meta.env.CALCOM_LINK;
---

<BaseLayout
  title="Contact"
  description="Hai să discutăm despre proiectul tău. Spune-ne pe scurt ce ai nevoie și revenim rapid. Prima discuție e fără obligații."
  transparentNav={true}
  navOverDark={true}
>
  <PageHeader
    crumb={[{ label: 'Acasă', href: '/' }, { label: 'Contact' }]}
    eyebrow="Contact"
    title="Hai să discutăm despre proiectul tău"
    accent="proiectul tău"
    subtitle="Spune-ne pe scurt ce ai nevoie și revenim în aceeași zi lucrătoare. Prima discuție e fără obligații."
  />

  <ContactSection variant="page" />

  {
    calLink && (
      <section class="section section--tint">
        <div class="container" style="text-align:center">
          <h2 class="sec-title" style="font-size:clamp(24px,2.6vw,34px)">
            Preferi o discuție directă?
          </h2>
          <p class="sec-sub" style="margin-left:auto;margin-right:auto">
            Programează o întâlnire la un moment care ți se potrivește.
          </p>
          <a
            class="pill pill--grad"
            href={calLink}
            target="_blank"
            rel="noopener"
            style="margin-top:28px"
          >
            Programează o întâlnire
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
        </div>
      </section>
    )
  }
</BaseLayout>
