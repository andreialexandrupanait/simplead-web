---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/sections/PageHeader.astro';
---

<BaseLayout title="Termeni și condiții" noindex={true} transparentNav={true} navOverDark={true}>
  <PageHeader title="Termeni și condiții" />
  <section class="section section--light">
    <div class="container" style="max-width:820px">
      <div class="prose-simplead">
        <!-- TODO: înlocuiește cu textul legal real, verificat juridic. -->
        <p>
          Aceasta este o pagină provizorie. Conținutul legal complet (termeni de utilizare,
          responsabilități, drepturi de autor) urmează a fi completat.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
