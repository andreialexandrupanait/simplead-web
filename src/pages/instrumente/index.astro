---
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHeader from '@components/sections/PageHeader.astro';

export const prerender = false;

const tools = [
  {
    href: '/instrumente/verificator-email',
    title: 'Verificator email deliverability',
    desc: 'MX, SPF, DKIM și DMARC pentru domeniul tău. Afli de ce ajung emailurile în spam.',
  },
  {
    href: '/instrumente/inspector-dns',
    title: 'Inspector DNS',
    desc: 'Nameservers, A/AAAA, MX, TXT și prezența SPF/DMARC pentru orice domeniu.',
  },
  {
    href: '/instrumente/scanner-seo',
    title: 'Scanner rapid SEO',
    desc: 'Title, meta, H1, viewport, Open Graph, HTTPS, robots.txt și sitemap — într-un click.',
  },
];

const metaDescription =
  'Instrumente gratuite de diagnostic pentru site și email: verificator deliverability (SPF/DKIM/DMARC), inspector DNS și scanner SEO. Fără cont, în câteva secunde.';
---

<BaseLayout
  title="Instrumente gratuite"
  description={metaDescription}
  transparentNav={true}
  navOverDark={true}
>
  <PageHeader
    crumb={[{ label: 'Acasă', href: '/' }, { label: 'Instrumente' }]}
    eyebrow="Instrumente gratuite"
    title="Verifică-ți site-ul în câteva secunde"
    accent="câteva secunde"
    subtitle="Instrumente rapide de diagnostic, fără cont. Dacă găsim ceva de reparat, îți spunem exact ce și cum."
  />

  <section class="tools-hub">
    <div class="tools-hub__wrap">
      <div class="tools-hub__grid">
        {
          tools.map((t) => (
            <a class="tools-hub__card" href={t.href}>
              <h2>{t.title}</h2>
              <p>{t.desc}</p>
              <span class="tools-hub__cta">Deschide →</span>
            </a>
          ))
        }
      </div>
      <p class="tools-hub__foot">
        Preferi să rezolvăm noi? Vezi <a href="/servicii-rapide">serviciile la preț fix</a> sau
        <a href="/suport">cere suport</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .tools-hub {
    background: var(--canvas);
    padding-block: clamp(40px, 6vw, 84px);
  }
  .tools-hub__wrap {
    max-width: 1000px;
    margin-inline: auto;
    padding-inline: var(--gutter, 24px);
  }
  .tools-hub__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 20px;
  }
  .tools-hub__card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 26px;
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    background: var(--canvas);
    box-shadow: var(--sh-sm);
    transition:
      box-shadow 0.18s var(--ease-snap),
      transform 0.18s var(--ease-snap);
  }
  .tools-hub__card:hover {
    box-shadow: var(--sh-md);
    transform: translateY(-2px);
  }
  .tools-hub__card h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--ink);
  }
  .tools-hub__card p {
    margin: 0;
    color: var(--muted);
    font-size: 0.94rem;
    line-height: 1.55;
    flex: 1;
  }
  .tools-hub__cta {
    margin-top: 6px;
    font-weight: 600;
    color: var(--electric);
  }
  .tools-hub__foot {
    margin-top: 30px;
    text-align: center;
    color: var(--muted);
    font-size: 0.94rem;
  }
  .tools-hub__foot a {
    color: var(--electric);
    font-weight: 600;
  }
</style>
