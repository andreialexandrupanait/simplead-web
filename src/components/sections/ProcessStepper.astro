---
/**
 * Proces: stepper orizontal (noul design „ciclul de viață").
 * Înlocuiește vechiul ProcessSection (tab-uri). Partajat de Acasă + hub Servicii.
 * Datele vin din content.ts (processSteps). Iconițele sunt mapate pe index.
 */
import { processSteps } from '@data/content';

interface Props {
  /** Tema secțiunii (implicit light). */
  variant?: 'light' | 'tint';
  eyebrow?: string;
  title?: string;
  titleAccent?: string;
  subtitle?: string;
}
const {
  variant = 'light',
  eyebrow = 'Cum lucrăm',
  title = 'Un proces simplu, ',
  titleAccent = 'de la idee la rezultate',
  subtitle = 'Cinci pași clari, cu efort minim din partea ta. Apasă pe oricare etapă ca să vezi ce se întâmplă.',
} = Astro.props;

// Iconițele celor 5 etape (din export), mapate pe index.
const stepIcons = [
  '<path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>',
  '<path d="M3 3v18h18"/><path d="M7 14l3-4 3 2 4-6"/>',
  '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r="1"/>',
  '<path d="M13 2L4.5 13H11l-1 9 8.5-11H12z"/>',
  '<path d="M3 17l6-6 4 4 7-7"/><path d="M14 7h7v7"/>',
];
const chevron = '<path d="M9 6l6 6-6 6"/>';
---

<section class:list={['section', `section--${variant}`]}>
  <div class="container" style="max-width: 980px">
    <div class="sec-head center" data-reveal>
      <span class="sec-eyebrow" style="display:inline-flex;justify-content:center;">{eyebrow}</span>
      <h2 class="sec-title">{title}<span class="g">{titleAccent}</span></h2>
      {subtitle && <p class="sec-sub">{subtitle}</p>}
    </div>

    <div class="stepper" id="stepper" role="tablist" data-reveal>
      {
        processSteps.map((s, i) => (
          <>
            {i > 0 && (
              <span class="pstep-sep">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2.2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={chevron}
                />
              </span>
            )}
            <button class:list={['pstep', i === 0 && 'active']} role="tab" data-i={i}>
              <span class="pstep-box">{String(s.n).padStart(2, '0')}</span>
              <span class="pstep-ic">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.9"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={stepIcons[i % stepIcons.length]}
                />
              </span>
              <span class="pstep-lbl">{s.title}</span>
            </button>
          </>
        ))
      }
    </div>

    <div class="pproc-panel-wrap" data-reveal>
      <div class="pproc-bar"></div>
      <div class="pproc-panel" id="pprocPanel">
        {
          processSteps.map((s, i) => (
            <div class:list={['pproc-detail', i === 0 && 'on']} data-i={i}>
              <span class="pic">
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.9"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={stepIcons[i % stepIcons.length]}
                />
              </span>
              <div class="pbody">
                <h3>{s.title}</h3>
                <p>{s.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const st = document.getElementById('stepper');
  if (st) {
    const steps = Array.from(st.querySelectorAll<HTMLButtonElement>('.pstep'));
    const details = Array.from(document.querySelectorAll<HTMLElement>('#pprocPanel .pproc-detail'));
    const select = (i: number) => {
      steps.forEach((s) => s.classList.toggle('active', s.dataset.i === String(i)));
      details.forEach((d) => d.classList.toggle('on', d.dataset.i === String(i)));
    };
    steps.forEach((s) => s.addEventListener('click', () => select(parseInt(s.dataset.i!, 10))));
  }
</script>
