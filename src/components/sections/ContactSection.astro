---
import ContactForm from '@components/react/ContactForm';
import { site } from '@data/site';
import { getPublicSettings, whatsappHref } from '@lib/server/public-settings';

interface Props {
  /** 'home' = layout pe Acasă (contact-wrap); 'page' = pagina Contact (cp-grid + Program). */
  variant?: 'home' | 'page';
}
const { variant = 'home' } = Astro.props;
const isPage = variant === 'page';
const pub = await getPublicSettings();
const waHref = whatsappHref(pub.whatsappNumber);
---

<section class="section section--light" id="contact">
  <div class="container">
    <div class:list={[isPage ? 'cp-grid' : 'contact-wrap']}>
      <div class="contact-aside">
        <h2>Spune-ne ce ai în cap. Restul rezolvăm împreună.</h2>
        <p class="lead">
          Nu dai peste un robot și un mesaj rătăcit într-un inbox. Citim fiecare rând și revenim cu
          întrebări bune, nu cu un răspuns la indigo.
        </p>
        <div class="contact-sign">
          <span class="ph av">
            <img
              src="/andrei.jpg"
              alt={site.founder}
              width="1092"
              height="1092"
              style="object-position: center 22%"
            />
          </span>
          <div>
            <b>{site.founder}</b>
            <small>fondator Simplead · {site.founderTitle}</small>
          </div>
        </div>
        <div class="contact-direct">
          {
            pub.showPhone && (
              <a href={site.contact.phoneHref}>
                <span class="lbl">Telefon</span>
                {site.contact.phone}
              </a>
            )
          }
          {
            waHref && (
              <a href={waHref} target="_blank" rel="noopener">
                <span class="lbl">WhatsApp</span>Scrie-ne pe WhatsApp
              </a>
            )
          }
          <a href={`mailto:${site.contact.email}`}
            ><span class="lbl">Email</span>{site.contact.email}</a
          >
          {
            isPage && (
              <span class="row">
                <span class="lbl">Program</span>
                {site.contact.schedule}
              </span>
            )
          }
        </div>
      </div>

      <ContactForm client:visible />
    </div>
  </div>
</section>
