---
/**
 * Graficul orbital din hero: reproducere fidelă a designului (Acasă.html).
 * Disc central cu logo + 8 servicii pe orbită. Mod implicit „combo"
 * (rotație inele + plutire noduri + pulsuri puncte). Pur CSS (fără JS):
 * panoul de „tweaks" din export a fost eliminat, modul rămâne fix pe combo.
 * Animațiile se opresc automat la prefers-reduced-motion.
 */
const nodes = [
  { label: 'Copywriting', side: 'left', left: '34.18%', top: '11.82%' },
  { label: 'Branding', side: 'right', left: '65.82%', top: '11.82%' },
  { label: 'Web Design', side: 'right', left: '88.18%', top: '34.18%' },
  { label: 'Social Media', side: 'right', left: '88.18%', top: '65.82%' },
  { label: 'SEO', side: 'right', left: '65.82%', top: '88.18%' },
  { label: 'Ads', side: 'left', left: '34.18%', top: '88.18%' },
  { label: 'Foto-Video', side: 'left', left: '11.82%', top: '65.82%' },
  { label: 'eCommerce', side: 'left', left: '11.82%', top: '34.18%' },
] as const;
---

<div class="orbit" data-anim="combo" aria-hidden="true">
  <svg class="rings" viewBox="0 0 600 600" fill="none" style="width:100%;height:100%">
    <defs>
      <radialGradient id="coreGlowGrad" cx="50%" cy="50%" r="50%">
        <stop offset="0" stop-color="#0077FC" stop-opacity="0.30"></stop>
        <stop offset="1" stop-color="#0077FC" stop-opacity="0"></stop>
      </radialGradient>
    </defs>
    <circle cx="300" cy="300" r="290" fill="url(#coreGlowGrad)"></circle>
    <circle cx="300" cy="300" r="104" stroke="rgba(255,255,255,0.10)" stroke-width="1"></circle>
    <circle
      cx="300"
      cy="300"
      r="178"
      stroke="rgba(255,255,255,0.13)"
      stroke-width="1"
      stroke-dasharray="3 7"></circle>
    <circle cx="300" cy="300" r="210" stroke="rgba(255,255,255,0.10)" stroke-width="1"></circle>
    <g class="spokes" stroke="rgba(255,255,255,0.10)" stroke-width="1">
      <line x1="300" y1="300" x2="380.4" y2="106.0"></line>
      <line x1="300" y1="300" x2="494.0" y2="219.6"></line>
      <line x1="300" y1="300" x2="494.0" y2="380.4"></line>
      <line x1="300" y1="300" x2="380.4" y2="494.0"></line>
      <line x1="300" y1="300" x2="219.6" y2="494.0"></line>
      <line x1="300" y1="300" x2="106.0" y2="380.4"></line>
      <line x1="300" y1="300" x2="106.0" y2="219.6"></line>
      <line x1="300" y1="300" x2="219.6" y2="106.0"></line>
    </g>
    <g class="dots" fill="#ECC0FE">
      <circle cx="380.4" cy="106.0" r="3.5"></circle>
      <circle cx="494.0" cy="219.6" r="3.5"></circle>
      <circle cx="494.0" cy="380.4" r="3.5"></circle>
      <circle cx="380.4" cy="494.0" r="3.5"></circle>
      <circle cx="219.6" cy="494.0" r="3.5"></circle>
      <circle cx="106.0" cy="380.4" r="3.5"></circle>
      <circle cx="106.0" cy="219.6" r="3.5"></circle>
      <circle cx="219.6" cy="106.0" r="3.5"></circle>
    </g>
  </svg>

  <!-- core: disc cu logo (icon-color inline) -->
  <div class="orbit-core">
    <div class="disc">
      <svg viewBox="0 0 1000 1000" xmlns="http://www.w3.org/2000/svg" style="width:60%">
        <defs>
          <linearGradient
            id="oc-b"
            x1="332.9"
            y1="-120.972"
            x2="1101.521"
            y2="605.284"
            gradientUnits="userSpaceOnUse"
          >
            <stop offset="0" stop-color="#014df9"></stop>
            <stop offset="1" stop-color="#ecc0fd"></stop>
          </linearGradient>
          <linearGradient id="oc-c" x1="175.862" y1="45.227" x2="944.483" y2="771.483" href="#oc-b"
          ></linearGradient>
          <linearGradient
            id="oc-d"
            x1="-129.45"
            y1="368.348"
            x2="639.171"
            y2="1094.604"
            href="#oc-b"></linearGradient>
          <linearGradient id="oc-e" x1="27.589" y1="202.149" x2="796.21" y2="928.405" href="#oc-b"
          ></linearGradient>
        </defs>
        <polygon
          points="903.855 522.995 903.855 115.993 711.133 115.993 561.518 397.565 903.855 522.995"
          fill="url(#oc-b)"></polygon>
        <path
          d="m500.024,115.993h-201.94c-111.528,0-201.94,90.411-201.94,201.939h0c0,91.185,60.455,168.208,143.457,193.29L711.133,115.993h-211.109Z"
          fill="url(#oc-c)"></path>
        <polygon
          points="96.145 477.005 96.145 884.007 288.822 884.007 438.437 602.435 96.145 477.005"
          fill="url(#oc-d)"></polygon>
        <path
          d="m499.976,884.007h201.94c111.528,0,201.94-90.411,201.94-201.939h0c0-91.197-60.471-168.229-143.489-193.301l-471.544,395.24h211.154Z"
          fill="url(#oc-e)"></path>
      </svg>
    </div>
  </div>

  <!-- 8 servicii pe orbită -->
  {
    nodes.map((n) => (
      <div class:list={['node-out', n.side]} style={`left:${n.left};top:${n.top}`}>
        {n.side === 'left' && <span>{n.label}</span>}
        <span class="d">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            {n.label === 'Copywriting' && (
              <path d="M12 20h9M3 20l1-4 11-11a2.1 2.1 0 0 1 3 3L7 19z" />
            )}
            {n.label === 'Branding' && (
              <>
                <circle cx="12" cy="12" r="9" />
                <path d="M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18M3 12h18" />
              </>
            )}
            {n.label === 'Web Design' && (
              <>
                <rect x="3" y="4" width="18" height="14" rx="2" />
                <path d="M3 9h18M8 21h8" />
              </>
            )}
            {n.label === 'Social Media' && (
              <>
                <circle cx="18" cy="5" r="2.5" />
                <circle cx="6" cy="12" r="2.5" />
                <circle cx="18" cy="19" r="2.5" />
                <path d="M8.2 10.8l7.6-4.6M8.2 13.2l7.6 4.6" />
              </>
            )}
            {n.label === 'SEO' && (
              <>
                <circle cx="11" cy="11" r="7" />
                <path d="M21 21l-4.3-4.3" />
              </>
            )}
            {n.label === 'Ads' && (
              <>
                <path d="M3 10v4a1 1 0 0 0 1 1h3l5 4V5L7 9H4a1 1 0 0 0-1 1z" />
                <path d="M16 9a4 4 0 0 1 0 6" />
              </>
            )}
            {n.label === 'Foto-Video' && (
              <>
                <rect x="2.5" y="6" width="14" height="12" rx="2" />
                <path d="M16.5 10l5-3v10l-5-3z" />
              </>
            )}
            {n.label === 'eCommerce' && (
              <>
                <circle cx="9" cy="20" r="1.5" />
                <circle cx="18" cy="20" r="1.5" />
                <path d="M2 3h2.5l2 12.5h11L20 7H6" />
              </>
            )}
          </svg>
        </span>
        {n.side === 'right' && <span>{n.label}</span>}
      </div>
    ))
  }
</div>

<style>
  .orbit {
    position: relative;
    width: 470px;
    height: 470px;
    max-width: 100%;
  }
  .rings {
    position: absolute;
    inset: 0;
    overflow: visible;
  }

  .orbit-core {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    width: 264px;
    height: 264px;
    border-radius: 50%;
    background: radial-gradient(
      circle,
      rgba(0, 119, 252, 0.42) 0%,
      rgba(110, 91, 224, 0.14) 58%,
      transparent 74%
    );
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
  }
  .orbit-core .disc {
    width: 212px;
    height: 212px;
    border-radius: 50%;
    background: linear-gradient(158deg, rgba(255, 255, 255, 0.16), rgba(255, 255, 255, 0.03));
    border: 1px solid rgba(255, 255, 255, 0.22);
    box-shadow:
      0 26px 64px -20px rgba(0, 0, 0, 0.65),
      inset 0 1px 0 rgba(255, 255, 255, 0.3);
    backdrop-filter: blur(6px);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .orbit-core .disc svg {
    filter: drop-shadow(0 10px 22px rgba(0, 0, 0, 0.45));
  }

  .node-out {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 13px;
    font-weight: 500;
    color: rgba(231, 236, 250, 0.82);
    white-space: nowrap;
    z-index: 3;
  }
  .node-out .d {
    width: 33px;
    height: 33px;
    border-radius: 5px;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.15);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .node-out .d svg {
    width: 16px;
    height: 16px;
    color: var(--purple, #ecc0fe);
  }
  /* etichetele cresc spre exterior */
  .node-out.right {
    transform: translate(0, -50%);
  }
  .node-out.left {
    transform: translate(-100%, -50%);
  }

  @media (max-width: 1024px) {
    .orbit {
      width: 460px;
      height: 460px;
    }
  }
  @media (max-width: 900px) {
    .orbit {
      width: 420px;
      height: 420px;
      margin: 0 auto;
    }
  }

  /* ============ ANIMAȚII ============ */
  @media (prefers-reduced-motion: no-preference) {
    .orbit-core::before {
      content: '';
      position: absolute;
      inset: -26px;
      border-radius: 50%;
      background: radial-gradient(
        circle,
        rgba(110, 91, 224, 0.55) 0%,
        rgba(0, 119, 252, 0.18) 45%,
        transparent 68%
      );
      z-index: -1;
      animation: coreGlow 4.6s ease-in-out infinite;
    }
    @keyframes coreGlow {
      0%,
      100% {
        opacity: 0.45;
        transform: scale(0.9);
      }
      50% {
        opacity: 0.95;
        transform: scale(1.12);
      }
    }

    .orbit[data-anim='combo'] .rings {
      transform-origin: 50% 50%;
      animation: ringSpin 70s linear infinite;
    }
    @keyframes ringSpin {
      to {
        transform: rotate(360deg);
      }
    }

    .orbit[data-anim='combo'] .node-out {
      animation: nodeFloat 5s ease-in-out infinite;
    }
    @keyframes nodeFloat {
      0%,
      100% {
        margin-top: 0;
      }
      50% {
        margin-top: -9px;
      }
    }
    .orbit[data-anim='combo'] .node-out:nth-of-type(even) {
      animation-delay: 1.6s;
    }
    .orbit[data-anim='combo'] .node-out:nth-of-type(3n) {
      animation-delay: 0.8s;
    }

    .orbit[data-anim='combo'] .dots circle {
      transform-box: fill-box;
      transform-origin: center;
      animation: dotPulse 2.6s ease-in-out infinite;
    }
    .orbit[data-anim='combo'] .dots circle:nth-child(2) {
      animation-delay: 0.3s;
    }
    .orbit[data-anim='combo'] .dots circle:nth-child(3) {
      animation-delay: 0.6s;
    }
    .orbit[data-anim='combo'] .dots circle:nth-child(4) {
      animation-delay: 0.9s;
    }
    .orbit[data-anim='combo'] .dots circle:nth-child(5) {
      animation-delay: 1.2s;
    }
    .orbit[data-anim='combo'] .dots circle:nth-child(6) {
      animation-delay: 1.5s;
    }
    .orbit[data-anim='combo'] .dots circle:nth-child(7) {
      animation-delay: 1.8s;
    }
    .orbit[data-anim='combo'] .dots circle:nth-child(8) {
      animation-delay: 2.1s;
    }
    @keyframes dotPulse {
      0%,
      100% {
        opacity: 0.4;
        transform: scale(0.85);
      }
      50% {
        opacity: 1;
        transform: scale(1.5);
      }
    }
  }
</style>
