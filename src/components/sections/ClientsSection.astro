---
import { clients } from '@data/content';
// Afișăm 5 sloturi de logo (placeholder striat din design). TODO: logo-uri reale.
const slots = Array.from({ length: 5 }, (_, i) => clients[i] ?? 'logo client');
---

<section class="section section--light">
  <div class="container">
    <div class="sec-head center">
      <h2 class="sec-title">Branduri care <span class="g">s-au bazat pe noi</span></h2>
    </div>
    <div class="cl-row">
      {slots.map((name) => <div class="ph cl-logo">{name}</div>)}
    </div>
  </div>
</section>
