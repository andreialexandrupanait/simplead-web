---
import { faqs as defaultFaqs, type Faq } from '@data/content';

interface Props {
  items?: Faq[];
  variant?: 'light' | 'tint';
  eyebrow?: string;
  title?: string;
  titleAccent?: string;
  /** SVG inner-markup opțional (ex. din SUPPORT_ICON) — badge lângă titlu. */
  iconSvg?: string;
}
const {
  items = defaultFaqs,
  variant = 'light',
  title = 'Ai ',
  titleAccent = 'întrebări?',
  iconSvg,
} = Astro.props;
const faqs = items;
---

<section class:list={['section', `section--${variant}`]}>
  <div class="container">
    <div class="sec-head center">
      {
        iconSvg && (
          <span class="faq-cat-ic">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={iconSvg}
            />
          </span>
        )
      }
      <h2 class="sec-title">{title}<span class="g">{titleAccent}</span></h2>
    </div>
    <div class="faq">
      {
        faqs.map((f, i) => (
          <div class:list={['faq-item', i === 0 && 'open']}>
            <button class="faq-q" aria-expanded={i === 0 ? 'true' : 'false'}>
              {f.q}
              <span class="faq-ic">
                {i === 0 ? (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.4"
                    stroke-linecap="round"
                  >
                    <path d="M5 12h14" />
                  </svg>
                ) : (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.4"
                    stroke-linecap="round"
                  >
                    <path d="M12 5v14M5 12h14" />
                  </svg>
                )}
              </span>
            </button>
            <div class="faq-a">
              <div class="faq-a-inner">
                <div class="faq-a-body">
                  {f.body.map((p) => (
                    <p set:html={p} />
                  ))}
                  {f.list && (
                    <ul>
                      {f.list.map((li) => (
                        <li>{li}</li>
                      ))}
                    </ul>
                  )}
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Badge iconiță de categorie deasupra titlului (centrat cu .sec-head.center). */
  .faq-cat-ic {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 52px;
    height: 52px;
    margin: 0 auto 14px;
    border-radius: var(--r-md);
    background: color-mix(in srgb, var(--electric) 9%, transparent);
    color: var(--electric);
  }
  .faq-cat-ic svg {
    width: 26px;
    height: 26px;
  }
  /* Linkuri din răspunsuri (injectate prin set:html, deci :global). */
  .faq-a-body :global(a) {
    color: var(--electric);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>

<script>
  // Acordeon single-open PER listă. Folosim querySelectorAll ca să meargă și când
  // sunt mai multe FaqSection pe aceeași pagină (ex. hub-ul /intrebari-frecvente).
  const setOpen = (item: HTMLElement, open: boolean) => {
    item.classList.toggle('open', open);
    const a = item.querySelector<HTMLElement>('.faq-a');
    const q = item.querySelector<HTMLButtonElement>('.faq-q');
    const ic = item.querySelector<HTMLElement>('.faq-ic svg path');
    if (a) a.style.maxHeight = open ? a.scrollHeight + 'px' : '0px';
    if (q) q.setAttribute('aria-expanded', String(open));
    if (ic) ic.setAttribute('d', open ? 'M5 12h14' : 'M12 5v14M5 12h14');
  };
  document.querySelectorAll<HTMLElement>('.faq').forEach((list) => {
    const items = Array.from(list.querySelectorAll<HTMLElement>('.faq-item'));
    items.forEach((it) => setOpen(it, it.classList.contains('open')));
    items.forEach((item) => {
      item.querySelector('.faq-q')?.addEventListener('click', () => {
        const isOpen = item.classList.contains('open');
        items.forEach((other) => setOpen(other, false));
        setOpen(item, !isOpen);
      });
    });
  });
</script>
