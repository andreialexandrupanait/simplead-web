---
/** S2 — „Pentru cine": compact, 2 coloane (titlu+lead stânga · listă problemă→consecință dreapta). */
import type { ForWhomItem } from '@data/services';

interface Props {
  items: ForWhomItem[];
  eyebrow?: string;
  title?: string;
  titleAccent?: string;
  /** Linia de „rezolvare" (lead, sub titlu, în coloana din stânga). */
  closing?: string;
}
const {
  items,
  eyebrow = 'Pentru cine',
  title = 'Sună ',
  titleAccent = 'cunoscut?',
  closing = 'Dacă te regăsești în măcar una, ești exact unde trebuie — hai să vedem ce schimbăm.',
} = Astro.props;
---

<section class="section section--tint fw-sec">
  <div class="fw-wrap">
    <div class="fw2">
      <div class="fw2__intro" data-reveal>
        <span class="sec-eyebrow">{eyebrow}</span>
        <h2 class="sec-title">{title}<span class="g">{titleAccent}</span></h2>
        {closing && <p class="fw2__lead">{closing}</p>}
      </div>

      <ul class="fw2__panel" data-reveal>
        {
          items.map((it) => (
            <li class="fw2__row">
              <p class="fw-problem">{it.problem}</p>
              <p class="fw-cost">
                <span class="fw-arrow">→</span>
                {it.cost}
              </p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  /* Padding vertical compact (în loc de cele ~110px din .container). */
  .fw-sec {
    padding-block: clamp(40px, 5vw, 64px);
  }
  .fw-wrap {
    width: 100%;
    max-width: var(--maxw);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
  .fw2 {
    display: grid;
    grid-template-columns: 0.85fr 1.15fr;
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
  }
  .fw2__intro {
    position: sticky;
    top: calc(var(--nav-h) + 28px);
  }
  .fw2__intro .sec-eyebrow {
    display: inline-flex;
  }
  .fw2__lead {
    margin-top: 16px;
    max-width: 36ch;
    font-size: 1.02rem;
    line-height: 1.55;
    color: var(--muted);
  }

  /* Panou definit (card) cu lista densă: rânduri cu divider. */
  .fw2__panel {
    list-style: none;
    margin: 0;
    padding: 6px 30px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: var(--sh-sm);
  }
  .fw2__row {
    padding: 22px 0;
    border-top: 1px solid var(--line);
  }
  .fw2__row:first-child {
    border-top: 0;
  }
  .fw-problem {
    margin: 0;
    font-size: 1.08rem;
    line-height: 1.4;
    font-weight: 700;
    color: var(--ink);
    text-wrap: balance;
  }
  .fw-cost {
    margin: 7px 0 0;
    display: flex;
    gap: 9px;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .fw-arrow {
    flex: none;
    color: var(--electric);
    font-weight: 700;
  }

  @media (max-width: 820px) {
    .fw2 {
      grid-template-columns: 1fr;
      gap: clamp(22px, 4vw, 32px);
    }
    .fw2__intro {
      position: static;
    }
    .fw2__lead {
      max-width: 56ch;
    }
  }
</style>
