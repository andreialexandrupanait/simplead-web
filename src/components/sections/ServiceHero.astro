---
/** Hero pagină detaliu serviciu (sp-hero) — crumb + titlu + acțiuni + foto. */
import { site } from '@data/site';

interface Props {
  title: string;
  titleAccent: string;
  sub: string;
  image: string;
  imageAlt?: string;
  /** Eticheta serviciului pentru breadcrumb (ultimul nod). */
  current: string;
}
const { title, titleAccent, sub, image, imageAlt = '', current } = Astro.props;
const chev = '<path d="M9 6l6 6-6 6"/>';
const phoneIcon =
  '<path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.4 0 .8-.3 1l-2.2 2.2z"/>';
const arrow = '<path d="M7 17L17 7M7 7h10v10"/>';
---

<section class="sp-hero">
  <div class="sp-hero__inner">
    <div data-reveal>
      <div class="crumb">
        <a href="/">Acasă</a>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" set:html={chev} />
        <a href="/servicii">Servicii</a>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" set:html={chev} />
        <span class="cur">{current}</span>
      </div>
      <h1>{title}<span class="g">{titleAccent}</span></h1>
      <p class="sub">{sub}</p>
      <div class="sp-hero__actions">
        <div class="btn-cta">
          <a href="/contact">Solicită ofertă
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" set:html={arrow} />
          </a>
        </div>
        <a class="gphone" href={site.contact.phoneHref}>
          <span class="gic"><svg viewBox="0 0 24 24" fill="currentColor" set:html={phoneIcon} /></span>
          <span><small>Sună-ne acum</small><b>{site.contact.phone}</b></span>
        </a>
      </div>
    </div>
    <div class="ph sp-hero__photo" data-reveal><img src={image} alt={imageAlt} /></div>
  </div>
</section>
