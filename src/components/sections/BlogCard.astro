---
/** Card de articol reutilizabil (blog index, pagini de tag, „Citește mai departe"). */
import type { Post } from '@lib/server/content';
import { authorAvatar } from '@lib/author';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const av = authorAvatar(post.author);
// Thumbnail mai mic pentru carduri (mai puțină lățime de bandă). Coperele
// self-hostate au un fișier `-800.webp` dedicat; pentru URL-uri externe (ex.
// Unsplash, la postări noi din admin) reducem `w=` din query.
const thumb = post.cover
  ? post.cover.startsWith('/blog-covers/')
    ? post.cover.replace(/\.webp$/, '-800.webp')
    : post.cover.replace(/([?&])w=\d+/, '$1w=800')
  : post.cover;
const dateStr = (post.publishedAt ?? new Date()).toLocaleDateString('ro-RO', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});
---

<a class="bcard" href={`/blog/${post.slug}`}>
  <div class="bcard__thumb">
    {
      post.cover ? (
        <img src={thumb} alt={post.title} loading="lazy" width="640" height="400" />
      ) : (
        <span class="bcard__ph">{post.title}</span>
      )
    }
    {post.category && <span class="bcard__cat">{post.category}</span>}
  </div>
  <div class="bcard__byline">
    {
      av.src ? (
        <img
          class="bcard__avatar"
          src={av.src}
          alt={post.author}
          width="28"
          height="28"
          loading="lazy"
        />
      ) : (
        <span class="bcard__avatar bcard__avatar--mono" aria-hidden="true">
          {av.monogram}
        </span>
      )
    }
    <span class="bcard__author">{post.author}</span>
    <span class="bcard__dot">·</span>
    <time datetime={(post.publishedAt ?? post.createdAt).toISOString()}>{dateStr}</time>
  </div>
  <h3 class="bcard__title">{post.title}</h3>
  <span class="bcard__more">
    Citește articolul
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <line x1="5" y1="12" x2="19" y2="12"></line>
      <polyline points="12 5 19 12 12 19"></polyline>
    </svg>
  </span>
</a>
