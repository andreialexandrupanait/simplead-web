---
/** CTA final cu decupaj (cta-notch) — folosit pe paginile de detaliu serviciu. */
import { site } from '@data/site';

interface Props {
  title: string;
  subtitle?: string;
  ctaLabel?: string;
}
const {
  title,
  subtitle = 'De la design și UX până la dezvoltare, lansare și mentenanță — livrăm produse digitale solide, bazate pe date.',
  ctaLabel = 'Discută cu un expert',
} = Astro.props;
const arrow = '<path d="M7 17L17 7M7 7h10v10"/>';
const phoneIcon =
  '<path d="M6.6 10.8c1.4 2.8 3.8 5.1 6.6 6.6l2.2-2.2c.3-.3.7-.4 1-.2 1.1.4 2.3.6 3.6.6.6 0 1 .4 1 1V20c0 .6-.4 1-1 1-9.4 0-17-7.6-17-17 0-.6.4-1 1-1h3.5c.6 0 1 .4 1 1 0 1.2.2 2.4.6 3.6.1.4 0 .8-.3 1l-2.2 2.2z"/>';
---

<section class="cta-final">
  <div class="cta-notch">
    <h2 set:html={title} />
    <p>{subtitle}</p>
    <div class="cta-actions">
      <div class="btn-cta">
        <a href="/contact">{ctaLabel}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" set:html={arrow} />
        </a>
      </div>
      <a class="phone" href={site.contact.phoneHref}>
        <span class="phone__ic"><svg viewBox="0 0 24 24" fill="currentColor" set:html={phoneIcon} /></span>
        <span class="phone__txt"><small>Sună-ne acum</small><b>{site.contact.phone}</b></span>
      </a>
    </div>
  </div>
</section>
