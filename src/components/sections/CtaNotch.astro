---
/** CTA final pe paginile de detaliu serviciu: stil dark consistent cu homepage. */
import Button from '@components/ui/Button.astro';
import { getPublicSettings, getDirectContact } from '@lib/server/public-settings';
import { phoneIconPath, whatsappIconPath } from '@lib/icons';

interface Props {
  title: string;
  subtitle?: string;
  ctaLabel?: string;
}
const {
  title,
  subtitle = 'De la design și UX până la dezvoltare, lansare și mentenanță: livrăm produse digitale solide, bazate pe date.',
  ctaLabel = 'Discută cu un expert',
} = Astro.props;
const direct = getDirectContact(await getPublicSettings());
const directIcon = direct?.kind === 'whatsapp' ? whatsappIconPath : phoneIconPath;
---

<section class="ctan">
  <div class="site-container ctan__inner" data-reveal>
    <h2 class="ctan__title" set:html={title} />
    <p class="ctan__sub">{subtitle}</p>
    <div class="ctan__actions">
      <Button href="/contact" size="lg" withArrow>{ctaLabel}</Button>
      {
        direct && (
          <a
            class="ctan__phone"
            href={direct.href}
            {...(direct.kind === 'whatsapp' ? { target: '_blank', rel: 'noopener' } : {})}
          >
            <span class="ic"><svg viewBox="0 0 24 24" fill="currentColor" set:html={directIcon} /></span>
            <span class="txt"><small>{direct.sub}</small><b>{direct.label}</b></span>
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .ctan {
    position: relative;
    background: var(--ink);
    color: #fff;
    padding-block: clamp(72px, 10vw, 124px);
    overflow: hidden;
  }
  .ctan::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
    background-size: 64px 64px;
    -webkit-mask-image: radial-gradient(90% 120% at 50% 0%, #000, transparent 75%);
    mask-image: radial-gradient(90% 120% at 50% 0%, #000, transparent 75%);
    pointer-events: none;
  }
  .ctan__inner {
    position: relative;
    max-width: 760px;
    margin-inline: auto;
    text-align: center;
  }
  .ctan__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 4.2vw, 3.2rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .ctan__title :global(.g) {
    color: var(--cyan);
  }
  .ctan__sub {
    margin-top: 18px;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--muted-dark);
  }
  .ctan__actions {
    margin-top: 32px;
    display: flex;
    gap: 24px;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
  }
  .ctan__phone {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .ctan__phone .ic {
    width: 46px;
    height: 46px;
    border-radius: var(--r-sm);
    background: var(--signal);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ctan__phone .ic svg {
    width: 20px;
    height: 20px;
    color: var(--ink);
  }
  .ctan__phone .txt {
    text-align: left;
  }
  .ctan__phone small {
    display: block;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted-dark);
  }
  .ctan__phone b {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: #fff;
  }
</style>
