---
/** „Cum începem colaborarea" (start-grid): 4 pași. */
import { startSteps } from '@data/content';

interface Props {
  variant?: 'light' | 'tint';
  eyebrow?: string;
  title?: string;
  titleAccent?: string;
  sub?: string;
}
const {
  variant = 'light',
  title = 'De la „salut" la ',
  titleAccent = 'primul rezultat',
  sub = 'Patru pași simpli, fără bătăi de cap și fără limbaj corporatist.',
} = Astro.props;
---

<section class:list={['section', `section--${variant}`]}>
  <div class="container">
    <div class="sec-head center" data-reveal>
      <h2 class="sec-title">{title}<span class="g">{titleAccent}</span></h2>
      {sub && <p class="sec-sub">{sub}</p>}
    </div>
    <div class="start-grid" data-reveal-stagger>
      {
        startSteps.map((s) => (
          <div class="start-step">
            <span class="sn">{s.n}</span>
            <h4>{s.title}</h4>
            <p>{s.text}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
