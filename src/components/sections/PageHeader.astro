---
/** Antet de pagină interioară: hero DARK (navy + glow albastru/turquoise + puncte). */
interface Crumb {
  label: string;
  href?: string;
}
interface Props {
  eyebrow?: string;
  title: string;
  accent?: string;
  subtitle?: string;
  crumb?: Crumb[];
}
const { eyebrow, title, accent, subtitle, crumb } = Astro.props;
const chev = '<path d="M9 6l6 6-6 6"/>';

function splitTitle() {
  if (accent && title.includes(accent)) {
    const [before, after] = title.split(accent);
    return { before, accent, after };
  }
  return { before: title, accent: '', after: '' };
}
const t = splitTitle();
---

<section class="page-header">
  <div class="site-container page-header__inner">
    {
      crumb && crumb.length > 0 && (
        <div class="crumb">
          {crumb.map((c, i) => (
            <>
              {i > 0 && (
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={chev}
                />
              )}
              {c.href ? <a href={c.href}>{c.label}</a> : <span class="cur">{c.label}</span>}
            </>
          ))}
        </div>
      )
    }
    {eyebrow && <span class="page-header__kicker">{eyebrow}</span>}
    <h1 class="page-header__title">
      {t.before}{t.accent && <span class="accent">{t.accent}</span>}{t.after}
    </h1>
    {subtitle && <p class="page-header__sub">{subtitle}</p>}
  </div>
</section>

<style>
  .page-header {
    position: relative;
    background: #050a33;
    color: #fff;
    overflow: hidden;
  }
  /* glow navy + albastru + turquoise (fără mov) */
  .page-header::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(50% 70% at 82% 0%, rgba(0, 119, 252, 0.26) 0%, transparent 60%),
      radial-gradient(42% 60% at 6% 30%, rgba(0, 224, 198, 0.16) 0%, transparent 60%);
  }
  /* fundal cu puncte */
  .page-header::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.05) 1px, transparent 1px);
    background-size: 30px 30px;
    pointer-events: none;
  }
  .page-header__inner {
    position: relative;
    z-index: 1;
    padding-top: calc(var(--nav-h) + var(--hero-pad-top));
    padding-bottom: var(--hero-pad-bottom);
  }
  .crumb {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.86rem;
    color: var(--muted-dark);
    margin-bottom: 18px;
  }
  .crumb svg {
    width: 14px;
    height: 14px;
    opacity: 0.6;
  }
  .crumb a:hover {
    color: var(--cyan);
  }
  .crumb .cur {
    color: #fff;
    font-weight: 600;
  }
  .page-header__kicker {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--cyan);
    margin-bottom: 14px;
  }
  .page-header__title {
    max-width: 18ch;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 4vw, 3.25rem);
    line-height: 1.14;
    letter-spacing: -0.025em;
    color: #fff;
    text-wrap: balance;
  }
  .page-header__title .accent {
    color: var(--cyan);
  }
  .page-header__sub {
    margin-top: 18px;
    max-width: 60ch;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--muted-dark);
  }
</style>
