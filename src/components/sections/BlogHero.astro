---
/** Hero DARK pentru lista de blog + paginile de tag: titlu, subtitlu, căutare. */
interface Props {
  title: string;
  subtitle?: string;
  query?: string;
}
const { title, subtitle, query = '' } = Astro.props;
const searchIcon = '<circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/>';
---

<section class="bhero">
  <div class="site-container bhero__inner">
    <div class="bhero__left">
      <h1 class="bhero__title">{title}</h1>
      {subtitle && <p class="bhero__sub">{subtitle}</p>}
    </div>
    <div class="bhero__right">
      <form class="bhero__search" method="get" action="/blog" role="search">
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          set:html={searchIcon}
        />
        <input
          type="search"
          name="q"
          value={query}
          placeholder="Caută un articol…"
          aria-label="Caută un articol"
        />
      </form>
    </div>
  </div>
</section>
