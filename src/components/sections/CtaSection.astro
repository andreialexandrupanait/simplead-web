---
import Button from '@components/ui/Button.astro';

interface Props {
  title?: string;
  subtitle?: string;
  href?: string;
  cta?: string;
  kicker?: string;
  /** Butonul secundar (default: „Vezi portofoliu" → /portofoliu). */
  secondaryHref?: string;
  secondaryLabel?: string;
  showSecondary?: boolean;
}
const {
  title = 'Gata să-ți pui afacerea pe roți?',
  subtitle = 'Hai să discutăm despre proiectul tău. Prima întâlnire e fără obligații.',
  href = '/contact',
  cta = 'Cere o ofertă',
  kicker = 'Hai să începem',
  secondaryHref = '/portofoliu',
  secondaryLabel = 'Vezi portofoliu',
  showSecondary = true,
} = Astro.props;
---

<section class="cta">
  <div class="site-container cta__inner" data-reveal>
    <p class="cta__kicker">{kicker}</p>
    <h2 class="cta__title">{title}</h2>
    <p class="cta__sub">{subtitle}</p>
    <div class="cta__actions">
      <Button href={href} size="lg" withArrow>{cta}</Button>
      {
        showSecondary && (
          <Button href={secondaryHref} size="lg" variant="outline" onDark>
            {secondaryLabel}
          </Button>
        )
      }
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    background: var(--ink);
    color: #fff;
    padding-block: clamp(72px, 10vw, 128px);
    overflow: hidden;
  }
  .cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
    background-size: 64px 64px;
    -webkit-mask-image: radial-gradient(90% 120% at 50% 0%, #000, transparent 75%);
    mask-image: radial-gradient(90% 120% at 50% 0%, #000, transparent 75%);
    pointer-events: none;
  }
  .cta__inner {
    position: relative;
    max-width: 720px;
    margin-inline: auto;
    text-align: center;
  }
  .cta__kicker {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 400;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--cyan);
  }
  .cta__kicker::before {
    content: '';
    flex: none;
    width: 30px;
    height: 1px;
    background: linear-gradient(90deg, currentColor, transparent);
  }
  .cta__title {
    margin-top: 16px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2rem, 4.2vw, 3.2rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .cta__sub {
    margin-top: 18px;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--muted-dark);
  }
  .cta__actions {
    margin-top: 32px;
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
