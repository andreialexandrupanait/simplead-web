---
/**
 * Catalog de servicii tehnice/suport pe /servicii (sub piloni).
 * Secțiuni statice pe categorii; fiecare card duce la /servicii/{slug}.
 */
import { supportCategories, supportByCategory, SUPPORT_ICON } from '@data/support-services';
---

<section class="section section--tint" id="catalog-suport">
  <div class="container">
    <div class="sec-head center" data-reveal>
      <h2 class="sec-title">Și pentru <span class="g">partea tehnică</span></h2>
      <p class="sec-sub">
        Dincolo de proiectele mari, ne ocupăm și de treaba de zi cu zi: site, server, securitate și
        urgențe. Alege ce-ți trebuie sau scrie-ne dacă nu ești sigur.
      </p>
    </div>

    {
      supportCategories.map((cat) => {
        const items = supportByCategory(cat.id);
        if (items.length === 0) return null;
        return (
          <div class="cat" data-reveal>
            <header class="cat__head">
              <h3 class="cat__title">{cat.label}</h3>
              <p class="cat__sub">{cat.sub}</p>
            </header>
            <div class="cat__grid">
              {items.map((s) => (
                <a class="svc-card" href={`/servicii/${s.slug}`}>
                  <span class="svc-card__ic">
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      set:html={SUPPORT_ICON[s.icon]}
                    />
                  </span>
                  <span class="svc-card__tag">{cat.label}</span>
                  <h4>{s.title}</h4>
                  <p>{s.cardSummary}</p>
                  <span class="svc-card__more">
                    Vezi detalii
                    <svg
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2.2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M5 12h14M13 6l6 6-6 6" />
                    </svg>
                  </span>
                </a>
              ))}
            </div>
          </div>
        );
      })
    }
  </div>
</section>

<style>
  .cat {
    margin-top: 48px;
  }
  .cat:first-of-type {
    margin-top: 40px;
  }
  .cat__head {
    margin-bottom: 20px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--line);
  }
  .cat__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.3rem, 2.2vw, 1.7rem);
    color: var(--ink);
  }
  .cat__sub {
    margin-top: 6px;
    font-size: 0.98rem;
    color: var(--muted);
  }
  .cat__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 18px;
  }
  .svc-card {
    display: flex;
    flex-direction: column;
    padding: 24px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    transition:
      transform 0.2s var(--ease-snap, ease),
      box-shadow 0.25s ease,
      border-color 0.2s ease;
  }
  .svc-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--sh-lg);
    border-color: color-mix(in srgb, var(--electric) 40%, var(--line));
  }
  .svc-card__ic {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--r-sm);
    background: var(--canvas-soft);
    color: var(--electric);
  }
  .svc-card__ic svg {
    width: 22px;
    height: 22px;
  }
  .svc-card__tag {
    margin-top: 16px;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .svc-card h4 {
    margin-top: 6px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.12rem;
    color: var(--ink);
  }
  .svc-card p {
    margin-top: 8px;
    font-size: 0.94rem;
    line-height: 1.55;
    color: var(--muted);
  }
  .svc-card__more {
    margin-top: 18px;
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-weight: 700;
    font-size: 0.88rem;
    color: var(--electric);
  }
  .svc-card__more svg {
    width: 16px;
    height: 16px;
    transition: transform 0.2s var(--ease-snap, ease);
  }
  .svc-card:hover .svc-card__more svg {
    transform: translateX(3px);
  }

  @media (max-width: 860px) {
    .cat__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (max-width: 560px) {
    .cat__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
