---
/** S4 — Ancoră de preț: carduri „de la X€" + link către /pachete#ancoră. */
import type { AnchorTier } from '@data/pricing';

interface Props {
  anchor: string;
  tiers: AnchorTier[];
  note?: string;
  variant?: 'light' | 'tint';
}
const { anchor, tiers, note, variant = 'tint' } = Astro.props;
const arrow = '<path d="M5 12h14M13 6l6 6-6 6"/>';
---

<section class:list={['section', `section--${variant}`]} id="preturi">
  <div class="container">
    <div class="sec-head center" data-reveal>
      <h2 class="sec-title">Prețuri clare, <span class="g">de la</span></h2>
    </div>
    <div class="pa-grid" data-reveal>
      {
        tiers.map((t) => (
          <div class:list={['pa-card', t.badge && 'pa-card--feat']}>
            {t.badge && <span class="pa-badge">{t.badge}</span>}
            <h3>{t.name}</h3>
            <p class="pa-price">{t.price}</p>
          </div>
        ))
      }
    </div>
    {note && <p class="pa-note">{note}</p>}
    <div class="pa-foot">
      <a class="pa-link" href={anchor}>
        Vezi toate pachetele
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.2"
          stroke-linecap="round"
          stroke-linejoin="round"
          set:html={arrow}
        />
      </a>
      <p class="pa-tva">Simplead nu e plătitor de TVA: prețurile sunt finale.</p>
    </div>
  </div>
</section>

<style>
  .pa-grid {
    margin-top: clamp(24px, 3vw, 36px);
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 16px;
    max-width: 880px;
    margin-inline: auto;
  }
  .pa-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: var(--sh-sm);
    transition:
      transform 0.2s var(--ease-snap),
      box-shadow 0.25s ease;
  }
  .pa-card:hover {
    transform: translateY(-3px);
    box-shadow: var(--sh-md);
  }
  .pa-card--feat {
    border-color: color-mix(in srgb, var(--electric) 45%, var(--line));
    background: linear-gradient(180deg, color-mix(in srgb, var(--electric) 6%, #fff), #fff 60%);
  }
  .pa-badge {
    position: absolute;
    top: 14px;
    right: -7px;
    transform: skew(-10deg);
    background: var(--signal);
    padding: 5px 12px;
    font-family: var(--font-display);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #1a1205;
    box-shadow: 0 8px 18px -8px rgba(245, 217, 63, 0.7);
  }
  .pa-card h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.05rem;
    line-height: 1.25;
    color: var(--ink);
  }
  .pa-price {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    color: var(--electric);
  }
  .pa-note {
    max-width: 880px;
    margin: 16px auto 0;
    text-align: center;
    font-size: 0.92rem;
    line-height: 1.5;
    color: var(--muted);
  }
  .pa-foot {
    margin-top: clamp(22px, 3vw, 32px);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .pa-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 26px;
    border-radius: var(--r-sm);
    background: var(--electric);
    color: #fff;
    font-weight: 700;
    box-shadow: var(--glow-electric);
    transition: filter 0.18s var(--ease-snap);
  }
  .pa-link:hover {
    filter: brightness(1.06);
  }
  .pa-link svg {
    width: 17px;
    height: 17px;
    transition: transform 0.2s var(--ease-snap);
  }
  .pa-link:hover svg {
    transform: translateX(3px);
  }
  .pa-tva {
    margin: 0;
    font-size: 0.84rem;
    color: var(--muted);
  }
</style>
