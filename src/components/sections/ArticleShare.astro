---
/** Butoane de share + copiază link pentru pagina de articol. */
interface Props {
  url: string;
  title: string;
}
const { url, title } = Astro.props;
const u = encodeURIComponent(url);
const t = encodeURIComponent(title);

const links = [
  {
    label: 'Distribuie pe LinkedIn',
    href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}`,
    icon: '<path d="M4.98 3.5a2 2 0 1 1 0 4 2 2 0 0 1 0-4ZM3.4 9h3.16v11H3.4V9Zm5.04 0h3.03v1.5h.04c.42-.8 1.45-1.64 2.99-1.64 3.2 0 3.79 2.1 3.79 4.84V20h-3.16v-4.7c0-1.12-.02-2.56-1.56-2.56-1.56 0-1.8 1.22-1.8 2.48V20H8.44V9Z"/>',
  },
  {
    label: 'Distribuie pe X',
    href: `https://twitter.com/intent/tweet?url=${u}&text=${t}`,
    icon: '<path d="M17.53 3H20l-5.6 6.4L21 21h-5.16l-4.04-5.28L7.18 21H4.7l6-6.86L3 3h5.29l3.65 4.83L17.53 3Zm-.9 16h1.37L7.43 4.4H5.96L16.63 19Z"/>',
  },
  {
    label: 'Distribuie pe Facebook',
    href: `https://www.facebook.com/sharer/sharer.php?u=${u}`,
    icon: '<path d="M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.9h2.54V9.85c0-2.51 1.49-3.9 3.78-3.9 1.1 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.78-1.63 1.57v1.88h2.78l-.44 2.9h-2.34V22c4.78-.76 8.43-4.92 8.43-9.94Z"/>',
  },
];
---

<div class="article-share">
  <span class="article-share__label">Distribuie</span>
  <div class="article-share__btns">
    {
      links.map((l) => (
        <a class="article-share__btn" href={l.href} target="_blank" rel="noopener" aria-label={l.label}>
          <svg viewBox="0 0 24 24" fill="currentColor" set:html={l.icon} />
        </a>
      ))
    }
    <button class="article-share__btn" type="button" data-copy-link={url} aria-label="Copiază linkul">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M10 13a5 5 0 0 0 7.07 0l3-3A5 5 0 0 0 13 3l-1.5 1.5" />
        <path d="M14 11a5 5 0 0 0-7.07 0l-3 3A5 5 0 0 0 11 21l1.5-1.5" />
      </svg>
    </button>
  </div>
</div>

<style>
  .article-share {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .article-share__btns {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .article-share__label {
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .article-share__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: var(--r-pill);
    border: 1px solid var(--line);
    background: #fff;
    color: var(--muted);
    cursor: pointer;
    transition:
      color 0.18s ease,
      border-color 0.18s ease,
      transform 0.18s ease;
  }
  .article-share__btn:hover {
    color: var(--electric);
    border-color: var(--electric);
    transform: translateY(-1px);
  }
  .article-share__btn.is-copied {
    color: var(--cyan);
    border-color: var(--cyan);
  }
  .article-share__btn svg {
    width: 17px;
    height: 17px;
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy-link]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const link = btn.dataset.copyLink || location.href;
      try {
        await navigator.clipboard.writeText(link);
      } catch {
        return;
      }
      btn.classList.add('is-copied');
      setTimeout(() => btn.classList.remove('is-copied'), 1600);
    });
  });
</script>
