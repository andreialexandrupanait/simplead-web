---
/** Articol featured (blog-feature) din capul paginii de blog. */
import type { Post } from '@lib/server/content';

interface Props {
  post: Post;
}
const { post } = Astro.props;
const fmt = (d: Date | null) =>
  (d ?? new Date()).toLocaleDateString('ro-RO', { year: 'numeric', month: 'long', day: 'numeric' });
const arrow = '<path d="M5 12h14M13 6l6 6-6 6"/>';
---

<article class="blog-feature">
  <a class="ph thumb" href={`/blog/${post.slug}`}>
    {post.cover ? <img src={post.cover} alt={post.title} /> : post.title}
  </a>
  <div class="body pad">
    <div class="blog-meta">
      <span class="cat">{post.tags[0] ?? 'Blog'}</span>
      <span>{fmt(post.publishedAt)}</span>
    </div>
    <h2>{post.title}</h2>
    <p>{post.description}</p>
    <div style="margin-top:22px;">
      <a class="link-more" href={`/blog/${post.slug}`}>
        Citește articolul
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" set:html={arrow} />
      </a>
    </div>
  </div>
</article>
