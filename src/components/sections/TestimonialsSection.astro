---
import { testimonials } from '@data/content';
---

<section class="section section--tint">
  <div class="container">
    <div class="sec-head center">
      <h2 class="sec-title">Ce spun <span class="g">clienții</span></h2>
    </div>
    <div class="tst-wrap">
      <div class="tst-track">
        <div class="tst-row" id="tstRow">
          {
            testimonials.map((t) => (
              <div class="tst-card">
                <div class="tst-inner">
                  <span class="tst-mark">&ldquo;</span>
                  <p class="tst-quote">{t.quote}</p>
                  <div class="tst-who">
                    {t.author}
                    <span>{t.company}</span>
                  </div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
      <div class="tst-nav" id="tstNav">
        {
          testimonials.map((_, i) => (
            <button
              class:list={['tst-dot', i === 0 && 'on']}
              data-i={i}
              aria-label={`Testimonial ${i + 1}`}
            />
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  const row = document.getElementById('tstRow');
  const nav = document.getElementById('tstNav');
  if (row && nav) {
    const dots = Array.from(nav.querySelectorAll<HTMLButtonElement>('.tst-dot'));
    const count = dots.length;
    let cur = 0;
    let timer: ReturnType<typeof setInterval>;
    const go = (i: number) => {
      cur = (i + count) % count;
      row.style.transform = 'translateX(-' + cur * 100 + '%)';
      dots.forEach((d, k) => d.classList.toggle('on', k === cur));
    };
    const start = () => {
      timer = setInterval(() => go(cur + 1), 6000);
    };
    const reset = () => {
      clearInterval(timer);
      start();
    };
    dots.forEach((d) =>
      d.addEventListener('click', () => {
        go(parseInt(d.dataset.i!, 10));
        reset();
      }),
    );
    start();
  }
</script>
