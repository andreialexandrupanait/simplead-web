---
import { getCollection } from 'astro:content';

const projects = (await getCollection('portfolio', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 6);
---

<section class="section section--navy" id="portofoliu">
  <div class="container">
    <div class="sec-head">
      <span class="sec-eyebrow">Portofoliu</span>
      <h2 class="sec-title">Proiecte de care<br /><span class="g">suntem mândri</span></h2>
      <p class="sec-sub">De la branding și magazine online, până la campanii de admitere universitară.</p>
    </div>
    <div class="pf-grid">
      {
        projects.map((entry) => (
          <a class="pf-card" href={`/portofoliu/${entry.id}`}>
            <div class="ph ph--dark pf-thumb">
              {entry.data.cover ? <img src={entry.data.cover} alt={entry.data.title} /> : entry.data.title}
            </div>
            <div class="pf-body">
              <span class="pf-tag">{entry.data.service}</span>
              <h3>{entry.data.title}</h3>
            </div>
          </a>
        ))
      }
    </div>
    <div class="pf-foot">
      <a class="pill pill--ghost" href="/portofoliu">
        Vezi tot portofoliul
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
      </a>
    </div>
  </div>
</section>
