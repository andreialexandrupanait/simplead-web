---
/** Bară subțire de progres la citit, fixată sub navbar. Urmărește scroll-ul
 * peste elementul cu [data-article] (corpul articolului). */
---

<div class="reading-progress" aria-hidden="true">
  <span class="reading-progress__bar" data-reading-bar></span>
</div>

<style>
  .reading-progress {
    position: fixed;
    top: var(--nav-h);
    left: 0;
    right: 0;
    height: 3px;
    z-index: 40;
    background: transparent;
    pointer-events: none;
  }
  .reading-progress__bar {
    display: block;
    height: 100%;
    width: 0;
    background: var(--grad, linear-gradient(90deg, var(--electric), var(--cyan)));
    transition: width 0.08s linear;
  }
</style>

<script>
  const bar = document.querySelector<HTMLElement>('[data-reading-bar]');
  const article = document.querySelector<HTMLElement>('[data-article]');
  if (bar && article) {
    const update = () => {
      const rect = article.getBoundingClientRect();
      const vh = window.innerHeight;
      const total = rect.height - vh;
      const passed = -rect.top;
      const ratio = total > 0 ? Math.min(1, Math.max(0, passed / total)) : 0;
      bar.style.width = `${ratio * 100}%`;
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
  }
</script>
