---
/** Grilă portofoliu cu filtre (pf-filters + pf-page-grid). Filtrare client-side. */
import type { Project } from '@lib/server/content';
import { excerpt } from '@lib/server/markdown';

interface Props {
  projects: Project[];
  variant?: 'light' | 'tint';
}
const { projects, variant = 'light' } = Astro.props;

// Categoriile, în ordinea preferată din export, intersectate cu ce există.
const preferred = [
  'Branding',
  'Web Design',
  'Marketing',
  'Grafică',
  'Foto-Video',
  'Social Media',
  'Mentenanță',
];
const present = new Set<string>(projects.map((p) => p.service));
const cats = ['Toate', ...preferred.filter((c) => present.has(c))];
const trend = '<path d="M3 17l6-6 4 4 7-7"/><path d="M14 7h7v7"/>';
---

<section class:list={['section', `section--${variant}`]}>
  <div class="container">
    {
      projects.length === 0 && (
        <p style="text-align:center;color:var(--ink-soft);padding:48px 0">
          Pregătim studiile de caz — revino curând.
        </p>
      )
    }
    <div class="pf-filters" id="pfFilters" role="tablist" data-reveal>
      {
        cats.map((c, i) => (
          <button
            class="pf-filter"
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            data-cat={c}
          >
            {c}
          </button>
        ))
      }
    </div>
    <div class="pf-page-grid" id="pfGrid" data-reveal-stagger>
      {
        projects.map((project) => (
          <a class="pf-page-card" href={`/portofoliu/${project.slug}`} data-cat={project.service}>
            <div class="ph thumb">
              {project.cover ? (
                <img src={project.cover} alt={project.title} loading="lazy" />
              ) : (
                project.title
              )}
            </div>
            <div class="body">
              <span class="tag">{project.service}</span>
              <h3>{project.title}</h3>
              <p>{project.summary}</p>
              {project.result && (
                <span class="pf-result">
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    set:html={trend}
                  />
                  {excerpt(project.result, 90)}
                </span>
              )}
            </div>
          </a>
        ))
      }
    </div>
  </div>
</section>

<script>
  const filters = document.getElementById('pfFilters');
  const grid = document.getElementById('pfGrid');
  if (filters && grid) {
    const btns = Array.from(filters.querySelectorAll<HTMLButtonElement>('.pf-filter'));
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.pf-page-card'));
    filters.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('.pf-filter');
      if (!btn) return;
      const cat = btn.dataset.cat;
      btns.forEach((b) => b.setAttribute('aria-selected', String(b === btn)));
      cards.forEach((c) => {
        const show = cat === 'Toate' || c.dataset.cat === cat;
        c.style.display = show ? '' : 'none';
      });
    });
  }
</script>
