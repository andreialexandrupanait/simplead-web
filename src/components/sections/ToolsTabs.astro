---
/**
 * Stack tehnologic: tab-uri segmentate + plăcuțe hexagonale (noul design).
 * Înlocuiește vechiul ToolsSection (.tech-tabs). Partajat de Acasă + hub Servicii.
 * Datele vin din content.ts (toolCategories).
 */
import { toolCategories, toolsAiNote } from '@data/content';

interface Props {
  variant?: 'light' | 'tint';
  eyebrow?: string;
  title?: string;
  titleAccent?: string;
  subtitle?: string;
  aiNote?: string;
}
const {
  variant = 'tint',
  title = 'Lucrăm cu platformele ',
  titleAccent = 'care contează',
  subtitle = 'Instrumente profesionale pentru fiecare etapă: de la design și web, la campanii și analiză.',
  aiNote = toolsAiNote,
} = Astro.props;
---

<section class:list={['section', `section--${variant}`]}>
  <div class="container">
    <div class="sec-head center" data-reveal>
      <h2 class="sec-title">{title}<span class="g">{titleAccent}</span></h2>
      {subtitle && <p class="sec-sub">{subtitle}</p>}
    </div>

    <div class="tk-tabs" id="tkTabs" role="tablist" data-reveal>
      {
        toolCategories.map((c, i) => (
          <button class="tk-tab" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-i={i}>
            {c.label}
          </button>
        ))
      }
    </div>

    <div class="tk-panel">
      {
        toolCategories.map((c, i) => (
          <div class:list={['tk-grid', i === 0 && 'on']} data-i={i}>
            {c.tools.map((t) => (
              <div class="tk-item">
                <span class="tk-hex">
                  <img src={t.logo} alt={t.name} loading="lazy" width="44" height="44" />
                </span>
                <span>{t.name}</span>
              </div>
            ))}
          </div>
        ))
      }
    </div>

    {
      aiNote && (
        <p class="tk-ainote" data-reveal>
          <span class="tk-ainote-tag">AI</span>
          {aiNote}
        </p>
      )
    }
  </div>
</section>

<style>
  .tk-ainote {
    margin: 36px auto 0;
    max-width: 72ch;
    text-align: center;
    font-size: 0.95rem;
    line-height: 1.55;
    color: var(--muted, var(--ink-soft));
  }
  .tk-ainote-tag {
    display: inline-block;
    margin-right: 8px;
    padding: 2px 8px;
    border-radius: var(--r-pill);
    font-family: var(--font-mono, monospace);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--electric);
    background: rgba(0, 119, 252, 0.1);
    vertical-align: middle;
  }
</style>

<script>
  const tabs = document.getElementById('tkTabs');
  if (tabs) {
    const btns = Array.from(tabs.querySelectorAll<HTMLButtonElement>('.tk-tab'));
    const grids = Array.from(document.querySelectorAll<HTMLElement>('.tk-grid'));
    btns.forEach((b) =>
      b.addEventListener('click', () => {
        const i = b.dataset.i;
        btns.forEach((x) => x.setAttribute('aria-selected', String(x.dataset.i === i)));
        grids.forEach((g) => g.classList.toggle('on', g.dataset.i === i));
      }),
    );
  }
</script>
