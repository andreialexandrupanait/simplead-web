---
import Logo from '@components/ui/Logo.astro';
import Button from '@components/ui/Button.astro';
import MobileMenu from '@components/react/MobileMenu';
import { mainNav } from '@data/nav';
import { useTranslations, resolveLocale } from '@i18n/index';

interface Props {
  transparent?: boolean;
  activePath?: string;
}
const { transparent = false, activePath = Astro.url.pathname } = Astro.props;
const t = useTranslations(resolveLocale(Astro.currentLocale));

const isActive = (href: string) =>
  href === '/' ? activePath === '/' : activePath.startsWith(href);
---

<header
  data-nav
  data-transparent={transparent ? 'true' : 'false'}
  class:list={[
    'z-50 flex h-[88px] items-center transition-all duration-300',
    transparent ? 'fixed inset-x-0 top-0' : 'sticky top-0 border-b border-white/8 bg-[#050a33]/85 backdrop-blur-md',
  ]}
>
  <div class="site-container flex items-center gap-7">
    <a class="flex-shrink-0" href="/" aria-label="Simplead — Acasă">
      <Logo height={34} />
    </a>

    <nav class="mx-auto hidden items-center gap-1.5 md:flex" aria-label={t.nav.mainNav}>
      {
        mainNav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'group relative mx-[11px] px-1 py-2.5 text-[15px] transition-colors',
              isActive(item.href)
                ? 'font-semibold text-white'
                : 'font-medium text-[rgba(233,238,250,0.78)] hover:text-white',
            ]}
          >
            {item.label}
            <span
              class:list={[
                'absolute inset-x-0 bottom-0.5 h-0.5 origin-left bg-white transition-transform duration-300',
                isActive(item.href) ? 'scale-x-100' : 'scale-x-0 group-hover:scale-x-100',
              ]}
            />
          </a>
        ))
      }
    </nav>

    <div class="hidden flex-shrink-0 md:block">
      <Button href="/contact" size="md">{t.nav.cta}</Button>
    </div>

    <div class="ml-auto md:hidden">
      <MobileMenu
        client:load
        items={mainNav}
        ctaLabel={t.nav.cta}
        ctaHref="/contact"
        activePath={activePath}
      />
    </div>
  </div>
</header>

<style>
  /* Navbar transparent (peste hero) devine solid la scroll — ca în export. */
  header[data-transparent='true'].nav-solid {
    height: 66px;
    background: rgba(5, 10, 51, 0.78);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 14px 40px -22px rgba(0, 0, 0, 0.7);
  }
  header[data-transparent='true'] :global(svg) {
    transition: height 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }
  header[data-transparent='true'].nav-solid :global(a[aria-label] svg) {
    height: 28px;
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>("header[data-nav][data-transparent='true']");
  if (nav) {
    const onScroll = () => nav.classList.toggle('nav-solid', window.scrollY > 28);
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }
</script>
