---
/**
 * Sparkline inline (SVG) pentru stat cards / rânduri. Fără axe, fără JS.
 * Se scalează în lățime (preserveAspectRatio none + non-scaling-stroke),
 * culorile vin din tokeni ca dark mode să meargă automat.
 */
interface Props {
  values: number[];
  width?: number;
  height?: number;
  stroke?: string;
  fill?: boolean;
  strokeWidth?: number;
  dot?: boolean;
  label?: string;
}
const {
  values,
  width = 120,
  height = 32,
  stroke = 'var(--electric)',
  fill = true,
  strokeWidth = 1.5,
  dot = true,
  label,
} = Astro.props;

const pad = 2;
const w = width;
const h = height;
const n = values.length;
const max = Math.max(1, ...values);
const min = Math.min(0, ...values);
const span = max - min || 1;

const pts = values.map((v, i) => {
  const x = n <= 1 ? w / 2 : pad + (i * (w - pad * 2)) / (n - 1);
  const y = h - pad - ((v - min) / span) * (h - pad * 2);
  return [x, y] as const;
});

const line = pts.map(([x, y], i) => `${i === 0 ? 'M' : 'L'}${x.toFixed(1)} ${y.toFixed(1)}`).join(' ');
const area = pts.length ? `${line} L${pts[pts.length - 1][0].toFixed(1)} ${h} L${pts[0][0].toFixed(1)} ${h} Z` : '';
const last = pts[pts.length - 1];
const title = label ?? `Tendință: ${values.join(', ')}`;
---

<svg
  class="admin-spark"
  viewBox={`0 0 ${w} ${h}`}
  width={w}
  height={h}
  preserveAspectRatio="none"
  role="img"
  aria-label={title}
>
  <title>{title}</title>
  {fill && area && <path d={area} fill={stroke} fill-opacity="0.08" stroke="none" />}
  <path
    d={line}
    fill="none"
    stroke={stroke}
    stroke-width={strokeWidth}
    stroke-linejoin="round"
    stroke-linecap="round"
    vector-effect="non-scaling-stroke"
  />
  {
    dot && last && (
      <circle cx={last[0]} cy={last[1]} r="2.4" fill="var(--cyan)" vector-effect="non-scaling-stroke" />
    )
  }
</svg>
