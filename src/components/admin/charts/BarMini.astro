---
/** Listă de bare mici orizontale (ex. conversii pe tip). Fără JS. */
interface Item {
  label: string;
  value: number;
}
interface Props {
  items: Item[];
  accent?: string;
  format?: (n: number) => string;
}
const { items, accent = 'var(--electric)', format = (n: number) => n.toLocaleString('ro-RO') } = Astro.props;
const top = Math.max(1, ...items.map((i) => i.value));
---

<ul class="barmini">
  {
    items.map((it) => (
      <li>
        <span class="barmini__label">{it.label}</span>
        <span class="barmini__val">{format(it.value)}</span>
        <span class="barmini__track">
          <span class="barmini__bar" style={`width:${Math.max((it.value / top) * 100, it.value ? 3 : 0)}%;background:${accent}`} />
        </span>
      </li>
    ))
  }
</ul>

<style>
  .barmini {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .barmini li {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: 4px 12px;
  }
  .barmini__label {
    font-size: 0.88rem;
    color: var(--admin-text);
    font-weight: 500;
  }
  .barmini__val {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--admin-text);
    font-variant-numeric: tabular-nums;
  }
  .barmini__track {
    grid-column: 1 / -1;
    height: 6px;
    border-radius: var(--r-pill);
    background: var(--admin-surface-2);
    overflow: hidden;
  }
  .barmini__bar {
    display: block;
    height: 100%;
    border-radius: var(--r-pill);
  }
</style>
