---
/**
 * Funnel/pipeline orizontal: fiecare etapă = bară proporțională cu numărul,
 * plus % din prima etapă. Fără JS. Tonurile mapează pe semantica StatusBadge.
 */
interface Stage {
  label: string;
  value: number;
  tone?: 'electric' | 'cyan' | 'signal' | 'info' | 'ok' | 'danger' | 'muted';
  href?: string;
}
interface Props {
  stages: Stage[];
}
const { stages } = Astro.props;

const toneColor: Record<string, string> = {
  electric: 'var(--electric)',
  cyan: 'var(--cyan)',
  signal: 'var(--signal)',
  info: 'var(--electric)',
  ok: 'var(--cyan)',
  danger: '#e0685a',
  muted: 'var(--admin-muted)',
};

const top = Math.max(1, ...stages.map((s) => s.value));
---

<ul class="funnel">
  {
    stages.map((s) => {
      const pct = Math.round((s.value / top) * 100);
      const color = toneColor[s.tone ?? 'muted'];
      const Tag = s.href ? 'a' : 'div';
      return (
        <li>
          <Tag class="funnel__row" href={s.href}>
            <span class="funnel__label">{s.label}</span>
            <span class="funnel__track">
              <span class="funnel__bar" style={`width:${Math.max(pct, s.value ? 4 : 0)}%;background:${color}`} />
            </span>
            <span class="funnel__val">
              {s.value}
              <em>{pct}%</em>
            </span>
          </Tag>
        </li>
      );
    })
  }
</ul>

<style>
  .funnel {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .funnel__row {
    display: grid;
    grid-template-columns: 96px 1fr auto;
    align-items: center;
    gap: 12px;
    color: inherit;
  }
  a.funnel__row:hover .funnel__label {
    color: var(--electric);
  }
  .funnel__label {
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--admin-text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .funnel__track {
    height: 22px;
    border-radius: var(--r-xs);
    background: var(--admin-surface-2);
    overflow: hidden;
  }
  .funnel__bar {
    display: block;
    height: 100%;
    border-radius: var(--r-xs);
    min-width: 0;
    transition: width 0.4s var(--ease, ease);
  }
  .funnel__val {
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--admin-text);
    font-variant-numeric: tabular-nums;
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    min-width: 64px;
    justify-content: flex-end;
  }
  .funnel__val em {
    font-style: normal;
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--admin-muted);
  }
</style>
