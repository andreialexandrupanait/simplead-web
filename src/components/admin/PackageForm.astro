---
/**
 * Formular partajat pentru creare/editare pachet (admin).
 * Valorile vin fie din DB (editare), fie din raw-ul formularului (la eroare).
 */
interface Props {
  values: {
    name: string;
    slug: string;
    kind: string;
    description: string;
    price: string;
    currency: string;
    interval: string;
    pricing: string;
    features: string;
    category: string;
    note: string;
    sort: number | string;
    active: boolean;
    otoPackageId: string;
    otoDiscountPercent: number | string;
  };
  errors?: Record<string, string[]>;
  submitLabel: string;
  /** Pachetele one-time care pot fi oferite ca OTO (fără pachetul curent). */
  otoCandidates?: { id: string; name: string }[];
}
const { values, errors = {}, submitLabel, otoCandidates = [] } = Astro.props;

const kinds = [
  { value: 'service', label: 'Pachet de servicii (one-time)' },
  { value: 'maintenance', label: 'Plan de mentenanță (abonament)' },
  { value: 'addon', label: 'Add-on mentenanță' },
];
const intervals = [
  { value: 'one_time', label: 'Plată unică' },
  { value: 'monthly', label: 'Lunar' },
  { value: 'yearly', label: 'Anual' },
];
const categories = [
  { value: '', label: 'Fără grupare' },
  { value: 'web', label: 'Web' },
  { value: 'grafica-marketing', label: 'Grafică & marketing' },
];
const pricings = [
  { value: 'fixed', label: 'Preț fix (afișează preț + Cumpără)' },
  { value: 'from', label: 'De la (scope variabil, doar Cere ofertă)' },
  { value: 'quote', label: 'La cerere (fără preț, doar Cere ofertă)' },
];
---

<form method="post">
  <div class="form-grid">
    <label class="admin-field">
      <span>Nume</span>
      <input class="admin-input" type="text" name="name" value={values.name} required />
      {errors.name && <small class="field-error">{errors.name[0]}</small>}
    </label>
    <label class="admin-field">
      <span>Slug</span>
      <input class="admin-input" type="text" name="slug" value={values.slug} required />
      <small>Identificator URL, ex. <code>site-prezentare</code>.</small>
      {errors.slug && <small class="field-error">{errors.slug[0]}</small>}
    </label>
    <label class="admin-field">
      <span>Tip</span>
      <select class="admin-select" name="kind">
        {
          kinds.map((k) => (
            <option value={k.value} selected={values.kind === k.value}>
              {k.label}
            </option>
          ))
        }
      </select>
    </label>
    <label class="admin-field">
      <span>Interval de plată</span>
      <select class="admin-select" name="interval">
        {
          intervals.map((i) => (
            <option value={i.value} selected={values.interval === i.value}>
              {i.label}
            </option>
          ))
        }
      </select>
    </label>
    <label class="admin-field">
      <span>Preț</span>
      <input class="admin-input" type="text" name="price" value={values.price} required />
      <small>În moneda aleasă, ex. <code>480</code> sau <code>480.50</code>.</small>
      {errors.price && <small class="field-error">{errors.price[0]}</small>}
    </label>
    <label class="admin-field">
      <span>Monedă</span>
      <select class="admin-select" name="currency">
        <option value="EUR" selected={values.currency === 'EUR'}>EUR</option>
        <option value="RON" selected={values.currency === 'RON'}>RON</option>
      </select>
    </label>
    <label class="admin-field">
      <span>Mod preț</span>
      <select class="admin-select" name="pricing">
        {
          pricings.map((p) => (
            <option value={p.value} selected={values.pricing === p.value}>
              {p.label}
            </option>
          ))
        }
      </select>
      <small>„De la"/„La cerere" ascund butonul Cumpără (scope pe ofertă).</small>
    </label>
    <label class="admin-field">
      <span>Grupare pe /pachete</span>
      <select class="admin-select" name="category">
        {
          categories.map((c) => (
            <option value={c.value} selected={values.category === c.value}>
              {c.label}
            </option>
          ))
        }
      </select>
      <small>Doar pentru pachetele de servicii (web vs. grafică & marketing).</small>
    </label>
    <label class="admin-field">
      <span>Ordine afișare</span>
      <input class="admin-input" type="number" name="sort" value={String(values.sort)} min="0" />
      <small>Număr mic = mai sus în listă.</small>
    </label>
    <label class="admin-field admin-check" style="align-self:center">
      <input type="checkbox" name="active" value="1" checked={values.active} />
      <span style="margin:0">Activ (vizibil pe site)</span>
    </label>
  </div>

  <label class="admin-field">
    <span>Descriere</span>
    <textarea class="admin-textarea" name="description">{values.description}</textarea>
    {errors.description && <small class="field-error">{errors.description[0]}</small>}
  </label>

  <label class="admin-field">
    <span>Beneficii (unul pe linie)</span>
    <textarea class="admin-textarea" name="features" rows="8">{values.features}</textarea>
    <small>
      Pentru grupuri (ex. „La început" / „Lunar"), începe un grup cu o linie
      <code>## Titlu grup</code>; liniile de sub el sunt itemele lui. Pentru un detaliu afișat la
      hover (un „i"), scrie <code>Etichetă || detaliul lung</code>.
    </small>
  </label>

  <label class="admin-field">
    <span>Notă-callout (opțional)</span>
    <textarea class="admin-textarea" name="note">{values.note}</textarea>
    <small>Text afișat vizibil pe card, ex. precizarea „nu creăm logo-uri".</small>
    {errors.note && <small class="field-error">{errors.note[0]}</small>}
  </label>

  <div class="form-grid">
    <label class="admin-field">
      <span>Ofertă OTO după cumpărare</span>
      <select class="admin-select" name="otoPackageId">
        <option value="" selected={!values.otoPackageId}>fără ofertă</option>
        {
          otoCandidates.map((c) => (
            <option value={c.id} selected={values.otoPackageId === c.id}>
              {c.name}
            </option>
          ))
        }
      </select>
      <small>
        Pachetul (cu plată unică) oferit cu discount pe pagina de mulțumire, valabil 30 de minute.
      </small>
      {errors.otoPackageId && <small class="field-error">{errors.otoPackageId[0]}</small>}
    </label>
    <label class="admin-field">
      <span>Discount OTO (%)</span>
      <input
        class="admin-input"
        type="number"
        name="otoDiscountPercent"
        value={String(values.otoDiscountPercent)}
        min="0"
        max="90"
      />
      {
        errors.otoDiscountPercent && (
          <small class="field-error">{errors.otoDiscountPercent[0]}</small>
        )
      }
    </label>
  </div>

  <div class="admin-actions">
    <button type="submit" class="admin-btn">{submitLabel}</button>
    <a href="/admin/pachete" class="admin-btn admin-btn--ghost">Renunță</a>
  </div>
</form>

<style>
  .form-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    column-gap: 20px;
  }
  .field-error {
    color: #8a2424;
    font-weight: 600;
  }
</style>
