---
/**
 * Logo/emblemă pentru o integrare: plăcuță rotunjită cu culoarea brandului și
 * un glyph alb. Consistent vizual pe toate integrările. Google folosește „G"-ul
 * oficial pe fundal alb. `name` = cheia integrării din registrul INTEGRATIONS.
 */
interface Props {
  name: string;
  size?: number;
}
const { name, size = 44 } = Astro.props;

// bg = fundal plăcuță, glyph = SVG interior (alb), monogram = literă fallback.
const BRANDS: Record<string, { bg: string; glyph?: string; mono?: string }> = {
  stripe: {
    bg: '#635BFF',
    // „S" stilizat Stripe.
    glyph:
      '<path fill="#fff" d="M13.5 9.2c0-.7.6-1 1.5-1 1.3 0 3 .4 4.3 1.1V5.5C18 5 16.6 4.8 15 4.8c-3.4 0-5.7 1.8-5.7 4.8 0 4.6 6.4 3.9 6.4 5.9 0 .8-.7 1.1-1.7 1.1-1.5 0-3.4-.6-4.9-1.4v3.9c1.6.7 3.3 1 4.9 1 3.5 0 5.9-1.7 5.9-4.8 0-5-6.4-4.2-6.4-6.1Z"/>',
  },
  smartbill: {
    bg: '#0F9D58',
    // Bon/factură.
    glyph:
      '<path fill="#fff" d="M7 3h10a1 1 0 0 1 1 1v16l-2.5-1.5L13 20l-2.5-1.5L8 20l-2.5-1.5L6 19V4a1 1 0 0 1 1-1Zm1.5 4.5h7v1.5h-7V7.5Zm0 3.5h7v1.5h-7V11Zm0 3.5h4.5V16H8.5v-1.5Z"/>',
  },
  postmark: {
    bg: '#FFCB2E',
    // Plic.
    glyph:
      '<path fill="#1b1b1b" d="M4 6.5A1.5 1.5 0 0 1 5.5 5h13A1.5 1.5 0 0 1 20 6.5v11A1.5 1.5 0 0 1 18.5 19h-13A1.5 1.5 0 0 1 4 17.5v-11Zm2 .8 6 4 6-4V6.8l-6 4-6-4v.5Z"/>',
  },
  email: {
    bg: '#0077fc',
    glyph:
      '<path fill="#fff" d="M4 6.5A1.5 1.5 0 0 1 5.5 5h13A1.5 1.5 0 0 1 20 6.5v11A1.5 1.5 0 0 1 18.5 19h-13A1.5 1.5 0 0 1 4 17.5v-11Zm2 .8 6 4 6-4V6.8l-6 4-6-4v.5Z"/>',
  },
  slack: {
    bg: '#4A154B',
    // Patru forme (simplificat hashtag).
    glyph:
      '<path fill="#fff" d="M9.5 4.2A1.8 1.8 0 1 1 7.7 6h1.8V4.2Zm0 3.6H4.8a1.8 1.8 0 1 0 0 3.6h4.7V7.8Zm10.3 1.8A1.8 1.8 0 1 1 18 7.8h1.8v1.8Zm-3.6 0V4.8a1.8 1.8 0 1 0-3.6 0v4.8h3.6Zm-1.8 10.2A1.8 1.8 0 1 1 16.2 18h-1.8v1.8Zm0-3.6h4.7a1.8 1.8 0 1 0 0-3.6h-4.7v3.6ZM4.2 14.4A1.8 1.8 0 1 1 6 16.2H4.2v-1.8Zm3.6 0v4.8a1.8 1.8 0 1 0 3.6 0v-4.8H7.8Z"/>',
  },
  google: {
    bg: '#ffffff',
    glyph:
      '<path fill="#4285F4" d="M21.6 12.2c0-.7-.06-1.37-.18-2.02H12v3.83h5.4a4.6 4.6 0 0 1-2 3.02v2.5h3.23c1.9-1.74 2.97-4.3 2.97-7.33Z"/><path fill="#34A853" d="M12 22c2.7 0 4.97-.9 6.63-2.43l-3.24-2.5c-.9.6-2.05.96-3.39.96-2.6 0-4.8-1.76-5.59-4.12H3.07v2.58A10 10 0 0 0 12 22Z"/><path fill="#FBBC05" d="M6.41 13.91a6 6 0 0 1 0-3.82V7.51H3.07a10 10 0 0 0 0 8.98l3.34-2.58Z"/><path fill="#EA4335" d="M12 6.96c1.47 0 2.79.5 3.83 1.5l2.87-2.87C16.96 3.98 14.7 3 12 3a10 10 0 0 0-8.93 5.5l3.34 2.6C7.2 8.72 9.4 6.96 12 6.96Z"/>',
  },
};

const brand = BRANDS[name] ?? { bg: 'var(--ink)', mono: name.charAt(0).toUpperCase() };
const radius = Math.round(size * 0.28);
---

<span
  class="int-logo"
  style={`width:${size}px;height:${size}px;border-radius:${radius}px;background:${brand.bg};${name === 'google' ? 'border:1px solid var(--line);' : ''}`}
  aria-hidden="true"
>
  {
    brand.glyph ? (
      <svg viewBox="0 0 24 24" width={size * 0.6} height={size * 0.6} set:html={brand.glyph} />
    ) : (
      <span class="int-logo__mono">{brand.mono}</span>
    )
  }
</span>

<style>
  .int-logo {
    display: inline-grid;
    place-items: center;
    flex: none;
    box-shadow: var(--sh-sm);
  }
  .int-logo__mono {
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
  }
</style>
