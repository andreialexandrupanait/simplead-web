---
/** Formular partajat pentru proiectele de portofoliu (nou + editare). */
import MarkdownEditor from '../react/admin/MarkdownEditor';
import CoverField from '../react/admin/CoverField';
import { projectServices } from '../../lib/server/admin-schemas';

interface Props {
  values: Record<string, string>;
  errors?: Record<string, string[]>;
  submitLabel: string;
  publishedSlug?: string;
  previewHref?: string;
  deleteAction?: boolean;
}
const { values, errors = {}, submitLabel, publishedSlug, previewHref, deleteAction } = Astro.props;
const err = (field: string) => errors[field]?.[0];
---

<form method="post">
  <div class="post-form-cols">
    <div>
      <div class="admin-card">
        <label class="admin-field">
          <span>Titlu proiect</span>
          <input
            class="admin-input"
            type="text"
            name="title"
            value={values.title}
            required
            id="pfTitle"
          />
          {err('title') && <small class="field-error">{err('title')}</small>}
        </label>
        <label class="admin-field">
          <span>Slug (URL: /portofoliu/<em>slug</em>)</span>
          <input
            class="admin-input"
            type="text"
            name="slug"
            value={values.slug}
            required
            id="pfSlug"
            data-published-slug={publishedSlug ?? ''}
          />
          {err('slug') && <small class="field-error">{err('slug')}</small>}
          <small id="pfSlugWarn" style="display:none;color:#7a6505">
            Atenție: schimbarea slug-ului unui proiect publicat rupe linkurile existente.
          </small>
        </label>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
          <label class="admin-field">
            <span>Client</span>
            <input class="admin-input" type="text" name="client" value={values.client} />
          </label>
          <label class="admin-field">
            <span>Serviciu</span>
            <select class="admin-select" name="service">
              {
                projectServices.map((s) => (
                  <option value={s} selected={values.service === s}>
                    {s}
                  </option>
                ))
              }
            </select>
          </label>
        </div>
        <label class="admin-field">
          <span>Rezumat (apare pe card și sub titlu)</span>
          <textarea class="admin-textarea" name="summary" style="min-height:60px"
            >{values.summary}</textarea
          >
          {err('summary') && <small class="field-error">{err('summary')}</small>}
        </label>
        <label class="admin-field">
          <span>Rezultat (apare pe card și în panoul lateral: cifre concrete, dacă există)</span>
          <textarea class="admin-textarea" name="result" style="min-height:60px"
            >{values.result}</textarea
          >
        </label>
      </div>

      <div class="admin-card" style="margin-top:20px">
        <h2>Studiul de caz</h2>
        <p class="admin-hint">Povestea proiectului, în Markdown.</p>
        <MarkdownEditor client:load name="body" initial={values.body} />
      </div>
    </div>

    <div>
      <div class="admin-card">
        <h2>Publicare</h2>
        <label class="admin-field">
          <span>Status</span>
          <select class="admin-select" name="status">
            <option value="draft" selected={values.status !== 'published'}
              >Draft (nepublicat)</option
            >
            <option value="published" selected={values.status === 'published'}>Publicat</option>
          </select>
        </label>
        <label class="admin-field">
          <span>Ordine în listă (mai mic = mai sus)</span>
          <input
            class="admin-input"
            type="number"
            name="sort"
            value={values.sort}
            min="0"
            max="9999"
          />
        </label>
        <div class="admin-actions">
          <button type="submit" class="admin-btn">{submitLabel}</button>
          {
            previewHref && (
              <a
                class="admin-btn admin-btn--ghost admin-btn--sm"
                href={previewHref}
                target="_blank"
                rel="noopener"
              >
                Previzualizează ↗
              </a>
            )
          }
        </div>
      </div>

      <div class="admin-card" style="margin-top:20px">
        <h2>Detalii</h2>
        <label class="admin-field">
          <span>Imagine de copertă</span>
          <CoverField client:load name="cover" initial={values.cover} />
        </label>
        <label class="admin-field">
          <span>Provocarea (opțional)</span>
          <textarea class="admin-textarea" name="challenge" style="min-height:60px"
            >{values.challenge}</textarea
          >
        </label>
        <label class="admin-field">
          <span>Soluția (opțional)</span>
          <textarea class="admin-textarea" name="solution" style="min-height:60px"
            >{values.solution}</textarea
          >
        </label>
      </div>

      <details class="admin-card" style="margin-top:20px">
        <summary style="cursor:pointer;font-weight:600">SEO (opțional)</summary>
        <label class="admin-field" style="margin-top:14px">
          <span>Titlu SEO</span>
          <input class="admin-input" type="text" name="seoTitle" value={values.seoTitle} />
        </label>
        <label class="admin-field">
          <span>Descriere SEO</span>
          <textarea class="admin-textarea" name="seoDescription" style="min-height:60px"
            >{values.seoDescription}</textarea
          >
        </label>
      </details>

      {
        deleteAction && (
          <div class="admin-card" style="margin-top:20px">
            <h2>Zonă periculoasă</h2>
            <p class="admin-hint">Ștergerea e definitivă; proiectul dispare imediat de pe site.</p>
            <button
              type="submit"
              name="action"
              value="delete"
              class="admin-btn admin-btn--danger admin-btn--sm"
              onclick="return confirm('Sigur ștergi proiectul? Acțiunea e definitivă.')"
            >
              Șterge proiectul
            </button>
          </div>
        )
      }
    </div>
  </div>
</form>

<style>
  .post-form-cols {
    display: grid;
    grid-template-columns: 1fr 330px;
    gap: 20px;
    align-items: start;
  }
  @media (max-width: 1100px) {
    .post-form-cols {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const title = document.getElementById('pfTitle') as HTMLInputElement | null;
  const slug = document.getElementById('pfSlug') as HTMLInputElement | null;
  const warn = document.getElementById('pfSlugWarn');
  if (title && slug) {
    const published = slug.dataset.publishedSlug || '';
    let touched = slug.value !== '';
    const slugify = (s: string) =>
      s
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '')
        .slice(0, 120);
    title.addEventListener('input', () => {
      if (!touched && !published) slug.value = slugify(title.value);
    });
    slug.addEventListener('input', () => {
      touched = true;
      if (warn && published) {
        warn.style.display = slug.value !== published ? 'block' : 'none';
      }
    });
  }
</script>
