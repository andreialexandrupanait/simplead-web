---
/**
 * Formular partajat pentru articole (nou + editare), layout în stil WordPress:
 * titlu mare + slug inline sus, editorul pe toată lățimea, setările grupate
 * dedesubt și un savebar lipicios mereu la îndemână. Server-ul validează cu
 * postFormSchema; aici doar afișăm valorile + erorile per câmp.
 */
import MarkdownEditor from '../react/admin/MarkdownEditor';
import CoverField from '../react/admin/CoverField';
import { postCategories } from '@data/categories';

interface Props {
  values: Record<string, string>;
  errors?: Record<string, string[]>;
  submitLabel: string;
  /** Slug-ul publicat curent (avertisment la schimbare). */
  publishedSlug?: string;
  /** Link de previzualizare (doar la editare). */
  previewHref?: string;
  /** Acțiune de ștergere (doar la editare). */
  deleteAction?: boolean;
}
const { values, errors = {}, submitLabel, publishedSlug, previewHref, deleteAction } = Astro.props;
const err = (field: string) => errors[field]?.[0];
const hasErrors = Object.keys(errors).length > 0;
---

<form method="post" id="postForm">
  {
    hasErrors && (
      <div class="admin-banner admin-banner--error">
        Formularul are erori. Verifică câmpurile marcate cu roșu.
      </div>
    )
  }

  <div class="pf-head">
    <div class="admin-card pf-head__main">
      <input
        class="admin-title-input"
        type="text"
        name="title"
        value={values.title}
        required
        id="pfTitle"
        placeholder="Titlul articolului…"
        autocomplete="off"
      />
      {
        err('title') && (
          <small class="field-error" style="display:block">
            {err('title')}
          </small>
        )
      }
      <div class="admin-slug-line">
        <span>simplead.ro/blog/</span>
        <input
          type="text"
          name="slug"
          value={values.slug}
          required
          id="pfSlug"
          data-published-slug={publishedSlug ?? ''}
          autocomplete="off"
          spellcheck="false"
        />
      </div>
      {
        err('slug') && (
          <small class="field-error" style="display:block;margin-top:4px">
            {err('slug')}
          </small>
        )
      }
      <small id="pfSlugWarn" style="display:none;color:#7a6505;margin-top:4px">
        ⚠ Schimbarea slug-ului unui articol publicat rupe linkurile existente (Google, social
        media).
      </small>
      <label class="admin-field" style="margin:16px 0 0">
        <span
          >Descriere scurtă <small style="display:inline;color:var(--muted)"
            >(apare în listă și în Google, max 300 caractere)</small
          ></span
        >
        <textarea class="admin-textarea" name="description" style="min-height:58px"
          >{values.description}</textarea
        >
        {err('description') && <small class="field-error">{err('description')}</small>}
      </label>
    </div>

    <div class="admin-card pf-head__side">
      <h2>Publicare</h2>
      <label class="admin-field">
        <span>Status</span>
        <select class="admin-select" name="status" id="pfStatus">
          <option value="draft" selected={values.status !== 'published'}>Draft (nepublicat)</option>
          <option value="published" selected={values.status === 'published'}>Publicat</option>
        </select>
      </label>
      <label class="admin-field">
        <span>Data publicării</span>
        <input
          class="admin-input"
          type="datetime-local"
          name="publishedAt"
          value={values.publishedAt}
        />
        <small>Gol = data curentă la prima publicare.</small>
      </label>
      <label class="admin-field" style="margin-bottom:0">
        <span>Autor</span>
        <input class="admin-input" type="text" name="author" value={values.author} />
      </label>
    </div>
  </div>

  <div
    class="admin-card"
    style="margin-top:20px;padding:0;border:none;box-shadow:none;background:transparent"
  >
    <MarkdownEditor client:load name="body" initial={values.body} />
  </div>

  <div class="pf-meta">
    <div class="admin-card">
      <h2>Copertă, categorie & taguri</h2>
      <label class="admin-field">
        <span>Imagine de copertă</span>
        <CoverField client:load name="cover" initial={values.cover} />
      </label>
      <label class="admin-field">
        <span>Categorie</span>
        <select class="admin-select" name="category">
          <option value="" selected={!values.category}>Fără categorie</option>
          {
            postCategories.map((c) => (
              <option value={c} selected={values.category === c}>
                {c}
              </option>
            ))
          }
        </select>
        <small>Apare ca filtru pe /blog și ca etichetă principală pe card.</small>
      </label>
      <label class="admin-field" style="margin-bottom:0">
        <span>Taguri (separate prin virgulă)</span>
        <input
          class="admin-input"
          type="text"
          name="tags"
          value={values.tags}
          placeholder="Neuromarketing, SEO"
        />
        <small>Tag-uri secundare (pagini /blog/tag/... pentru SEO).</small>
      </label>
    </div>

    <div class="admin-card">
      <h2>
        Pe scurt & FAQ <small style="display:inline;font-weight:400;color:var(--muted)"
          >(opțional)</small
        >
      </h2>
      <label class="admin-field">
        <span>Pe scurt · concluzii cheie</span>
        <textarea
          class="admin-textarea"
          name="takeaways"
          style="min-height:88px"
          placeholder="O concluzie pe rând…">{values.takeaways}</textarea
        >
        <small>O concluzie pe rând. Apar într-o casetă sus, sub titlu.</small>
      </label>
      <label class="admin-field" style="margin-bottom:0">
        <span>Întrebări frecvente</span>
        <textarea
          class="admin-textarea"
          name="faq"
          style="min-height:140px"
          placeholder={'Ce este X?\nRăspunsul la întrebare, pe unul sau mai multe paragrafe.\n---\nCât costă Y?\nAlt răspuns.'}
          >{values.faq}</textarea
        >
        <small
          >O întrebare per bloc: prima linie = întrebarea, restul = răspunsul. Separă întrebările cu
          o linie <code>---</code>. Apar ca acordeon la final + în Google (schema FAQ).</small
        >
      </label>
    </div>

    <div class="admin-card">
      <h2>
        SEO <small style="display:inline;font-weight:400;color:var(--muted)">(opțional)</small>
      </h2>
      <label class="admin-field">
        <span>Titlu SEO</span>
        <input class="admin-input" type="text" name="seoTitle" value={values.seoTitle} />
        <small>Gol = se folosește titlul articolului.</small>
      </label>
      <label class="admin-field" style="margin-bottom:0">
        <span>Descriere SEO</span>
        <textarea class="admin-textarea" name="seoDescription" style="min-height:58px"
          >{values.seoDescription}</textarea
        >
        <small>Gol = se folosește descrierea scurtă.</small>
      </label>
    </div>

    {
      deleteAction && (
        <div class="admin-card">
          <h2>Zonă periculoasă</h2>
          <p class="admin-hint">Ștergerea e definitivă; articolul dispare imediat de pe site.</p>
          <button
            type="submit"
            name="action"
            value="delete"
            class="admin-btn admin-btn--danger admin-btn--sm"
            onclick="return confirm('Sigur ștergi articolul? Acțiunea e definitivă.')"
          >
            Șterge articolul
          </button>
        </div>
      )
    }
  </div>

  <div class="admin-savebar">
    <button type="submit" class="admin-btn">{submitLabel}</button>
    {
      previewHref && (
        <a
          class="admin-btn admin-btn--ghost admin-btn--sm"
          href={previewHref}
          target="_blank"
          rel="noopener"
        >
          Previzualizează ↗
        </a>
      )
    }
    <span class="spacer"></span>
    <span class="savebar-status" id="pfSavebarStatus"></span>
  </div>
</form>

<style>
  .pf-head {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 20px;
    align-items: start;
  }
  .pf-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 20px;
    margin-top: 20px;
  }
  @media (max-width: 1000px) {
    .pf-head {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Slug sugerat din titlu (cât timp nu e editat manual și articolul nu e
  // publicat) + avertisment la schimbarea unui slug publicat + status în savebar.
  const title = document.getElementById('pfTitle') as HTMLInputElement | null;
  const slug = document.getElementById('pfSlug') as HTMLInputElement | null;
  const warn = document.getElementById('pfSlugWarn');
  const statusSel = document.getElementById('pfStatus') as HTMLSelectElement | null;
  const savebarStatus = document.getElementById('pfSavebarStatus');

  const syncSavebar = () => {
    if (savebarStatus && statusSel) {
      savebarStatus.textContent =
        statusSel.value === 'published'
          ? 'La salvare: articolul va fi PUBLIC pe site.'
          : 'La salvare: rămâne draft (doar tu îl vezi).';
    }
  };
  syncSavebar();
  statusSel?.addEventListener('change', syncSavebar);

  if (title && slug) {
    const published = slug.dataset.publishedSlug || '';
    let touched = slug.value !== '';
    const slugify = (s: string) =>
      s
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9]+/g, '-')
        .replace(/^-+|-+$/g, '')
        .slice(0, 120);
    title.addEventListener('input', () => {
      if (!touched && !published) slug.value = slugify(title.value);
    });
    slug.addEventListener('input', () => {
      touched = true;
      if (warn && published) {
        warn.style.display = slug.value !== published ? 'block' : 'none';
      }
    });
  }
</script>
