---
/** Antet de secțiune: kicker monospace opțional + titlu + subtitlu. */
interface Props {
  eyebrow?: string;
  title: string;
  /** Partea din titlu evidențiată cu accent (trebuie să apară în `title`). */
  accent?: string;
  subtitle?: string;
  align?: 'left' | 'center';
  /** Pe secțiuni dark (fundal --ink). */
  onDark?: boolean;
  class?: string;
}

const {
  title,
  accent,
  subtitle,
  align = 'left',
  onDark = false,
  class: className = '',
} = Astro.props;

function renderTitle() {
  if (accent && title.includes(accent)) {
    const [before, after] = title.split(accent);
    return { before, accent, after };
  }
  return { before: title, accent: '', after: '' };
}
const t = renderTitle();
---

<div class:list={['sh', align === 'center' && 'sh--center', onDark && 'sh--dark', className]}>
  <h2 class="sh__title">
    {t.before}{t.accent && <span class="sh__accent">{t.accent}</span>}{t.after}
  </h2>
  {subtitle && <p class="sh__sub">{subtitle}</p>}
</div>

<style>
  .sh {
    max-width: 40rem;
  }
  .sh--center {
    margin-inline: auto;
    text-align: center;
  }
  .sh__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.9rem, 3.2vw, 2.85rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-wrap: balance;
  }
  .sh--dark .sh__title {
    color: #fff;
  }
  /* Accentul rămâne solid (culoarea titlului) — cuvintele colorate doar în hero. */
  .sh__accent {
    color: inherit;
  }
  .sh__sub {
    margin-top: 10px;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--muted);
    text-wrap: balance;
  }
  .sh--dark .sh__sub {
    color: var(--muted-dark);
  }
</style>
