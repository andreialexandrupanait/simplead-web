---
/**
 * Buton oblic (skew -10deg): semnătura vizuală Simplead, păstrată din vechiul
 * design dar pe paleta nouă FLAT (fără gradient mov).
 *  - primary : fundal electric, text alb, glow electric→cyan la hover
 *  - outline : 1px contur, fundal transparent (CTA secundar / low-commitment)
 *  - yellow  : accent signal (rar)
 */
interface Props {
  href: string;
  variant?: 'primary' | 'outline' | 'yellow';
  size?: 'md' | 'lg';
  withArrow?: boolean;
  /** Pe fundal dark (ex. secțiuni navy), outline-ul devine deschis. */
  onDark?: boolean;
  class?: string;
  rel?: string;
  target?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  withArrow = false,
  onDark = false,
  class: className = '',
  rel,
  target,
} = Astro.props;
---

<a
  href={href}
  rel={rel}
  target={target}
  class:list={['btn', `btn--${variant}`, `btn--${size}`, onDark && 'btn--on-dark', className]}
>
  <span class="btn__inner">
    <slot />
    {
      withArrow && (
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.3"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="btn__arrow"
          aria-hidden="true"
        >
          <path d="M5 12h14M13 6l6 6-6 6" />
        </svg>
      )
    }
  </span>
</a>

<style>
  .btn {
    display: inline-block;
    transform: skew(-10deg);
    border-radius: var(--r-xs);
    border: 1px solid transparent;
    transition:
      transform 0.18s var(--ease-snap),
      box-shadow 0.25s var(--ease-snap),
      background-color 0.18s var(--ease-snap),
      color 0.18s var(--ease-snap),
      border-color 0.18s var(--ease-snap);
  }
  .btn__inner {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    transform: skew(10deg);
    font-family: var(--font-body);
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* Mărimi (padding pe ancoră, ca skew-ul să prindă tot) */
  .btn--md {
    padding: 13px 24px;
    font-size: 0.86rem;
  }
  .btn--lg {
    padding: 16px 30px;
    font-size: 0.92rem;
  }

  /* Primar: electric flat */
  .btn--primary {
    background: var(--electric);
    color: #fff;
    box-shadow: var(--glow-electric);
  }
  .btn--primary:hover {
    transform: skew(-10deg) translateY(-2px);
    box-shadow: var(--glow-electric);
  }

  /* Secundar: outline (low-commitment) */
  .btn--outline {
    background: transparent;
    color: var(--ink);
    border-color: var(--ink);
  }
  .btn--outline:hover {
    transform: skew(-10deg) translateY(-2px);
    background: var(--canvas-soft);
    border-color: var(--electric);
    color: var(--electric);
  }
  .btn--outline.btn--on-dark {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.35);
  }
  .btn--outline.btn--on-dark:hover {
    background: rgba(255, 255, 255, 0.06);
    border-color: var(--cyan);
    color: var(--cyan);
  }

  /* Accent rar: signal */
  .btn--yellow {
    background: var(--signal);
    color: var(--ink);
    box-shadow: 0 14px 30px -14px rgba(245, 217, 63, 0.6);
  }
  .btn--yellow:hover {
    transform: skew(-10deg) translateY(-2px);
    box-shadow: 0 14px 30px -14px rgba(245, 217, 63, 0.6);
  }

  .btn__arrow {
    width: 17px;
    height: 17px;
    transition: transform 0.2s var(--ease-snap);
  }
  .btn:hover .btn__arrow {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .btn,
    .btn__arrow {
      transition: none;
    }
    .btn:hover {
      transform: skew(-10deg);
    }
  }
</style>
