---
/**
 * Buton Simplead — identitate proprie (NU mai e parallelogramul skew, ca să nu
 * semene cu thecon.ro). Două semnături:
 *  - primary / yellow : DEPTH — corp dreptunghiular (colțuri drepte) care „se
 *    apasă” fizic într-o bază de dedesubt (hover ridică, click coboară).
 *  - outline          : KEYLINE · DUO — dreptunghi curat cu două linii care se
 *    desfac din centru sus & jos la hover (secundar rafinat).
 * API neschimbat: variant / size / onDark / withArrow.
 */
interface Props {
  href: string;
  variant?: 'primary' | 'outline' | 'yellow';
  size?: 'md' | 'lg';
  withArrow?: boolean;
  /** Pe fundal dark (ex. secțiuni navy), outline-ul devine deschis. */
  onDark?: boolean;
  class?: string;
  rel?: string;
  target?: string;
}

const {
  href,
  variant = 'primary',
  size = 'md',
  withArrow = false,
  onDark = false,
  class: className = '',
  rel,
  target,
} = Astro.props;

// Doar variantele „solide” au baza fizică de dedesubt.
const hasBase = variant === 'primary' || variant === 'yellow';
---

<a
  href={href}
  rel={rel}
  target={target}
  class:list={['btn', `btn--${variant}`, `btn--${size}`, onDark && 'btn--on-dark', className]}
>
  {hasBase && <span class="btn__base" aria-hidden="true" />}
  <span class="btn__face">
    <span class="btn__inner">
      <slot />
      {
        withArrow && (
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.3"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="btn__arrow"
            aria-hidden="true"
          >
            <path d="M5 12h14M13 6l6 6-6 6" />
          </svg>
        )
      }
    </span>
  </span>
</a>

<style>
  .btn {
    position: relative;
    display: inline-block;
    text-decoration: none;
  }
  .btn__face {
    position: relative;
    display: inline-block;
  }
  .btn__inner {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    font-family: var(--font-body);
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  /* Mărimi (padding pe inner) */
  .btn--md .btn__inner {
    padding: 13px 24px;
    font-size: 0.86rem;
  }
  .btn--lg .btn__inner {
    padding: 16px 30px;
    font-size: 0.92rem;
  }

  /* ============================================================
     DEPTH · NOTCH — primary & yellow
     ============================================================ */
  .btn--primary,
  .btn--yellow {
    margin-bottom: 6px;
  }
  .btn--primary .btn__base,
  .btn--primary .btn__face,
  .btn--yellow .btn__base,
  .btn--yellow .btn__face {
    border-radius: 2px;
  }
  .btn--primary .btn__base,
  .btn--yellow .btn__base {
    position: absolute;
    inset: 0;
    transform: translateY(6px);
    z-index: 0;
  }
  .btn--primary .btn__face,
  .btn--yellow .btn__face {
    z-index: 1;
    transition: transform 0.1s var(--ease-snap);
  }
  .btn--primary:hover .btn__face,
  .btn--yellow:hover .btn__face {
    transform: translateY(3px);
  }
  .btn--primary:active .btn__face,
  .btn--yellow:active .btn__face {
    transform: translateY(6px);
  }

  /* Primary: electric face, bază albastră închisă */
  .btn--primary .btn__face {
    background: var(--electric);
    color: #fff;
  }
  .btn--primary .btn__base {
    background: #0a3bd0;
  }

  /* Yellow: accent signal, bază galben închis */
  .btn--yellow .btn__face {
    background: var(--signal);
    color: var(--ink);
  }
  .btn--yellow .btn__base {
    background: #cdaf1c;
  }

  /* ============================================================
     KEYLINE · DUO — outline (secundar)
     ============================================================ */
  .btn--outline .btn__face {
    border-radius: 2px;
    background: transparent;
    color: var(--ink);
    box-shadow: inset 0 0 0 1.5px var(--line);
    transition: color 0.18s var(--ease-snap);
  }
  .btn--outline .btn__face::before,
  .btn--outline .btn__face::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    height: 2.5px;
    background: var(--electric);
    transform: scaleX(0);
    transition: transform 0.32s var(--ease-snap);
    z-index: 2;
  }
  .btn--outline .btn__face::before {
    top: 0;
  }
  .btn--outline .btn__face::after {
    bottom: 0;
  }
  .btn--outline:hover .btn__face {
    color: var(--electric);
  }
  .btn--outline:hover .btn__face::before,
  .btn--outline:hover .btn__face::after {
    transform: scaleX(1);
  }

  /* Outline pe fundal dark */
  .btn--outline.btn--on-dark .btn__face {
    color: #fff;
    box-shadow: inset 0 0 0 1.5px rgba(255, 255, 255, 0.24);
  }
  .btn--outline.btn--on-dark .btn__face::before,
  .btn--outline.btn--on-dark .btn__face::after {
    background: var(--cyan);
  }
  .btn--outline.btn--on-dark:hover .btn__face {
    color: var(--cyan);
  }

  /* ============================================================
     Săgeată
     ============================================================ */
  .btn__arrow {
    width: 17px;
    height: 17px;
    transition: transform 0.2s var(--ease-snap);
  }
  .btn:hover .btn__arrow {
    transform: translateX(3px);
  }

  /* Pe mobil: padding mai mic ca 2 butoane să încapă unul lângă altul. */
  @media (max-width: 480px) {
    .btn--md .btn__inner {
      padding: 12px 16px;
    }
    .btn--lg .btn__inner {
      padding: 14px 18px;
      font-size: 0.88rem;
    }
    .btn__inner {
      gap: 7px;
      letter-spacing: 0.02em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .btn__face,
    .btn__arrow,
    .btn--outline .btn__face::before,
    .btn--outline .btn__face::after {
      transition: none;
    }
    .btn--primary:hover .btn__face,
    .btn--yellow:hover .btn__face,
    .btn--primary:active .btn__face,
    .btn--yellow:active .btn__face {
      transform: none;
    }
  }
</style>
