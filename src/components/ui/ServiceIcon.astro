---
import type { ServiceIcon } from '@data/services';
/** Iconițe SVG inline pentru cele 4 servicii. */
interface Props {
  icon: ServiceIcon;
  class?: string;
}
const { icon, class: className = '' } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={['h-6 w-6', className]}
  aria-hidden="true"
>
  {/* Marketing — grafic ascendent */}
  {icon === 'marketing' && <path d="M3 3v18h18M7 15l3-3 3 3 5-6" />}
  {/* Grafică — paletă / peniță */}
  {
    icon === 'grafica' && (
      <>
        <path d="M12 19l7-7 3 3-7 7-3-3z" />
        <path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z" />
        <path d="M2 2l7.586 7.586" />
        <circle cx="11" cy="11" r="2" />
      </>
    )
  }
  {/* Web Design — fereastră browser */}
  {
    icon === 'web' && (
      <>
        <rect x="3" y="4" width="18" height="16" rx="2" />
        <path d="M3 9h18M7 6.5h.01M10 6.5h.01" />
      </>
    )
  }
  {/* Mentenanță — cheie / setări */}
  {
    icon === 'mentenanta' && (
      <>
        <path d="M14.7 6.3a4 4 0 0 0-5.4 5.4L3 18l3 3 6.3-6.3a4 4 0 0 0 5.4-5.4l-2.7 2.7-2.4-.3-.3-2.4 2.7-2.7z" />
      </>
    )
  }
</svg>
