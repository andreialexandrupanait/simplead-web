---
import Logo from '@components/ui/Logo.astro';
import { footerNav, footerServices, footerLegal } from '@data/nav';
import { site } from '@data/site';

const year = new Date().getFullYear();
const social = site.social;
---

<footer class="footer">
  <div class="footer-top">
    <div class="footer-brand">
      <a class="brand" href="/" aria-label="Simplead, Acasă"><Logo height={30} color="#fff" /></a>
      <p class="footer-about">
        Simplead oferă servicii de grafică și marketing digital dezvoltate de {site.founder}. Punem
        ordine în imagine, mesaj și prezența online, ca afacerile să se vadă mai clar online și să
        aducă mai mulți clienți.
      </p>
      <a class="footer-founder" href={site.founderSite} target="_blank" rel="noopener">
        <span>Cercetare & neuromarketing</span>
        <b>panaitandrei.ro</b>
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"><path d="M7 17L17 7M9 7h8v8"></path></svg
        >
      </a>
      <div class="footer-socials">
        {
          social.facebook && (
            <a
              class="soc"
              href={social.facebook}
              target="_blank"
              rel="noopener"
              aria-label="Facebook"
            >
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M13.5 21v-7h2.3l.4-2.9h-2.7V9.2c0-.8.3-1.4 1.5-1.4h1.3V5.2c-.6-.1-1.4-.2-2.3-.2-2.3 0-3.8 1.4-3.8 3.9v2.2H7.7V14h2.2v7h3.6z" />
              </svg>
            </a>
          )
        }
        {
          social.instagram && (
            <a
              class="soc"
              href={social.instagram}
              target="_blank"
              rel="noopener"
              aria-label="Instagram"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3.5" y="3.5" width="17" height="17" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none" />
              </svg>
            </a>
          )
        }
        {
          social.linkedin && (
            <a
              class="soc"
              href={social.linkedin}
              target="_blank"
              rel="noopener"
              aria-label="LinkedIn"
            >
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M6.9 8.8H3.9V20h3V8.8zM5.4 4a1.7 1.7 0 1 0 0 3.4 1.7 1.7 0 0 0 0-3.4zM20.1 20v-6.1c0-3-1.6-4.4-3.7-4.4-1.7 0-2.5.9-2.9 1.6V8.8h-3V20h3v-5.8c0-1.3.6-2 1.6-2 .9 0 1.6.5 1.6 2V20h3.4z" />
              </svg>
            </a>
          )
        }
      </div>
    </div>

    <details class="footer-col footer-acc" open>
      <summary class="footer-acc__sum">Navigare</summary>
      <ul>
        {
          footerNav.map((i) => (
            <li>
              <a href={i.href} {...(i.href === '/contact' ? { 'data-no-drawer': '' } : {})}>
                {i.label}
              </a>
            </li>
          ))
        }
      </ul>
    </details>

    <details class="footer-col footer-acc" open>
      <summary class="footer-acc__sum">Servicii</summary>
      <ul>
        {
          footerServices.map((i) => (
            <li>
              <a href={i.href}>{i.label}</a>
            </li>
          ))
        }
      </ul>
    </details>

    <div class="footer-col footer-news">
      <h5>Newsletter</h5>
      <p>Primește idei utile de marketing, o dată pe lună. Fără spam.</p>
      <form class="footer-form" data-newsletter>
        <input
          type="email"
          name="email"
          required
          placeholder="Adresa ta de email"
          aria-label="Adresa ta de email"
        />
        <input
          type="text"
          name="company"
          tabindex="-1"
          autocomplete="off"
          aria-hidden="true"
          style="position:absolute;left:-9999px"
        />
        <button type="submit">Mă abonez</button>
      </form>
      <p class="footer-news-msg" data-newsletter-msg aria-live="polite"></p>
    </div>
  </div>

  <!-- wordmark gigant -->
  <div class="footer-wordmark" aria-hidden="true"><span>simplead</span></div>

  <div class="footer-bottom">
    <span>
      © {year}
      {site.legalName}. Toate drepturile rezervate.
      {
        (site.legal.cif || site.legal.regCom) && (
          <span class="footer-legal">
            {site.legal.cif && <>CIF: {site.legal.cif}</>}
            {site.legal.cif && site.legal.regCom && ' · '}
            {site.legal.regCom && <>Reg. Com.: {site.legal.regCom}</>}
          </span>
        )
      }
    </span>
    <div class="links">
      {footerLegal.map((i) => <a href={i.href}>{i.label}</a>)}
    </div>
  </div>
</footer>

<style>
  .footer-legal {
    display: inline-block;
    margin-left: 10px;
    opacity: 0.72;
  }

  /* Coloanele de linkuri: pe desktop = listă normală (deschisă); pe mobil =
     dropdown/acordeon. JS-ul ține deschis pe desktop, închis pe mobil. */
  .footer-acc {
    min-width: 0;
  }
  .footer-acc__sum {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    color: #fff;
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-weight: 600;
    margin: 0 0 18px;
    cursor: default;
  }
  .footer-acc__sum::-webkit-details-marker {
    display: none;
  }
  .footer-acc__sum::after {
    content: '';
    flex-shrink: 0;
    width: 8px;
    height: 8px;
    border-right: 2px solid currentColor;
    border-bottom: 2px solid currentColor;
    transform: rotate(45deg);
    opacity: 0.55;
    transition: transform 0.2s ease;
    display: none;
  }
  .footer-acc[open] > .footer-acc__sum::after {
    transform: rotate(-135deg);
  }
  @media (max-width: 768px) {
    .footer-acc__sum {
      cursor: pointer;
      margin-bottom: 0;
      padding: 14px 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    }
    .footer-acc__sum::after {
      display: block;
    }
    .footer-acc[open] > .footer-acc__sum {
      margin-bottom: 14px;
      border-bottom-color: transparent;
    }
  }
</style>

<style>
  /* Scoatem golul de jos de la footer-top: coloanele se lipesc de wordmark. */
  .footer-top {
    padding-bottom: 0;
  }
  /* Textul „despre" umple coloana de brand (fără plafon), ca spațiul spre
     „Navigare" să fie egal cu cel dintre „Servicii" și „Newsletter". */
  .footer-about {
    max-width: none;
  }
  /* ===== Wordmark gigant ===== */
  .footer-wordmark {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 var(--gutter) 0;
    /* Înălțime limitată + overflow: textul iese puțin peste (jos), ca să NU
       crească footerul. */
    height: clamp(48px, 9.5vw, 144px);
    overflow: hidden;
  }
  .footer-wordmark span {
    display: block;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(64px, 14vw, 192px);
    line-height: 1;
    letter-spacing: -0.05em;
    white-space: nowrap;
    transform: translateY(-0.06em);
    background: linear-gradient(
      180deg,
      rgba(160, 188, 255, 0.16) 0%,
      rgba(0, 224, 198, 0.09) 55%,
      rgba(0, 224, 198, 0.03) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    /* Masca topește textul spre transparent în partea de jos: jos nu se mai vede. */
    -webkit-mask-image: linear-gradient(180deg, #000 34%, transparent 80%);
    mask-image: linear-gradient(180deg, #000 34%, transparent 80%);
    user-select: none;
  }

  /* ===== Micro-interacțiuni: linkuri coloane ===== */
  .footer-col a {
    position: relative;
    display: inline-flex;
    align-items: center;
  }
  .footer-col a::before {
    content: '→';
    display: inline-block;
    width: 0;
    opacity: 0;
    transform: translateX(-4px);
    color: var(--cyan);
    transition:
      width 0.2s var(--ease-snap),
      opacity 0.2s var(--ease-snap),
      transform 0.2s var(--ease-snap),
      margin-right 0.2s var(--ease-snap);
  }
  .footer-col a:hover::before {
    width: 1em;
    margin-right: 5px;
    opacity: 1;
    transform: translateX(0);
  }
  .footer-col a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -2px;
    height: 1px;
    width: 100%;
    background: linear-gradient(90deg, var(--electric), var(--cyan));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.24s var(--ease-snap);
  }
  .footer-col a:hover::after {
    transform: scaleX(1);
  }

  /* ===== Micro-interacțiuni: social pop ===== */
  .footer-socials .soc {
    transition:
      background 0.18s var(--ease-snap),
      border-color 0.18s var(--ease-snap),
      transform 0.18s var(--ease-snap),
      box-shadow 0.18s var(--ease-snap);
  }
  .footer-socials .soc:hover {
    background: linear-gradient(120deg, var(--electric), var(--cyan));
    border-color: transparent;
    transform: translateY(-3px) scale(1.08);
    box-shadow: 0 12px 26px -8px rgba(0, 119, 252, 0.55);
  }

  .footer-news-msg {
    margin-top: 8px;
    font-size: 0.84rem;
    min-height: 1.2em;
  }
  .footer-news-msg.is-ok {
    color: var(--cyan);
  }
  .footer-news-msg.is-error {
    color: #ff9d8f;
  }
</style>

<script>
  // Abonarea la newsletter: POST către /api/newsletter, mesaj inline.
  const form = document.querySelector<HTMLFormElement>('[data-newsletter]');
  const msg = document.querySelector<HTMLElement>('[data-newsletter-msg]');
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!msg) return;
    const email = (form.querySelector('input[name="email"]') as HTMLInputElement).value;
    const company = (form.querySelector('input[name="company"]') as HTMLInputElement).value;
    msg.className = 'footer-news-msg';
    msg.textContent = 'Se trimite…';
    try {
      const res = await fetch('/api/newsletter', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, company, source: 'footer' }),
      });
      const body = (await res.json()) as { ok: boolean; error?: string };
      if (body.ok) {
        msg.classList.add('is-ok');
        msg.textContent = 'Gata, ești pe listă! Ne auzim o dată pe lună.';
        form.reset();
      } else {
        msg.classList.add('is-error');
        msg.textContent = body.error ?? 'Ceva n-a mers. Încearcă din nou.';
      }
    } catch {
      msg.classList.add('is-error');
      msg.textContent = 'Eroare de rețea. Încearcă din nou.';
    }
  });

  // Footer: coloanele de linkuri sunt acordeon pe mobil, deschise pe desktop.
  const accs = Array.from(document.querySelectorAll<HTMLDetailsElement>('.footer-acc'));
  if (accs.length) {
    const mq = window.matchMedia('(max-width: 768px)');
    const sync = () => accs.forEach((d) => (d.open = !mq.matches));
    sync();
    mq.addEventListener('change', sync);
  }
</script>
