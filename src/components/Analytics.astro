---
/**
 * GTM ca MOTOR UNIC + CONSIMȚĂMÂNT pe categorii (GDPR).
 * GTM ID vine din /admin/tracking (settings), fallback pe env. GTM se încarcă
 * DOAR după alegerea din CookieBanner (oricare categorie). Toate tag-urile și
 * pixelii (GA4, Meta, TikTok, Clarity, Google Ads) trăiesc ÎN GTM și respectă
 * consimțământul la nivel de tag (Consent Mode v2 + „Additional consent checks").
 * Site-ul doar împinge evenimente curate în dataLayer — GTM decide ce se trimite.
 * Expune window.__saApplyConsent(cats) + window.saTrack(event, params).
 */
import { getPublicSettings } from '@lib/server/public-settings';

const t = (await getPublicSettings()).tracking;

const GTM_ID = t.gtmId || import.meta.env.GTM_ID || '';
---

{
  GTM_ID && (
    <script is:inline define:vars={{ GTM_ID }}>
      (function () {
        const KEY = 'sa_consent';
        let gtmLoaded = false;
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          // eslint-disable-next-line prefer-rest-params
          dataLayer.push(arguments);
        }
        window.gtag = window.gtag || gtag;

        // Consent Mode v2: implicit refuzat, cât mai devreme.
        window.gtag('consent', 'default', {
          ad_storage: 'denied',
          analytics_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          functionality_storage: 'granted',
          security_storage: 'granted',
        });

        function injectGtm() {
          if (gtmLoaded) return;
          gtmLoaded = true;
          (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
            const f = d.getElementsByTagName(s)[0],
              j = d.createElement(s),
              dl = l != 'dataLayer' ? '&l=' + l : '';
            j.async = true;
            j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
            f.parentNode.insertBefore(j, f);
          })(window, document, 'script', 'dataLayer', GTM_ID);
        }

        // Alegerea pe categorii → Consent Mode + semnal în dataLayer. GTM pornește
        // la oricare categorie; tag-urile din GTM gate-uiesc pe analytics_/ad_storage.
        function applyConsent(c) {
          c = c || {};
          window.gtag('consent', 'update', {
            analytics_storage: c.analytics ? 'granted' : 'denied',
            ad_storage: c.marketing ? 'granted' : 'denied',
            ad_user_data: c.marketing ? 'granted' : 'denied',
            ad_personalization: c.marketing ? 'granted' : 'denied',
          });
          window.dataLayer.push({
            event: 'consent_update',
            consent_analytics: !!c.analytics,
            consent_marketing: !!c.marketing,
          });
          if (c.analytics || c.marketing) injectGtm();
        }
        window.__saApplyConsent = applyConsent;

        // Bridge de evenimente: totul în dataLayer (GTM decide restul, cu consimțământ).
        window.saTrack = function (name, params) {
          window.dataLayer.push(Object.assign({ event: name }, params || {}));
        };

        // La încărcare: aplică alegerea salvată (dacă există).
        let stored = null;
        try {
          stored = JSON.parse(localStorage.getItem(KEY) || 'null');
        } catch {
          /* localStorage indisponibil */
        }
        if (stored) applyConsent(stored);
      })();
    </script>
  )
}
