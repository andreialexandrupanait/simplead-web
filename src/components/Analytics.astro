---
/**
 * Tracking condiționat de setări (admin) + CONSIMȚĂMÂNT pe categorii (GDPR).
 * ID-urile vin din /admin/tracking (settings), fallback pe env. Trackerele pornesc
 * DOAR după alegerea din CookieBanner: Analiză (GA4, Clarity) și/sau Marketing
 * (Meta, TikTok). GTM se încarcă dacă e acceptată oricare categorie (container +
 * Consent Mode v2). Expune window.__saApplyConsent(cats) + window.saTrack(event, params).
 */
import { getPublicSettings } from '@lib/server/public-settings';

const t = (await getPublicSettings()).tracking;

const GTM_ID = t.gtmId || import.meta.env.GTM_ID || '';
const GA4_ID = t.ga4Id || import.meta.env.GA4_ID || '';
const CLARITY_ID = t.clarityId || import.meta.env.CLARITY_ID || '';
const META_PIXEL_ID = t.metaPixelId || import.meta.env.META_PIXEL_ID || '';
const TIKTOK_PIXEL_ID = t.tiktokPixelId || import.meta.env.TIKTOK_PIXEL_ID || '';

const hasTrackers = Boolean(GTM_ID || GA4_ID || CLARITY_ID || META_PIXEL_ID || TIKTOK_PIXEL_ID);
---

{
  hasTrackers && (
    <script
      is:inline
      define:vars={{ GTM_ID, GA4_ID, CLARITY_ID, META_PIXEL_ID, TIKTOK_PIXEL_ID }}
    >
      (function () {
        const KEY = 'sa_consent';
        var loaded = { gtm: false, ga: false, clarity: false, meta: false, tiktok: false };
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          // eslint-disable-next-line prefer-rest-params
          dataLayer.push(arguments);
        }

        // Consent Mode v2: implicit refuzat, cât mai devreme (dacă folosim Google).
        if (GA4_ID || GTM_ID) {
          window.gtag = window.gtag || gtag;
          window.gtag('consent', 'default', {
            ad_storage: 'denied',
            analytics_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
            functionality_storage: 'granted',
            security_storage: 'granted',
          });
        }

        function injectGtm() {
          if (loaded.gtm || !GTM_ID) return;
          loaded.gtm = true;
          (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
            const f = d.getElementsByTagName(s)[0],
              j = d.createElement(s),
              dl = l != 'dataLayer' ? '&l=' + l : '';
            j.async = true;
            j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
            f.parentNode.insertBefore(j, f);
          })(window, document, 'script', 'dataLayer', GTM_ID);
        }

        function injectGa() {
          if (loaded.ga || !GA4_ID) return;
          loaded.ga = true;
          const s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA4_ID;
          document.head.appendChild(s);
          window.gtag = window.gtag || gtag;
          window.gtag('js', new Date());
          window.gtag('config', GA4_ID);
        }

        function injectClarity() {
          if (loaded.clarity || !CLARITY_ID) return;
          loaded.clarity = true;
          (function (c, l, a, r, i, t, y) {
            c[a] =
              c[a] ||
              function () {
                // eslint-disable-next-line prefer-rest-params
                (c[a].q = c[a].q || []).push(arguments);
              };
            t = l.createElement(r);
            t.async = 1;
            t.src = 'https://www.clarity.ms/tag/' + i;
            y = l.getElementsByTagName(r)[0];
            y.parentNode.insertBefore(t, y);
          })(window, document, 'clarity', 'script', CLARITY_ID);
        }

        function injectMeta() {
          if (loaded.meta || !META_PIXEL_ID) return;
          loaded.meta = true;
          !(function (f, b, e, v, n, t, s) {
            if (f.fbq) return;
            n = f.fbq = function () {
              // eslint-disable-next-line prefer-rest-params
              n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
            };
            if (!f._fbq) f._fbq = n;
            n.push = n;
            n.loaded = !0;
            n.version = '2.0';
            n.queue = [];
            t = b.createElement(e);
            t.async = !0;
            t.src = v;
            s = b.getElementsByTagName(e)[0];
            s.parentNode.insertBefore(t, s);
          })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
          window.fbq('init', META_PIXEL_ID);
          window.fbq('track', 'PageView');
        }

        function injectTiktok() {
          if (loaded.tiktok || !TIKTOK_PIXEL_ID) return;
          loaded.tiktok = true;
          (function (w, d, t) {
            w.TiktokAnalyticsObject = t;
            var ttq = (w[t] = w[t] || []);
            ttq.methods = [
              'page','track','identify','instances','debug','on','off','once','ready','alias','group','enableCookie','disableCookie','holdConsent','revokeConsent','grantConsent',
            ];
            ttq.setAndDefer = function (e, n) {
              e[n] = function () {
                // eslint-disable-next-line prefer-rest-params
                e.push([n].concat(Array.prototype.slice.call(arguments, 0)));
              };
            };
            for (var i = 0; i < ttq.methods.length; i++) ttq.setAndDefer(ttq, ttq.methods[i]);
            ttq.load = function (e, n) {
              var r = 'https://analytics.tiktok.com/i18n/pixel/events.js';
              ttq._i = ttq._i || {};
              ttq._i[e] = [];
              ttq._i[e]._u = r;
              ttq._t = ttq._t || {};
              ttq._t[e] = +new Date();
              ttq._o = ttq._o || {};
              ttq._o[e] = n || {};
              n = d.createElement('script');
              n.type = 'text/javascript';
              n.async = !0;
              n.src = r + '?sdkid=' + e + '&lib=' + t;
              var s = d.getElementsByTagName('script')[0];
              s.parentNode.insertBefore(n, s);
            };
            ttq.load(TIKTOK_PIXEL_ID);
            ttq.page();
          })(window, document, 'ttq');
        }

        // Aplică alegerea pe categorii: Analiză (GA4, Clarity), Marketing (Meta, TikTok).
        // GTM se încarcă la oricare categorie; Consent Mode primește semnalul corect.
        function applyConsent(c) {
          c = c || {};
          if (window.gtag) {
            window.gtag('consent', 'update', {
              analytics_storage: c.analytics ? 'granted' : 'denied',
              ad_storage: c.marketing ? 'granted' : 'denied',
              ad_user_data: c.marketing ? 'granted' : 'denied',
              ad_personalization: c.marketing ? 'granted' : 'denied',
            });
          }
          if (c.analytics || c.marketing) injectGtm();
          if (c.analytics) {
            injectGa();
            injectClarity();
          }
          if (c.marketing) {
            injectMeta();
            injectTiktok();
          }
        }
        window.__saApplyConsent = applyConsent;

        // Bridge de evenimente: mereu în dataLayer (GTM); nativ dacă e încărcat.
        var NATIVE = {
          generate_lead: ['Lead', 'SubmitForm'],
          sign_up: ['CompleteRegistration', 'Subscribe'],
          purchase: ['Purchase', 'CompletePayment'],
        };
        window.saTrack = function (name, params) {
          params = params || {};
          window.dataLayer.push(Object.assign({ event: name }, params));
          if (window.gtag) window.gtag('event', name, params);
          var m = NATIVE[name];
          if (m) {
            if (window.fbq) window.fbq('track', m[0], params);
            if (window.ttq) window.ttq.track(m[1], params);
          }
        };

        // La încărcare: aplică alegerea salvată (dacă există).
        var stored = null;
        try {
          stored = JSON.parse(localStorage.getItem(KEY) || 'null');
        } catch {
          /* localStorage indisponibil */
        }
        if (stored) applyConsent(stored);
      })();
    </script>
  )
}
