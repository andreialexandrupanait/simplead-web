---
/**
 * „Omul din spate" - feature appealing cu portret + credibilitate (doctorat /
 * neuromarketing). Pune `photo` pe URL-ul/calea pozei reale a lui Andrei;
 * gol = placeholder grafic elegant (monogram).
 */
import Button from '@components/ui/Button.astro';
import { site } from '@data/site';

// TODO: pune calea pozei reale (ex: '/andrei.jpg' din folderul public/).
const photo = '';
---

<section class="founder">
  <div class="site-container founder__inner">
    <div class="founder__media" data-reveal>
      <span class="founder__glow" aria-hidden="true"></span>
      <div class="founder__frame">
        {
          photo ? (
            <img src={photo} alt={site.founder} loading="lazy" />
          ) : (
            <span class="founder__ph" aria-hidden="true">
              AP
            </span>
          )
        }
        <span class="founder__badge">
          <b>{site.founder}</b>
          <small>Doctor în marketing · fondator</small>
        </span>
      </div>
    </div>

    <div class="founder__copy" data-reveal>
      <span class="kicker kicker--cyan">Omul din spate</span>
      <h2 class="founder__title">Decizii din neuroștiință, <span>nu din „mie îmi place”.</span></h2>
      <p class="founder__p">
        Înainte să fac ceva, mă uit la cum decid oamenii. E obișnuința rămasă din cercetare,
        dintr-un doctorat în marketing cu accent pe neuromarketing. N-o scot în față ca să sune bine,
        ci o folosesc ca să iau decizii mai bune pentru proiectul tău.
      </p>
      <p class="founder__p">
        Și n-o fac de unul singur: lucrez cu colegi care îmi sunt și colaboratori, pe foto-video,
        dezvoltare și ads, în funcție de ce cere proiectul.
      </p>
      <div class="founder__cta">
        <Button href="/despre" withArrow>Hai să ne cunoaștem</Button>
      </div>
    </div>
  </div>
</section>

<style>
  .founder {
    background: var(--canvas);
    padding-block: clamp(64px, 9vw, 120px);
  }
  .founder__inner {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: 60px;
    align-items: center;
  }

  /* Portret */
  .founder__media {
    position: relative;
  }
  .founder__glow {
    position: absolute;
    inset: -10% -8% -8% -10%;
    border-radius: 50%;
    background:
      radial-gradient(60% 60% at 30% 30%, rgba(0, 119, 252, 0.22), transparent 70%),
      radial-gradient(50% 50% at 80% 80%, rgba(0, 224, 198, 0.22), transparent 70%);
    filter: blur(8px);
    z-index: 0;
  }
  .founder__frame {
    position: relative;
    z-index: 1;
    aspect-ratio: 4 / 5;
    max-width: 420px;
    border-radius: var(--r-xl);
    overflow: hidden;
    border: 1px solid var(--line);
    box-shadow: var(--sh-lg);
  }
  .founder__frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .founder__ph {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background:
      radial-gradient(110% 80% at 75% 15%, rgba(0, 224, 198, 0.25), transparent 60%),
      linear-gradient(150deg, var(--ink) 0%, #0a1b6b 100%);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3rem, 8vw, 5rem);
    letter-spacing: 0.03em;
    color: #fff;
  }
  .founder__badge {
    position: absolute;
    left: 16px;
    bottom: 16px;
    display: flex;
    flex-direction: column;
    padding: 12px 16px;
    background: rgba(3, 13, 74, 0.78);
    backdrop-filter: blur(8px);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: var(--r-sm);
    box-shadow: var(--sh-md);
  }
  .founder__badge b {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.98rem;
    color: #fff;
  }
  .founder__badge small {
    margin-top: 3px;
    font-size: 0.74rem;
    letter-spacing: 0.03em;
    color: var(--cyan);
  }

  /* Copy */
  .founder__title {
    margin-top: 16px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.85rem, 3.2vw, 2.85rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-wrap: balance;
  }
  .founder__title span {
    color: var(--electric);
  }
  .founder__p {
    margin-top: 18px;
    max-width: 56ch;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--muted);
  }
  .founder__cta {
    margin-top: 30px;
  }

  @media (max-width: 900px) {
    .founder__inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .founder__frame {
      max-width: 340px;
    }
  }
</style>
