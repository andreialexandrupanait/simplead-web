---
import Button from '@components/ui/Button.astro';

const features = [
  {
    title: 'Monitorizare inteligentă',
    body: 'Aplicația internă urmărește continuu starea site-ului tău și semnalează din timp ce nu e în regulă.',
  },
  {
    title: 'Automatizări',
    body: 'Sarcini repetitive (rapoarte, alerte, fluxuri) trec pe pilot automat, ca să rămână timp de afacere.',
  },
  {
    title: 'Conținut asistat',
    body: 'AI-ul accelerează ciornele și ideile, dar deciziile și forma finală rămân la om.',
  },
];
---

<section class="ai">
  <div class="site-container ai__inner">
    <div class="ai__copy" data-reveal>
      <p class="kicker">AI pentru business</p>
      <h2 class="ai__title">AI, acolo unde <span>chiar îți face treaba.</span></h2>
      <p class="ai__sub">
        Folosim AI-ul unde aduce rezultat concret: monitorizarea site-ului, automatizări și
        producția de conținut. Și spunem clar unde nu ajută.
      </p>
      <div class="ai__cta">
        <Button href="/servicii/ai-pentru-business" withArrow>Descoperă AI pentru business</Button>
      </div>
    </div>

    <ul class="ai__list" data-reveal-stagger>
      {
        features.map((f) => (
          <li class="ai__feature">
            <span class="ai__spark">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M13 2L4.5 13H11l-1 9 8.5-11H12z" />
              </svg>
            </span>
            <div>
              <h3>{f.title}</h3>
              <p>{f.body}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .ai {
    background: var(--canvas-soft);
    padding-block: clamp(64px, 9vw, 120px);
  }
  .ai__inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .ai__title {
    margin-top: 16px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.9rem, 3.4vw, 3rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .ai__title span {
    color: var(--electric);
  }
  .ai__sub {
    margin-top: 20px;
    max-width: 44ch;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--muted);
  }
  .ai__cta {
    margin-top: 28px;
  }
  .ai__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .ai__feature {
    display: flex;
    gap: 18px;
    padding: 22px 24px;
    background: var(--canvas-soft);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    transition:
      transform 0.22s var(--ease-snap),
      border-color 0.2s var(--ease-snap),
      box-shadow 0.2s var(--ease-snap);
  }
  .ai__feature:hover {
    border-color: var(--cyan);
    transform: translateY(-3px);
    box-shadow: var(--sh-sm);
  }
  @media (prefers-reduced-motion: reduce) {
    .ai__feature {
      transition: none;
    }
    .ai__feature:hover {
      transform: none;
    }
  }
  .ai__spark {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--r-sm);
    background: var(--signal);
    color: var(--ink);
  }
  .ai__spark svg {
    width: 22px;
    height: 22px;
  }
  .ai__feature h3 {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.08rem;
    color: var(--ink);
  }
  .ai__feature p {
    margin-top: 6px;
    font-size: 0.94rem;
    line-height: 1.5;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .ai__inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
