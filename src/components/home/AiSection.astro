---
import Button from '@components/ui/Button.astro';

const features = [
  {
    title: 'Procese mai bune',
    body: 'Ne uităm la felul în care lucrezi și folosim AI ca să eliminăm pașii inutili și să scurtăm drumul de la idee la rezultat.',
    accent: 'var(--electric)',
    ic: '#fff',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="5" cy="5" r="2"/><circle cx="5" cy="19" r="2"/><circle cx="19" cy="12" r="2"/><path d="M7 5h5a5 5 0 0 1 5 5M7 19h5a5 5 0 0 0 5-5"/></svg>',
  },
  {
    title: 'Aplicații pe măsura ta',
    body: 'Dezvoltăm aplicații specifice businessului tău: de la fluxuri interne la unelte care nu există „de-a gata" pe piață.',
    accent: 'var(--cyan)',
    ic: 'var(--ink)',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="16" rx="2"/><path d="M3 9h18"/><path d="M6 6.6h.01M9 6.6h.01"/><path d="M10 13l-2 2 2 2M14 13l2 2-2 2"/></svg>',
  },
  {
    title: 'Automatizări cu cap',
    body: 'Sarcinile repetitive trec pe pilot automat, ca timpul tău să meargă spre ce contează cu adevărat.',
    accent: 'var(--signal)',
    ic: 'var(--ink)',
    icon: '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M17 2l4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><path d="M7 22l-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>',
  },
];
---

<section class="ai">
  <div class="ai__glow" aria-hidden="true"></div>
  <div class="site-container ai__inner">
    <div class="ai__copy" data-reveal>
      <p class="ai__eyebrow"><span class="ai__tick"></span>AI pentru business</p>
      <h2 class="ai__title">AI gândit pe <span>afacerea ta</span>, nu de dragul tehnologiei.</h2>
      <p class="ai__sub">
        Nu folosim AI ca să bifăm o tendință. Îl folosim ca să îți eficientizăm procesele, să
        automatizăm ce te ține pe loc și să construim aplicații gândite exact pe nevoile afacerii
        tale. Iar acolo unde nu aduce un plus real, îți spunem direct.
      </p>
      <div class="ai__cta">
        <Button href="/servicii/ai-pentru-business" withArrow>Descoperă AI pentru business</Button>
      </div>
    </div>

    <div class="ai__panel" data-reveal>
      <div class="ai__panel-head">
        <span class="ai__panel-title">Ce construim cu AI</span>
        <span class="ai__panel-meta">03 direcții</span>
      </div>
      <ul class="ai__rows">
        {
          features.map((f, i) => (
            <li class="ai__row" style={`--accent:${f.accent};--ic:${f.ic}`}>
              <span class="ai__idx">{String(i + 1).padStart(2, '0')}</span>
              <span class="ai__ic" set:html={f.icon} />
              <div class="ai__row-copy">
                <h3>{f.title}</h3>
                <p>{f.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .ai {
    position: relative;
    background: var(--canvas-soft);
    padding-block: clamp(64px, 9vw, 120px);
    overflow: hidden;
    --font-mono: ui-monospace, 'SF Mono', 'JetBrains Mono', 'Roboto Mono', Menlo, monospace;
  }
  .ai__glow {
    position: absolute;
    top: -12%;
    left: -6%;
    width: 52%;
    height: 74%;
    background:
      radial-gradient(50% 50% at 28% 28%, rgba(0, 119, 252, 0.1), transparent 70%),
      radial-gradient(42% 42% at 8% 62%, rgba(0, 224, 198, 0.1), transparent 70%);
    pointer-events: none;
  }
  .ai__inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: clamp(40px, 5vw, 72px);
    align-items: center;
  }
  /* Inversat: panoul în stânga (order 1), textul în dreapta (order 2) */
  .ai__copy {
    order: 2;
  }

  /* Right copy */
  .ai__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--electric);
  }
  .ai__tick {
    width: 28px;
    height: 1px;
    background: linear-gradient(90deg, var(--electric), transparent);
  }
  .ai__title {
    margin-top: 18px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.9rem, 3.2vw, 2.85rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--ink);
    text-wrap: balance;
  }
  .ai__title span {
    color: var(--electric);
  }
  .ai__sub {
    margin-top: 20px;
    max-width: 46ch;
    font-size: 1.0625rem;
    line-height: 1.62;
    color: var(--muted);
  }
  .ai__cta {
    margin-top: 28px;
  }

  /* Left panel: spec sheet */
  .ai__panel {
    order: 1;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: var(--sh-lg);
    overflow: hidden;
  }
  .ai__panel-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding: 15px 22px;
    background: var(--canvas-soft);
    border-bottom: 1px solid var(--line);
  }
  .ai__panel-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.95rem;
    color: var(--ink);
  }
  .ai__panel-meta {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ai__rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ai__row {
    position: relative;
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: start;
    gap: 16px;
    padding: 22px;
    border-top: 1px solid var(--line);
    transition: background 0.2s ease;
  }
  .ai__row:first-child {
    border-top: 0;
  }
  .ai__row::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.24s var(--ease-snap, ease);
  }
  .ai__row:hover {
    background: color-mix(in srgb, var(--accent) 6%, #fff);
  }
  .ai__row:hover::before {
    transform: scaleY(1);
  }
  .ai__idx {
    padding-top: 11px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
  }
  .ai__ic {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--r-sm);
    background: var(--accent);
    color: var(--ic);
  }
  .ai__ic :global(svg) {
    display: block;
    width: 22px;
    height: 22px;
  }
  .ai__row-copy h3 {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.08rem;
    color: var(--ink);
  }
  .ai__row-copy p {
    margin-top: 6px;
    font-size: 0.94rem;
    line-height: 1.5;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .ai__inner {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    /* pe mobil: textul (titlul) primul, panoul dedesubt */
    .ai__copy {
      order: 1;
    }
    .ai__panel {
      order: 2;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .ai__row,
    .ai__row::before {
      transition: none;
    }
  }
</style>
