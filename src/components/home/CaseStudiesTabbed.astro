---
/**
 * Studii de caz pe taburi (homepage), funcționalitate în stil HubSpot, stil Simplead.
 * Header pe 2 coloane (etichetă + buton „vezi tot"; titlu + subtitlu) → taburi cu
 * underline → un card per tab (imagine + citat + autor + link + 2 statistici).
 */
import { homeCaseStudies } from '@data/content';
---

<section class="cs2" id="cs2">
  <div class="site-container" data-reveal>
    <!-- Header -->
    <div class="cs2__head-top">
      <span class="cs2__rule" aria-hidden="true"></span>
      <a class="cs2__all" href="/portofoliu">
        Vezi tot portofoliul
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg
        >
      </a>
    </div>
    <div class="cs2__head-main">
      <h2 class="cs2__title">
        Rezultate care se văd, <span class="g">pentru orice afacere.</span>
      </h2>
      <p class="cs2__sub">
        Proiecte reale, pentru afaceri reale. Dovada e în rezultatele clienților noștri.
      </p>
    </div>

    <!-- Taburi -->
    <div class="cs2__tabs" role="tablist" aria-label="Categorii studii de caz">
      {
        homeCaseStudies.map((c, i) => (
          <button
            class="cs2__tab"
            role="tab"
            type="button"
            data-i={i}
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            {c.tab}
          </button>
        ))
      }
    </div>

    <!-- Carduri (un panel per tab) -->
    <div class="cs2__panels">
      {
        homeCaseStudies.map((c, i) => (
          <article
            class:list={['cs2__card', i === 0 && 'on']}
            role="tabpanel"
            data-i={i}
            aria-hidden={i === 0 ? 'false' : 'true'}
          >
            <div class="cs2__main">
              <div class="cs2__media">
                {c.image ? (
                  <img src={c.image} alt={c.imageAlt} loading="lazy" />
                ) : (
                  <span class="cs2__ph" aria-hidden="true">
                    <span class="cs2__ph-mark">{c.logo}</span>
                  </span>
                )}
              </div>
              <div class="cs2__quote">
                <p class="cs2__qt">{c.quote}</p>
                <div class="cs2__who">
                  <b>{c.author}</b>
                  <span>{c.role}</span>
                </div>
                <a class="cs2__read" href={c.href}>
                  Citește studiul complet
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  >
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </a>
              </div>
            </div>
            <div class="cs2__stats">
              {c.stats.map((s) => (
                <div class="cs2__stat">
                  <b>{s.value}</b>
                  <span>{s.label}</span>
                </div>
              ))}
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cs2 {
    background: var(--canvas);
    padding-block: var(--section-pad);
  }

  /* Header sus: etichetă · linie punctată · buton */
  .cs2__head-top {
    display: flex;
    align-items: center;
    gap: 22px;
  }
  .cs2__rule {
    flex: 1;
    height: 0;
    border-top: 1px dashed var(--line);
  }
  .cs2__all {
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    border: 1px solid var(--ink);
    border-radius: var(--r-sm);
    font-weight: 600;
    font-size: 0.92rem;
    color: var(--ink);
    transition:
      background 0.18s var(--ease-snap),
      color 0.18s var(--ease-snap),
      gap 0.18s var(--ease-snap);
  }
  .cs2__all svg {
    width: 17px;
    height: 17px;
  }
  .cs2__all:hover {
    background: var(--ink);
    color: #fff;
    gap: 11px;
  }

  /* Header principal: titlu + subtitlu */
  .cs2__head-main {
    margin-top: 28px;
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 40px;
    align-items: end;
  }
  .cs2__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.9rem, 3.6vw, 3rem);
    line-height: 1.06;
    letter-spacing: -0.025em;
    color: var(--ink);
    text-wrap: balance;
  }
  .cs2__title .g {
    color: var(--electric);
  }
  .cs2__sub {
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--muted);
  }

  /* Taburi */
  .cs2__tabs {
    margin-top: 44px;
    display: flex;
    flex-wrap: wrap;
    gap: 32px;
    border-bottom: 1px solid var(--line);
  }
  .cs2__tab {
    position: relative;
    padding: 0 2px 16px;
    background: none;
    border: none;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 1.02rem;
    font-weight: 600;
    color: var(--muted);
    transition: color 0.18s var(--ease-snap);
  }
  .cs2__tab::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: 2px;
    background: var(--electric);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.22s var(--ease-snap);
  }
  .cs2__tab:hover {
    color: var(--ink);
  }
  .cs2__tab[aria-selected='true'] {
    color: var(--ink);
  }
  .cs2__tab[aria-selected='true']::after {
    transform: scaleX(1);
  }

  /* Card */
  .cs2__panels {
    margin-top: 36px;
  }
  .cs2__card {
    display: none;
    background: var(--canvas);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    padding: 32px;
    box-shadow: var(--sh-md);
  }
  .cs2__card.on {
    display: block;
    animation: cs2-in 0.3s var(--ease) both;
  }
  @keyframes cs2-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
  .cs2__main {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: center;
  }
  .cs2__media {
    aspect-ratio: 4 / 3;
    border-radius: var(--r-lg);
    overflow: hidden;
  }
  .cs2__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .cs2__ph {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background:
      radial-gradient(120% 90% at 80% 10%, rgba(0, 224, 198, 0.22), transparent 60%),
      linear-gradient(150deg, var(--ink) 0%, #0a1b6b 100%);
  }
  .cs2__ph-mark {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.5rem, 6vw, 4rem);
    letter-spacing: 0.02em;
    color: #fff;
    opacity: 0.92;
  }
  .cs2__qt {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.15rem, 1.7vw, 1.5rem);
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .cs2__who {
    margin-top: 24px;
  }
  .cs2__who b {
    display: block;
    font-size: 1rem;
    color: var(--ink);
  }
  .cs2__who span {
    font-size: 0.92rem;
    color: var(--muted);
  }
  .cs2__read {
    margin-top: 18px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 0.96rem;
    color: var(--electric);
    border-bottom: 2px solid var(--electric);
    padding-bottom: 2px;
    transition: gap 0.18s var(--ease-snap);
  }
  .cs2__read svg {
    width: 16px;
    height: 16px;
  }
  .cs2__read:hover {
    gap: 11px;
  }

  /* Statistici (jos) */
  .cs2__stats {
    margin-top: 32px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 28px;
  }
  .cs2__stat {
    text-align: center;
    position: relative;
  }
  .cs2__stat + .cs2__stat::before {
    content: '';
    position: absolute;
    left: -14px;
    top: 4px;
    bottom: 4px;
    width: 1px;
    background: var(--line);
  }
  .cs2__stat b {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.2rem, 4vw, 3rem);
    line-height: 1;
    color: var(--ink);
    letter-spacing: -0.02em;
  }
  .cs2__stat span {
    display: block;
    margin-top: 8px;
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--muted);
  }

  @media (max-width: 768px) {
    .cs2__head-main {
      grid-template-columns: 1fr;
      gap: 16px;
      align-items: start;
    }
    .cs2__main {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .cs2__media {
      aspect-ratio: 16 / 9;
    }
  }
  @media (max-width: 560px) {
    .cs2__head-top {
      flex-wrap: wrap;
      gap: 14px;
    }
    .cs2__rule {
      display: none;
    }
    .cs2__tabs {
      gap: 22px;
    }
    .cs2__tab {
      font-size: 0.95rem;
    }
    .cs2__card {
      padding: 22px;
    }
    .cs2__stats {
      gap: 18px;
    }
    .cs2__stat + .cs2__stat::before {
      left: -9px;
    }
  }
</style>

<script>
  const root = document.getElementById('cs2');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('.cs2__tab'));
    const cards = Array.from(root.querySelectorAll<HTMLElement>('.cs2__card'));
    const select = (i: string) => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.i === i)));
      cards.forEach((c) => {
        const on = c.dataset.i === i;
        c.classList.toggle('on', on);
        c.setAttribute('aria-hidden', String(!on));
      });
    };
    tabs.forEach((t, idx) => {
      t.addEventListener('click', () => t.dataset.i && select(t.dataset.i));
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
          e.preventDefault();
          const dir = e.key === 'ArrowRight' ? 1 : -1;
          const next = tabs[(idx + dir + tabs.length) % tabs.length];
          if (next?.dataset.i) select(next.dataset.i);
          next?.focus();
        }
      });
    });
  }
</script>
