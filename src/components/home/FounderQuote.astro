---
/**
 * FounderQuote — banda „omul din spate": avatar + citat + nume fondator.
 *
 * A fost inițial la baza secțiunii Differentiator („Designul bun se vede").
 * Scoasă de acolo și păstrată aici ca bloc de sine stătător, ca s-o putem
 * reactiva pe home sau refolosi pe altă pagină (ex: /despre).
 *
 * Refolosire:
 *   import FounderQuote from '@components/home/FounderQuote.astro';
 *   <FounderQuote />
 *
 * Pune `founderPhoto` pe calea pozei reale (din public/); gol => inițialele „AP".
 */
import { site } from '@data/site';

const founderPhoto = '/andrei.jpg';
---

<figure class="fquote" data-reveal>
  <div class="site-container fquote__inner">
    <span class="fquote__avatar">
      {
        founderPhoto ? (
          <img src={founderPhoto} alt={site.founder} loading="lazy" />
        ) : (
          <span>AP</span>
        )
      }
    </span>
    <blockquote class="fquote__quote">
      „Nu folosesc partea asta ca să sune bine, ci ca să iau decizii mai bune pentru proiectul
      tău.”
    </blockquote>
    <figcaption class="fquote__by">
      <b>{site.founder}</b>
      <span>Doctor în marketing, cu cercetare în neuromarketing</span>
    </figcaption>
  </div>
</figure>

<style>
  .fquote {
    position: relative;
    z-index: 2;
    overflow: hidden;
    margin: 0;
    padding: 32px 0;
    background:
      radial-gradient(90% 180% at 86% 130%, rgba(110, 91, 224, 0.4), transparent 55%),
      radial-gradient(70% 150% at 8% -30%, rgba(0, 119, 252, 0.2), transparent 55%), #020a3a;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 34px 70px -34px rgba(0, 0, 0, 0.55);
  }
  .fquote__inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .fquote__avatar {
    flex: none;
    width: 76px;
    height: 76px;
    border-radius: 50%;
    overflow: hidden;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, var(--electric), var(--cyan));
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.4rem;
    box-shadow: var(--glow-electric);
  }
  .fquote__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 22%;
  }
  .fquote__quote {
    flex: 1;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.02rem, 1.5vw, 1.28rem);
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: #fff;
    text-wrap: pretty;
  }
  .fquote__by {
    flex: none;
    margin-left: clamp(28px, 5vw, 80px);
    text-align: right;
  }
  .fquote__by b {
    display: block;
    color: #fff;
    font-size: 0.98rem;
  }
  .fquote__by span {
    display: block;
    margin-top: 2px;
    font-size: 0.84rem;
    color: var(--cyan);
  }
  @media (max-width: 768px) {
    .fquote__inner {
      flex-direction: column;
      text-align: center;
      gap: 16px;
    }
    .fquote__quote,
    .fquote__by {
      text-align: center;
    }
    .fquote__by {
      margin-left: 0;
    }
  }
</style>
