---
import Button from '@components/ui/Button.astro';
---

<section class="cta">
  <div class="site-container cta__inner" data-reveal>
    <h2 class="cta__title">Ai o afacere bună.<br />Hai s-o facem și să se vadă.</h2>
    <p class="cta__sub">
      Spune-ne în câteva cuvinte cu ce te putem ajuta. Îți răspundem noi, oameni, la fiecare mesaj.
    </p>
    <div class="cta__actions">
      <Button href="/contact" size="lg" withArrow>Cere o ofertă</Button>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    background: var(--ink);
    color: #fff;
    padding-block: clamp(80px, 11vw, 140px);
    overflow: hidden;
  }
  .cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
    background-size: 72px 72px;
    -webkit-mask-image: radial-gradient(90% 120% at 50% 0%, #000, transparent 75%);
    mask-image: radial-gradient(90% 120% at 50% 0%, #000, transparent 75%);
    pointer-events: none;
  }
  .cta__inner {
    position: relative;
    max-width: 880px;
    margin-inline: auto;
    text-align: center;
  }
  .kicker--cyan {
    color: var(--cyan);
  }
  .cta__title {
    margin-top: 16px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.1rem, 4.4vw, 3.4rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .cta__sub {
    margin-top: 20px;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--muted-dark);
  }
  .cta__actions {
    margin-top: 34px;
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
  }
</style>
