---
import { site } from '@data/site';
import Button from '@components/ui/Button.astro';

const founderPhoto = '/andrei.jpg';

const points = [
  {
    title: 'Pornim de la știință',
    body: 'Neuroștiința explică de ce oamenii privesc, simt și decid într-un anumit fel. De acolo pleacă orice proiect — nu de la „cred că arată bine".',
  },
  {
    title: 'Adaptăm la publicul tău',
    body: 'Traducem cercetarea în decizii concrete: ce mesaj, ce structură, ce imagini.',
  },
  {
    title: 'Validăm științific',
    body: 'Confirmăm cu unelte din sfera neuroștiinței — eye-tracking, heatmaps, Analytics — ca să știm ce funcționează, nu să ghicim.',
  },
];
---

<section class="diff">
  <div class="site-container">
    <div class="diff__top">
      <div class="diff__head" data-reveal>
        <p class="kicker kicker--cyan">De ce Simplead</p>
        <h2 class="diff__title">
          Designul bun nu se ghicește. <span>Se vede și se măsoară.</span>
        </h2>
        <p class="diff__sub">
          Fiecare decizie de design și mesaj pleacă de la cum funcționează atenția și alegerea — și
          o validăm cu unelte din neuroștiință (eye-tracking, heatmaps), nu pe presupuneri.
        </p>
        <div class="diff__cta">
          <Button
            href={site.founderSite}
            target="_blank"
            rel="noopener"
            variant="primary"
            withArrow
          >
            Vezi cercetarea pe panaitandrei.ro
          </Button>
        </div>
      </div>

      <ul class="diff__points" data-reveal-stagger>
        {
          points.map((p, i) => (
            <li class="diff__point">
              <span class="diff__num">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <h3>{p.title}</h3>
                <p>{p.body}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>

  <!-- „Omul din spate" - bandă full-width la baza secțiunii -->
  <figure class="diff__founder" data-reveal>
    <div class="site-container diff__founder-inner">
      <span class="diff__avatar">
        {
          founderPhoto ? (
            <img src={founderPhoto} alt={site.founder} loading="lazy" />
          ) : (
            <span>AP</span>
          )
        }
      </span>
      <blockquote class="diff__founder-quote">
        „Nu folosesc știința ca să sune bine, ci ca să luăm decizii mai bune pentru tine.”
      </blockquote>
      <figcaption class="diff__founder-by">
        <b>{site.founder}</b>
        <span>Doctor în marketing, neuromarketing</span>
      </figcaption>
    </div>
  </figure>
</section>

<style>
  .diff {
    position: relative;
    background: var(--ink);
    color: #fff;
    padding-block: clamp(72px, 10vw, 128px) 0;
    overflow: visible;
  }
  .diff::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
    background-size: 72px 72px;
    -webkit-mask-image: radial-gradient(110% 90% at 15% 0%, #000, transparent 70%);
    mask-image: radial-gradient(110% 90% at 15% 0%, #000, transparent 70%);
    pointer-events: none;
  }
  .diff__top {
    position: relative;
    display: grid;
    grid-template-columns: 0.95fr 1.05fr;
    gap: 64px;
    align-items: start;
  }
  .kicker--cyan {
    color: var(--cyan);
  }
  .diff__title {
    margin-top: 16px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
  }
  .diff__title span {
    color: var(--cyan);
  }
  .diff__sub {
    margin-top: 22px;
    max-width: 44ch;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--muted-dark);
  }
  .diff__cta {
    margin-top: 30px;
  }

  /* „Omul din spate" - bandă full-width peste tranziția dark → light */
  .diff__founder {
    position: relative;
    z-index: 2;
    overflow: hidden;
    margin-top: clamp(64px, 9vw, 110px);
    margin-bottom: clamp(-76px, -6vw, -50px);
    padding: 32px 0;
    background:
      radial-gradient(90% 180% at 86% 130%, rgba(110, 91, 224, 0.4), transparent 55%),
      radial-gradient(70% 150% at 8% -30%, rgba(0, 119, 252, 0.2), transparent 55%), #020a3a;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    box-shadow: 0 34px 70px -34px rgba(0, 0, 0, 0.55);
  }
  .diff__founder-inner {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 28px;
  }
  .diff__avatar {
    flex: none;
    width: 76px;
    height: 76px;
    border-radius: 50%;
    overflow: hidden;
    display: grid;
    place-items: center;
    background: linear-gradient(135deg, var(--electric), var(--cyan));
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.4rem;
    box-shadow: var(--glow-electric);
  }
  .diff__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 22%;
  }
  .diff__founder-quote {
    flex: 1;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(1.02rem, 1.5vw, 1.28rem);
    line-height: 1.4;
    letter-spacing: -0.01em;
    color: #fff;
    text-wrap: pretty;
  }
  .diff__founder-by {
    flex: none;
    text-align: right;
  }
  .diff__founder-by b {
    display: block;
    color: #fff;
    font-size: 0.98rem;
  }
  .diff__founder-by span {
    display: block;
    margin-top: 2px;
    font-size: 0.84rem;
    color: var(--cyan);
  }
  @media (max-width: 768px) {
    .diff__founder-inner {
      flex-direction: column;
      text-align: center;
      gap: 16px;
    }
    .diff__founder-quote,
    .diff__founder-by {
      text-align: center;
    }
  }
  .diff__points {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 1px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--r-md);
    overflow: hidden;
  }
  .diff__point {
    display: flex;
    gap: 20px;
    padding: 28px;
    background: var(--ink-soft);
  }
  .diff__num {
    font-family: var(--font-display);
    font-size: 0.85rem;
    color: var(--cyan);
    padding-top: 4px;
  }
  .diff__point h3 {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.1rem;
    color: #fff;
  }
  .diff__point p {
    margin-top: 8px;
    font-size: 0.96rem;
    line-height: 1.55;
    color: var(--muted-dark);
  }

  @media (max-width: 900px) {
    .diff__top {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
