---
/** Bandă social proof: nume clienți ca text (logo-uri de adăugat ulterior). */
const clients = [
  'Blitzstudio',
  'Echipamente-medicale.ro',
  'FEAA Galați',
  'Universitatea „Dunărea de Jos"',
  'Cross2Map',
];
---

<section class="clients" aria-label="Clienți">
  <div class="site-container">
    <p class="clients__label">Au lucrat cu noi</p>
    <ul class="clients__row">
      {clients.map((c) => <li>{c}</li>)}
    </ul>
  </div>
</section>

<style>
  .clients {
    background: var(--canvas);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    padding-block: 36px;
  }
  .clients__label {
    text-align: center;
    font-family: var(--font-display);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 20px;
  }
  .clients__row {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 18px 40px;
  }
  .clients__row li {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.05rem, 2vw, 1.4rem);
    color: var(--ink);
    opacity: 0.55;
    transition: opacity 0.2s var(--ease-snap);
  }
  .clients__row li:hover {
    opacity: 1;
  }
</style>
