---
import SectionHeading from '@components/ui/SectionHeading.astro';

const steps = [
  { n: '01', title: 'Descoperire', body: 'Înțelegem afacerea, publicul și obiectivele măsurabile.' },
  { n: '02', title: 'Cercetare & strategie', body: 'Analiză, neuromarketing și un plan clar de execuție.' },
  { n: '03', title: 'Execuție', body: 'Design și implementare validate pe atenția vizuală.' },
  { n: '04', title: 'Rezultate & mentenanță', body: 'Măsurăm, optimizăm și ținem totul la zi cu AI.' },
];
---

<section class="proc">
  <div class="site-container">
    <SectionHeading
      eyebrow="Cum lucrăm"
      title="Un proces simplu, de la idee la rezultate."
      accent="de la idee la rezultate"
      align="center"
    />
    <ol class="proc__steps" data-reveal-stagger>
      {
        steps.map((s) => (
          <li class="proc__step">
            <span class="proc__n">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .proc {
    position: relative;
    background: var(--canvas-soft);
    padding-block: clamp(64px, 9vw, 120px);
    overflow: hidden;
  }
  /* fundal cu puncte subtil */
  .proc::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(3, 13, 74, 0.06) 1px, transparent 1px);
    background-size: 28px 28px;
    -webkit-mask-image: radial-gradient(80% 80% at 50% 0%, #000, transparent 75%);
    mask-image: radial-gradient(80% 80% at 50% 0%, #000, transparent 75%);
    pointer-events: none;
  }
  .proc :global(.site-container) {
    position: relative;
  }
  .proc :global(.sh) {
    margin-bottom: 56px;
  }
  .proc__steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    overflow: hidden;
  }
  .proc__step {
    background: var(--canvas);
    padding: 32px 26px 36px;
    position: relative;
  }
  .proc__n {
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    color: var(--electric);
  }
  .proc__step h3 {
    margin-top: 14px;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.15rem;
    color: var(--ink);
  }
  .proc__step p {
    margin-top: 8px;
    font-size: 0.94rem;
    line-height: 1.55;
    color: var(--muted);
  }
  @media (max-width: 900px) {
    .proc__steps {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (max-width: 520px) {
    .proc__steps {
      grid-template-columns: 1fr;
    }
  }
</style>
