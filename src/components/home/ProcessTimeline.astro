---
import SectionHeading from '@components/ui/SectionHeading.astro';

const steps = [
  {
    n: '01',
    title: 'Ne cunoaștem',
    body: 'O discuție fără obligații în care ascultăm: ce vrei să obții, unde ești blocat și dacă suntem partenerii potriviți pentru tine.',
    tag: 'Start',
  },
  {
    n: '02',
    title: 'Analiză & cercetare',
    body: 'Ne uităm la situația ta, la concurență și la public. Aici intră datele și neuromarketingul, ca deciziile să nu fie pe ghicite.',
    tag: 'Cercetare',
  },
  {
    n: '03',
    title: 'Strategie',
    body: 'Punem concluziile într-un plan concret, pe obiective măsurabile. Știi exact ce facem, pe ce canale și ce rezultat țintim.',
    tag: 'Plan',
  },
  {
    n: '04',
    title: 'Execuție',
    body: 'Ducem planul în realitate — design, web, campanii — transparent și cu update-uri regulate, ca să știi mereu unde suntem.',
    tag: 'Execuție',
  },
  {
    n: '05',
    title: 'Rezultate & mentenanță',
    body: 'Măsurăm, optimizăm și rămânem alături. Pentru noi treaba nu se termină la lansare, ci când se văd rezultatele.',
    tag: 'Rezultate',
  },
];
---

<section class="proc" id="proces" data-reveal>
  <div class="site-container proc__inner">
    <SectionHeading
      eyebrow="Cum lucrăm"
      title="De la idee la rezultate, pas cu pas"
      accent="pas cu pas"
      subtitle="Un proces clar și transparent, în care la fiecare etapă știi exact unde suntem și de ce."
      align="center"
    />

    <div class="proc__stage" data-proc>
      {/* coloana stângă: lista de pași clicabilă */}
      <ol class="proc__list" role="tablist" aria-label="Etapele procesului">
        {
          steps.map((s, i) => (
            <li>
              <button
                class="proc__tab"
                type="button"
                role="tab"
                data-i={i}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
              >
                <span class="proc__tabn">{s.n}</span>
                <span class="proc__tabt">{s.title}</span>
              </button>
            </li>
          ))
        }
      </ol>

      {/* coloana dreaptă: panoul mare */}
      <div class="proc__panel">
        {
          steps.map((s, i) => (
            <article
              class="proc__slide"
              role="tabpanel"
              data-i={i}
              aria-hidden={i === 0 ? 'false' : 'true'}
            >
              <span class="proc__ghost" aria-hidden="true">
                {s.n}
              </span>
              <div class="proc__slidebody">
                <span class="proc__tag">{s.tag}</span>
                <h3 class="proc__title">{s.title}</h3>
                <p class="proc__text">{s.body}</p>
                <div class="proc__count" aria-hidden="true">
                  <b>{s.n}</b>
                  <span>/ 05</span>
                </div>
              </div>
            </article>
          ))
        }
        <div class="proc__dots" aria-hidden="true">
          {steps.map((_, i) => <span class="proc__dot" data-i={i} />)}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .proc {
    position: relative;
    isolation: isolate;
    /* gri foarte deschis: contrast subtil față de secțiunile albe vecine */
    background: var(--canvas-soft);
    color: var(--ink);
    padding-block: clamp(72px, 10vw, 132px);
    overflow: hidden;
  }
  /* textură punctată subtilă + un singur glow electric discret */
  .proc::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: radial-gradient(rgba(3, 13, 74, 0.05) 1px, transparent 1px);
    background-size: 30px 30px;
    -webkit-mask-image: radial-gradient(90% 70% at 50% 0%, #000, transparent 78%);
    mask-image: radial-gradient(90% 70% at 50% 0%, #000, transparent 78%);
    pointer-events: none;
  }
  .proc::after {
    content: '';
    position: absolute;
    z-index: -1;
    top: -12%;
    right: -6%;
    width: 44vw;
    height: 44vw;
    max-width: 600px;
    max-height: 600px;
    background: radial-gradient(circle, rgba(0, 119, 252, 0.12), transparent 64%);
    pointer-events: none;
  }
  .proc :global(.sh) {
    margin-bottom: clamp(40px, 5vw, 64px);
  }

  /* layout split */
  .proc__stage {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(20px, 3vw, 48px);
    align-items: stretch;
  }

  /* ---- lista de pași (stânga) ---- */
  .proc__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .proc__tab {
    position: relative;
    width: 100%;
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 16px;
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--canvas);
    color: var(--muted);
    font-family: var(--font-body);
    text-align: left;
    cursor: pointer;
    transition:
      background 0.3s var(--ease),
      border-color 0.3s var(--ease),
      color 0.3s var(--ease),
      box-shadow 0.3s var(--ease),
      transform 0.3s var(--ease);
  }
  /* accent electric pe muchia din stânga (vizibil la activ) */
  .proc__tab::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    transform: translateY(-50%) scaleY(0);
    width: 3px;
    height: 56%;
    border-radius: 0 3px 3px 0;
    background: linear-gradient(180deg, var(--electric), var(--cyan));
    transition: transform 0.3s var(--ease);
  }
  .proc__tab:hover {
    color: var(--ink);
    border-color: rgba(0, 119, 252, 0.4);
  }
  .proc__tab[aria-selected='true'] {
    background: var(--canvas);
    border-color: rgba(0, 119, 252, 0.5);
    color: var(--ink);
    box-shadow: var(--sh-md);
    transform: translateX(4px);
  }
  .proc__tab[aria-selected='true']::before {
    transform: translateY(-50%) scaleY(1);
  }
  .proc__tabn {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
    color: var(--electric);
    opacity: 0.5;
    transition: opacity 0.3s var(--ease);
  }
  .proc__tab:hover .proc__tabn,
  .proc__tab[aria-selected='true'] .proc__tabn {
    opacity: 1;
  }
  .proc__tabt {
    font-weight: 600;
    font-size: 1.02rem;
    line-height: 1.25;
  }

  /* ---- panoul mare (dreapta) ---- */
  .proc__panel {
    position: relative;
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    background:
      radial-gradient(120% 120% at 100% 0%, rgba(0, 119, 252, 0.07), transparent 55%), var(--canvas);
    box-shadow: var(--sh-lg);
    padding: clamp(28px, 3.4vw, 52px);
    min-height: 340px;
    overflow: hidden;
  }
  .proc__slide {
    position: absolute;
    inset: clamp(28px, 3.4vw, 52px);
    display: flex;
    align-items: center;
    opacity: 0;
    transform: translateY(14px);
    pointer-events: none;
    transition:
      opacity 0.5s var(--ease),
      transform 0.5s var(--ease);
  }
  .proc__slide[aria-hidden='false'] {
    opacity: 1;
    transform: none;
    pointer-events: auto;
  }
  /* număr-fantomă gigant în spate (contur subtil navy) */
  .proc__ghost {
    position: absolute;
    top: 50%;
    right: -2%;
    transform: translateY(-50%);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(11rem, 22vw, 19rem);
    line-height: 0.8;
    letter-spacing: -0.04em;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(3, 13, 74, 0.09);
    pointer-events: none;
    z-index: 0;
  }
  .proc__slidebody {
    position: relative;
    z-index: 1;
    max-width: 30ch;
  }
  .proc__tag {
    display: inline-block;
    font-family: var(--font-display);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--electric);
    background: rgba(0, 119, 252, 0.07);
    padding: 6px 12px;
    border: 1px solid rgba(0, 119, 252, 0.28);
    border-radius: var(--r-pill);
    margin-bottom: 20px;
  }
  .proc__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .proc__text {
    margin: 16px 0 0;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--muted);
  }
  .proc__count {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-top: 28px;
    font-family: var(--font-display);
  }
  .proc__count b {
    font-size: 1.5rem;
    color: var(--ink);
  }
  .proc__count span {
    font-size: 0.95rem;
    color: var(--muted);
  }
  /* dots de navigare jos */
  .proc__dots {
    position: absolute;
    right: clamp(28px, 3.4vw, 52px);
    bottom: clamp(22px, 2.4vw, 34px);
    display: flex;
    gap: 8px;
    z-index: 2;
  }
  .proc__dot {
    width: 22px;
    height: 4px;
    border-radius: 2px;
    background: var(--line);
    transition:
      background 0.3s var(--ease),
      width 0.3s var(--ease);
  }
  .proc__dot.on {
    width: 34px;
    background: linear-gradient(90deg, var(--electric), var(--cyan));
  }

  /* ---- responsive ---- */
  @media (max-width: 860px) {
    .proc__stage {
      grid-template-columns: minmax(0, 1fr);
      gap: 18px;
    }
    /* lista devine un rând orizontal scrollabil de pastile */
    .proc__list {
      flex-direction: row;
      gap: 10px;
      min-width: 0;
      overflow-x: auto;
      scrollbar-width: none;
      padding-bottom: 4px;
      scroll-snap-type: x proximity;
      /* fade la margini → semnalează că rândul de pași se derulează lateral */
      -webkit-mask-image: linear-gradient(
        90deg,
        transparent 0,
        #000 18px,
        #000 calc(100% - 18px),
        transparent 100%
      );
      mask-image: linear-gradient(
        90deg,
        transparent 0,
        #000 18px,
        #000 calc(100% - 18px),
        transparent 100%
      );
    }
    .proc__list::-webkit-scrollbar {
      display: none;
    }
    .proc__list li {
      flex: 0 0 auto;
      scroll-snap-align: start;
    }
    .proc__tab {
      grid-template-columns: auto;
      gap: 4px;
      padding: 12px 16px;
      min-width: 124px;
    }
    .proc__tab[aria-selected='true'] {
      transform: none;
    }
    .proc__tab::before {
      display: none;
    }
    .proc__tabt {
      font-size: 0.9rem;
    }
    .proc__ghost {
      font-size: clamp(8rem, 40vw, 13rem);
    }
    .proc__panel {
      min-height: 300px;
    }
  }
  @media (max-width: 480px) {
    .proc__slidebody {
      max-width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .proc__slide,
    .proc__tab,
    .proc__tab::before,
    .proc__dot {
      transition: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-proc]');
  if (root) {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('.proc__tab'));
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.proc__slide'));
    const dots = Array.from(root.querySelectorAll<HTMLElement>('.proc__dot'));
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const DUR = 5200;

    let current = 0;
    let timer: ReturnType<typeof setTimeout> | undefined;
    let paused = false;

    const schedule = () => {
      clearTimeout(timer);
      if (reduce || paused) return;
      timer = setTimeout(() => show((current + 1) % slides.length), DUR);
    };

    const show = (i: number, fromClick = false) => {
      current = i;
      tabs.forEach((t, k) => {
        const on = k === i;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
      });
      slides.forEach((s, k) => s.setAttribute('aria-hidden', k === i ? 'false' : 'true'));
      dots.forEach((d, k) => d.classList.toggle('on', k === i));
      schedule();
      if (fromClick) tabs[i]?.focus();
    };

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => show(i));
      // navigare cu săgeți (tab roving)
      t.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
          e.preventDefault();
          show((current + 1) % tabs.length, true);
        } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
          e.preventDefault();
          show((current - 1 + tabs.length) % tabs.length, true);
        }
      });
    });

    // pauză pe hover/focus în secțiune
    const setPaused = (p: boolean) => {
      paused = p;
      if (p) {
        clearTimeout(timer);
      } else {
        schedule();
      }
    };
    root.addEventListener('pointerenter', () => setPaused(true));
    root.addEventListener('pointerleave', () => setPaused(false));
    root.addEventListener('focusin', () => setPaused(true));
    root.addEventListener('focusout', (e) => {
      if (!root.contains(e.relatedTarget as Node)) setPaused(false);
    });

    // pornește doar când secțiunea intră în viewport
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((en) => {
            if (en.isIntersecting) {
              schedule();
            } else {
              clearTimeout(timer);
            }
          });
        },
        { threshold: 0.35 },
      );
      io.observe(root);
    }

    // stare inițială
    show(0);
  }
</script>
