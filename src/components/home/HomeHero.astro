---
import Button from '@components/ui/Button.astro';

// Parteneri reali — logo-uri descărcate local (public/parteneri).
const partners = [
  { src: '/parteneri/marketing-deck.png', name: 'Marketing Deck' },
  { src: '/parteneri/paul-ardeleanu.png', name: 'Paul Ardeleanu' },
  { src: '/parteneri/m1-med-beauty.png', name: 'M1 Med Beauty' },
  { src: '/parteneri/matematica-interactiva.png', name: 'Matematica Interactivă' },
  { src: '/parteneri/feaa-galati.png', name: 'FEAA Galați' },
  { src: '/parteneri/simona-halep.png', name: 'Hotel Simona Halep' },
  { src: '/parteneri/priority-clinic.png', name: 'Priority Clinic' },
  { src: '/parteneri/fastrackids.webp', name: 'FasTrackKids' },
];
---

<section class="hero">
  <div class="hero__bg" aria-hidden="true"></div>
  <div class="hero__wash" aria-hidden="true"></div>

  <div class="site-container hero__inner">
    <p class="hero__pill">Studio de grafică &amp; marketing digital</p>

    <h1 class="hero__title">
      Servicii digitale fundamentate pe <span class="hero__accent">neuroștiință</span>, nu pe noroc.
    </h1>

    <p class="hero__sub">
      Înainte să arate bine, ne asigurăm că funcționează. Grafică, web și marketing livrate de doi
      oameni dedicați, cu colaboratori specializați pentru ce cere proiectul.
    </p>

    <div class="hero__cta">
      <Button href="/contact" variant="primary" size="lg">Cere o ofertă</Button>
      <a class="hero__textlink" href="/servicii">Vezi serviciile</a>
    </div>

    <!-- Semnătura: același design, înainte și cu heatmap-ul de atenție -->
    <div class="hero__show">
      <figure class="shot">
        <img src="/exemplu-design.png" alt="Material de design realizat de Simplead" width="383" height="384" />
        <figcaption>Designul</figcaption>
      </figure>
      <span class="hero__arrow" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4">
          <path d="M5 12h14M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </span>
      <figure class="shot shot--heat">
        <img src="/exemplu-heatmap.png" alt="Harta de atenție (heatmap) peste același design" width="381" height="383" />
        <figcaption>Unde se duce atenția, măsurat</figcaption>
      </figure>
    </div>

    <div class="hero__trust">
      <span class="hero__trust-lbl">Lucrează cu noi</span>
      <div class="marquee">
        <ul class="marquee__group">
          {
            partners.map((p) => (
              <li>
                <img src={p.src} alt={p.name} loading="lazy" />
              </li>
            ))
          }
        </ul>
        <ul class="marquee__group" aria-hidden="true">
          {
            partners.map((p) => (
              <li>
                <img src={p.src} alt="" loading="lazy" />
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    background: var(--canvas);
    padding-top: calc(var(--nav-h) + clamp(24px, 4vw, 52px));
    padding-bottom: var(--section-pad);
  }
  /* pattern discret în fundal, estompat cu gradient + opacitate */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image:
      linear-gradient(to right, rgba(3, 13, 74, 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(3, 13, 74, 0.035) 1px, transparent 1px);
    background-size: 40px 40px;
    -webkit-mask-image: linear-gradient(180deg, #000 0%, rgba(0, 0, 0, 0.35) 38%, transparent 66%);
    mask-image: linear-gradient(180deg, #000 0%, rgba(0, 0, 0, 0.35) 38%, transparent 66%);
    pointer-events: none;
  }
  .hero__wash {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: radial-gradient(56% 42% at 50% -6%, rgba(0, 119, 252, 0.08), transparent 70%);
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* pastila „kicker" de brand */
  .hero__pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 24px;
    padding: 8px 18px;
    background: #fff;
    border: var(--border);
    border-radius: var(--r-pill);
    box-shadow: var(--sh-sm);
    font-family: var(--font-display);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--ink);
  }
  .hero__pill::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--electric);
  }

  .hero__title {
    margin: 0;
    max-width: 30ch;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.2rem, 5vw, 3.8rem);
    line-height: 1.06;
    letter-spacing: -0.03em;
    color: var(--ink);
    text-wrap: balance;
  }
  .hero__accent {
    color: var(--electric);
  }
  .hero__sub {
    margin: 22px 0 0;
    max-width: 75ch;
    font-size: clamp(1.0625rem, 1.4vw, 1.2rem);
    line-height: 1.55;
    color: var(--muted);
  }

  .hero__cta {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 12px 26px;
  }
  /* link „doar text" cu efectul de subliniere din footer */
  .hero__textlink {
    position: relative;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.98rem;
    color: var(--ink);
    text-decoration: none;
    padding: 4px 2px;
  }
  .hero__textlink::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: linear-gradient(90deg, var(--electric), var(--cyan));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.24s var(--ease-snap);
  }
  .hero__textlink:hover::after {
    transform: scaleX(1);
  }

  /* ===== semnătura: design -> heatmap ===== */
  .hero__show {
    margin-top: 46px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(16px, 3vw, 40px);
  }
  .shot {
    margin: 0;
    width: clamp(220px, 30vw, 340px);
    background: #fff;
    border: var(--border);
    border-radius: var(--r-lg);
    box-shadow: var(--sh-lg);
    overflow: hidden;
  }
  .shot img {
    display: block;
    width: 100%;
    height: auto;
  }
  .shot figcaption {
    padding: 12px 16px;
    font-size: 0.82rem;
    font-weight: 600;
    color: var(--muted);
    border-top: var(--border);
    text-align: left;
  }
  .shot--heat {
    box-shadow: var(--glow-electric), var(--sh-lg);
  }
  .shot--heat figcaption {
    color: var(--ink);
  }
  .hero__arrow {
    flex: none;
    color: var(--electric);
  }
  .hero__arrow svg {
    width: 30px;
    height: 30px;
  }

  /* ===== lucrează cu noi: logo-uri parteneri ===== */
  .hero__trust {
    margin-top: 50px;
    width: 100%;
    border-top: var(--border);
    padding-top: 24px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 18px;
    text-align: left;
  }
  .hero__trust-lbl {
    font-family: var(--font-display);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  /* bandă cu derulare continuă (marquee), un singur rând, logo-uri la dim. plină */
  .marquee {
    position: relative;
    display: flex;
    width: 100%;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 5%, #000 95%, transparent 100%);
    mask-image: linear-gradient(90deg, transparent 0, #000 5%, #000 95%, transparent 100%);
  }
  .marquee__group {
    list-style: none;
    flex: none;
    display: flex;
    align-items: center;
    animation: heroMarquee 42s linear infinite;
  }
  .marquee:hover .marquee__group {
    animation-play-state: paused;
  }
  .marquee__group li {
    display: flex;
    align-items: center;
    padding: 0 32px;
  }
  .marquee__group img {
    height: 34px;
    width: auto;
    max-width: 170px;
    object-fit: contain;
    filter: grayscale(1);
    opacity: 0.62;
    transition:
      filter 0.22s var(--ease-snap),
      opacity 0.22s var(--ease-snap);
  }
  .marquee__group li:hover img {
    filter: grayscale(0);
    opacity: 1;
  }
  @keyframes heroMarquee {
    to {
      transform: translateX(-100%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee {
      overflow-x: auto;
    }
    .marquee__group {
      animation: none;
    }
    .marquee__group[aria-hidden='true'] {
      display: none;
    }
  }

  @media (max-width: 640px) {
    .hero__show {
      flex-direction: column;
    }
    .hero__arrow {
      transform: rotate(90deg);
    }
    .shot {
      width: min(86vw, 340px);
    }
    .marquee__group img {
      height: 26px;
    }
    .marquee__group li {
      padding: 0 22px;
    }
  }
</style>
