---
import Button from '@components/ui/Button.astro';
---

<section class="hero">
  <div class="site-container hero__inner">
    <div class="hero__copy">
      <p class="kicker">Design bazat pe cercetare · Mentenanță cu AI</p>
      <h1 class="hero__title">
        Marketing și grafică fundamentate pe <span class="hero__accent">neuroștiință</span>, nu pe
        noroc.
      </h1>
      <p class="hero__sub">
        Branding, web și marketing pentru afaceri care vor să arate remarcabil. Validăm fiecare
        decizie cu neuromarketing și date — nu cu presupuneri.
      </p>
      <div class="hero__cta">
        <Button href="/contact" size="lg" withArrow>Cere o ofertă</Button>
        <Button href="/servicii" size="lg" variant="outline">Vezi cum lucrăm</Button>
      </div>
    </div>

    <!-- Vizual focal: mockup „research / heatmap" peste o plasă (grid) — pur CSS+SVG -->
    <div class="hero__visual" aria-hidden="true">
      <div class="mesh"></div>
      <div class="mock">
        <div class="mock__bar"><span></span><span></span><span></span></div>
        <div class="mock__body">
          <div class="mock__line mock__line--lg"></div>
          <div class="mock__line"></div>
          <div class="mock__line mock__line--sm"></div>
          <div class="mock__cta"></div>
          <svg class="mock__heat" viewBox="0 0 120 120">
            <circle cx="78" cy="34" r="26" fill="var(--signal)" opacity="0.22" />
            <circle cx="78" cy="34" r="16" fill="var(--signal)" opacity="0.30" />
            <circle cx="78" cy="34" r="7" fill="var(--electric)" opacity="0.55" />
          </svg>
        </div>
      </div>
      <div class="hero__chip"><span class="dot"></span> Eye-tracking · expoze.app</div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    background: var(--canvas);
    padding-top: calc(var(--nav-h) + clamp(24px, 4vw, 48px));
    padding-bottom: clamp(56px, 7vw, 92px);
    overflow: hidden;
  }
  .hero__inner {
    position: relative;
    width: 100%;
    display: grid;
    grid-template-columns: 1.08fr 0.92fr;
    gap: 48px;
    align-items: center;
  }
  .hero__title {
    margin-top: 18px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.85rem, 3.4vw, 3.1rem);
    line-height: 1.07;
    letter-spacing: -0.025em;
    color: var(--ink);
    text-wrap: balance;
  }
  .hero__accent {
    color: var(--electric);
  }
  .hero__sub {
    margin-top: 20px;
    max-width: 46ch;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--muted);
  }
  .hero__cta {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  /* ===== Vizual dreapta: plasă + mockup ===== */
  .hero__visual {
    position: relative;
    justify-self: center;
    width: 100%;
    max-width: 440px;
    aspect-ratio: 1 / 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  /* plasa (grid) din spatele mockup-ului, în dreapta */
  .mesh {
    position: absolute;
    inset: -10% -8% -10% -2%;
    background-image:
      linear-gradient(rgba(0, 119, 252, 0.16) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0, 119, 252, 0.16) 1px, transparent 1px);
    background-size: 34px 34px;
    -webkit-mask-image: radial-gradient(70% 70% at 60% 40%, #000, transparent 75%);
    mask-image: radial-gradient(70% 70% at 60% 40%, #000, transparent 75%);
    pointer-events: none;
  }
  /* noduri pe plasă */
  .mesh::after {
    content: '';
    position: absolute;
    inset: 0;
    background-image: radial-gradient(var(--cyan) 1.6px, transparent 2px);
    background-size: 34px 34px;
    background-position: -1px -1px;
    opacity: 0.5;
    -webkit-mask-image: radial-gradient(60% 60% at 60% 40%, #000, transparent 72%);
    mask-image: radial-gradient(60% 60% at 60% 40%, #000, transparent 72%);
  }
  .mock {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 380px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    box-shadow: var(--glow-cyan), var(--sh-lg);
    overflow: hidden;
  }
  .mock__bar {
    display: flex;
    gap: 7px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--line);
  }
  .mock__bar span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--line);
  }
  .mock__body {
    position: relative;
    padding: 28px 24px 36px;
  }
  .mock__line {
    height: 14px;
    width: 100%;
    border-radius: 6px;
    background: var(--canvas-soft);
    margin-bottom: 14px;
  }
  .mock__line--lg {
    height: 22px;
    width: 70%;
    background: var(--ink);
    opacity: 0.85;
  }
  .mock__line--sm {
    width: 45%;
  }
  .mock__cta {
    margin-top: 18px;
    height: 38px;
    width: 140px;
    border-radius: var(--r-sm);
    background: var(--electric);
  }
  .mock__heat {
    position: absolute;
    top: 12px;
    right: 14px;
    width: 120px;
    height: 120px;
  }
  .hero__chip {
    position: absolute;
    bottom: 6%;
    left: -2%;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    background: var(--ink);
    color: #fff;
    border-radius: var(--r-pill);
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    box-shadow: var(--sh-md);
  }
  .hero__chip .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 0 4px rgba(0, 224, 198, 0.25);
  }

  @media (max-width: 960px) {
    .hero {
      min-height: auto;
      padding-bottom: 56px;
    }
    .hero__inner {
      grid-template-columns: 1fr;
      gap: 44px;
    }
    .hero__visual {
      order: -1;
      max-width: 340px;
    }
  }
  @media (max-width: 480px) {
    .hero__cta {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
